{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The name of the Sentinel workspace"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2024-03-01",
      "type": "Microsoft.SecurityInsights/alertRules",
      "name": "AZ-MITRE-ATTACK-022",
      "properties": {
        "displayName": "MITRE T1053.005: Scheduled Task",
        "description": "Detects ATT&CK technique T1053.005 (Scheduled Task). Adversaries may abuse the Windows Task Scheduler to perform task scheduling for initial or recurring execution of malicious code. There are multiple ways to access the Task Scheduler in Windows. The [",
        "severity": "Medium",
        "query": "AuditLogs | where OperationName contains \"mitre\" | summarize count() by bin(TimeGenerated, 5m), InitiatedBy | where count_ > 5 // AZ-MITRE-ATTACK-022",
        "queryFrequency": "5m",
        "queryPeriod": "10m",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 5,
        "tactics": [
          "Execution"
        ],
        "techniques": [
          "T1053.005"
        ],
        "enabled": true,
        "kind": "Scheduled",
        "tags": {
          "compliance": "NIST-800-53-SI-4,PCI-DSS-10.2"
        }
      }
    }
  ],
  "outputs": {
    "ruleId": {
      "type": "string",
      "value": "AZ-MITRE-ATTACK-022"
    }
  }
}