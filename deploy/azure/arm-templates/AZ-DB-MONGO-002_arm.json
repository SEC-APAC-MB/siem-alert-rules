{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The name of the Sentinel workspace"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2024-03-01",
      "type": "Microsoft.SecurityInsights/alertRules",
      "name": "AZ-DB-MONGO-002",
      "properties": {
        "displayName": "MongoDB \u2014 admin Database Unauthorized Access",
        "description": "Detects unauthorized access to MongoDB admin database",
        "severity": "Medium",
        "query": "AzureDiagnostics | where Category == \"SQLSecurityAuditEvents\" | where statement_s contains \"mongodb\" or action_name_s contains \"admin\" | summarize count() by bin(TimeGenerated, 5m), database_name_s, session_server_principal_name_s | where count_ > 5 // AZ-DB-MONGO-002",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT5M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 5,
        "tactics": [
          "Collection"
        ],
        "techniques": [],
        "enabled": true,
        "kind": "Scheduled",
        "tags": {
          "compliance": "PCI-DSS-2.1"
        }
      }
    }
  ],
  "outputs": {
    "ruleId": {
      "type": "string",
      "value": "AZ-DB-MONGO-002"
    }
  }
}