{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The name of the Sentinel workspace"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2024-03-01",
      "type": "Microsoft.SecurityInsights/alertRules",
      "name": "AZ-AI-PD-005",
      "properties": {
        "displayName": "AI \u2014 Data Exfiltration via Model Output",
        "description": "Detects sensitive data being exfiltrated through LLM response manipulation",
        "severity": "Medium",
        "query": "union CommonSecurityLog, SecurityEvent | where Message contains \"data\" or Message contains \"exfiltration\" | summarize count() by bin(TimeGenerated, 5m), Computer | where count_ > 1 // AZ-AI-PD-005",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT5M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 1,
        "tactics": [
          "Discovery"
        ],
        "techniques": [],
        "enabled": true,
        "kind": "Scheduled",
        "tags": {
          "compliance": "AI-DEX-001,GDPR-32A,PCI-DSS-3.3"
        }
      }
    }
  ],
  "outputs": {
    "ruleId": {
      "type": "string",
      "value": "AZ-AI-PD-005"
    }
  }
}