{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The name of the Sentinel workspace"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2024-03-01",
      "type": "Microsoft.SecurityInsights/alertRules",
      "name": "AZ-AI-DB-027",
      "properties": {
        "displayName": "AI \u2014 Feature Store Poisoning Detection",
        "description": "Detects poisoning of ML feature stores that serve AI models with manipulated input features",
        "severity": "Medium",
        "query": "union CommonSecurityLog, SecurityEvent | where Message contains \"feature\" or Message contains \"store\" | summarize count() by bin(TimeGenerated, 5m), Computer | where count_ > 5 // AZ-AI-DB-027",
        "queryFrequency": "PT15M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 5,
        "tactics": [
          "Discovery"
        ],
        "techniques": [],
        "enabled": true,
        "kind": "Scheduled",
        "tags": {
          "compliance": "AI-DB-013,AI-ACT-15"
        }
      }
    }
  ],
  "outputs": {
    "ruleId": {
      "type": "string",
      "value": "AZ-AI-DB-027"
    }
  }
}