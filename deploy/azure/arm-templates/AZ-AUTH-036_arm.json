{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The name of the Sentinel workspace"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2024-03-01",
      "type": "Microsoft.SecurityInsights/alertRules",
      "name": "AZ-AUTH-036",
      "properties": {
        "displayName": "Authentication \u2014 Idle Session Hijacking",
        "description": "Detects session hijacking of idle authenticated sessions",
        "severity": "Medium",
        "query": "SigninLogs | where TimeGenerated > ago(1h) | where ResultType == 0 | where SessionLifetime > 8h | where TimeSinceLastActivity > 30m | summarize count() by bin(TimeGenerated, 1h), UserPrincipalName, IpAddress | where count_ > 2",
        "queryFrequency": "PT1H",
        "queryPeriod": "PT1H",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 2,
        "tactics": [
          "Discovery"
        ],
        "techniques": [],
        "enabled": true,
        "kind": "Scheduled",
        "tags": {
          "compliance": "NIST-800-53-SI-4"
        }
      }
    }
  ],
  "outputs": {
    "ruleId": {
      "type": "string",
      "value": "AZ-AUTH-036"
    }
  }
}