{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The name of the Sentinel workspace"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2024-03-01",
      "type": "Microsoft.SecurityInsights/alertRules",
      "name": "AZ-AUTH-032",
      "properties": {
        "displayName": "Authentication \u2014 Certificate-based Auth Fraud",
        "description": "Detects fraudulent certificate-based authentication including stolen or forged certificates",
        "severity": "Medium",
        "query": "SigninLogs | where TimeGenerated > ago(15m) | where ResultType == 0 | where AuthenticationProtocol == \"X509\" | where AuthenticationProcessingDetails has_any (\"certificate\", \"smartcard\") | summarize count() by bin(TimeGenerated, 15m), UserPrincipalName, IpAddress | where count_ > 5",
        "queryFrequency": "PT15M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 5,
        "tactics": [
          "Discovery"
        ],
        "techniques": [],
        "enabled": true,
        "kind": "Scheduled",
        "tags": {
          "compliance": "NIST-800-53-SI-4"
        }
      }
    }
  ],
  "outputs": {
    "ruleId": {
      "type": "string",
      "value": "AZ-AUTH-032"
    }
  }
}