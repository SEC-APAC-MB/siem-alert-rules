{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The name of the Sentinel workspace"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2024-03-01",
      "type": "Microsoft.SecurityInsights/alertRules",
      "name": "AZ-AUTH-025",
      "properties": {
        "displayName": "Authentication \u2014 JWT Token Manipulation",
        "description": "Detects JWT token manipulation attempts including algorithm confusion and signature bypass",
        "severity": "Medium",
        "query": "let jwt_patterns = dynamic([\"alg.none\", \"alg.None\", \"algorithm:none\"]); AzureDiagnostics | where Category contains 'gateway' | where RequestHeaders has_any (jwt_patterns) or RequestBody has_any (jwt_patterns) | summarize count() by bin(TimeGenerated, 5m), resource_group, SourceIP",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT5M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 1,
        "tactics": [
          "Discovery"
        ],
        "techniques": [],
        "enabled": true,
        "kind": "Scheduled",
        "tags": {
          "compliance": "NIST-800-53-SI-4"
        }
      }
    }
  ],
  "outputs": {
    "ruleId": {
      "type": "string",
      "value": "AZ-AUTH-025"
    }
  }
}