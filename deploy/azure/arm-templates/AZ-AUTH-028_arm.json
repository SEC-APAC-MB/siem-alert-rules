{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The name of the Sentinel workspace"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2024-03-01",
      "type": "Microsoft.SecurityInsights/alertRules",
      "name": "AZ-AUTH-028",
      "properties": {
        "displayName": "Authentication \u2014 DNS-Based Authentication Bypass",
        "description": "Detects DNS manipulation used to bypass authentication or redirect traffic",
        "severity": "Medium",
        "query": "AzureDiagnostics | where Category contains 'dns' | where QueryType in (\"A\", \"AAAA\", \"CNAME\") | where Name has_any (\"login\", \"auth\", \"sso\", \"vpn\") | summarize dcount(IPAddresses), count() by bin(TimeGenerated, 10m), ClientIP, Name | where dcount_IPAddresses > 2",
        "queryFrequency": "PT10M",
        "queryPeriod": "PT10M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 2,
        "tactics": [
          "Discovery"
        ],
        "techniques": [],
        "enabled": true,
        "kind": "Scheduled",
        "tags": {
          "compliance": "NIST-800-53-SI-4"
        }
      }
    }
  ],
  "outputs": {
    "ruleId": {
      "type": "string",
      "value": "AZ-AUTH-028"
    }
  }
}