{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The name of the Sentinel workspace"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2024-03-01",
      "type": "Microsoft.SecurityInsights/alertRules",
      "name": "AZ-EXECUTION-137",
      "properties": {
        "displayName": "PowerShell Suspicious Execution",
        "description": "Detect encoded PowerShell, -bypass, hidden window, and download cradle patterns",
        "severity": "Medium",
        "query": "SecurityEvent | where EventID == 4688 | where NewProcessName contains \"powershell\" or CommandLine contains \"execution\" | summarize count() by bin(TimeGenerated, 5m), Computer, Account, NewProcessName | where count_ > 5 // AZ-EXECUTION-137",
        "queryFrequency": "5m",
        "queryPeriod": "10m",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 5,
        "tactics": [
          "Execution"
        ],
        "techniques": [],
        "enabled": true,
        "kind": "Scheduled"
      }
    }
  ],
  "outputs": {
    "ruleId": {
      "type": "string",
      "value": "AZ-EXECUTION-137"
    }
  }
}