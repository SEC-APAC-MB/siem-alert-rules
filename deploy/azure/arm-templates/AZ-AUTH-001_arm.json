{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The name of the Sentinel workspace"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2024-03-01",
      "type": "Microsoft.SecurityInsights/alertRules",
      "name": "AZ-AUTH-001",
      "properties": {
        "displayName": "Authentication \u2014 Brute Force Login Attempts",
        "description": "Detects high volume of failed authentication attempts from a single source IP indicating brute force attack",
        "severity": "Medium",
        "query": "AzureDiagnostics | where Category contains 'auth_failed' | summarize count() by bin(TimeGenerated, 5m), resource_group, SourceIP | where count_ > 10",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT5M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 10,
        "tactics": [
          "Discovery"
        ],
        "techniques": [],
        "enabled": true,
        "kind": "Scheduled",
        "tags": {
          "compliance": "NIST-800-53-SI-4,PCI-DSS-8.1,NIS2-Art.15"
        }
      }
    }
  ],
  "outputs": {
    "ruleId": {
      "type": "string",
      "value": "AZ-AUTH-001"
    }
  }
}