{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The name of the Sentinel workspace"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2024-03-01",
      "type": "Microsoft.SecurityInsights/alertRules",
      "name": "AZ-MOBILE_SECURITY-104",
      "properties": {
        "displayName": "Clipboard Data Leakage",
        "description": "Android and iOS specific attack detection: app repackaging, certificate pinning bypass, API tampering",
        "severity": "Medium",
        "query": "SecurityEvent | where EventID == 4688 | where NewProcessName contains \"clipboard\" or CommandLine contains \"data\" | summarize count() by bin(TimeGenerated, 5m), Computer, Account, NewProcessName | where count_ > 5 // AZ-MOBILE_SECURITY-104",
        "queryFrequency": "5m",
        "queryPeriod": "10m",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 5,
        "tactics": [
          "Discovery"
        ],
        "techniques": [],
        "enabled": true,
        "kind": "Scheduled"
      }
    }
  ],
  "outputs": {
    "ruleId": {
      "type": "string",
      "value": "AZ-MOBILE_SECURITY-104"
    }
  }
}