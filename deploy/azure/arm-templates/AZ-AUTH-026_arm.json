{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The name of the Sentinel workspace"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2024-03-01",
      "type": "Microsoft.SecurityInsights/alertRules",
      "name": "AZ-AUTH-026",
      "properties": {
        "displayName": "Authentication \u2014 SAML Token Forging",
        "description": "Detects SAML token forging attempts and XML signature wrapping attacks",
        "severity": "Medium",
        "query": "SigninLogs | where TimeGenerated > ago(10m) | where ResultType in (50053, 50074, 50076) | where AuthenticationProtocol == \"SAML\" | summarize count() by bin(TimeGenerated, 10m), UserPrincipalName, IpAddress | where count_ > 2",
        "queryFrequency": "PT10M",
        "queryPeriod": "PT10M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 2,
        "tactics": [
          "Discovery"
        ],
        "techniques": [],
        "enabled": true,
        "kind": "Scheduled",
        "tags": {
          "compliance": "NIST-800-53-SI-4"
        }
      }
    }
  ],
  "outputs": {
    "ruleId": {
      "type": "string",
      "value": "AZ-AUTH-026"
    }
  }
}