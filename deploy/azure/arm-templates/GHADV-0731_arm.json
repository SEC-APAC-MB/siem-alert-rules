{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The name of the Sentinel workspace"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2024-03-01",
      "type": "Microsoft.SecurityInsights/alertRules",
      "name": "GHADV-0731",
      "properties": {
        "displayName": "ImageMagick: Information Disclosure in MNG decoder because allocated memory is left unchanged",
        "description": "ImageMagick: Information Disclosure in MNG decoder because allocated memory is left unchanged",
        "severity": "Medium",
        "query": "AuditLogs | where OperationName contains \"imagemagick\" | summarize count() by bin(TimeGenerated, 5m), InitiatedBy | where count_ > 3 // GHADV-0731",
        "queryFrequency": "PT5M",
        "queryPeriod": "PT15M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 3,
        "tactics": [
          "Discovery",
          "Reconnaissance"
        ],
        "techniques": [
          "T1087",
          "T1592"
        ],
        "enabled": true,
        "kind": "Scheduled"
      }
    }
  ],
  "outputs": {
    "ruleId": {
      "type": "string",
      "value": "GHADV-0731"
    }
  }
}