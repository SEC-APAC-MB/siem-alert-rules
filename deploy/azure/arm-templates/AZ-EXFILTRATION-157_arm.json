{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "The name of the Sentinel workspace"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    }
  },
  "resources": [
    {
      "apiVersion": "2024-03-01",
      "type": "Microsoft.SecurityInsights/alertRules",
      "name": "AZ-EXFILTRATION-157",
      "properties": {
        "displayName": "DNS Tunneling Detection",
        "description": "Detect anomalous DNS query patterns indicating data exfiltration via DNS",
        "severity": "Medium",
        "query": "CommonSecurityLog| where DestinationPort in (53, 5353)| where DeviceAction == \"Denied\" or DeviceAction == \"Blocked\"| summarize count() by bin(TimeGenerated, 5m), SourceIP, DestinationIP | where count_ > 5 // AZ-EXFILTRATION-157",
        "queryFrequency": "5m",
        "queryPeriod": "10m",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 5,
        "tactics": [
          "Exfiltration"
        ],
        "techniques": [],
        "enabled": true,
        "kind": "Scheduled"
      }
    }
  ],
  "outputs": {
    "ruleId": {
      "type": "string",
      "value": "AZ-EXFILTRATION-157"
    }
  }
}