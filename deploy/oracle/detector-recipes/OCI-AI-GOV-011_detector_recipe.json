{
  "displayName": "OCI-AI-GOV-011: AI \u2014 Model Version Drift Detection",
  "description": "Detects AI model performance drift beyond acceptable thresholds requiring governance review",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "OCI-AI-GOV-011",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1565"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "OCI-AI-GOV-011_events",
      "conditions": [
        {
