        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "PutObject",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CopyObject",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "GetObject",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "DeleteObject",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('CreateObject','PutObject','CopyObject','GetObject','DeleteObject')",
    "events": [
      "CreateObject",
      "PutObject",
      "CopyObject",
      "GetObject",
      "DeleteObject"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-AI-GOV-011",
