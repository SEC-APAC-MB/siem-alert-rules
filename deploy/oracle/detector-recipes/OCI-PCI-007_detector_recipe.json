{
  "displayName": "OCI-PCI-007: PCI-DSS \u2014 Wireless Access Point in CDE",
  "description": "Detects unauthorized wireless access points in or near cardholder data environment",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "OCI-PCI-007",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1190",
      "T1133"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "OCI-PCI-007_events",
      "conditions": [
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateInstance",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "UpdateInstance",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateBootVolume",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "UpdateBootVolume",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('CreateInstance','UpdateInstance','CreateBootVolume','UpdateBootVolume')",
    "events": [
      "CreateInstance",
      "UpdateInstance",
      "CreateBootVolume",
      "UpdateBootVolume"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-PCI-007",
    "category": "general",
    "severity_label": "MEDIUM",
    "source_file": "compliance-pci-dss.json"
  },
  "status": "DEPLOY-AS-IS",
  "statusReason": "Production OCI Cloud Guard detector recipe with 4 real audit event(s)"
}