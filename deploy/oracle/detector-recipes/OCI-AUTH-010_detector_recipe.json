{
  "displayName": "OCI-AUTH-010: Authentication \u2014 Pass-the-Ticket Detection",
  "description": "Detects Kerberos ticket reuse patterns consistent with pass-the-ticket attacks",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "OCI-AUTH-010",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1550.003"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "OCI-AUTH-010_events",
      "conditions": [
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
