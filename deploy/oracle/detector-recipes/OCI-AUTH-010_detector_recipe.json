          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateDbCredential",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "GetAuthToken",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "ListAuthTokens",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('CreateAuthToken','CreateDbCredential','GetAuthToken','ListAuthTokens')",
    "events": [
      "CreateAuthToken",
      "CreateDbCredential",
      "GetAuthToken",
      "ListAuthTokens"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-AUTH-010",
    "category": "general",
    "severity_label": "MEDIUM",
