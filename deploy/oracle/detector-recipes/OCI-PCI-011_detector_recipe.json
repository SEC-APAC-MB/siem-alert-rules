{
  "displayName": "OCI-PCI-011: PCI-DSS \u2014 Payment Skimming Detection",
  "description": "Detects web skimming or JavaScript injection targeting payment pages",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "OCI-PCI-011",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1190",
      "T1059.007"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "OCI-PCI-011_events",
      "conditions": [
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "DeleteVolumeBackup",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "DeleteBootVolumeBackup",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "DeletePolicy",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "DeleteVault",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('DeleteVolumeBackup','DeleteBootVolumeBackup','DeletePolicy','DeleteVault')",
    "events": [
      "DeleteVolumeBackup",
      "DeleteBootVolumeBackup",
      "DeletePolicy",
      "DeleteVault"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-PCI-011",
    "category": "general",
    "severity_label": "MEDIUM",
    "source_file": "compliance-pci-dss.json"
  },
  "status": "DEPLOY-AS-IS",
  "statusReason": "Production OCI Cloud Guard detector recipe with 4 real audit event(s)"
}