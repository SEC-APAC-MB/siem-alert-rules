{
  "displayName": "OCI-API-002: API2: Broken Authentication \u2014 Default Credentials",
  "description": "Detects API authentication attempts using default or well-known credentials",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "OCI-API-002",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1078.001"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "OCI-API-002_events",
      "conditions": [
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateApiDeployment",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "UpdateApiDeployment",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "GetApiDeployment",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "ListApiDeployments",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('CreateApiDeployment','UpdateApiDeployment','GetApiDeployment','ListApiDeployments')",
    "events": [
      "CreateApiDeployment",
      "UpdateApiDeployment",
      "GetApiDeployment",
      "ListApiDeployments"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-API-002",
    "category": "general",
    "severity_label": "MEDIUM",
    "source_file": "api-security.json"
  },
  "status": "DEPLOY-AS-IS",
  "statusReason": "Production OCI Cloud Guard detector recipe with 4 real audit event(s)"
}