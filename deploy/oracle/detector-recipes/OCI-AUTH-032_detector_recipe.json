{
  "displayName": "OCI-AUTH-032: Authentication \u2014 Certificate-based Auth Fraud",
  "description": "Detects fraudulent certificate-based authentication including stolen or forged certificates",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "OCI-AUTH-032",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1550.004"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "OCI-AUTH-032_events",
      "conditions": [
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateAuthToken",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateApiKey",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateOrResetUIPassword",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateSwiftPassword",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('CreateAuthToken','CreateApiKey','CreateOrResetUIPassword','CreateSwiftPassword')",
    "events": [
      "CreateAuthToken",
      "CreateApiKey",
      "CreateOrResetUIPassword",
      "CreateSwiftPassword"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-AUTH-032",
    "category": "general",
    "severity_label": "MEDIUM",
    "source_file": "wstg-04-09-auth-errors.json"
  },
  "status": "DEPLOY-AS-IS",
  "statusReason": "Production OCI Cloud Guard detector recipe with 4 real audit event(s)"
}