{
  "displayName": "OCI-AI-PD-033: AI \u2014 Output Redirection to External Service",
  "description": "Detects attempts to redirect AI model outputs to external services for data collection",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "OCI-AI-PD-033",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1567"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "OCI-AI-PD-033_events",
      "conditions": [
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateObject",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "PutObject",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CopyObject",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "GetObject",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateBucket",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('CreateObject','PutObject','CopyObject','GetObject','CreateBucket')",
    "events": [
      "CreateObject",
      "PutObject",
      "CopyObject",
      "GetObject",
      "CreateBucket"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-AI-PD-033",
    "category": "general",
    "severity_label": "MEDIUM",
    "source_file": "ai-security-prompt-data-model.json"
  },
  "status": "DEPLOY-AS-IS",
  "statusReason": "Production OCI Cloud Guard detector recipe with 5 real audit event(s)"
}