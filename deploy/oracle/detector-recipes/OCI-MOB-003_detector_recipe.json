{
  "displayName": "OCI-MOB-003: Mobile \u2014 Hardcoded Credentials in Binary",
  "description": "Detects hardcoded credentials, API keys, or tokens in mobile app binaries or configuration files",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "OCI-MOB-003",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1552.001"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "OCI-MOB-003_events",
      "conditions": [
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "GetSecret",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "GetSecretBundle",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "ListSecrets",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "ListSecretBundles",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('GetSecret','GetSecretBundle','ListSecrets','ListSecretBundles')",
    "events": [
      "GetSecret",
      "GetSecretBundle",
      "ListSecrets",
      "ListSecretBundles"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-MOB-003",
    "category": "general",
    "severity_label": "MEDIUM",
    "source_file": "mobile-security.json"
  },
  "status": "DEPLOY-AS-IS",
  "statusReason": "Production OCI Cloud Guard detector recipe with 4 real audit event(s)"
}