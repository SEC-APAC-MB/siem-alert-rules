{
  "displayName": "OCI-PCI-009: PCI-DSS \u2014 Audit Log Tampering in CDE",
  "description": "Detects tampering or disabling of audit logs in cardholder data environment",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "OCI-PCI-009",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1070",
      "T1562"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "OCI-PCI-009_events",
      "conditions": [
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateVault",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateKey",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "UpdateKey",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "RotateKey",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "DisableKey",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('CreateVault','CreateKey','UpdateKey','RotateKey','DisableKey')",
    "events": [
      "CreateVault",
      "CreateKey",
      "UpdateKey",
      "RotateKey",
      "DisableKey"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-PCI-009",
    "category": "general",
    "severity_label": "MEDIUM",
    "source_file": "compliance-pci-dss.json"
  },
  "status": "DEPLOY-AS-IS",
  "statusReason": "Production OCI Cloud Guard detector recipe with 5 real audit event(s)"
}