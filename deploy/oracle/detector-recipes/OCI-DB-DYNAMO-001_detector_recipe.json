          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "ChangeAutonomousDatabaseAdminPassword",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateAutonomousDatabaseBackup",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "RotateAutonomousDatabaseEncryptionKey",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
