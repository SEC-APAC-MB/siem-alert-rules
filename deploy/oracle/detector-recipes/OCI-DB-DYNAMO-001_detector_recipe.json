    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('UpdateAutonomousDatabase','AutonomousDatabaseDataSafe','ChangeAutonomousDatabaseAdminPassword','CreateAutonomousDatabaseBackup','RotateAutonomousDatabaseEncryptionKey')",
    "events": [
      "UpdateAutonomousDatabase",
      "AutonomousDatabaseDataSafe",
      "ChangeAutonomousDatabaseAdminPassword",
      "CreateAutonomousDatabaseBackup",
      "RotateAutonomousDatabaseEncryptionKey"
    ]
  },
  "isEnabled": true,
  "labels": {
