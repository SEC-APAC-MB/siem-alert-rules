{
  "displayName": "OCI-PCI-008: PCI-DSS \u2014 Excessive Privileges in CDE",
  "description": "Detects users with excessive privileges in cardholder data environment violating least privilege",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "OCI-PCI-008",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1548",
      "T1078.002"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "OCI-PCI-008_events",
      "conditions": [
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "UpdatePolicy",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreatePolicy",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "AddUserToGroup",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "RemoveUserFromGroup",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('UpdatePolicy','CreatePolicy','AddUserToGroup','RemoveUserFromGroup')",
    "events": [
      "UpdatePolicy",
      "CreatePolicy",
      "AddUserToGroup",
      "RemoveUserFromGroup"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-PCI-008",
    "category": "general",
    "severity_label": "MEDIUM",
    "source_file": "compliance-pci-dss.json"
  },
  "status": "DEPLOY-AS-IS",
  "statusReason": "Production OCI Cloud Guard detector recipe with 4 real audit event(s)"
}