    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('UpdateAutonomousDatabase','AutonomousDatabaseDataSafe','UpdateAutonomousDatabaseWallet')",
    "events": [
      "UpdateAutonomousDatabase",
      "AutonomousDatabaseDataSafe",
      "UpdateAutonomousDatabaseWallet"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-DB-PG-002",
