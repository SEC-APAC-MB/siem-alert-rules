{
  "displayName": "OCI-API-009: API9: Improper Inventory Management \u2014 Shadow API",
  "description": "Detects access to undocumented or deprecated API endpoints not in the API inventory",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "OCI-API-009",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1190"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "OCI-API-009_events",
      "conditions": [
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateApiDeployment",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "UpdateApiDeployment",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateApiGateway",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "UpdateApiGateway",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('CreateApiDeployment','UpdateApiDeployment','CreateApiGateway','UpdateApiGateway')",
    "events": [
      "CreateApiDeployment",
      "UpdateApiDeployment",
      "CreateApiGateway",
      "UpdateApiGateway"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-API-009",
    "category": "general",
    "severity_label": "MEDIUM",
    "source_file": "api-security.json"
  },
  "status": "DEPLOY-AS-IS",
  "statusReason": "Production OCI Cloud Guard detector recipe with 4 real audit event(s)"
}