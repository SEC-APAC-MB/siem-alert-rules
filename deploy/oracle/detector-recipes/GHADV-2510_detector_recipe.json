{
  "displayName": "GHADV-2510: GeoServer has an arbitrary file write vulnerability in its Master Password Dump Page",
  "description": "GeoServer has an arbitrary file write vulnerability in its Master Password Dump Page",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "GHADV-2510",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1190"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "GHADV-2510_events",
      "conditions": [
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateInstance",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateLoadBalancer",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "UpdateLoadBalancer",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateNetworkLoadBalancer",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('CreateInstance','CreateLoadBalancer','UpdateLoadBalancer','CreateNetworkLoadBalancer')",
    "events": [
      "CreateInstance",
      "CreateLoadBalancer",
      "UpdateLoadBalancer",
      "CreateNetworkLoadBalancer"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "GHADV-2510",
    "category": "other",
    "severity_label": "MEDIUM",
    "source_file": "github-advisory-rules.json"
  },
  "status": "DEPLOY-AS-IS",
