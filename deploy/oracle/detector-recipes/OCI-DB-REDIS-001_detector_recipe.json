        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "GetSecret",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "GetSecretBundle",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "ListSecrets",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
