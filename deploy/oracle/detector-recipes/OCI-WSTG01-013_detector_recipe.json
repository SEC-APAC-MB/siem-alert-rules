{
  "displayName": "OCI-WSTG01-013: Cloud Storage Bucket Enumeration",
  "description": "Detects enumeration of cloud storage buckets (S3, GCS, Azure Blob) for data exposure",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "OCI-WSTG01-013",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1580",
      "T1537"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "OCI-WSTG01-013_events",
      "conditions": [
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CopyObject",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "PutObject",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateObject",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateBucket",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "GetObject",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('CopyObject','PutObject','CreateObject','CreateBucket','GetObject')",
    "events": [
      "CopyObject",
      "PutObject",
      "CreateObject",
      "CreateBucket",
      "GetObject"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-WSTG01-013",
    "category": "general",
    "severity_label": "MEDIUM",
    "source_file": "wstg-01-03.json"
  },
  "status": "DEPLOY-AS-IS",
  "statusReason": "Production OCI Cloud Guard detector recipe with 5 real audit event(s)"
}