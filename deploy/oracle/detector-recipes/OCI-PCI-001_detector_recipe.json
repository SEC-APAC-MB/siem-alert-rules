{
  "displayName": "OCI-PCI-001: PCI-DSS \u2014 Unencrypted Cardholder Data Transmission",
  "description": "Detects transmission of cardholder data over unencrypted channels violating PCI-DSS Requirement 4",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "OCI-PCI-001",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1040",
      "T1567"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "OCI-PCI-001_events",
      "conditions": [
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "UpdateBucket",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateBucket",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "UpdateVolume",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "CreateVolume",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('UpdateBucket','CreateBucket','UpdateVolume','CreateVolume')",
    "events": [
      "UpdateBucket",
      "CreateBucket",
      "UpdateVolume",
      "CreateVolume"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-PCI-001",
    "category": "general",
    "severity_label": "MEDIUM",
    "source_file": "compliance-pci-dss.json"
  },
  "status": "DEPLOY-AS-IS",
  "statusReason": "Production OCI Cloud Guard detector recipe with 4 real audit event(s)"
}