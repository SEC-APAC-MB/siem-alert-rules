{
  "displayName": "OCI-AUTH-030: Authentication \u2014 Admin Account Enumeration",
  "description": "Detects attempts to enumerate admin or privileged accounts via LDAP or directory queries",
  "detector": "OCI_ACTIVITY",
  "detectorRecipeId": "OCI-AUTH-030",
  "sourceDetectorRecipeId": null,
  "severity": "MEDIUM",
  "mappings": {
    "mitreAttackTechniques": [
      "T1087.002",
      "T1087.001"
    ]
  },
  "conditionGroups": [
    {
      "groupName": "OCI-AUTH-030_events",
      "conditions": [
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "ListUsers",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "ListGroups",
          "dataType": "STRING"
        },
        {
          "fieldName": "data.eventName",
          "operator": "EQ",
          "value": "ListPolicies",
          "dataType": "STRING"
        }
      ],
      "operator": "OR"
    }
  ],
  "dataSourceDetails": {
    "dataSource": "OCI_AUDIT",
    "namespace": "AuditEvents",
    "query": "SELECT * FROM AuditEvents WHERE eventName IN ('ListUsers','ListGroups','ListPolicies')",
    "events": [
      "ListUsers",
      "ListGroups",
      "ListPolicies"
    ]
  },
  "isEnabled": true,
  "labels": {
    "rule_id": "OCI-AUTH-030",
