# Gitignore for siem-alert-rules
# Rule repositories must never contain actual scan output, credentials, or secrets

# Scan results — may contain sensitive vulnerability data
scans/**/*.html
scans/**/*.json
scans/**/*.md
scans/**/*.sarif
scans/**/*.xml
scans/**/*.log
!scans/**/.gitkeep

# Environment files
.env
.env.local
.env.*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Temporary
*.tmp
*.bak