  </rule>

  <rule id="FSIEM-AIDEX-003" severity="HIGH" enabled="true">
    <name>AI — Training Data Extraction via Membership Inference</name>
    <description>Detects membership inference attacks that query the model to determine if specific data was in the training set</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>AI-PROMPT</action>
        <payload regex="true">.*(was this in your training|do you remember|did you learn).*</payload>
        <membership_inference regex="true">true</membership_inference>
