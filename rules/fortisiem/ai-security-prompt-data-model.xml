  <rule id="FSIEM-AIDEX-001" severity="CRITICAL" enabled="true">
    <name>AI — Data Exfiltration via Model Output Channels</name>
    <description>Detects data exfiltration attempts through LLM output channels including encoded responses, URL generation, and API calls</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>AI-RESPONSE</action>
        <data_exfil_pattern regex="true">.*(encoded output|base64 in response|url in response).*</data_exfil_pattern>
      </event>
    </pattern>
    <mitre>
      <tactic>Exfiltration</tactic>
      <technique>T1567</technique>
      <tactic>Exfiltration</tactic>
      <technique>T1041</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
      <standard>GDPR</standard>
      <control>32A</control>
    </compliance>
    <references>AI-DEX-010</references>
    <action>ALERT</action>
    <group>ai_data_exfiltration</group>
  </rule>

  <rule id="FSIEM-AIDEX-002" severity="CRITICAL" enabled="true">
    <name>AI — Data Exfiltration via Prompt-Driven DNS</name>
    <description>Detects data exfiltration through DNS queries generated by LLM output encoding sensitive data in subdomain labels</description>
    <pattern>
      <event>
        <product>DNS</product>
        <action>DNS-QUERY</action>
        <llm_dns_exfil regex="true">true</llm_dns_exfil>
