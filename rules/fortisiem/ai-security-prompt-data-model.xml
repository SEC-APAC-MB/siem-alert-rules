<!-- FortiSIEM SIEM Alert Rules — AI Security: Prompt Injection, Data Exfiltration, and Model Attacks -->
<rules>
  <rule id="FSIEM-AIPI-001" severity="CRITICAL" enabled="true">
    <name>AI — Prompt Injection via Unicode Obfuscation</name>
    <description>Detects prompt injection attempts using Unicode homoglyphs, zero-width characters, or RTL overrides to bypass content filters</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>AI-PROMPT</action>
        <payload regex="true">.*(unicode-bypass|homoglyph|rtl-override|zero-width).*</payload>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
      <standard>NIST-AI-RMF</standard>
    </compliance>
    <references>AI-PI-010</references>
    <action>ALERT</action>
    <group>ai_prompt_injection</group>
  </rule>

  <rule id="FSIEM-AIPI-002" severity="HIGH" enabled="true">
    <name>AI — Prompt Injection via Base64 Encoding</name>
    <description>Detects base64-encoded prompt injection payloads designed to evade text-based content filters</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>AI-PROMPT</action>
        <payload regex="true">.*base64.*(ignore|disregard|override).*</payload>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
      <tactic>Defense Evasion</tactic>
      <technique>T1027</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
    </compliance>
    <references>AI-PI-011</references>
    <action>ALERT</action>
    <group>ai_prompt_injection</group>
  </rule>

  <rule id="FSIEM-AIPI-003" severity="CRITICAL" enabled="true">
    <name>AI — Prompt Injection via Context Window Overflow</name>
    <description>Detects attempts to overflow the LLM context window to push safety instructions out of scope</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>AI-PROMPT</action>
        <token_count regex="true">>100000</token_count>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
    </compliance>
    <references>AI-PI-012</references>
    <action>ALERT</action>
    <group>ai_prompt_injection</group>
  </rule>

  <rule id="FSIEM-AIPI-004" severity="HIGH" enabled="true">
    <name>AI — Prompt Injection via Markdown/HTML Injection</name>
    <description>Detects prompt injection payloads hidden in Markdown or HTML formatting that execute when rendered by LLM systems</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>AI-PROMPT</action>
        <payload regex="true">.*(&lt;script|&lt;iframe|\[system\]|```system).*</payload>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
      <tactic>Execution</tactic>
      <technique>T1059.007</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
    </compliance>
    <references>AI-PI-013</references>
    <action>ALERT</action>
    <group>ai_prompt_injection</group>
  </rule>

  <rule id="FSIEM-AIPI-005" severity="CRITICAL" enabled="true">
    <name>AI — Multi-Modal Prompt Injection via Image Attachment</name>
    <description>Detects prompt injection attacks embedded in image metadata or steganographic content targeting multi-modal LLMs</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>AI-PROMPT</action>
        <file_type regex="true">(png|jpg|jpeg|gif|webp)</file_type>
        <embedded_text regex="true">true</embedded_text>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
    </compliance>
    <references>AI-PI-014</references>
    <action>ALERT</action>
    <group>ai_prompt_injection</group>
  </rule>

  <rule id="FSIEM-AIPI-006" severity="HIGH" enabled="true">
    <name>AI — Prompt Injection via Chain-of-Thought Manipulation</name>
