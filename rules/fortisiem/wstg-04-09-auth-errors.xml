  <rule id="FSIEM-AUTH-029" severity="HIGH" enabled="true">
    <name>Account Lockout — Lockout Followed by Unlock Anomaly</name>
    <description>Detects account lockout immediately followed by unlock from a different source, suggesting attacker activity</description>
    <pattern>
      <event>
