        <action>ACCOUNT-LOCKOUT</action>
        <followed_by>
          <event>
            <product>OS</product>
            <action>ACCOUNT-UNLOCK</action>
            <different_source regex="true">true</different_source>
            <time_window>1800</time_window>
          </event>
        </followed_by>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1110.001</technique>
