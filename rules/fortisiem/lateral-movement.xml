    <compliance>
      <standard>NIST</standard>
      <control>AC-17</control>
    </compliance>
    <references>MITRE-T1021</references>
    <action>ALERT</action>
    <group>lateral_movement</group>
  </rule>

  <rule id="FSIEM-LATR-019" severity="HIGH" enabled="true">
    <name>Windows Authentication Relay</name>
    <description>Detects NTLM relay attacks</description>
    <pattern>
      <event>
        <product>Windows</product>
        <event_id>4624</event_id>
        <logon_type>3</logon_type>
        <authentication_package>NTLM</authentication_package>
        <source_ip regex="true">!^(192\.168|10\.|172\.(1[6-9]|2[0-9]|3[01]))</source_ip>
        <target_user regex="true">!^(.*\$|SYSTEM|LOCAL SERVICE|NETWORK SERVICE|ANONYMOUS LOGON)$</target_user>
      </event>
    </pattern>
    <mitre>
      <tactic>Lateral Movement</tactic>
      <technique>T1557</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>IA-5</control>
    </compliance>
