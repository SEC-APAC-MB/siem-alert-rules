    <group>lateral_movement</group>
  </rule>

  <rule id="FSIEM-LATR-020" severity="HIGH" enabled="true">
    <name>Suspicious Service Installation</name>
    <description>Detects suspicious service installations from remote sources</description>
    <pattern>
      <event>
        <product>Windows</product>
        <event_id>7045</event_id>
        <service_path regex="true">.*(powershell|cmd\.exe|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin|\.tmp|\.temp|\\AppData\\|\\Public\\).*</service_path>
        <source_ip regex="true">!^(127\.0\.0\.1|::1)$</source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Lateral Movement</tactic>
      <technique>T1543.003</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1543.003</references>
    <action>ALERT</action>
    <group>lateral_movement</group>
  </rule>

  <rule id="FSIEM-LATR-021" severity="MEDIUM" enabled="true">
    <name>Internal HTTP Lateral Movement</name>
    <description>Detects HTTP-based lateral movement via WinRM or PowerShell</description>
    <pattern>
      <event>
        <product>Network</product>
        <destination_port>5985|5986</destination_port>
        <protocol>TCP</protocol>
        <source_ip regex="true">^(192\.168|10\.|172\.(1[6-9]|2[0-9]|3[01]))</source_ip>
        <destination_ip regex="true">^(192\.168|10\.|172\.(1[6-9]|2[0-9]|3[01]))</destination_ip>
        <distinct_destination_count regex="true">>5</distinct_destination_count>
        <time_window>3600</time_window>
      </event>
    </pattern>
    <mitre>
      <tactic>Lateral Movement</tactic>
      <technique>T1021.006</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>AC-17</control>
    </compliance>
    <references>MITRE-T1021.006</references>
    <action>ALERT</action>
    <group>lateral_movement</group>
  </rule>

  <rule id="FSIEM-LATR-022" severity="HIGH" enabled="true">
    <name>Abuse of Trust Relationship</name>
    <description>Detects abuse of Active Directory trust relationships for lateral movement</description>
    <pattern>
      <event>
        <product>Active Directory</product>
        <event_id>4624</event_id>
        <logon_type>3</logon_type>
        <source_domain regex="true">!^(CORP\.LOCAL|INTERNAL\.LOCAL)$</source_domain>
        <target_domain regex="true">^(CORP\.LOCAL|INTERNAL\.LOCAL)$</target_domain>
        <privilege regex="true">.*SeTcbPrivilege.*|.*SeAssignPrimaryTokenPrivilege.*</privilege>
      </event>
    </pattern>
    <mitre>
      <tactic>Lateral Movement</tactic>
      <technique>T1484</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>AC-3</control>
    </compliance>
    <references>MITRE-T1484</references>
    <action>ALERT</action>
    <group>lateral_movement</group>
  </rule>

  <rule id="FSIEM-LATR-023" severity="MEDIUM" enabled="true">
    <name>LDP Enumeration of AD</name>
    <description>Detects LDAP enumeration of Active Directory</description>
    <pattern>
      <event>
        <product>Active Directory</product>
        <event_id regex="true">4662</event_id>
        <object_type regex="true">.*user.*|.*group.*|.*computer.*|.*container.*|.*organizationalUnit.*</object_type>
        <count regex="true">>50</count>
        <time_window>300</time_window>
        <same_source_ip regex="true">true</same_source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Discovery</tactic>
      <technique>T1087</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1087</references>
    <action>ALERT</action>
    <group>lateral_movement</group>
  </rule>

  <rule id="FSIEM-LATR-024" severity="HIGH" enabled="true">
    <name>Remote Registry Modification</name>
    <description>Detects remote registry modifications for lateral movement</description>
    <pattern>
      <event>
        <product>Windows</product>
        <event_id>13</event_id>
        <registry_key regex="true">.*(Software\\Microsoft\\Windows\\CurrentVersion\\Run|Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce|SYSTEM\\CurrentControlSet\\Services|SYSTEM\\CurrentControlSet\\Control\\Terminal Server).*</registry_key>
        <source_ip regex="true">!^(127\.0\.0\.1|::1)$</source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Lateral Movement</tactic>
      <technique>T1112</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1112</references>
    <action>ALERT</action>
    <group>lateral_movement</group>
  </rule>

  <rule id="FSIEM-LATR-025" severity="HIGH" enabled="true">
    <name>Admin Share Connection from Compromised Host</name>
    <description>Detects admin share connections from potentially compromised hosts</description>
    <pattern>
      <event>
        <product>Windows</product>
        <event_id>5140</event_id>
        <share_type regex="true">.*\\.*\$.*</share_type>
        <source_ip regex="true">^(192\.168|10\.|172\.(1[6-9]|2[0-9]|3[01]))</source_ip>
        <source_compromised regex="true">true</source_compromised>
      </event>
    </pattern>
    <mitre>
      <tactic>Lateral Movement</tactic>
      <technique>T1021.002</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>AC-17</control>
    </compliance>
    <references>MITRE-T1021.002</references>
    <action>ALERT</action>
    <group>lateral_movement</group>
