  </rule>

  <rule id="FSIEM-ERRH-007" severity="MEDIUM" enabled="true">
    <name>Error Response - 500 Status Code Spike</name>
    <description>Detects abnormal spikes in 500-level error responses</description>
    <pattern>
      <event>
        <product>Web Server</product>
        <response_code regex="true">500|501|502|503|504</response_code>
        <count regex="true">>20</count>
        <time_window>300</time_window>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
