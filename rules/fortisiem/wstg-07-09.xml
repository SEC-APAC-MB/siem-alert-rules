<!-- FortiSIEM SIEM Alert Rules — WSTG 07-09: Input Validation, Error Handling, Cryptography -->
<rules>
  <rule id="FSIEM-IVLD-001" severity="CRITICAL" enabled="true">
    <name>SQL Injection - Union-Based</name>
    <description>Detects UNION-based SQL injection attempts</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*(\bUNION\b.*\bSELECT\b|\bSELECT\b.*\bUNION\b).*</url>
        <http_method regex="true">GET|POST</http_method>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>HIPAA</standard>
      <control>164.312(b)</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-01</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-002" severity="CRITICAL" enabled="true">
    <name>SQL Injection - Error-Based</name>
    <description>Detects error-based SQL injection via database error messages</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*(\bOR\b\s+\d+\s*=\s*\d+|'\s*OR\s+'[^']*'\s*=\s*'[^']*|\bAND\b\s+\d+\s*=\s*\d+).*</url>
        <response_code regex="true">200|500</response_code>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-01</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-003" severity="CRITICAL" enabled="true">
    <name>SQL Injection - Blind Boolean-Based</name>
    <description>Detects blind boolean-based SQL injection attempts</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*(\band\b\s+\d+\s*=\s*\d+|\bor\b\s+\d+\s*=\s*\d+|\band\b\s+.*\s*--|\bor\b\s+.*\s*--).*</url>
        <http_method regex="true">GET|POST</http_method>
        <count regex="true">>5</count>
        <time_window>60</time_window>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-01</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-004" severity="CRITICAL" enabled="true">
    <name>SQL Injection - Time-Based Blind</name>
    <description>Detects time-based blind SQL injection using SLEEP or BENCHMARK</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*(\bSLEEP\s*\(|\bBENCHMARK\s*\(|\bWAITFOR\s+DELAY\b|\bpg_sleep\s*\().*</url>
        <http_method regex="true">GET|POST</http_method>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-01</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-005" severity="CRITICAL" enabled="true">
    <name>Cross-Site Scripting - Reflected</name>
    <description>Detects reflected XSS payloads in request parameters</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*(&lt;script|&lt;img|&lt;svg|&lt;iframe|javascript:|onerror\s*=|onload\s*=|onmouseover\s*=|onfocus\s*=|onmouse\s*=).*</url>
        <http_method>GET</http_method>
        <response_code>200</response_code>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-02</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-006" severity="HIGH" enabled="true">
    <name>Cross-Site Scripting - DOM-Based</name>
    <description>Detects DOM-based XSS patterns in URL parameters</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*(document\.(write|cookie|location|domain|URL)|eval\s*\(|innerHTML|outerHTML|document\.createElement|location\.hash|location\.search).*</url>
        <http_method>GET</http_method>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-02</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-007" severity="CRITICAL" enabled="true">
    <name>Command Injection - OS Command</name>
    <description>Detects OS command injection attempts</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*(\b(;\s*(cat|ls|id|whoami|uname|pwd|wget|curl|nc|bash|sh|cmd|powershell)\b|\|.*\b(cat|ls|id|whoami|uname|pwd|wget|curl|nc)\b|`[^`]+`|\$\([^)]+\)).*</url>
        <http_method regex="true">GET|POST</http_method>
      </event>
    </pattern>
    <mitre>
      <tactic>Execution</tactic>
      <technique>T1059</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>HIPAA</standard>
      <control>164.312(b)</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-03</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-008" severity="CRITICAL" enabled="true">
    <name>Local File Inclusion</name>
    <description>Detects local file inclusion attempts accessing system files</description>
    <pattern>
      <event>
        <product>Web Server</product>
        <url regex="true">.*(\.\./|\.\.\\|%2e%2e%2f|%2e%2e\/|..%2f|%2e%2e%5c).*(etc/passwd|etc/shadow|etc/hosts|windows/system32|boot\.ini|web\.config|wp-config\.php|\.htaccess).*</url>
        <http_method>GET</http_method>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>HIPAA</standard>
      <control>164.312(b)</control>
    </compliance>
    <references>WSTG-INPV-04</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-009" severity="CRITICAL" enabled="true">
    <name>Remote File Inclusion</name>
    <description>Detects remote file inclusion attempts via URL parameters</description>
    <pattern>
      <event>
        <product>Web Server</product>
        <url regex="true">.*(\bfile\b|\bpage\b|\bpath\b|\binclude\b|\btemplate\b|\bdoc\b|\blast\b|\bredirect\b|\burl\b)=.*(https?://|ftp://|php://|data://|zip://|phar://).*</url>
        <http_method>GET</http_method>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-04</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-010" severity="HIGH" enabled="true">
    <name>XPath Injection</name>
    <description>Detects XPath injection attempts in XML-based applications</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*('(\s)*or(\s)*'|(\s)*or(\s)+'[^']*'\s*=\s*'|string-length\(|count\(|name\(|\bor\b\s+\d+\s*=\s*\d+).*</url>
        <content_type regex="true">.*xml.*</content_type>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-05</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-011" severity="HIGH" enabled="true">
    <name>LDAP Injection</name>
    <description>Detects LDAP injection attempts in authentication queries</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*(\)(\|?\()|(\)\(|\*\)\(|\)\|\(|\)\&amp;\(|(\*\*\0\)).*</url>
        <http_method regex="true">GET|POST</http_method>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-05</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-012" severity="MEDIUM" enabled="true">
    <name>HTTP Response Splitting</name>
    <description>Detects HTTP response splitting attempts via CRLF injection</description>
    <pattern>
      <event>
        <product>Web Server</product>
        <url regex="true">.*(%0d%0a|%0D%0A|\r\n).*(Content-Type|Location|Set-Cookie|HTTP\/).*</url>
        <http_method regex="true">GET|POST</http_method>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-06</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-013" severity="HIGH" enabled="true">
    <name>Server-Side Template Injection</name>
    <description>Detects server-side template injection attempts</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*(\{\{.*\}\}|\$\{.*\}|&lt;%.*%&gt;|\{%.*%\}|\#\{.*\}).*</url>
        <http_method regex="true">GET|POST</http_method>
        <response_code regex="true">200|500</response_code>
      </event>
    </pattern>
    <mitre>
      <tactic>Execution</tactic>
      <technique>T1059</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-07</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-014" severity="MEDIUM" enabled="true">
    <name>Open Redirect</name>
    <description>Detects open redirect vulnerabilities allowing external URL redirection</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*(\bredirect\b|\bnext\b|\burl\b|\breturn\b|\bdest\b|\bforward\b|\bcontinue\b|\bgoto\b)=.*(https?://|//).*</url>
        <http_method>GET</http_method>
        <response_code regex="true">301|302|303|307|308</response_code>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1200</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-08</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-015" severity="MEDIUM" enabled="true">
    <name>XML External Entity Injection</name>
    <description>Detects XXE injection attempts in XML payloads</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <content_type regex="true">.*xml.*</content_type>
        <content regex="true">.*(&lt;!ENTITY|&lt;!DOCTYPE.*SYSTEM|&lt;!DOCTYPE.*PUBLIC|&lt;!ENTITY.*SYSTEM|externalEntity|parameterEntity).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-05</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-ERRH-001" severity="HIGH" enabled="true">
    <name>Stack Trace Exposure - Java</name>
    <description>Detects Java stack traces exposed in error responses</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <response_code regex="true">500|501|502|503</response_code>
        <content regex="true">.*(java\.lang\.|java\.util\.|java\.io\.|org\.apache\.|javax\.servlet\.|at\s+[a-zA-Z0-9_]+\.[a-zA-Z0-9_]+).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Discovery</tactic>
      <technique>T1082</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-ERRH-01</references>
    <action>ALERT</action>
    <group>error_handling</group>
  </rule>

  <rule id="FSIEM-ERRH-002" severity="HIGH" enabled="true">
    <name>Stack Trace Exposure - .NET</name>
    <description>Detects .NET stack traces exposed in error responses</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <response_code regex="true">500</response_code>
        <content regex="true">.*(System\.[a-zA-Z]+|Microsoft\.|at\s+[A-Za-z0-9_\.]+\(\)|Exception:\s*|Stack Trace:).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Discovery</tactic>
      <technique>T1082</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-ERRH-01</references>
    <action>ALERT</action>
    <group>error_handling</group>
  </rule>

  <rule id="FSIEM-ERRH-003" severity="MEDIUM" enabled="true">
    <name>Database Error Message Exposure</name>
    <description>Detects database error messages exposed to end users</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <response_code regex="true">500</response_code>
        <content regex="true">.*(ORA-\d{5}|Microsoft OLE DB|PostgreSQL query failed|mysql_fetch|SQLSTATE|SQL error|Supplied argument is not a valid MySQL|Warning: mysql_).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Discovery</tactic>
      <technique>T1082</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>HIPAA</standard>
      <control>164.312(b)</control>
    </compliance>
    <references>WSTG-ERRH-01</references>
    <action>ALERT</action>
    <group>error_handling</group>
  </rule>

  <rule id="FSIEM-ERRH-004" severity="MEDIUM" enabled="true">
    <name>Verbose Error Messages - Path Disclosure</name>
    <description>Detects error messages revealing file system paths</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <response_code regex="true">500|404</response_code>
        <content regex="true">.*(/[a-zA-Z]:/|/var/www/|/usr/share/|/home/[a-z]+/|/opt/|C:\\inetpub\\|C:\\Program Files\\).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Discovery</tactic>
      <technique>T1082</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-ERRH-02</references>
    <action>ALERT</action>
    <group>error_handling</group>
  </rule>

  <rule id="FSIEM-ERRH-005" severity="MEDIUM" enabled="true">
    <name>Improper Error Handling - Default Error Pages</name>
    <description>Detects default framework error pages in production</description>
    <pattern>
      <event>
        <product>Web Server</product>
        <response_code regex="true">500|501|502|503</response_code>
        <content regex="true">.*(Whitelabel Error Page|Apache Tomcat|Nginx Error|IIS Detailed Error|Express Error|Django Error|Ruby on Rails Error).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Discovery</tactic>
      <technique>T1082</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>CM-7</control>
    </compliance>
    <references>WSTG-ERRH-01</references>
    <action>ALERT</action>
    <group>error_handling</group>
  </rule>

  <rule id="FSIEM-ERRH-006" severity="HIGH" enabled="true">
    <name>Information Leakage via Error - Version Disclosure</name>
    <description>Detects error messages revealing software version details</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <response_code regex="true">500</response_code>
        <content regex="true">.*(version|v[0-9]+\.[0-9]+|build|release).*(OpenSSL|Apache|nginx|PHP|Python|Java|Node\.js|Express|Django|Flask).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Discovery</tactic>
      <technique>T1082</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>CM-7</control>
    </compliance>
    <references>WSTG-ERRH-02</references>
    <action>ALERT</action>
    <group>error_handling</group>
  </rule>

  <rule id="FSIEM-CRPT-001" severity="CRITICAL" enabled="true">
    <name>Weak TLS Version - SSL 3.0</name>
    <description>Detects use of SSL 3.0 protocol</description>
    <pattern>
      <event>
        <product>Network</product>
        <tls_version>SSLv3</tls_version>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1040</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>4.1</control>
      <standard>HIPAA</standard>
      <control>164.312(e)</control>
      <standard>NIST</standard>
      <control>SC-8</control>
    </compliance>
    <references>WSTG-CRPT-01</references>
    <action>ALERT</action>
    <group>cryptography</group>
  </rule>

  <rule id="FSIEM-CRPT-002" severity="CRITICAL" enabled="true">
    <name>Weak TLS Version - TLS 1.0</name>
    <description>Detects use of deprecated TLS 1.0 protocol</description>
    <pattern>
      <event>
        <product>Network</product>
        <tls_version>TLSv1.0</tls_version>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1040</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>4.1</control>
      <standard>HIPAA</standard>
      <control>164.312(e)</control>
      <standard>NIST</standard>
      <control>SC-8</control>
    </compliance>
    <references>WSTG-CRPT-01</references>
    <action>ALERT</action>
    <group>cryptography</group>
  </rule>

  <rule id="FSIEM-CRPT-003" severity="HIGH" enabled="true">
    <name>Weak TLS Version - TLS 1.1</name>
    <description>Detects use of deprecated TLS 1.1 protocol</description>
    <pattern>
      <event>
        <product>Network</product>
        <tls_version>TLSv1.1</tls_version>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1040</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>4.1</control>
      <standard>NIST</standard>
      <control>SC-8</control>
    </compliance>
    <references>WSTG-CRPT-01</references>
    <action>ALERT</action>
    <group>cryptography</group>
  </rule>

  <rule id="FSIEM-CRPT-004" severity="CRITICAL" enabled="true">
    <name>Weak Cipher Suite - RC4</name>
    <description>Detects use of RC4 cipher which is cryptographically broken</description>
    <pattern>
      <event>
        <product>Network</product>
        <cipher_suite regex="true">.*RC4.*|.*RC2.*</cipher_suite>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1040</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>4.1</control>
      <standard>NIST</standard>
      <control>SC-8</control>
    </compliance>
    <references>WSTG-CRPT-01</references>
    <action>ALERT</action>
    <group>cryptography</group>
  </rule>

  <rule id="FSIEM-CRPT-005" severity="CRITICAL" enabled="true">
    <name>Weak Cipher Suite - NULL or Export</name>
    <description>Detects use of NULL or export-grade cipher suites</description>
    <pattern>
      <event>
        <product>Network</product>
        <cipher_suite regex="true">.*NULL.*|.*EXPORT.*|.*eNULL.*|.*aNULL.*</cipher_suite>
