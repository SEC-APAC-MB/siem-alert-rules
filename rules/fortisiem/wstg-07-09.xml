  <rule id="FSIEM-IVLD-016" severity="HIGH" enabled="true">
    <name>Cross-Site Request Forgery</name>
    <description>Detects state-changing requests missing CSRF protection</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(transfer|delete|update|change|remove|modify).*</url>
        <http_method>POST</http_method>
        <origin_different regex="true">true</origin_different>
        <content_not_present>csrf</content_not_present>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-09</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-017" severity="MEDIUM" enabled="true">
    <name>HTTP Parameter Pollution</name>
    <description>Detects HTTP parameter pollution attacks using duplicate parameters</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*(\?|&amp;)[^=&amp;]+=([^&amp;]*)(&amp;)[^=&amp;]+=([^&amp;]*).*\3=\4.*</url>
        <http_method regex="true">GET|POST</http_method>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INPV-10</references>
    <action>ALERT</action>
    <group>input_validation</group>
  </rule>

  <rule id="FSIEM-IVLD-018" severity="HIGH" enabled="true">
    <name>Prototype Pollution</name>
    <description>Detects JavaScript prototype pollution attempts</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*(__proto__|constructor\.prototype|prototype\[).*</url>
        <http_method regex="true">GET|POST|PUT|PATCH</http_method>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
