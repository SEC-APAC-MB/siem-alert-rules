      <control>SI-4</control>
    </compliance>
    <references>WSTG-ERRH-03</references>
    <action>ALERT</action>
    <group>error_handling</group>
  </rule>

  <rule id="FSIEM-ERRH-008" severity="HIGH" enabled="true">
    <name>Information Exposure via Error - Connection String</name>
    <description>Detects database connection strings leaked in error messages</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <response_code regex="true">500</response_code>
        <content regex="true">.*(mongodb://|postgres://|mysql://|jdbc:|Server=[^;]+;Database=[^;]+;User|Data Source=[^;]+;Initial Catalog).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Discovery</tactic>
      <technique>T1082</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>GDPR</standard>
      <control>32</control>
    </compliance>
    <references>WSTG-ERRH-02</references>
    <action>ALERT</action>
    <group>error_handling</group>
  </rule>

  <rule id="FSIEM-CRPT-011" severity="MEDIUM" enabled="true">
    <name>Sensitive Data Over Unencrypted Channel</name>
