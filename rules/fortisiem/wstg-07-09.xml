    <group>cryptography</group>
  </rule>

  <rule id="FSIEM-CRPT-012" severity="HIGH" enabled="true">
    <name>Hardcoded Cryptographic Key</name>
    <description>Detects hardcoded encryption keys in source code or configuration</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <content regex="true">.*(AES_KEY|SECRET_KEY|ENCRYPTION_KEY|PRIVATE_KEY|API_SECRET).*=.*['\"][a-zA-Z0-9+/=]{16,}['\"].*</content>
        <url regex="true">.*\.(js|env|config|yaml|yml|json|properties|xml|conf).*</url>
        <response_code>200</response_code>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1552</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>GDPR</standard>
      <control>32</control>
      <standard>NIST</standard>
      <control>SC-8</control>
    </compliance>
    <references>WSTG-CRPT-04</references>
    <action>ALERT</action>
    <group>cryptography</group>
  </rule>

