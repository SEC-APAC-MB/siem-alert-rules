<!-- FortiSIEM SIEM Alert Rules — MITRE ATT&CK -->
<rules>
  <rule id="FSIEM-MITRE-001" severity="CRITICAL" enabled="true">
    <name>Reconnaissance - Active Scanning</name>
    <description>Detects active scanning of network services and vulnerabilities</description>
    <pattern>
      <event>
        <product>Network</product>
        <destination_port regex="true">^(21|22|23|25|53|80|110|111|135|139|143|443|445|993|995|1433|1521|3306|3389|5432|5900|8080|8443|9200|27017)$</destination_port>
        <connection_count regex="true">>50</connection_count>
        <time_window>60</time_window>
        <same_source_ip regex="true">true</same_source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Reconnaissance</tactic>
      <technique>T1595</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1595</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-002" severity="MEDIUM" enabled="true">
    <name>Reconnaissance - Phishing Domain Registration</name>
    <description>Detects DNS queries for recently registered domains resembling internal services</description>
    <pattern>
      <event>
        <product>DNS Server</product>
        <dns_query regex="true">.*(g00gle|goggle|googel|paypa1|paypai|mircosoft|micros0ft|app1e|amaz0n|netfl1x).*</dns_query>
        <dns_query_type>A</dns_query_type>
      </event>
    </pattern>
    <mitre>
      <tactic>Reconnaissance</tactic>
      <technique>T1598</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1598</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-003" severity="HIGH" enabled="true">
    <name>Initial Access - Exploit Public-Facing Application</name>
    <description>Detects exploitation attempts against public-facing web applications</description>
    <pattern>
      <event>
        <product>Web Server</product>
        <url regex="true">.*(\.\.\/|\.env|\.git|wp-content|wp-admin|phpmyadmin|manager\/html|actuator|console|/api/v1/exploit).*</url>
        <response_code regex="true">200|500</response_code>
        <source_ip regex="true">!^(192\.168|10\.|172\.(1[6-9]|2[0-9]|3[01]))</source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1190</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-004" severity="CRITICAL" enabled="true">
    <name>Initial Access - Spearphishing Link</name>
    <description>Detects clicks on known malicious URLs from email communications</description>
    <pattern>
      <event>
        <product>Proxy</product>
        <url regex="true">.*(\.xyz|\.top|\.click|\.download|\.stream|\.gq|\.ml|\.cf|\.tk|\.pw|\.bid|\.loan).*</url>
        <user regex="true">.*</user>
        <source_ip regex="true">^(192\.168|10\.|172\.(1[6-9]|2[0-9]|3[01]))</source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1566.001</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1566</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-005" severity="CRITICAL" enabled="true">
    <name>Execution - PowerShell Download Cradle</name>
    <description>Detects PowerShell download cradle patterns</description>
    <pattern>
      <event>
        <product>Windows</product>
        <event_id>4104</event_id>
        <command_line regex="true">.*(New-Object\s+Net\.WebClient|IEX\s*\(|Invoke-Expression|DownloadString|DownloadFile|Start-BitsTransfer|Net\.WebRequest|System\.Net\.WebClient).*</command_line>
      </event>
    </pattern>
    <mitre>
      <tactic>Execution</tactic>
      <technique>T1059.001</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1059.001</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-006" severity="HIGH" enabled="true">
    <name>Execution - Scheduled Task Creation</name>
    <description>Detects creation of scheduled tasks for persistence</description>
    <pattern>
      <event>
        <product>Windows</product>
        <event_id>4698</event_id>
        <task_name regex="true">.*(Update|System|Windows|Security|Service|Google|Chrome|Adobe).*</task_name>
        <command_line regex="true">.*(powershell|cmd\.exe|wscript|cscript|mshta|certutil|bitsadmin).*</command_line>
      </event>
    </pattern>
    <mitre>
      <tactic>Persistence</tactic>
      <technique>T1053.005</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1053.005</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-007" severity="HIGH" enabled="true">
    <name>Persistence - Registry Run Key</name>
    <description>Detects modification of registry run keys for persistence</description>
    <pattern>
      <event>
        <product>Windows</product>
        <event_id>13</event_id>
        <registry_key regex="true">.*(Software\\Microsoft\\Windows\\CurrentVersion\\Run|Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce|Software\\Microsoft\\Windows\\CurrentVersion\\RunServices|Software\\Microsoft\\Windows\\CurrentVersion\\RunServicesOnce).*</registry_key>
      </event>
    </pattern>
    <mitre>
      <tactic>Persistence</tactic>
      <technique>T1547.001</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1547.001</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-008" severity="HIGH" enabled="true">
    <name>Persistence - New Service Creation</name>
    <description>Detects creation of new Windows services for persistence</description>
    <pattern>
      <event>
        <product>Windows</product>
        <event_id>7045</event_id>
        <service_name regex="true">!^(.*Windows.*|.*Microsoft.*|.*Update.*|.*Security.*|.*Defender.*|.*Firewall.*)$</service_name>
        <service_path regex="true">.*(powershell|cmd\.exe|wscript|cscript|mshta|certutil|bitsadmin|%TEMP%|%APPDATA%|%LOCALAPPDATA%).*</service_path>
      </event>
    </pattern>
    <mitre>
      <tactic>Persistence</tactic>
      <technique>T1543.003</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1543.003</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-009" severity="CRITICAL" enabled="true">
    <name>Privilege Escalation - Token Manipulation</name>
    <description>Detects token impersonation and privilege escalation attempts</description>
    <pattern>
      <event>
        <product>Windows</product>
        <event_id>4672</event_id>
        <privilege regex="true">.*SeDebugPrivilege.*|.*SeAssignPrimaryTokenPrivilege.*|.*SeImpersonatePrivilege.*</privilege>
        <target_user regex="true">!(SYSTEM|LOCAL SERVICE|NETWORK SERVICE)</target_user>
      </event>
    </pattern>
    <mitre>
      <tactic>Privilege Escalation</tactic>
      <technique>T1134</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>AC-6</control>
    </compliance>
    <references>MITRE-T1134</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-010" severity="CRITICAL" enabled="true">
    <name>Privilege Escalation - UAC Bypass</name>
    <description>Detects User Account Control bypass attempts</description>
    <pattern>
      <event>
        <product>Windows</product>
        <process_path regex="true">.*(eventvwr\.exe|fodhelper\.exe|diskcleanup\.exe|mmc\.exe|SystemPropertiesAdvanced\.exe|Taskmgr\.exe|ColorCpl\.exe|tabledtwologger\.exe).*</process_path>
        <command_line regex="true">.*(bypass|elevated|runas).*</command_line>
      </event>
    </pattern>
    <mitre>
      <tactic>Privilege Escalation</tactic>
      <technique>T1548.002</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>AC-6</control>
    </compliance>
    <references>MITRE-T1548.002</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-011" severity="HIGH" enabled="true">
    <name>Defense Evasion - Process Injection</name>
    <description>Detects process injection attempts</description>
    <pattern>
      <event>
        <product>Windows</product>
        <event_id>8</event_id>
        <source_process regex="true">.*(powershell|cmd|wscript|cscript|mshta|rundll32|regsvr32).*</source_process>
        <target_process regex="true">.*(explorer|svchost|lsass|csrss|winlogon|dwm|taskhostw|sihost).*</target_process>
      </event>
    </pattern>
    <mitre>
      <tactic>Defense Evasion</tactic>
      <technique>T1055</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1055</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-012" severity="HIGH" enabled="true">
    <name>Defense Evasion - Disable Security Tools</name>
    <description>Detects attempts to disable security tools</description>
    <pattern>
      <event>
        <product>Windows</product>
        <command_line regex="true">.*(netsh\s+advfirewall\s+set\s+.*\s+off|netsh\s+firewall\s+set\s+opmode\s+disable|Set-MpPreference\s+-DisableRealtime|sc\s+config\s+.*\s+start=\s*disabled|sc\s+stop\s+(WinDefend|SecurityHealthService|MsMpEng)|taskkill\s+.*/(f\s+)?/im\s+(MsMpEng|SecurityHealthService|WinDefend)|reg\s+add.*DisableAntiSpyware).*</command_line>
      </event>
    </pattern>
    <mitre>
      <tactic>Defense Evasion</tactic>
      <technique>T1562.001</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1562.001</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-013" severity="CRITICAL" enabled="true">
    <name>Credential Access - LSASS Memory Dumping</name>
    <description>Detects attempts to dump LSASS process memory</description>
    <pattern>
      <event>
        <product>Windows</product>
        <command_line regex="true">.*(procdump.*-ma.*lsass|procdump.*lsass|comsvcs\.dll.*MiniDump.*lsass|rundll32\.exe.*comsvcs\.dll.*MiniDump|taskmgr\.exe.*lsass|mimikatz|sekurlsa|lsadump|procdump|procexp).*|.*\b(lsass|LSASS)\b.*\bdump\b.*</command_line>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1003.001</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>IA-5</control>
    </compliance>
    <references>MITRE-T1003.001</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-014" severity="CRITICAL" enabled="true">
    <name>Credential Access - Kerberoasting</name>
    <description>Detects Kerberos TGS requests for service accounts</description>
    <pattern>
      <event>
        <product>Active Directory</product>
        <event_id>4769</event_id>
        <encryption_type regex="true">0x1|0x3</encryption_type>
        <failure_code>0x0</failure_code>
        <service_name regex="true">!^(krbtgt|.*\$)$</service_name>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1558.001</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>IA-5</control>
    </compliance>
    <references>MITRE-T1558.001</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-015" severity="HIGH" enabled="true">
    <name>Credential Access - Brute Force AD</name>
    <description>Detects brute force attacks against Active Directory accounts</description>
    <pattern>
      <event>
        <product>Active Directory</product>
        <event_id>4771</event_id>
        <failure_code regex="true">0x0|0x1|0x6|0x7|0x9|0xC|0x12|0x18|0x19</failure_code>
        <count regex="true">>10</count>
        <time_window>300</time_window>
        <same_target_user regex="true">true</same_target_user>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1110</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>IA-5</control>
    </compliance>
    <references>MITRE-T1110</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-016" severity="HIGH" enabled="true">
    <name>Discovery - Account Enumeration</name>
    <description>Detects Active Directory account enumeration</description>
    <pattern>
      <event>
        <product>Active Directory</product>
        <event_id regex="true">4768|4769|4771</event_id>
        <failure_code regex="true">0x6|0x7|0xC</failure_code>
        <count regex="true">>10</count>
        <time_window>300</time_window>
        <same_source_ip regex="true">true</same_source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Discovery</tactic>
      <technique>T1087</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1087</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-017" severity="MEDIUM" enabled="true">
    <name>Discovery - Network Scanning</name>
    <description>Detects network scanning activity from internal hosts</description>
    <pattern>
      <event>
        <product>Network</product>
        <connection_count regex="true">>100</connection_count>
        <distinct_destination_ports regex="true">>20</distinct_destination_ports>
        <time_window>60</time_window>
        <same_source_ip regex="true">true</same_source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Discovery</tactic>
      <technique>T1046</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1046</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-018" severity="MEDIUM" enabled="true">
    <name>Discovery - System Information Discovery</name>
    <description>Detects system information discovery commands</description>
    <pattern>
      <event>
        <product>Windows</product>
        <command_line regex="true">.*(systeminfo|hostname|ipconfig\s*/all|net\s+share|net\s+user|net\s+localgroup|net\s+group|whoami|nltest|dsquery|dsget|netdom|wmic\s+.*get).*</command_line>
        <source_ip regex="true">!^(192\.168|10\.|172\.(1[6-9]|2[0-9]|3[01]))</source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Discovery</tactic>
      <technique>T1082</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1082</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-019" severity="CRITICAL" enabled="true">
    <name>Lateral Movement - Pass the Hash</name>
    <description>Detects pass-the-hash authentication attempts</description>
    <pattern>
      <event>
        <product>Windows</product>
        <event_id>4624</event_id>
        <logon_type>3</logon_type>
        <authentication_package>NTLM</authentication_package>
        <source_network_address regex="true">!^(127\.0\.0\.1|::1)$</source_network_address>
        <target_user regex="true">!^(.*\$|SYSTEM|LOCAL SERVICE|NETWORK SERVICE)$</target_user>
      </event>
    </pattern>
    <mitre>
      <tactic>Lateral Movement</tactic>
      <technique>T1550.002</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>IA-5</control>
    </compliance>
    <references>MITRE-T1550.002</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-020" severity="CRITICAL" enabled="true">
    <name>Lateral Movement - Remote Desktop Brute Force</name>
    <description>Detects RDP brute force attacks</description>
    <pattern>
      <event>
        <product>Windows</product>
        <event_id>4625</event_id>
        <logon_type>10</logon_type>
        <count regex="true">>5</count>
        <time_window>300</time_window>
        <same_source_ip regex="true">true</same_source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Lateral Movement</tactic>
      <technique>T1021.001</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>AC-17</control>
    </compliance>
    <references>MITRE-T1021.001</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-021" severity="HIGH" enabled="true">
    <name>Lateral Movement - WMI Remote Execution</name>
    <description>Detects WMI-based remote command execution</description>
    <pattern>
      <event>
        <product>Windows</product>
        <event_id>4688</event_id>
        <process_path regex="true">.*\\wmiprvse\.exe$</process_path>
        <command_line regex="true">.*(cmd\.exe|powershell|cscript|wscript|mshta).*</command_line>
      </event>
    </pattern>
    <mitre>
      <tactic>Lateral Movement</tactic>
      <technique>T1047</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1047</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-022" severity="HIGH" enabled="true">
    <name>Lateral Movement - PSExec Usage</name>
    <description>Detects PSExec tool usage for lateral movement</description>
    <pattern>
      <event>
        <product>Windows</product>
        <event_id>5145</event_id>
        <share_name regex="true">.*\\ADMIN\$.*|.*\\IPC\$.*</share_name>
        <source_ip regex="true">!^(127\.0\.0\.1|::1)$</source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Lateral Movement</tactic>
      <technique>T1021.002</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>AC-17</control>
    </compliance>
    <references>MITRE-T1021.002</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-023" severity="HIGH" enabled="true">
    <name>Collection - Data Staging</name>
    <description>Detects suspicious data staging activity</description>
    <pattern>
      <event>
        <product>Windows</product>
        <command_line regex="true">.*(robocopy.*\\\\.*\\C\$|xcopy.*\\\\.*\\C\$|copy.*\\\\.*\\C\$|7z\s+.*-mx|rar\s+.*-r|tar\s+.*-czf|zip\s+-r).*</command_line>
        <target_path regex="true">.*(\\\\\\\\|\\TEMP\\|\\TMP\\|\\AppData\\|\\Public\\|\\Desktop\\).*</target_path>
      </event>
    </pattern>
    <mitre>
      <tactic>Collection</tactic>
      <technique>T1560</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>GDPR</standard>
      <control>32</control>
    </compliance>
    <references>MITRE-T1560</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-024" severity="HIGH" enabled="true">
    <name>Command and Control - DNS Tunneling</name>
    <description>Detects DNS tunneling activity via unusual query patterns</description>
    <pattern>
      <event>
        <product>DNS Server</product>
        <dns_query regex="true">.*[a-zA-Z0-9]{30,}.*\.(com|net|org|info|xyz|top|click|online|site|club).*</dns_query>
        <dns_query_type regex="true">TXT|NULL</dns_query_type>
        <count regex="true">>50</count>
        <time_window>300</time_window>
      </event>
    </pattern>
    <mitre>
      <tactic>Command and Control</tactic>
      <technique>T1071.004</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1071.004</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-025" severity="HIGH" enabled="true">
    <name>Command and Control - Beaconing Activity</name>
    <description>Detects regular beaconing patterns in network traffic</description>
    <pattern>
      <event>
        <product>Network</product>
        <connection_count regex="true">>10</connection_count>
        <interval_variance regex="true">&lt;5</interval_variance>
        <time_window>3600</time_window>
        <same_destination_ip regex="true">true</same_destination_ip>
        <same_destination_port regex="true">true</same_destination_port>
      </event>
    </pattern>
    <mitre>
      <tactic>Command and Control</tactic>
      <technique>T1071</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>MITRE-T1071</references>
    <action>ALERT</action>
    <group>mitre_attack</group>
  </rule>

  <rule id="FSIEM-MITRE-026" severity="CRITICAL" enabled="true">
    <name>Exfiltration - Data Transfer to External Storage</name>
    <description>Detects large data transfers to external cloud storage</description>
    <pattern>
      <event>
        <product>Proxy</product>
