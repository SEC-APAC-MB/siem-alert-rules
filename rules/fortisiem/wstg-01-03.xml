  <rule id="FSIEM-CONF-011" severity="MEDIUM" enabled="true">
    <name>Path Traversal Attempt</name>
    <description>Detects path traversal attempts targeting configuration files</description>
    <pattern>
      <event>
        <product>Web Server</product>
        <url regex="true">.*(\.\.\/|\.\.\\|%2e%2e%2f|%2e%2e\/|..%2f).*(etc\/passwd|etc\/shadow|windows\/system32).*</url>
        <response_code regex="true">200|403</response_code>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
