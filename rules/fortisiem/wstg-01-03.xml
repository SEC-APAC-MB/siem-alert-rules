  <rule id="FSIEM-INFO-017" severity="MEDIUM" enabled="true">
    <name>Sitemap.xml Disclosure</name>
    <description>Detects access to sitemap.xml revealing application structure</description>
    <pattern>
      <event>
        <product>Web Server</product>
        <url regex="true">.*\/sitemap(\-[0-9]+)?\.xml</url>
        <response_code>200</response_code>
        <source_ip regex="true">!^(192\.168|10\.|172\.(1[6-9]|2[0-9]|3[01]))</source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Reconnaissance</tactic>
      <technique>T1592</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
