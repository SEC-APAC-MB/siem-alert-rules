    <action>ALERT</action>
    <group>information_gathering</group>
  </rule>

  <rule id="FSIEM-INFO-018" severity="LOW" enabled="true">
    <name>Client Error Rate - Scanning Indicator</name>
    <description>Detects high rate of 404 errors indicating directory scanning</description>
    <pattern>
      <event>
        <product>Web Server</product>
        <response_code>404</response_code>
        <count regex="true">>50</count>
        <time_window>60</time_window>
        <source_ip regex="true">.*</source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Reconnaissance</tactic>
      <technique>T1592</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-INFO-01</references>
    <action>ALERT</action>
    <group>information_gathering</group>
  </rule>

  <rule id="FSIEM-INFO-019" severity="MEDIUM" enabled="true">
    <name>WP-Content Directory Listing</name>
