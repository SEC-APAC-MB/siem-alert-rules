  <rule id="FSIEM-IDNT-006" severity="MEDIUM" enabled="true">
    <name>Insecure Remember Me Implementation</name>
    <description>Detects insecure remember-me cookies with predictable values</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <header regex="true">.*Set-Cookie:.*remember_me=.*(admin|root|true|1|yes).*</header>
