  <rule id="FSIEM-CONF-017" severity="HIGH" enabled="true">
    <name>Server-Side Request Forgery Attempt</name>
    <description>Detects SSRF attempts targeting internal resources</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(fetch|proxy|preview|render|load|url|dest|redirect|next|return).*</url>
        <content regex="true">.*(127\.0\.0\.1|localhost|169\.254\.169\.254|10\.\d+\.\d+\.\d+|192\.168\.\d+\.\d+|0\.0\.0\.0).*</content>
        <response_code regex="true">200|301|302</response_code>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-CONF-05</references>
    <action>ALERT</action>
    <group>configuration</group>
  </rule>

  <rule id="FSIEM-CONF-018" severity="MEDIUM" enabled="true">
    <name>Insecure Content Security Policy</name>
    <description>Detects weak Content-Security-Policy headers allowing unsafe-inline or unsafe-eval</description>
    <pattern>
      <event>
        <product>Web Server</product>
        <header regex="true">.*Content-Security-Policy:.*unsafe-inline.*|.*Content-Security-Policy:.*unsafe-eval.*</header>
        <response_code>200</response_code>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-CONF-07</references>
    <action>ALERT</action>
    <group>configuration</group>
  </rule>

  <rule id="FSIEM-CONF-019" severity="MEDIUM" enabled="true">
    <name>Information Leakage via Error Pages</name>
    <description>Detects detailed error pages exposing application internals</description>
    <pattern>
      <event>
        <product>Web Server</product>
        <response_code regex="true">500|501|502|503</response_code>
        <content regex="true">.*(stack trace|exception details|SQL error|ORA-\d{5}|Microsoft OLE DB|PostgreSQL query failed|mysql_fetch).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Discovery</tactic>
      <technique>T1082</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-CONF-04</references>
    <action>ALERT</action>
    <group>configuration</group>
  </rule>

  <rule id="FSIEM-CONF-020" severity="MEDIUM" enabled="true">
    <name>Cacheable HTTPS Responses with Sensitive Data</name>
    <description>Detects HTTPS responses with sensitive content marked as cacheable</description>
    <pattern>
      <event>
        <product>Web Server</product>
        <url regex="true">https://.*</url>
        <header regex="true">.*Cache-Control:.*(public|max-age=[0-9]{6,}).*</header>
        <content_type regex="true">text/html.*</content_type>
        <response_code>200</response_code>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1539</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>HIPAA</standard>
      <control>164.312(e)</control>
    </compliance>
    <references>WSTG-CONF-06</references>
    <action>ALERT</action>
    <group>configuration</group>
  </rule>
