  <rule id="FSIEM-ATHZ-006" severity="HIGH" enabled="true">
    <name>Mass Assignment - Sensitive Field Modification</name>
    <description>Detects mass assignment attacks modifying sensitive fields</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(api|v[0-9])\/(user|profile|account).*</url>
        <http_method regex="true">PUT|PATCH</http_method>
        <content regex="true">.*"(is_admin|isAdmin|role|permission|user_type|account_type|balance|credit)".*</content>
        <response_code regex="true">200|204</response_code>
      </event>
    </pattern>
    <mitre>
      <tactic>Privilege Escalation</tactic>
      <technique>T1548</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>AC-4</control>
    </compliance>
    <references>WSTG-ATHZ-02</references>
    <action>ALERT</action>
    <group>authorization</group>
  </rule>

  <rule id="FSIEM-ATHZ-007" severity="MEDIUM" enabled="true">
    <name>API Rate Limiting Absent - Authorization Bypass</name>
    <description>Detects high-frequency API calls indicating missing rate limits</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/api\/.*</url>
        <http_method regex="true">GET|POST</http_method>
        <count regex="true">>100</count>
        <time_window>60</time_window>
        <source_ip regex="true">.*</source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Reconnaissance</tactic>
      <technique>T1592</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SC-5</control>
    </compliance>
    <references>WSTG-ATHZ-03</references>
    <action>ALERT</action>
    <group>authorization</group>
  </rule>

  <rule id="FSIEM-ATHZ-008" severity="HIGH" enabled="true">
    <name>Vertical Privilege Escalation - Admin Access from Regular User</name>
    <description>Detects regular user accessing admin-level resources</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(admin|management|sysadmin|superuser|root-access).*</url>
        <response_code>200</response_code>
        <user_role regex="true">user|viewer|guest</user_role>
      </event>
    </pattern>
    <mitre>
      <tactic>Privilege Escalation</tactic>
      <technique>T1548</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>8.1</control>
      <standard>HIPAA</standard>
      <control>164.312(a)</control>
      <standard>NIST</standard>
      <control>AC-6</control>
    </compliance>
    <references>WSTG-ATHZ-01</references>
    <action>ALERT</action>
    <group>authorization</group>
  </rule>

  <rule id="FSIEM-SESS-006" severity="HIGH" enabled="true">
    <name>Session Token Predictability</name>
    <description>Detects session tokens with insufficient entropy</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <header regex="true">.*Set-Cookie:.*session=[a-zA-Z0-9]{1,16}.*</header>
        <response_code regex="true">200|302</response_code>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1189</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SA-11</control>
    </compliance>
    <references>WSTG-SESS-01</references>
    <action>ALERT</action>
    <group>session</group>
  </rule>

  <rule id="FSIEM-SESS-007" severity="HIGH" enabled="true">
    <name>Concurrent Session Limit Exceeded</name>
    <description>Detects users exceeding maximum allowed concurrent sessions</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <same_user_session_count regex="true">>3</same_user_session_count>
        <distinct_source_ip_count regex="true">>3</distinct_source_ip_count>
        <time_window>3600</time_window>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1189</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>8.1</control>
      <standard>NIST</standard>
      <control>AC-10</control>
    </compliance>
    <references>WSTG-SESS-07</references>
    <action>ALERT</action>
    <group>session</group>
  </rule>

  <rule id="FSIEM-SESS-008" severity="MEDIUM" enabled="true">
    <name>Session Not Invalidated After Logout</name>
    <description>Detects session tokens remaining valid after logout</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(logout|signout).*</url>
        <response_code regex="true">200|302</response_code>
        <session_id_valid regex="true">true</session_id_valid>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1189</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>8.1</control>
      <standard>NIST</standard>
      <control>AC-12</control>
    </compliance>
    <references>WSTG-SESS-06</references>
    <action>ALERT</action>
    <group>session</group>
  </rule>

  <rule id="FSIEM-SESS-009" severity="HIGH" enabled="true">
    <name>Cross-Site Scripting - Session Theft</name>
    <description>Detects XSS payloads targeting session cookies</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*(&lt;script|javascript:|onerror|onload|document\.cookie|document\.location).*</url>
        <http_method regex="true">GET|POST</http_method>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-SESS-02</references>
    <action>ALERT</action>
    <group>session</group>
  </rule>

  <rule id="FSIEM-SESS-010" severity="MEDIUM" enabled="true">
    <name>Session Cookie SameSite Attribute Missing</name>
    <description>Detects session cookies without SameSite attribute</description>
    <pattern>
      <event>
        <product>Web Server</product>
        <header regex="true">.*Set-Cookie:.*(session|sid|token).*(?!SameSite).*</header>
        <response_code regex="true">200|302</response_code>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1189</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SC-8</control>
    </compliance>
    <references>WSTG-SESS-06</references>
    <action>ALERT</action>
    <group>session</group>
  </rule>

  <rule id="FSIEM-ATHN-016" severity="MEDIUM" enabled="true">
    <name>Credential Replay - Same Credentials Multiple IPs</name>
    <description>Detects same credentials authenticating from multiple distinct IPs rapidly</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(login|signin|auth).*</url>
        <http_method>POST</http_method>
        <response_code regex="true">200|302</response_code>
        <same_credential regex="true">true</same_credential>
        <distinct_source_ip_count regex="true">>3</distinct_source_ip_count>
        <time_window>600</time_window>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1110.004</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>8.1</control>
      <standard>NIST</standard>
      <control>IA-5</control>
    </compliance>
    <references>WSTG-ATHN-01</references>
    <action>ALERT</action>
    <group>authentication</group>
  </rule>

  <rule id="FSIEM-ATHN-017" severity="HIGH" enabled="true">
    <name>SQL Injection in Authentication</name>
    <description>Detects SQL injection patterns in authentication endpoints</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(login|signin|auth|authenticate).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*('OR|OR\s+1\s*=\s*1|'--|UNION\s+SELECT|;\s*DROP|;\s*DELETE|SLEEP\s*\(|BENCHMARK\s*\().*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>HIPAA</standard>
      <control>164.312(b)</control>
    </compliance>
    <references>WSTG-ATHN-01</references>
    <action>ALERT</action>
    <group>authentication</group>
  </rule>

  <rule id="FSIEM-ATHZ-009" severity="HIGH" enabled="true">
    <name>Path Traversal in Authorization Context</name>
    <description>Detects path traversal patterns used to bypass authorization controls</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(api|v[0-9])\/.*\/(..\/|..\\|%2e%2e%2f|%2e%2e\/|..%2f).*</url>
        <http_method regex="true">GET|POST|PUT|DELETE</http_method>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>HIPAA</standard>
      <control>164.312(b)</control>
    </compliance>
    <references>WSTG-ATHZ-04</references>
    <action>ALERT</action>
    <group>authorization</group>
  </rule>

  <rule id="FSIEM-ATHZ-010" severity="MEDIUM" enabled="true">
    <name>Unauthorized API Method Access</name>
    <description>Detects use of unexpected HTTP methods on API endpoints</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/api\/(user|profile|account|resource).*</url>
        <http_method>DELETE</http_method>
        <response_code regex="true">200|204</response_code>
        <user_role regex="true">!(admin|superuser)</user_role>
      </event>
    </pattern>
    <mitre>
      <tactic>Privilege Escalation</tactic>
      <technique>T1548</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>AC-4</control>
    </compliance>
    <references>WSTG-ATHZ-03</references>
    <action>ALERT</action>
    <group>authorization</group>
  </rule>

  <rule id="FSIEM-SESS-011" severity="MEDIUM" enabled="true">
    <name>Session Regeneration Failure on Login</name>
    <description>Detects session IDs that persist across authentication transitions</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(login|signin|auth).*</url>
        <http_method>POST</http_method>
        <response_code regex="true">200|302</response_code>
        <pre_login_session_id regex="true">true</pre_login_session_id>
        <post_login_session_id regex="true">true</post_login_session_id>
        <session_ids_equal regex="true">true</session_ids_equal>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1189</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SA-11</control>
    </compliance>
    <references>WSTG-SESS-01</references>
    <action>ALERT</action>
    <group>session</group>
  </rule>

  <rule id="FSIEM-ATHN-018" severity="MEDIUM" enabled="true">
    <name>Multi-Factor Authentication Bypass</name>
    <description>Detects access to MFA-protected resources without completing MFA</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(dashboard|profile|account|settings|protected).*</url>
        <http_method>GET</http_method>
        <response_code>200</response_code>
        <mfa_verified regex="true">false</mfa_verified>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1110</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>8.3</control>
      <standard>NIST</standard>
      <control>IA-2</control>
    </compliance>
    <references>WSTG-ATHN-05</references>
    <action>ALERT</action>
    <group>authentication</group>
  </rule>

  <rule id="FSIEM-ATHZ-011" severity="MEDIUM" enabled="true">
    <name>Referer-Based Authorization Check</name>
    <description>Detects authorization decisions based on Referer header</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <header regex="true">.*Referer:.*\/(admin|manage|dashboard).*</header>
        <response_code regex="true">200|201</response_code>
        <user_role regex="true">!(admin|superuser|manager)</user_role>
      </event>
    </pattern>
    <mitre>
      <tactic>Privilege Escalation</tactic>
      <technique>T1548</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>AC-3</control>
    </compliance>
    <references>WSTG-ATHZ-02</references>
    <action>ALERT</action>
    <group>authorization</group>
  </rule>

  <rule id="FSIEM-SESS-012" severity="HIGH" enabled="true">
    <name>Session Token in Referer Header</name>
    <description>Detects session tokens leaked in Referer headers to external sites</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <header regex="true">.*Referer:.*[\?&amp;](session|sid|token|jsessionid|phpsessid)=.{8,}.*</header>
        <external_referrer regex="true">true</external_referrer>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1189</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>GDPR</standard>
      <control>32</control>
    </compliance>
    <references>WSTG-SESS-03</references>
    <action>ALERT</action>
    <group>session</group>
  </rule>

  <rule id="FSIEM-ATHN-019" severity="MEDIUM" enabled="true">
    <name>Password Policy Violation - Complexity</name>
    <description>Detects password changes that don't meet complexity requirements</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(change-password|set-password|update-password).*</url>
        <http_method>POST</http_method>
        <response_code>200</response_code>
        <password_complexity regex="true">!(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9])(?=.*[^a-zA-Z0-9]).{8,}</password_complexity>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1110</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>8.2</control>
      <standard>NIST</standard>
      <control>IA-5</control>
    </compliance>
    <references>WSTG-ATHN-07</references>
    <action>ALERT</action>
    <group>authentication</group>
  </rule>

  <rule id="FSIEM-ATHZ-012" severity="HIGH" enabled="true">
    <name>JWT Token Manipulation</name>
    <description>Detects modified JWT tokens with altered payload claims</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <header regex="true">.*Authorization:\s*Bearer\s*eyJ.*</header>
        <jwt_claim_modified regex="true">true</jwt_claim_modified>
        <jwt_signature_valid regex="true">false</jwt_signature_valid>
      </event>
    </pattern>
    <mitre>
      <tactic>Privilege Escalation</tactic>
      <technique>T1548</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>IA-2</control>
    </compliance>
    <references>WSTG-ATHZ-01</references>
    <action>ALERT</action>
    <group>authorization</group>
  </rule>

  <rule id="FSIEM-SESS-013" severity="MEDIUM" enabled="true">
    <name>Session Cookie Path Too Broad</name>
    <description>Detects session cookies with path=/ unnecessarily exposing to all paths</description>
    <pattern>
      <event>
        <product>Web Server</product>
        <header regex="true">.*Set-Cookie:.*path=\/.*</header>
        <url regex="true">.*\/(login|signin|auth).*</url>
        <response_code regex="true">200|302</response_code>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1539</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SC-8</control>
    </compliance>
    <references>WSTG-SESS-06</references>
    <action>ALERT</action>
    <group>session</group>
  </rule>

  <rule id="FSIEM-ATHN-020" severity="HIGH" enabled="true">
    <name>Account Takeover - Impossible Travel</name>
    <description>Detects logins from geographically distant locations within short timeframe</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(login|signin|auth).*</url>
        <http_method>POST</http_method>
        <response_code regex="true">200|302</response_code>
        <geo_distance_km regex="true">>500</geo_distance_km>
        <time_window regex="true">&lt;3600</time_window>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1110</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>8.1</control>
      <standard>NIST</standard>
      <control>IA-4</control>
    </compliance>
    <references>WSTG-ATHN-01</references>
    <action>ALERT</action>
    <group>authentication</group>
  </rule>
</rules>