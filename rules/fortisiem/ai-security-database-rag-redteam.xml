  <rule id="FSIEM-AIRAG-004" severity="CRITICAL" enabled="true">
    <name>AI — RAG Pipeline — Cross-Tenant Data Leakage</name>
    <description>Detects cross-tenant data leakage in multi-tenant RAG systems where one tenant's documents appear in another's retrieval results</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>RAG-QUERY</action>
        <cross_tenant_leak regex="true">true</cross_tenant_leak>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
      <tactic>Valid Accounts</tactic>
      <technique>T1078</technique>
