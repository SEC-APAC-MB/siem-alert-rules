    <group>ai_rag_security</group>
  </rule>

  <rule id="FSIEM-AIDB-009" severity="CRITICAL" enabled="true">
    <name>AI — SQL Injection via LLM Query</name>
    <description>Detects SQL injection attacks that originate through LLM-generated queries to connected databases in AI application stacks</description>
    <pattern>
      <event>
        <product>Database</product>
        <action>AI-GENERATED-QUERY</action>
        <payload regex="true">.*(UNION SELECT|OR 1=1|DROP TABLE|--).*;--</payload>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
    </compliance>
    <references>AI-DB-011</references>
    <action>ALERT</action>
    <group>ai_database_security</group>
  </rule>

  <rule id="FSIEM-AIDB-010" severity="CRITICAL" enabled="true">
    <name>AI — NoSQL Injection via RAG Query</name>
    <description>Detects NoSQL injection attacks targeting document databases connected to RAG or AI agent systems</description>
    <pattern>
      <event>
        <product>Database</product>
        <action>AI-QUERY</action>
        <payload regex="true">.*(\$gt|\$ne|\$where|\$regex|\$or).*</payload>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
    </compliance>
    <references>AI-DB-012</references>
    <action>ALERT</action>
    <group>ai_database_security</group>
  </rule>

