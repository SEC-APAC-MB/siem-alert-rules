  </rule>

  <rule id="FSIEM-AIRED-002" severity="HIGH" enabled="true">
    <name>AI — Red Team — Adversarial Example Transfer Attack</name>
    <description>Detects adversarial examples crafted for one model that transfer to attack other models in the same deployment</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>AI-PROMPT</action>
        <transfer_attack regex="true">true</transfer_attack>
      </event>
    </pattern>
