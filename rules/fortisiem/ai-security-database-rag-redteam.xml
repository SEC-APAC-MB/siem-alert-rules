  <rule id="FSIEM-AIRED-001" severity="HIGH" enabled="true">
    <name>AI — Red Team — Multi-Turn Context Manipulation</name>
    <description>Detects multi-turn red team attacks that gradually build context across conversation turns to evade safety filters</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>AI-PROMPT</action>
        <multi_turn_escalation regex="true">true</multi_turn_escalation>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
