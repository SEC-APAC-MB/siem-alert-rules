  <rule id="FSIEM-AIDB-015" severity="HIGH" enabled="true">
    <name>AI — Anomalous Query Volume on Vector DB</name>
    <description>Detects unusual query volumes against vector databases that may indicate data harvesting or model extraction</description>
    <pattern>
      <event>
        <product regex="true">(Pinecone|Weaviate|Qdrant)</product>
        <action>QUERY</action>
