    <action>ALERT</action>
    <group>ai_rag_security</group>
  </rule>

  <rule id="FSIEM-AIRAG-006" severity="CRITICAL" enabled="true">
    <name>AI — RAG Pipeline — Knowledge Base Tampering</name>
    <description>Detects unauthorized modifications to RAG knowledge bases including document deletion, modification, or replacement</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action regex="true">(DELETE|UPDATE|REPLACE)</action>
        <tags>RAG</tags>
        <user regex="true">^(?!admin).*$</user>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1485</technique>
      <tactic>Defense Evasion</tactic>
      <technique>T1565.001</technique>
    </mitre>
