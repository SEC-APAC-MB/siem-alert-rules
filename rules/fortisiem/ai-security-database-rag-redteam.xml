      <control>15</control>
    </compliance>
    <references>AI-RAG-013</references>
    <action>ALERT</action>
    <group>ai_rag_security</group>
  </rule>

  <rule id="FSIEM-AIRAG-007" severity="CRITICAL" enabled="true">
    <name>AI — RAG Pipeline — Prompt Injection via Retrieved Context</name>
    <description>Detects indirect prompt injection through malicious content retrieved from the RAG knowledge base and injected into the LLM context window</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>RAG-RETRIEVAL</action>
        <retrieved_injection regex="true">true</retrieved_injection>
      </event>
