    <group>ai_rag_security</group>
  </rule>

  <rule id="FSIEM-AIRAG-008" severity="HIGH" enabled="true">
    <name>AI — RAG Pipeline — Relevance Score Manipulation</name>
    <description>Detects manipulation of RAG relevance or similarity scores to prioritize malicious documents in retrieval results</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>RAG-QUERY</action>
        <score_manipulation regex="true">true</score_manipulation>
      </event>
    </pattern>
    <mitre>
      <tactic>Resource Development</tactic>
