  </rule>

  <rule id="FSIEM-AIRED-003" severity="CRITICAL" enabled="true">
    <name>AI — Red Team — Model Extraction via Probing</name>
    <description>Detects systematic probing of model behavior to extract decision boundaries and reconstruct model internals</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>AI-API</action>
        <boundary_probe regex="true">true</boundary_probe>
        <count regex="true">>500</count>
        <time_window>3600</time_window>
      </event>
    </pattern>
    <mitre>
      <tactic>Collection</tactic>
      <technique>T1589.006</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
    </compliance>
    <references>AI-RED-012</references>
    <action>ALERT</action>
    <group>ai_red_team</group>
  </rule>

  <rule id="FSIEM-AIRED-004" severity="HIGH" enabled="true">
    <name>AI — Red Team — Safety Filter Bypass via Obfuscation</name>
    <description>Detects obfuscation techniques used to bypass AI safety filters including l33tspeak, character substitution, and fragmented instructions</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>AI-PROMPT</action>
        <safety_bypass regex="true">true</safety_bypass>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
      <tactic>Defense Evasion</tactic>
      <technique>T1027</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
    </compliance>
    <references>AI-RED-013</references>
    <action>ALERT</action>
    <group>ai_red_team</group>
  </rule>

  <rule id="FSIEM-AIRED-005" severity="CRITICAL" enabled="true">
    <name>AI — Red Team — Automated Jailbreak Framework Detection</name>
    <description>Detects automated jailbreak frameworks and tools used for red teaming that may indicate unauthorized testing or attack</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>AI-PROMPT</action>
        <payload regex="true">.*(autodan|pair|deepinception|gptfuzz|redteam).*</payload>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
    </compliance>
    <references>AI-RED-014</references>
    <action>ALERT</action>
    <group>ai_red_team</group>
  </rule>

  <rule id="FSIEM-AIRED-006" severity="HIGH" enabled="true">
