    </compliance>
    <references>AI-RAG-011</references>
    <action>ALERT</action>
    <group>ai_rag_security</group>
  </rule>

  <rule id="FSIEM-AIRAG-005" severity="HIGH" enabled="true">
    <name>AI — RAG Pipeline — Embedding Model Evasion</name>
    <description>Detects evasion of embedding models through crafted inputs that produce unexpected similarity scores in RAG retrieval</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>RAG-QUERY</action>
        <embedding_evasion regex="true">true</embedding_evasion>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
