<!-- FortiSIEM SIEM Alert Rules — AI Security: Database Attacks, RAG Poisoning, and Red Team Detection -->
<rules>
  <rule id="FSIEM-AIDB-001" severity="CRITICAL" enabled="true">
    <name>AI — Vector Database Unauthorized Access</name>
    <description>Detects unauthorized access attempts to vector databases used for AI embeddings and RAG systems</description>
    <pattern>
      <event>
        <product>Vector Database</product>
        <action>LOGIN-FAIL</action>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
      <standard>GDPR</standard>
      <control>32A</control>
    </compliance>
    <references>AI-DB-001</references>
    <action>ALERT</action>
    <group>ai_database_security</group>
  </rule>

  <rule id="FSIEM-AIDB-002" severity="CRITICAL" enabled="true">
    <name>AI — Vector Embedding Poisoning Attack</name>
    <description>Detects injection of malicious vector embeddings designed to manipulate RAG retrieval results</description>
    <pattern>
      <event>
        <product>Vector Database</product>
        <action>UPSERT</action>
        <poisoned_embedding regex="true">true</poisoned_embedding>
      </event>
    </pattern>
    <mitre>
      <tactic>Resource Development</tactic>
      <technique>T1584.006</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
    </compliance>
    <references>AI-DB-002</references>
    <action>ALERT</action>
    <group>ai_database_security</group>
  </rule>

  <rule id="FSIEM-AIDB-003" severity="CRITICAL" enabled="true">
    <name>AI — RAG Document Injection via Malicious Upload</name>
    <description>Detects injection of malicious documents into RAG knowledge bases containing hidden instructions for the LLM</description>
    <pattern>
      <event>
        <product>AI Platform</product>
        <action>RAG-UPLOAD</action>
        <payload regex="true">.*(ignore previous|disregard instructions|system:).*</payload>
      </event>
    </pattern>
    <mitre>
      <tactic>Resource Development</tactic>
      <technique>T1584.006</technique>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
    </compliance>
    <references>AI-DB-003</references>
    <action>ALERT</action>
    <group>ai_database_security</group>
  </rule>

  <rule id="FSIEM-AIDB-004" severity="CRITICAL" enabled="true">
    <name>AI — Pinecone Namespace Isolation Bypass</name>
    <description>Detects attempts to bypass Pinecone namespace isolation to access embeddings from other tenants</description>
    <pattern>
      <event>
        <product>Pinecone</product>
        <action>QUERY</action>
        <namespace_bypass regex="true">true</namespace_bypass>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
      <tactic>Valid Accounts</tactic>
      <technique>T1078</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
      <standard>GDPR</standard>
      <control>32A</control>
    </compliance>
    <references>AI-DB-004</references>
    <action>ALERT</action>
    <group>ai_database_security</group>
  </rule>

  <rule id="FSIEM-AIDB-005" severity="CRITICAL" enabled="true">
    <name>AI — Weaviate Tenant Data Isolation Failure</name>
    <description>Detects failures in Weaviate multi-tenant isolation allowing cross-tenant data access in RAG systems</description>
    <pattern>
      <event>
        <product>Weaviate</product>
        <action>QUERY</action>
        <tenant_isolation_failure regex="true">true</tenant_isolation_failure>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
      <tactic>Valid Accounts</tactic>
      <technique>T1078</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
      <standard>GDPR</standard>
      <control>32A</control>
    </compliance>
    <references>AI-DB-005</references>
    <action>ALERT</action>
    <group>ai_database_security</group>
  </rule>

  <rule id="FSIEM-AIDB-006" severity="CRITICAL" enabled="true">
    <name>AI — ChromaDB Embedding Poisoning via API</name>
    <description>Detects ChromaDB embedding poisoning through API manipulation that corrupts retrieval results</description>
    <pattern>
      <event>
        <product>ChromaDB</product>
        <action>ADD</action>
        <malicious_embedding regex="true">true</malicious_embedding>
      </event>
    </pattern>
    <mitre>
      <tactic>Resource Development</tactic>
      <technique>T1584.006</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
    </compliance>
    <references>AI-DB-006</references>
    <action>ALERT</action>
    <group>ai_database_security</group>
  </rule>

  <rule id="FSIEM-AIDB-007" severity="HIGH" enabled="true">
    <name>AI — Qdrant Payload Filter Injection</name>
    <description>Detects injection attacks targeting Qdrant payload filters that could expose or manipulate vector search results</description>
    <pattern>
      <event>
        <product>Qdrant</product>
        <action>SEARCH</action>
        <filter_injection regex="true">true</filter_injection>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
    </compliance>
    <references>AI-DB-007</references>
    <action>ALERT</action>
    <group>ai_database_security</group>
  </rule>

  <rule id="FSIEM-AIDB-008" severity="HIGH" enabled="true">
    <name>AI — Milvus Collection Manipulation</name>
    <description>Detects unauthorized manipulation of Milvus vector collections including schema changes and bulk data modifications</description>
    <pattern>
      <event>
        <product>Milvus</product>
        <action regex="true">(DROP_COLLECTION|ALTER_COLLECTION|CREATE_INDEX)</action>
        <user regex="true">^(?!admin).*$</user>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1485</technique>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>AI-ACT</standard>
      <control>15</control>
    </compliance>
    <references>AI-DB-008</references>
    <action>ALERT</action>
    <group>ai_database_security</group>
  </rule>

