<!-- FortiSIEM SIEM Alert Rules — WSTG 10: Business Logic -->
<rules>
  <rule id="FSIEM-BIZL-001" severity="HIGH" enabled="true">
    <name>Price Manipulation - Negative Amount</name>
    <description>Detects transactions with negative price or amount values</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(cart|checkout|order|purchase|payment|transaction).*</url>
        <http_method regex="true">POST|PUT|PATCH</http_method>
        <content regex="true">.*"(price|amount|total|cost|value|quantity)".*-[0-9]+.*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-BIZL-01</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-002" severity="HIGH" enabled="true">
    <name>Quantity Manipulation - Excessive Quantity</name>
    <description>Detects orders with abnormally large quantities</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(cart|order|checkout|purchase).*</url>
        <http_method regex="true">POST|PUT</http_method>
        <content regex="true">.*"quantity".*([0-9]{6,}|999999|2147483647).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-BIZL-01</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-003" severity="HIGH" enabled="true">
    <name>Bypass Payment - Zero Amount Transaction</name>
    <description>Detects transactions processed with zero amount</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(checkout|payment|process|charge|transaction).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*"(amount|total|price|cost)".*[":]\s*(0|0\.00|0,00).*</content>
        <response_code regex="true">200|201</response_code>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-BIZL-02</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-004" severity="HIGH" enabled="true">
    <name>Coupon Abuse - Multiple Redemptions</name>
    <description>Detects coupon or discount codes used more than allowed</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(apply-coupon|discount|promo|voucher).*</url>
        <http_method>POST</http_method>
        <same_coupon_count regex="true">>1</same_coupon_count>
        <time_window>3600</time_window>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-BIZL-02</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-005" severity="MEDIUM" enabled="true">
    <name>Workflow Bypass - Skip Steps</name>
    <description>Detects workflow step bypass by accessing later stages directly</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(checkout|confirm|complete|finalize|submit).*</url>
        <http_method>POST</http_method>
        <response_code regex="true">200|201</response_code>
        <previous_step_completed regex="true">false</previous_step_completed>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-BIZL-03</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-006" severity="HIGH" enabled="true">
    <name>Refund Abuse - Excessive Refund Requests</name>
    <description>Detects users submitting excessive refund requests</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(refund|return|cancel).*</url>
        <http_method>POST</http_method>
        <same_user_count regex="true">>5</same_user_count>
        <time_window>86400</time_window>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-BIZL-04</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-007" severity="MEDIUM" enabled="true">
    <name>Account Balance Manipulation</name>
    <description>Detects direct modification of account balance or credit parameters</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(api|v[0-9])\/(user|account|profile|wallet|balance).*</url>
        <http_method regex="true">PUT|PATCH</http_method>
        <content regex="true">.*"(balance|credit|wallet|account_balance|funds|money)".*</content>
        <user_role regex="true">!(admin|superuser|system)</user_role>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-BIZL-01</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-008" severity="HIGH" enabled="true">
    <name>Race Condition - Concurrent Transaction</name>
    <description>Detects concurrent requests that may exploit race conditions</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(transfer|withdraw|purchase|checkout|redeem).*</url>
        <http_method>POST</http_method>
        <same_user_concurrent regex="true">>3</same_user_concurrent>
        <time_window>5</time_window>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-BIZL-05</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-009" severity="MEDIUM" enabled="true">
    <name>Parameter Tampering - Hidden Field Modification</name>
    <description>Detects modification of hidden form fields affecting business logic</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(order|checkout|purchase|payment).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*"(price|total|discount|tax|shipping|fee|amount)".*[":]\s*[0-9]+.*</content>
        <price_changed regex="true">true</price_changed>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-BIZL-01</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-010" severity="HIGH" enabled="true">
    <name>Anti-Automation Bypass - Rate Limit Violation</name>
    <description>Detects automated requests exceeding rate limits</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(register|signup|reset-password|forgot-password|verify|login).*</url>
        <http_method>POST</http_method>
        <count regex="true">>10</count>
        <time_window>60</time_window>
        <source_ip regex="true">.*</source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Reconnaissance</tactic>
      <technique>T1589</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SC-5</control>
    </compliance>
    <references>WSTG-BIZL-06</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-011" severity="MEDIUM" enabled="true">
    <name>File Upload Bypass - Content Type Mismatch</name>
    <description>Detects file uploads where declared content type doesn't match actual content</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(upload|file|attachment|document|media).*</url>
        <http_method>POST</http_method>
        <content_type regex="true">.*image/(jpeg|png|gif|webp).*</content_type>
        <file_content regex="true">.*(&lt;\?php|&lt;script|&lt;html|MZ|#!/|&lt;%.*)</file_content>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-BIZL-07</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-012" severity="MEDIUM" enabled="true">
    <name>File Upload Bypass - Double Extension</name>
    <description>Detects file uploads with double extensions attempting bypass</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(upload|file|attachment).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*\.(jpg|png|gif|jpeg|doc|pdf)\.(php|jsp|asp|aspx|exe|sh|py|rb|pl).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-BIZL-07</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-013" severity="HIGH" enabled="true">
    <name>Email Bombing - Mass Email Send</name>
    <description>Detects mass email send operations indicating email bombing</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(send|email|notify|subscribe|newsletter|forgot-password).*</url>
        <http_method>POST</http_method>
        <count regex="true">>20</count>
        <time_window>300</time_window>
        <same_source_ip regex="true">true</same_source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SC-5</control>
    </compliance>
    <references>WSTG-BIZL-06</references>
    <action>ALERT</action>
