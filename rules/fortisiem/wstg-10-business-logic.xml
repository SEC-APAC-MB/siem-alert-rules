  <rule id="FSIEM-BIZL-025" severity="HIGH" enabled="true">
    <name>API Key Exposure in Response</name>
    <description>Detects API keys or secrets exposed in API responses</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(api|v[0-9])\/.*</url>
        <http_method>GET</http_method>
        <response_code>200</response_code>
        <content regex="true">.*"(api_key|secret|token|password|credential|private_key|access_key)".*"[a-zA-Z0-9+/=]{20,}".*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1552</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>GDPR</standard>
      <control>32</control>
      <standard>NIST</standard>
      <control>SC-8</control>
    </compliance>
    <references>WSTG-BIZL-07</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-026" severity="MEDIUM" enabled="true">
    <name>Date/Time Manipulation - Future Dating</name>
    <description>Detects transactions with future-dated timestamps</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(schedule|book|reserve|appointment|order).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*"(date|time|schedule|start)".*</content>
        <future_date regex="true">true</future_date>
        <future_offset_days regex="true">>365</future_offset_days>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-BIZL-09</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-027" severity="MEDIUM" enabled="true">
    <name>IDOR Pattern - Sequential Resource Access</name>
    <description>Detects sequential access to resources indicating IDOR testing</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(api|v[0-9])\/(user|order|document|record|invoice|ticket)\/[0-9]+.*</url>
        <http_method>GET</http_method>
        <count regex="true">>20</count>
        <time_window>300</time_window>
        <sequential_pattern regex="true">true</sequential_pattern>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>AC-4</control>
    </compliance>
    <references>WSTG-BIZL-10</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-028" severity="HIGH" enabled="true">
    <name>Gift Card Balance Drain</name>
    <description>Detects rapid sequential gift card balance checks or redemptions</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(gift-card|voucher|coupon|redeem|balance-check).*</url>
        <http_method>POST</http_method>
        <count regex="true">>10</count>
        <time_window>300</time_window>
        <same_source_ip regex="true">true</same_source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>WSTG-BIZL-04</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-029" severity="MEDIUM" enabled="true">
    <name>Two-Factor Skip - MFA Step Bypass</name>
    <description>Detects access to MFA-protected endpoints without MFA completion</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(dashboard|account|settings|profile|transaction).*</url>
        <http_method>GET</http_method>
        <response_code>200</response_code>
        <auth_steps_completed regex="true">1</auth_steps_completed>
        <auth_steps_required regex="true">2</auth_steps_required>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1110</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>8.3</control>
      <standard>NIST</standard>
      <control>IA-2</control>
    </compliance>
    <references>WSTG-BIZL-08</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>

  <rule id="FSIEM-BIZL-030" severity="HIGH" enabled="true">
    <name>Privilege Escalation via Business Flow</name>
    <description>Detects privilege escalation through business process manipulation</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(approve|escalate|grant|promote|upgrade|assign-role).*</url>
        <http_method regex="true">POST|PUT|PATCH</http_method>
        <response_code regex="true">200|201|204</response_code>
        <user_role regex="true">user|viewer|member</user_role>
        <target_role regex="true">admin|superuser|manager</target_role>
      </event>
    </pattern>
    <mitre>
      <tactic>Privilege Escalation</tactic>
      <technique>T1548</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>8.1</control>
      <standard>HIPAA</standard>
      <control>164.312(a)</control>
      <standard>NIST</standard>
      <control>AC-6</control>
    </compliance>
    <references>WSTG-BIZL-03</references>
    <action>ALERT</action>
    <group>business_logic</group>
  </rule>
</rules>