  <rule id="FSIEM-AISEC-037" severity="MEDIUM" enabled="true">
    <name>AI Hallucinated Citation Detection</name>
    <description>Detects AI responses containing fabricated citations or references</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate).*</url>
        <http_method>POST</http_method>
        <response_code>200</response_code>
        <response_content regex="true">.*(doi:|arXiv:|ISBN|PMID:|US Patent|according to (study|research|paper|report)).*</response_content>
        <citation_verified regex="true">false</citation_verified>
      </event>
    </pattern>
    <mitre>
      <tactic>Reconnaissance</tactic>
      <technique>T1589</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
