    <references>OWASP-LLM-05</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-035" severity="MEDIUM" enabled="true">
    <name>AI Response Manipulation Detection</name>
    <description>Detects manipulated AI responses cached or stored for downstream use</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(cache|response|store|save).*</url>
        <http_method regex="true">POST|PUT</http_method>
        <content regex="true">.*( tampered|modified|injected|malicious).*</content>
        <integrity_check regex="true">failed</integrity_check>
