  <rule id="FSIEM-AISEC-023" severity="HIGH" enabled="true">
    <name>AI Unauthorized Access to Internal Systems</name>
    <description>Detects LLM attempts to access internal systems via tool calls</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|function-call|tool-use).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(database_query|run_sql|execute_query|file_read|system_command|shell_exec|api_call|internal_request|admin_panel|backend_access).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Lateral Movement</tactic>
      <technique>T1021</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-06</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-024" severity="MEDIUM" enabled="true">
    <name>AI Agent Loop Detection</name>
    <description>Detects infinite or excessive AI agent loops</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|agent|execute).*</url>
        <http_method>POST</http_method>
        <same_conversation_turns regex="true">>20</same_conversation_turns>
        <time_window>300</time_window>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SC-5</control>
    </compliance>
    <references>OWASP-LLM-05</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-025" severity="CRITICAL" enabled="true">
    <name>AI RAG Data Exfiltration</name>
    <description>Detects attempts to exfiltrate data from RAG (Retrieval Augmented Generation) systems</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|query|search|retrieve).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(show me all|list all|dump all|export all|download|give me the full document|repeat verbatim|copy the entire|output everything you know about).*</content>
        <response_contains regex="true">.*(SSN|social security|credit card|password|API key|secret|private key|internal memo|confidential).*</response_contains>
      </event>
    </pattern>
    <mitre>
      <tactic>Exfiltration</tactic>
      <technique>T1567</technique>
    </mitre>
    <compliance>
      <standard>GDPR</standard>
      <control>32</control>
      <standard>HIPAA</standard>
      <control>164.312(b)</control>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
    </compliance>
    <references>OWASP-LLM-02</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-026" severity="MEDIUM" enabled="true">
    <name>AI Model Metadata Exposure</name>
    <description>Detects AI model metadata endpoints accessible without authentication</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(models|v1/models|model/info|model/config|health|metrics|debug|config|info|status|version).*</url>
        <http_method>GET</http_method>
        <response_code>200</response_code>
        <content regex="true">.*(model_name|model_version|model_id|training_data|parameters|weights|architecture).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Reconnaissance</tactic>
      <technique>T1592</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>CM-7</control>
    </compliance>
    <references>OWASP-LLM-10</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-027" severity="HIGH" enabled="true">
    <name>AI Prompt Smuggling</name>
    <description>Detects hidden prompts embedded in data meant for LLM processing</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|summarize|analyze|translate).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(\x00|\x01|\x1b|\u200b|\u200c|\u200d|\ufeff|zero.width|invisible.letter|soft.hyphen).*(ignore|disregard|override|new instruction|system:).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-01</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-028" severity="MEDIUM" enabled="true">
    <name>AI Excessive Automation Requests</name>
    <description>Detects automated/bot-like interaction patterns with AI endpoints</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt).*</url>
        <http_method>POST</http_method>
        <count regex="true">>30</count>
        <time_window>60</time_window>
        <same_source_ip regex="true">true</same_source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SC-5</control>
    </compliance>
    <references>OWASP-LLM-05</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-029" severity="HIGH" enabled="true">
    <name>AI Cross-Tenant Data Access</name>
    <description>Detects AI system responses containing data from other tenants</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|query).*</url>
        <http_method>POST</http_method>
        <response_code>200</response_code>
        <tenant_mismatch regex="true">true</tenant_mismatch>
      </event>
    </pattern>
    <mitre>
      <tactic>Collection</tactic>
      <technique>T1213</technique>
