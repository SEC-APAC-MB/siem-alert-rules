    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-030" severity="MEDIUM" enabled="true">
    <name>AI Model Denial of Service - Resource Exhaustion</name>
    <description>Detects AI resource exhaustion attacks targeting GPU/compute</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|embed).*</url>
        <http_method>POST</http_method>
        <response_code regex="true">503|504|429</response_code>
        <count regex="true">>5</count>
        <time_window>300</time_window>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SC-5</control>
    </compliance>
    <references>OWASP-LLM-05</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-031" severity="HIGH" enabled="true">
    <name>AI Generated Malicious Content Output</name>
    <description>Detects AI-generated outputs containing malicious code or exploit material</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate).*</url>
        <http_method>POST</http_method>
        <response_code>200</response_code>
        <response_content regex="true">.*(eval\s*\(|exec\s*\(|os\.system|subprocess|shell_exec|passthru|system\(|Runtime\.getRuntime|ProcessBuilder|&lt;script.*&gt;|onerror\s*=|onload\s*=|document\.cookie).*</response_content>
      </event>
    </pattern>
    <mitre>
      <tactic>Execution</tactic>
      <technique>T1059</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-09</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-032" severity="MEDIUM" enabled="true">
    <name>AI Bias Exploitation Attempt</name>
    <description>Detects attempts to exploit AI model biases for discriminatory outputs</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|classify|score).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(which (race|gender|ethnicity|religion|nationality) is|are (women|men|muslims|christians|jews|asians|blacks|whites) more likely|stereotype about|discriminatory|biased against).*</content>
      </event>
    </pattern>
    <mitre>
