  <rule id="FSIEM-AISEC-022" severity="MEDIUM" enabled="true">
    <name>AI Embedding Poisoning Detection</name>
    <description>Detects potential embedding/vector store poisoning attempts</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(embed|vector|knowledge|ingest|train|upload|add-document).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(malicious|poisoned|adversarial|backdoor|trigger word|hidden instruction|invisible text).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Defense Evasion</tactic>
      <technique>T1562</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-03</references>
