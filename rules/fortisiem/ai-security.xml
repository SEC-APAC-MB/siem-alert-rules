  <rule id="FSIEM-AISEC-034" severity="HIGH" enabled="true">
    <name>AI Supply Chain - Compromised Plugin Execution</name>
    <description>Detects execution of AI plugins with suspicious behavior patterns</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(plugin|tool|function|action|execute|run).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(file_system|network_access|database_query|shell_exec|process_create|registry_modify|install_package|download_file).*</content>
