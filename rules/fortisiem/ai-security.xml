    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-038" severity="CRITICAL" enabled="true">
    <name>AI System Prompt Extraction via Multi-Turn</name>
    <description>Detects multi-turn conversations designed to extract system prompts</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(summarize your instructions|list your rules|what can't you|what are your limitations|what were you told not to|what is the first thing you were told|repeat everything above this line).*</content>
        <conversation_turn regex="true">>3</conversation_turn>
      </event>
    </pattern>
    <mitre>
      <tactic>Collection</tactic>
      <technique>T1213</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-02</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-039" severity="MEDIUM" enabled="true">
    <name>AI Data Retention Policy Violation</name>
