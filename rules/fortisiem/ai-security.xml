<!-- FortiSIEM SIEM Alert Rules — AI/LLM Security -->
<rules>
  <rule id="FSIEM-AISEC-001" severity="CRITICAL" enabled="true">
    <name>LLM Prompt Injection - Direct</name>
    <description>Detects direct prompt injection attempts targeting LLM interfaces</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt|ask|query|ai|llm|gpt|claude).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(ignore previous instructions|disregard above|forget everything|new instructions|you are now|pretend you are|act as if|system prompt|override).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-01</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-002" severity="CRITICAL" enabled="true">
    <name>LLM Prompt Injection - Indirect</name>
    <description>Detects indirect prompt injection via external data sources</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt|ask|query|ai|llm).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(\[\[INST\]\]|\[\/INST\]|&lt;|im_start|&lt;/s&gt;|&lt;s&gt;|### Instruction|### System|### Human|### Assistant).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-01</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-003" severity="HIGH" enabled="true">
    <name>LLM Sensitive Data Extraction</name>
    <description>Detects attempts to extract training data or system prompts from LLM</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt|ask|query|ai|llm).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(repeat your instructions|what are your instructions|show me your prompt|what were you told|output your system prompt|reveal your training data|what data were you trained on).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Collection</tactic>
      <technique>T1213</technique>
    </mitre>
    <compliance>
      <standard>GDPR</standard>
      <control>32</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-02</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-004" severity="HIGH" enabled="true">
    <name>LLM Data Poisoning Input</name>
    <description>Detects potential data poisoning inputs to AI training pipelines</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(train|feedback|label|annotate|dataset|upload-data|ingest).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(ignore|disregard|override|bypass|skip validation|malicious|poison).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Defense Evasion</tactic>
      <technique>T1562</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-03</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-005" severity="CRITICAL" enabled="true">
    <name>LLM Unauthorized Tool/Function Call</name>
    <description>Detects attempts to invoke unauthorized functions through LLM</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt|function-call|tool-use).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(execute|run_command|shell|os\.system|subprocess|eval\(|exec\(|import os|__import__|delete_files|rm -rf|format_disk|drop_table|TRUNCATE).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Execution</tactic>
      <technique>T1059</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-06</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-006" severity="HIGH" enabled="true">
    <name>AI Model Evasion - Adversarial Input</name>
    <description>Detects adversarial inputs designed to evade AI content moderation</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|moderate|classify|analyze).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(base64|rot13|hex_encode|unicode_escape|zero-width|homoglyph|confusable|l33tsp34k|character substitution|character splitting).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Defense Evasion</tactic>
      <technique>T1562</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-04</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-007" severity="MEDIUM" enabled="true">
    <name>AI Model DoS - Excessive Token Consumption</name>
    <description>Detects denial of service through excessive LLM token consumption</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt).*</url>
        <http_method>POST</http_method>
        <content_length regex="true">>50000</content_length>
        <count regex="true">>10</count>
        <time_window>60</time_window>
        <same_source_ip regex="true">true</same_source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SC-5</control>
    </compliance>
    <references>OWASP-LLM-05</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-008" severity="HIGH" enabled="true">
    <name>LLM Supply Chain - Untrusted Plugin</name>
    <description>Detects use of untrusted or unauthorized LLM plugins/extensions</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(plugin|extension|tool|integration|connector|addon).*</url>
        <http_method regex="true">POST|PUT</http_method>
        <content regex="true">.*"(source|url|repository|download)".*(untrusted|unknown|third.party|external).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SA-12</control>
    </compliance>
    <references>OWASP-LLM-05</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-009" severity="HIGH" enabled="true">
    <name>PII Leakage via LLM Response</name>
    <description>Detects potential PII leakage in LLM responses</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt).*</url>
        <http_method>POST</http_method>
        <response_code>200</response_code>
        <response_content regex="true">.*(\b\d{3}[-.]?\d{2}[-.]?\d{4}\b|\b\d{3}-\d{2}-\d{4}\b|\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b|\b\d{16}\b|\b4\d{3}[-\s]?\d{4}[-\s]?\d{4}[-\s]?\d{4}\b).*</response_content>
      </event>
    </pattern>
    <mitre>
      <tactic>Collection</tactic>
      <technique>T1213</technique>
    </mitre>
    <compliance>
      <standard>GDPR</standard>
      <control>32</control>
      <standard>HIPAA</standard>
      <control>164.312(b)</control>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
    </compliance>
    <references>OWASP-LLM-02</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-010" severity="MEDIUM" enabled="true">
    <name>AI API Key Exposure</name>
    <description>Detects AI/LLM API keys exposed in requests or responses</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|api).*</url>
        <http_method regex="true">GET|POST</http_method>
        <content regex="true">.*(sk-[a-zA-Z0-9]{32,}|AIza[a-zA-Z0-9_-]{35}|key-[a-zA-Z0-9]{32,}|api_key|OPENAI_API_KEY|ANTHROPIC_API_KEY|GOOGLE_AI_API_KEY).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1552</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>GDPR</standard>
      <control>32</control>
      <standard>NIST</standard>
      <control>SC-8</control>
    </compliance>
    <references>OWASP-LLM-02</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-011" severity="HIGH" enabled="true">
    <name>LLM Role Escalation Attempt</name>
    <description>Detects attempts to escalate LLM from assistant to system/admin role</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(you are now a|pretend to be an?|act as an?|role:|switch role to|become a|you are a (hacker|malware|attacker|criminal|unethical)).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Privilege Escalation</tactic>
      <technique>T1548</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-01</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-012" severity="HIGH" enabled="true">
    <name>AI Hallucination Exploitation</name>
    <description>Detects queries designed to exploit LLM hallucination patterns</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(tell me about a real|is it true that|I heard that|according to|can you confirm|fact check this|what is the source for).*</content>
        <count regex="true">>5</count>
        <time_window>300</time_window>
      </event>
    </pattern>
    <mitre>
      <tactic>Reconnaissance</tactic>
      <technique>T1589</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-09</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-013" severity="MEDIUM" enabled="true">
    <name>AI Model Version Disclosure</name>
    <description>Detects AI model version information disclosure in responses</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|model|info|version).*</url>
        <http_method>GET</http_method>
        <response_code>200</response_code>
        <content regex="true">.*(GPT-[34]|gpt-4|claude-[123]|text-davinci|text-embedding|ada-002|curie|babbage|davinci|palm|gemini|llama|mistral|codellama).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Reconnaissance</tactic>
      <technique>T1592</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>CM-7</control>
    </compliance>
    <references>OWASP-LLM-10</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-014" severity="CRITICAL" enabled="true">
    <name>AI Jailbreak - DAN Mode</name>
    <description>Detects DAN (Do Anything Now) jailbreak pattern attempts</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(DAN|do anything now|jailbreak|bypass filter|bypass safety|ignore safety|no restrictions|unlocked mode|developer mode|debug mode|sudo mode|god mode).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-01</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-015" severity="HIGH" enabled="true">
    <name>AI Output Manipulation - Injection via Output</name>
    <description>Detects attempts to manipulate AI output for downstream system exploitation</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(output the following exactly|include this in your response|add this link|render this HTML|execute this JavaScript|send this email|visit this URL).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-01</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-016" severity="MEDIUM" enabled="true">
    <name>AI Training Data Extraction Attempt</name>
    <description>Detects patterns designed to extract training data from LLM models</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(what was in your training data|repeat word|say the alphabet backwards|complete this sequence|what text follows|finish this passage from|recite from memory|verbatim).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Collection</tactic>
      <technique>T1213</technique>
    </mitre>
    <compliance>
      <standard>GDPR</standard>
      <control>32</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-02</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-017" severity="HIGH" enabled="true">
    <name>AI SSRF via LLM Tool Use</name>
    <description>Detects SSRF attempts through LLM tool/function calling</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|function-call|tool-use).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(fetch|request|get|load|read|visit|browse|curl|wget|http_client).*(127\.0\.0\.1|localhost|169\.254\.169\.254|metadata\.google|100\.100\.100\.200|\[::1\]|0\.0\.0\.0|internal|private).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-06</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-018" severity="MEDIUM" enabled="true">
    <name>AI Rate Limit Exceeded</name>
    <description>Detects API rate limit violations on AI endpoints</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt|embed).*</url>
        <http_method>POST</http_method>
        <response_code>429</response_code>
        <count regex="true">>10</count>
        <time_window>60</time_window>
        <same_source_ip regex="true">true</same_source_ip>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SC-5</control>
    </compliance>
    <references>OWASP-LLM-05</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-019" severity="HIGH" enabled="true">
    <name>AI Content Policy Violation Request</name>
    <description>Detects requests attempting to generate prohibited content via AI</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(how to (hack|exploit|attack|steal|cheat)|write (malware|virus|ransomware|trojan)|create a (bomb|weapon|drug)|generate (phishing|spam|fraud)|bypass (security|authentication|encryption|filter|firewall)).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Reconnaissance</tactic>
      <technique>T1589</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SI-4</control>
    </compliance>
    <references>OWASP-LLM-09</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-020" severity="MEDIUM" enabled="true">
    <name>AI Model Input Token Limit Exceeded</name>
    <description>Detects inputs exceeding AI model token limits indicating abuse</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|embed).*</url>
        <http_method>POST</http_method>
        <content_length regex="true">>100000</content_length>
      </event>
    </pattern>
    <mitre>
      <tactic>Impact</tactic>
      <technique>T1498</technique>
    </mitre>
    <compliance>
      <standard>NIST</standard>
      <control>SC-5</control>
    </compliance>
    <references>OWASP-LLM-05</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-021" severity="HIGH" enabled="true">
    <name>AI Prompt Leakage via System Message</name>
    <description>Detects attempts to extract system prompts through probing</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(chat|completion|generate|prompt).*</url>
        <http_method>POST</http_method>
        <content regex="true">.*(what is your system prompt|what are your rules|what constraints|what are you not allowed|what can't you do|what is your personality|what is your character|output everything above|repeat the instructions).*</content>
      </event>
    </pattern>
    <mitre>
      <tactic>Collection</tactic>
      <technique>T1213</technique>
