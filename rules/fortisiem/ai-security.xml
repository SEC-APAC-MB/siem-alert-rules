    </compliance>
    <references>OWASP-LLM-09</references>
    <action>ALERT</action>
    <group>ai_security</group>
  </rule>

  <rule id="FSIEM-AISEC-033" severity="MEDIUM" enabled="true">
    <name>AI API Unauthorized Model Access</name>
    <description>Detects access to AI model endpoints by unauthorized users</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <url regex="true">.*\/(v1|v2|api)\/(models|chat|completions|embeddings|images|audio|moderations).*</url>
        <http_method regex="true">GET|POST</http_method>
        <response_code regex="true">200|201</response_code>
        <user_role regex="true">!(user|admin|developer)</user_role>
      </event>
    </pattern>
    <mitre>
      <tactic>Privilege Escalation</tactic>
