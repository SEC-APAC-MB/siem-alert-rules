      <control>6.5</control>
    </compliance>
    <references>CHAIN-009</references>
    <action>ALERT</action>
    <group>lateral_movement_chains</group>
  </rule>

  <rule id="FSIEM-LATCHAIN-010" severity="CRITICAL" enabled="true">
    <name>Lateral Chain — Golden Ticket to Full Domain Compromise</name>
    <description>Detects Golden Ticket creation followed by lateral movement and domain-level actions indicating full domain compromise</description>
    <pattern>
      <event>
        <product>Active Directory</product>
        <action>KERBEROS-TGT</action>
        <golden_ticket regex="true">true</golden_ticket>
        <followed_by>
          <event>
            <product>Active Directory</product>
            <action regex="true">.*(DCSYNC|DCSHADOW|GPO-MODIFY)</action>
            <time_window>7200</time_window>
