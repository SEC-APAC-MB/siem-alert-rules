  <rule id="FSIEM-LATCHAIN-013" severity="HIGH" enabled="true">
    <name>Lateral Chain — Cloud Instance Metadata to Lateral Cloud Movement</name>
    <description>Detects SSRF to cloud metadata service followed by lateral movement using stolen cloud credentials</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <action>SSRF</action>
        <target regex="true">.*(169\.254\.169\.254|metadata\.google|metadata\.azure).*</target>
        <followed_by>
          <event>
            <product>Cloud</product>
            <action regex="true">.*(AWS-API|AZURE-API|GCP-API)</action>
            <stolen_credentials regex="true">true</stolen_credentials>
            <time_window>7200</time_window>
          </event>
        </followed_by>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
      <tactic>Credential Access</tactic>
      <technique>T1552.005</technique>
      <tactic>Lateral Movement</tactic>
      <technique>T1537</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
    </compliance>
    <references>CHAIN-013</references>
    <action>ALERT</action>
    <group>lateral_movement_chains</group>
  </rule>

