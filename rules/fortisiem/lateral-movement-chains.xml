<!-- FortiSIEM SIEM Alert Rules — Lateral Movement Chains: Multi-Stage Detection -->
<rules>
  <rule id="FSIEM-LATCHAIN-001" severity="CRITICAL" enabled="true">
    <name>Lateral Chain — Initial Access to Credential Dump to Lateral Spread</name>
    <description>Detects a chain: initial compromise followed by credential dumping and lateral movement using stolen credentials</description>
    <pattern>
      <event>
        <product>OS</product>
        <action regex="true">.*(WEB-EXPLOIT|PHISH-CLICK|VULN-EXPLOIT)</action>
        <followed_by>
          <event>
            <product>Windows</product>
            <action regex="true">.*(LSASS-DUMP|MIMIKATZ|CRED-EXPORT)</action>
            <time_window>7200</time_window>
          </event>
        </followed_by>
        <followed_by>
          <event>
            <product>OS</product>
            <action regex="true">.*(PS-REMOTING|WMI-EXEC|RDP-LOGIN)</action>
            <time_window>3600</time_window>
          </event>
        </followed_by>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
      <tactic>Credential Access</tactic>
      <technique>T1003.001</technique>
      <tactic>Lateral Movement</tactic>
      <technique>T1021</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>10.2</control>
      <standard>NIST</standard>
      <control>AU-6</control>
    </compliance>
    <references>CHAIN-001</references>
    <action>ALERT</action>
    <group>lateral_movement_chains</group>
  </rule>

  <rule id="FSIEM-LATCHAIN-002" severity="CRITICAL" enabled="true">
    <name>Lateral Chain — Phishing to Account Takeover to Cloud Pivot</name>
    <description>Detects phishing compromise followed by account takeover and pivoting to cloud services</description>
    <pattern>
      <event>
        <product>Email</product>
        <action>PHISH-CLICK</action>
        <followed_by>
          <event>
            <product>Identity Provider</product>
            <action>LOGIN-SUCCESS</action>
            <new_device regex="true">true</new_device>
            <time_window>7200</time_window>
          </event>
        </followed_by>
        <followed_by>
          <event>
            <product>Cloud</product>
            <action regex="true">.*(AWS-CONSOLE|AZURE-PORTAL|GCP-CONSOLE)</action>
            <time_window>3600</time_window>
          </event>
        </followed_by>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1566.001</technique>
      <tactic>Valid Accounts</tactic>
      <technique>T1078</technique>
      <tactic>Lateral Movement</tactic>
      <technique>T1537</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>8.1.6</control>
    </compliance>
    <references>CHAIN-002</references>
    <action>ALERT</action>
    <group>lateral_movement_chains</group>
  </rule>

  <rule id="FSIEM-LATCHAIN-003" severity="CRITICAL" enabled="true">
    <name>Lateral Chain — Web Shell Upload to Internal Recon to Lateral Pivot</name>
    <description>Detects web shell deployment followed by internal reconnaissance and lateral movement</description>
    <pattern>
      <event>
        <product>Web Application</product>
        <action>FILE-UPLOAD</action>
        <file_type regex="true">.*(webshell|backdoor|reverse-shell).*</file_type>
        <followed_by>
          <event>
            <product>OS</product>
            <action regex="true">.*(NMAP-SCAN|NET-VIEW|AD-ENUM)</action>
            <time_window>7200</time_window>
          </event>
        </followed_by>
        <followed_by>
          <event>
            <product>OS</product>
            <action regex="true">.*(PS-REMOTING|WMI-EXEC|SMB-EXEC)</action>
            <time_window>3600</time_window>
          </event>
        </followed_by>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1190</technique>
      <tactic>Discovery</tactic>
      <technique>T1087</technique>
      <tactic>Lateral Movement</tactic>
      <technique>T1021</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>6.5</control>
    </compliance>
    <references>CHAIN-003</references>
    <action>ALERT</action>
    <group>lateral_movement_chains</group>
  </rule>

  <rule id="FSIEM-LATCHAIN-004" severity="CRITICAL" enabled="true">
    <name>Lateral Chain — Kerberoasting to Lateral Movement</name>
    <description>Detects Kerberoasting attack followed by lateral movement using cracked service account credentials</description>
    <pattern>
      <event>
        <product>Active Directory</product>
        <action>KERBEROS-TGS-REQUEST</action>
        <kerberoasting regex="true">true</kerberoasting>
        <followed_by>
          <event>
            <product>OS</product>
            <action regex="true">.*(PS-REMOTING|RDP-LOGIN|SMB-CONNECT)</action>
            <time_window>14400</time_window>
          </event>
        </followed_by>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1558.003</technique>
      <tactic>Lateral Movement</tactic>
      <technique>T1021</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>8.1.6</control>
    </compliance>
    <references>CHAIN-004</references>
    <action>ALERT</action>
    <group>lateral_movement_chains</group>
  </rule>

  <rule id="FSIEM-LATCHAIN-005" severity="CRITICAL" enabled="true">
    <name>Lateral Chain — Pass-the-Hash to Domain Admin to DCSync</name>
    <description>Detects pass-the-hash lateral movement escalating to domain admin and executing DCSync</description>
    <pattern>
      <event>
        <product>Windows</product>
        <action>NTLM-AUTH-SUCCESS</action>
        <hash_auth regex="true">true</hash_auth>
        <followed_by>
          <event>
            <product>Active Directory</product>
            <action>PRIVILEGE-ESCALATION</action>
            <target_privilege regex="true">.*(Domain Admins|Enterprise Admins).*</target_privilege>
            <time_window>7200</time_window>
          </event>
        </followed_by>
        <followed_by>
          <event>
            <product>Active Directory</product>
            <action>DCSYNC</action>
            <time_window>3600</time_window>
          </event>
        </followed_by>
      </event>
    </pattern>
    <mitre>
      <tactic>Defense Evasion</tactic>
      <technique>T1550.002</technique>
      <tactic>Privilege Escalation</tactic>
      <technique>T1078.002</technique>
      <tactic>Credential Access</tactic>
      <technique>T1003.006</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>8.1.6</control>
    </compliance>
    <references>CHAIN-005</references>
    <action>ALERT</action>
    <group>lateral_movement_chains</group>
  </rule>

  <rule id="FSIEM-LATCHAIN-006" severity="CRITICAL" enabled="true">
    <name>Lateral Chain — DLL Side-Loading to Registry Persistence</name>
    <description>Detects DLL side-loading attack followed by registry-based persistence establishment</description>
    <pattern>
      <event>
        <product>Windows</product>
        <action>DLL-SIDE-LOAD</action>
        <followed_by>
          <event>
            <product>Windows</product>
            <action>REGISTRY-MODIFY</action>
            <registry_key regex="true">.*(Run|RunOnce|Startup).*</registry_key>
            <time_window>3600</time_window>
          </event>
        </followed_by>
      </event>
    </pattern>
    <mitre>
      <tactic>Defense Evasion</tactic>
      <technique>T1574.002</technique>
      <tactic>Persistence</tactic>
      <technique>T1547.001</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>10.2</control>
    </compliance>
    <references>CHAIN-006</references>
    <action>ALERT</action>
    <group>lateral_movement_chains</group>
  </rule>

  <rule id="FSIEM-LATCHAIN-007" severity="HIGH" enabled="true">
    <name>Lateral Chain — SSH Key Theft to Cloud Infrastructure Pivot</name>
    <description>Detects theft of SSH private keys followed by lateral movement to cloud infrastructure</description>
    <pattern>
      <event>
        <product>OS</product>
        <action regex="true">.*(FILE-READ|FILE-COPY)</action>
        <file_path regex="true">.*(/\.ssh/id_rsa|/\.ssh/id_ed25519|/\.ssh/id_ecdsa).*</file_path>
        <followed_by>
          <event>
            <product>Cloud</product>
            <action regex="true">.*(SSH-CONNECT|SCP-TRANSFER)</action>
            <time_window>7200</time_window>
          </event>
        </followed_by>
      </event>
    </pattern>
    <mitre>
      <tactic>Credential Access</tactic>
      <technique>T1552.004</technique>
      <tactic>Lateral Movement</tactic>
      <technique>T1021.004</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>8.1.6</control>
    </compliance>
    <references>CHAIN-007</references>
    <action>ALERT</action>
    <group>lateral_movement_chains</group>
  </rule>

  <rule id="FSIEM-LATCHAIN-008" severity="CRITICAL" enabled="true">
    <name>Lateral Chain — Scheduled Task Creation to Ransomware Deployment</name>
    <description>Detects creation of scheduled tasks across multiple hosts followed by ransomware execution indicators</description>
    <pattern>
      <event>
        <product>Windows</product>
        <action>SCHEDULED-TASK-CREATE</action>
        <count regex="true">>5</count>
        <time_window>3600</time_window>
        <followed_by>
          <event>
            <product>OS</product>
            <action regex="true">.*(FILE-ENCRYPT|VSS-DELETE|BITLOCKER-ENABLE)</action>
            <time_window>3600</time_window>
          </event>
        </followed_by>
      </event>
    </pattern>
    <mitre>
      <tactic>Execution</tactic>
      <technique>T1053.005</technique>
      <tactic>Impact</tactic>
      <technique>T1486</technique>
    </mitre>
    <compliance>
      <standard>PCI-DSS</standard>
      <control>10.2</control>
    </compliance>
    <references>CHAIN-008</references>
    <action>ALERT</action>
    <group>lateral_movement_chains</group>
  </rule>

  <rule id="FSIEM-LATCHAIN-009" severity="CRITICAL" enabled="true">
    <name>Lateral Chain — Supply Chain Compromise to Internal Lateral Movement</name>
    <description>Detects supply chain compromise followed by lateral movement from compromised software</description>
    <pattern>
      <event>
        <product>OS</product>
        <action>SOFTWARE-UPDATE</action>
        <compromised_package regex="true">true</compromised_package>
        <followed_by>
          <event>
            <product>OS</product>
            <action regex="true">.*(REVERSE-SHELL|COBALT-STRIKE|C2-BEACON)</action>
            <time_window>7200</time_window>
          </event>
        </followed_by>
        <followed_by>
          <event>
            <product>OS</product>
            <action regex="true">.*(PS-REMOTING|WMI-EXEC|DCOM-EXEC)</action>
            <time_window>3600</time_window>
          </event>
        </followed_by>
      </event>
    </pattern>
    <mitre>
      <tactic>Initial Access</tactic>
      <technique>T1195.002</technique>
      <tactic>Command and Control</tactic>
      <technique>T1071</technique>
      <tactic>Lateral Movement</tactic>
      <technique>T1021</technique>
    </mitre>
    <compliance>
