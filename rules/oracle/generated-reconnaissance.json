[
  {
    "rule_id": "OCI-RECONNAISSANCE-117",
    "name": "Active Directory Domain Enumeration",
    "description": "Detect AD enumeration via LDAP queries, DSQuery, BloodHound collection",
    "severity": "MEDIUM",
    "category": "reconnaissance",
    "mitre_attack": [],
    "compliance": [],
    "query": "MQL: Active Directory Domain Enumeration -- OCI Monitoring Query Language detection",
    "rule_type": "query",
