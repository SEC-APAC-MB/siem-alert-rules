  {
    "rule_id": "OCI-CLOUD_NATIVE-067",
    "name": "Container Escape via Privileged Pod",
    "description": "Kubernetes, container, serverless, and cloud-specific attack detection",
    "severity": "CRITICAL",
    "category": "cloud_native",
    "mitre_attack": [],
    "compliance": [],
    "query": "MQL: Container Escape via Privileged Pod -- OCI Monitoring Query Language detection",
    "rule_type": "query",
