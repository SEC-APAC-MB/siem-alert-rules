    "description": "Detect anomalous DNS query patterns indicating data exfiltration via DNS",
    "severity": "CRITICAL",
    "category": "exfiltration",
    "mitre_attack": [],
    "compliance": [],
    "query": "MQL: DNS Tunneling Detection -- OCI Monitoring Query Language detection",
