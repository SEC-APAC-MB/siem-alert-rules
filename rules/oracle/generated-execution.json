[
  {
    "rule_id": "OCI-EXECUTION-137",
    "name": "PowerShell Suspicious Execution",
    "description": "Detect encoded PowerShell, -bypass, hidden window, and download cradle patterns",
    "severity": "CRITICAL",
    "category": "execution",
    "mitre_attack": [],
    "compliance": [],
    "query": "MQL: PowerShell Suspicious Execution -- OCI Monitoring Query Language detection",
    "rule_type": "query",
    "interval": "5m",
    "condition": {
      "eventType": [
        "com.oracle.cloud.monitoring"
      ],
      "compartmentId": "$COMPARTMENT_ID",
      "metric": "execution",
      "operator": "GT",
      "threshold": 5
    },
    "actions": [
      {
        "actionType": "ONS",
        "description": "Send alert notification"
      }
    ],
    "tags": [
      "execution"
    ]
  },
