# =============================================================================
# Suricata Rules — Web Application Attacks
# Covers: SQL injection, XSS, path traversal, command injection, SSRF, RCE,
#          deserialization, file upload, request smuggling
# Total rules: 57
# SID range: 2301001 - 2301057
# =============================================================================

# --- SQL Injection ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SQL Injection - UNION SELECT"; flow:established,to_server; content:"UNION"; nocase:true; http_uri; content:"SELECT"; nocase:true; http_uri; pcre:"/union\s+(all\s+)?select/i"; http_uri; classtype:web-application-attack; sid:2301001; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SQL Injection - UNION SELECT in POST"; flow:established,to_server; pcre:"/union\s+(all\s+)?select/i"; http_client_body; classtype:web-application-attack; sid:2301002; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SQL Injection - Boolean-Based Blind"; flow:established,to_server; pcre:"/(\b(and|or)\b\s+[\d'\"\)]+\s*=\s*[\d'\"]+|\b(and|or)\b\s+[\d'\"]+\s+like\s+[\d'\"]+)/i"; http_uri; classtype:web-application-attack; sid:2301003; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SQL Injection - Time-Based Blind"; flow:established,to_server; pcre:"/(sleep\s*\(\s*\d+\s*\)|benchmark\s*\(\s*\d+\s*,|waitfor\s+delay|pg_sleep\s*\(\s*\d+\s*\)|dbms_pipe\.receive_message)/i"; http_uri; classtype:web-application-attack; sid:2301004; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SQL Injection - Error-Based Information Disclosure"; flow:established,to_server; pcre:"/(convert\s*\(|cast\s*\(|extractvalue\s*\(|updatexml\s*\()/i"; http_uri; classtype:web-application-attack; sid:2301005; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SQL Injection - Stacked Queries"; flow:established,to_server; pcre:"/;\s*(select|insert|update|delete|drop|alter|create|exec|execute)\b/i"; http_client_body; classtype:web-application-attack; sid:2301006; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SQL Injection - Comment Bypass"; flow:established,to_server; pcre:"/(\/\*.*?\*\/|--\s|#\s|--)/iU"; http_uri; pcre:"/\b(select|insert|update|delete|drop|union|from|where)\b/i"; http_uri; classtype:web-application-attack; sid:2301007; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SQL Injection - NoSQL Operator Injection"; flow:established,to_server; pcre:"/(\$where|\$ne|\$gt|\$lt|\$regex|\$expr|\$jsonSchema)/i"; http_client_body; classtype:web-application-attack; sid:2301008; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SQL Injection - Authentication Bypass"; flow:established,to_server; content:"POST"; http_method; pcre:"/(password|passwd|pwd|secret).*('\s*(or|OR)\s+'[^']*'\s*=\s*'[^']*'|1\s*=\s*1|'--)/i"; http_client_body; classtype:web-application-attack; sid:2301009; rev:1; metadata:created_at 2026-08-17;)

# --- Cross-Site Scripting (XSS) ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - XSS - Script Tag Injection"; flow:established,to_server; content:"<script"; nocase:true; http_uri; pcre:"/<script\b[^>]*>/i"; http_uri; classtype:web-application-attack; sid:2301010; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - XSS - Script Tag in POST Body"; flow:established,to_server; content:"<script"; nocase:true; http_client_body; classtype:web-application-attack; sid:2301011; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - XSS - Event Handler Injection"; flow:established,to_server; pcre:"/on(click|load|error|mouseover|focus|blur|submit|change|keydown|keyup|keypress|mouseout|mousemove|mousedown|mouseup|resize|scroll|unload|beforeunload)\s*=/i"; http_uri; classtype:web-application-attack; sid:2301012; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - XSS - JavaScript Protocol in URI"; flow:established,to_server; content:"javascript:"; nocase:true; http_uri; classtype:web-application-attack; sid:2301013; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - XSS - Data URI Scheme Injection"; flow:established,to_server; pcre:"/data\s*:\s*(text\/html|application\/xhtml\+xml)\s*;\s*base64/i"; http_uri; classtype:web-application-attack; sid:2301014; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - XSS - SVG onload Injection"; flow:established,to_server; content:"<svg"; nocase:true; content:"onload"; nocase:true; pcre:"/<svg\b[^>]*onload\s*=/i"; http_uri; classtype:web-application-attack; sid:2301015; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - XSS - IMG onerror Injection"; flow:established,to_server; pcre:"/<img\b[^>]*onerror\s*=/i"; http_uri; classtype:web-application-attack; sid:2301016; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - XSS - Document Cookie Exfiltration"; flow:established,to_server; pcre:"/document\.(cookie|location|write|domain)/i"; http_uri; classtype:web-application-attack; sid:2301017; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - XSS - DOM Clobbering via Named Element"; flow:established,to_server; pcre:"/<(a|form|img|embed|object)\b[^>]*(id|name)\s*=\s*\"(body|forms|images|links|anchors)/i"; http_client_body; classtype:web-application-attack; sid:2301018; rev:1; metadata:created_at 2026-08-17;)

# --- Path Traversal ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Path Traversal - ../ Directory Traversal"; flow:established,to_server; pcre:"/(\.\.\/|\.\.\\)/i"; http_uri; classtype:web-application-attack; sid:2301019; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Path Traversal - Encoded ../"; flow:established,to_server; pcre:"/(\.\.%2[fF]|%2[eE]\.%2[fF]|%2[eE]%2[fF]|\.\.%5[cC]|%5[cC]\.\.)/i"; http_uri; classtype:web-application-attack; sid:2301020; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Path Traversal - /etc/passwd Access"; flow:established,to_server; content:"/etc/passwd"; nocase:true; http_uri; classtype:web-application-attack; sid:2301021; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Path Traversal - /etc/shadow Access"; flow:established,to_server; content:"/etc/shadow"; nocase:true; http_uri; classtype:web-application-attack; sid:2301022; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Path Traversal - Windows boot.ini Access"; flow:established,to_server; pcre:"/(boot\.ini|win\.ini|system32)/i"; http_uri; classtype:web-application-attack; sid:2301023; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Path Traversal - Null Byte Injection"; flow:established,to_server; pcre:"/%00|\x00/"; http_uri; classtype:web-application-attack; sid:2301024; rev:1; metadata:created_at 2026-08-17;)

# --- Command Injection ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Command Injection - Semicolon Chaining"; flow:established,to_server; pcre:"/[;&|`]\s*(ls|cat|id|whoami|uname|pwd|ifconfig|ipconfig|net\s+user|dir|ping|wget|curl|nc|ncat|bash|sh|powershell|cmd)\b/i"; http_uri; classtype:web-application-attack; sid:2301025; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Command Injection - Backtick Execution"; flow:established,to_server; pcre:"/`[^`]+`/"; http_client_body; pcre:"/`(ls|cat|id|whoami|uname|pwd|ifconfig|ping|wget|curl|nc|bash|sh)/i"; http_client_body; classtype:web-application-attack; sid:2301026; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Command Injection - Dollar Parenthesis"; flow:established,to_server; pcre:"/\$\([^)]+\)/"; http_client_body; pcre:"/\$\((ls|cat|id|whoami|uname|pwd|ifconfig|ping|wget|curl|nc|bash|sh)/i"; http_client_body; classtype:web-application-attack; sid:2301027; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Command Injection - Newline Injection"; flow:established,to_server; pcre:"/%0[ad]/i"; http_uri; pcre:"/\b(ls|cat|id|whoami|uname|pwd|ifconfig|ping|wget|curl|nc|bash|sh|powershell|cmd)\b/i"; http_uri; classtype:web-application-attack; sid:2301028; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Command Injection - OS Command in POST"; flow:established,to_server; pcre:"/(\b(exec|system|popen|proc_open|passthru|shell_exec|os\.system|subprocess|Runtime\.getRuntime)\s*[\(])/i"; http_client_body; classtype:web-application-attack; sid:2301029; rev:1; metadata:created_at 2026-08-17;)

# --- Server-Side Request Forgery (SSRF) ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SSRF - Internal IP in URL Parameter"; flow:established,to_server; pcre:"/(url|uri|path|dest|redirect|return|next|target|site|link|reference|rurl|img|image|load|file|page|feed|callback|src)\s*=\s*(https?:\/\/)?(127\.0\.0\.[0-9]|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+|192\.168\.\d+\.\d+|0\.0\.0\.0|localhost)/i"; http_uri; classtype:web-application-attack; sid:2301030; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SSRF - Cloud Metadata Endpoint Access"; flow:established,to_server; pcre:"/(url|uri|path|dest|redirect|return|next|target|site|link)\s*=\s*(https?:\/\/)?(169\.254\.169\.254|[fF][eE][dD]0:|metadata\.google|metadata\.azure)/i"; http_uri; classtype:web-application-attack; sid:2301031; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SSRF - DNS Rebinding via URL Parameter"; flow:established,to_server; pcre:"/(url|uri|path|dest|redirect)\s*=\s*https?:\/\/[a-z0-9-]+\.(nic\.fit|ssrf\.me|ssrf\.io|1e100\.net)/i"; http_uri; classtype:web-application-attack; sid:2301032; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SSRF - File Protocol Access"; flow:established,to_server; pcre:"/(url|uri|path|dest|file)\s*=\s*file:\/\/\//i"; http_uri; classtype:web-application-attack; sid:2301033; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SSRF - Gopher Protocol Abuse"; flow:established,to_server; pcre:"/(url|uri|path|dest)\s*=\s*gopher:\/\//i"; http_uri; classtype:web-application-attack; sid:2301034; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - SSRF - AWS Metadata in POST Body"; flow:established,to_server; pcre:"/(169\.254\.169\.254|metadata\.google\.internal|metadata\.azure\.com)/i"; http_client_body; classtype:web-application-attack; sid:2301035; rev:1; metadata:created_at 2026-08-17;)

# --- Remote Code Execution (RCE) ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - RCE - PHP Code Injection"; flow:established,to_server; pcre:"/(\beval\s*\(|assert\s*\(|preg_replace\s*\(.+\/[a-z]*e[a-z]*['\"]|create_function\s*\(|call_user_func\s*\()/i"; http_client_body; classtype:web-application-attack; sid:2301036; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - RCE - Template Injection - Jinja2/SSTI"; flow:established,to_server; pcre:"/\{\{.*(__class__|__mro__|__subclasses__|__builtins__|__import__|config|request).*\}\}/i"; http_client_body; classtype:web-application-attack; sid:2301037; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - RCE - Template Injection - Freemarker"; flow:established,to_server; pcre:"/<#assign|<#if|<#list|\$\{.*\}|<@|<#/"; http_client_body; pcre:"/(freemarker|template|execute|runtime)/i"; http_client_body; classtype:web-application-attack; sid:2301038; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - RCE - Expression Language Injection"; flow:established,to_server; pcre:"/#\{.*\}/"; http_uri; pcre:"/(Runtime|exec|ProcessBuilder|getRuntime)/i"; http_uri; classtype:web-application-attack; sid:2301039; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - RCE - Python os.system/import"; flow:established,to_server; pcre:"/(import\s+os|os\.system|os\.popen|subprocess\.(call|run|Popen)|__import__\(['\"]os)/i"; http_client_body; classtype:web-application-attack; sid:2301040; rev:1; metadata:created_at 2026-08-17;)

# --- Deserialization ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Java Deserialization - Magic Bytes AC ED 00 05"; flow:established,to_server; content:"|ac ed 00 05|"; classtype:web-application-attack; sid:2301041; rev:2; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Java Deserialization - rO0B Base64 Pattern"; flow:established,to_server; content:"rO0B"; http_client_body; classtype:web-application-attack; sid:2301042; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Java Deserialization - Commons Collections Gadget"; flow:established,to_server; content:"org.apache.commons.collections"; http_client_body; classtype:web-application-attack; sid:2301043; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Java Deserialization - Spring JNDI Injection"; flow:established,to_server; pcre:"/(jndi|rmi|ldap|iiop):\/\/[a-z0-9.-]+/i"; http_client_body; classtype:web-application-attack; sid:2301044; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - PHP Deserialization - Object Injection"; flow:established,to_server; pcre:"/O:\d+:\"(stdClass|WP_Query|WP_User|WP_Error|wpdb|JConfig|JDatabase|JFactory)/i"; http_client_body; classtype:web-application-attack; sid:2301045; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Python Deserialization - Pickle RCE"; flow:established,to_server; content:"|80 05|"; http_client_body; pcre:"/c(?:__builtin__|os|subprocess|commands)/i"; http_client_body; classtype:web-application-attack; sid:2301046; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - .NET Deserialization - ViewState RCE"; flow:established,to_server; content:"__VIEWSTATE"; http_client_body; pcre:"/[A-Za-z0-9+\/]{500,}/"; http_client_body; classtype:web-application-attack; sid:2301047; rev:1; metadata:created_at 2026-08-17;)

# --- File Upload ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - File Upload - PHP Webshell Extension"; flow:established,to_server; content:"multipart/form-data"; http_header; pcre:"/filename\s*=\s*\"[^\"]+\.(php[34567p]?|phtml|pht|phps)/i"; http_client_body; classtype:web-application-attack; sid:2301048; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - File Upload - JSP Webshell Extension"; flow:established,to_server; content:"multipart/form-data"; http_header; pcre:"/filename\s*=\s*\"[^\"]+\.(jsp|jspx|jspf|war)/i"; http_client_body; classtype:web-application-attack; sid:2301049; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - File Upload - Double Extension Bypass"; flow:established,to_server; content:"multipart/form-data"; http_header; pcre:"/filename\s*=\s*\"[^\"]+\.(php|jsp|asp|aspx|exe|sh)\.[a-z]{2,4}\"/i"; http_client_body; classtype:web-application-attack; sid:2301050; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - File Upload - Webshell Content Pattern"; flow:established,to_server; content:"multipart/form-data"; http_header; pcre:"/(eval\s*\(\s*(base64_decode|gzinflate|str_rot13|gzuncompress)\s*\(|assert\s*\(|preg_replace\s*\(.+\/e[\'\"]|<\?php\s+(echo|print|system|exec|passthru|shell_exec)\s*\(|<%\s*(execute|eval|response\.write))/i"; http_client_body; classtype:web-application-attack; sid:2301051; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - File Upload - Null Byte Extension Bypass"; flow:established,to_server; content:"multipart/form-data"; http_header; pcre:"/filename\s*=\s*\"[^\"]*%00\.(php|jsp|asp|aspx|exe|sh)/i"; http_client_body; classtype:web-application-attack; sid:2301052; rev:1; metadata:created_at 2026-08-17;)

# --- HTTP Request Smuggling ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - HTTP Request Smuggling - CL.TE Conflict"; flow:established,to_server; content:"Content-Length"; http_header; content:"Transfer-Encoding"; http_header; pcre:"/Content-Length\s*:\s*\d+[^]*Transfer-Encoding\s*:\s*chunked/i"; classtype:web-application-attack; sid:2301053; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - HTTP Request Smuggling - Duplicate Content-Length"; flow:established,to_server; pcre:"/Content-Length\s*:\s*\d+[^]*Content-Length\s*:\s*\d+/i"; classtype:web-application-attack; sid:2301054; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - HTTP Request Smuggling - TE.CL Conflict"; flow:established,to_server; content:"Transfer-Encoding"; http_header; content:"chunked"; http_header; content:"Content-Length"; http_header; classtype:web-application-attack; sid:2301055; rev:1; metadata:created_at 2026-08-17;)

# --- Additional Web Attacks ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Open Redirect - URL Parameter Manipulation to Suspicious Domain"; flow:established,to_server; pcre:"/[?&](redirect|return|next|url|redir|continue|dest|target|goto|link|r2|rurl|redirectUrl|redirect_to|returnUrl|return_to|forward|path|out|view|data|reference|ref|callback|return_path|successUrl|success_path|next_url|returnURL|redirectTo|redirect_url|RedirUrl|redirUrl)=https?:\/\/[^&]*\.(xyz|top|buzz|club|info|online|site|live|cc|tk|ml|ga|cf|pw|zip|review|work|party|click)/i"; http_uri; classtype:web-application-attack; sid:2301056; rev:2; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WEB ATTACK - Log4Shell - JNDI Lookup in Header"; flow:established,to_server; pcre:"/\$\{jndi:(ldap|rmi|dns|iiop|nis|nds|corba):\/\/[^\}]+\}/i"; http_header; classtype:web-application-attack; sid:2301057; rev:1; metadata:created_at 2026-08-17;)