alert tcp any any -> any 22 (msg:"MITRE T1021.004 Remote Services via SSH - brute force pattern"; flow:to_server,established; detection_filter:track by_src, count 10, seconds 60; classtype:attempted-recon; sid:521275190; rev:1; metadata:mitre_tactic_id TA0008, mitre_technique_id T1021_004;)
alert tcp any any -> any 445 (msg:"MITRE T1021.002 Remote Services via SMB - anomalous SMB access"; flow:to_server,established; content:"|00 00 00 2f ff 53 4d 42|"; depth:8; classtype:trojan-activity; sid:521275191; rev:1; metadata:mitre_tactic_id TA0008, mitre_technique_id T1021_002;)
