alert http any any -> any any (msg:"MITRE T1071.004 DNS - anomalous DNS query pattern for C2"; flow:established,to_server; dns.query.name; pcre:"/[a-z0-9]{15,}\.(info|tk|ml|ga|cf|gq)$/i"; classtype:trojan-activity; sid:521275197; rev:1; metadata:mitre_tactic_id TA0011, mitre_technique_id T1071_004;)
