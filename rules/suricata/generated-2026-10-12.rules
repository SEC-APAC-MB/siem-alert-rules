alert http any any -> any any (msg:"MITRE T1595 Active Scanning - rapid port sweep pattern"; flow:to_server; detection_filter:track by_src, count 20, seconds 10; pcre:"/^(GET|POST|HEAD|OPTIONS)\s+\/\s+HTTP\/1\.[01]$/"; classtype:network-scan; sid:521275165; rev:1; metadata:mitre_tactic_id TA0043, mitre_technique_id T1595;)
alert http any any -> any any (msg:"MITRE T1595.002 Active Scanning - vulnerability scanning User-Agent"; flow:established,to_server; http.header; pcre:"/(Nikto|Nmap|sqlmap|Nessus|OpenVAS|Masscan|ZGrab|gobuster|dirbuster|wpscan|acunetix)/iH"; classtype:network-scan; sid:521275166; rev:1; metadata:mitre_tactic_id TA0043, mitre_technique_id T1595_002;)
alert http any any -> any any (msg:"MITRE T1592 Gather Victim Host Info - system enumeration via HTTP headers"; flow:established,to_server; http.header; pcre:"/(X-Forwarded-For|X-Real-IP|True-Client-IP).*(;|union|select)/iH"; classtype:network-scan; sid:521275167; rev:1; metadata:mitre_tactic_id TA0043, mitre_technique_id T1592;)
# === MITRE ATT&CK - Initial Access (T1190) ===
