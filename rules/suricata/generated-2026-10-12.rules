alert http any any -> any any (msg:"MITRE T1190 - Log4Shell JNDI injection attempt"; flow:established,to_server; http.header; pcre:"/\$\{jndi:(ldap|rmi|dns|http|ldaps|niopi)/iH"; classtype:attempted-exploit; sid:521275169; rev:1; metadata:mitre_tactic_id TA0001, mitre_technique_id T1190;)
alert http any any -> any any (msg:"MITRE T1190 - Spring4Shell RCE attempt"; flow:established,to_server; http.uri; content:"class.module.classLoader"; nocase; classtype:attempted-exploit; sid:521275170; rev:1; metadata:mitre_tactic_id TA0001, mitre_technique_id T1190;)
alert http any any -> any any (msg:"MITRE T1190 - SSRF via URL parameter to internal services"; flow:established,to_server; http.uri; pcre:"/(url|uri|redirect|callback|fetch|source|dest|next|target|image_url|webhook).*=(http|\/\/)?(169\.254|10\.|192\.168|127\.|localhost)/iU"; classtype:attempted-exploit; sid:521275171; rev:1; metadata:mitre_tactic_id TA0001, mitre_technique_id T1190;)
# === MITRE ATT&CK - Execution (T1059) ===
alert http any any -> any any (msg:"MITRE T1059.004 Command and Scripting Interpreter - Unix shell injection"; flow:established,to_server; http.request_body; pcre:"/(\;\s*(cat|ls|id|whoami|uname|wget|curl|bash|sh|nc|ncat|python|perl)\b|\$\(|\`|\|\s*(bash|sh)\b)/i"; classtype:attempted-user; sid:521275172; rev:1; metadata:mitre_tactic_id TA0002, mitre_technique_id T1059_004;)
alert http any any -> any any (msg:"MITRE T1059.001 PowerShell execution via HTTP"; flow:established,to_server; http.request_body; pcre:"/(powershell|pwsh)\.exe.*-enc|powershell.*-exec.*bypass|powershell.*IEX|powershell.*DownloadString/i"; classtype:attempted-user; sid:521275173; rev:1; metadata:mitre_tactic_id TA0002, mitre_technique_id T1059_001;)
alert http any any -> any any (msg:"MITRE T1059 Python execution via web parameter"; flow:established,to_server; http.request_body; pcre:"/(python|python3)\s*-c\s*(import|exec|eval|__import__)/i"; classtype:attempted-user; sid:521275174; rev:1; metadata:mitre_tactic_id TA0002, mitre_technique_id T1059;)
