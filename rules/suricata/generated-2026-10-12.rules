alert http any any -> any any (msg:"MITRE T1087.002 Domain Account Discovery - LDAP query via web"; flow:established,to_server; http.request_body; pcre:"/(&(objectClass=user)(objectClass=person))|(&(objectCategory=person)(objectClass=user))/i"; classtype:network-scan; sid:521275187; rev:1; metadata:mitre_tactic_id TA0007, mitre_technique_id T1087_002;)
alert http any any -> any any (msg:"MITRE T1046 Network Service Discovery - internal port scan via SSRF"; flow:established,to_server; http.uri; pcre:"/url=http:\/\/(127\.0\.0\.1|localhost|10\.|192\.168\.|172\.16\.)/i"; classtype:network-scan; sid:521275188; rev:1; metadata:mitre_tactic_id TA0007, mitre_technique_id T1046;)
