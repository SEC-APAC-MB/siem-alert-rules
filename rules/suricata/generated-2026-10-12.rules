# === MITRE ATT&CK - Credential Access (T1110) ===
alert http any any -> any any (msg:"MITRE T1110 Brute Force - rapid authentication failures"; flow:established,to_server; http.method; content:"POST"; nocase; http.uri; content:"/login"; nocase; detection_filter:track by_src, count 10, seconds 60; classtype:attempted-admin; sid:521275182; rev:1; metadata:mitre_tactic_id TA0006, mitre_technique_id T1110;)
alert http any any -> any any (msg:"MITRE T1110.001 Password Guessing - common credential patterns"; flow:established,to_server; http.request_body; pcre:"/(password|passwd|pwd).*(admin|root|test|guest|123456|password1|qwerty)/i"; classtype:attempted-admin; sid:521275183; rev:1; metadata:mitre_tactic_id TA0006, mitre_technique_id T1110_001;)
alert http any any -> any any (msg:"MITRE T1110.003 Password Spraying - multiple users single password"; flow:established,to_server; http.method; content:"POST"; nocase; http.uri; content:"/login"; nocase; http.request_body; pcre:"/password=Winter2026|password=Summer2026|password=Welcome1/i"; detection_filter:track by_src, count 5, seconds 60; classtype:attempted-admin; sid:521275184; rev:1; metadata:mitre_tactic_id TA0006, mitre_technique_id T1110_003;)
alert http any any -> any any (msg:"MITRE T1555 Credentials from Password Stores - browser credential extraction"; flow:established,to_server; http.request_body; pcre:"/(Chrome|Edge|Firefox).*(Login Data|key4 db|cookies\.sqlite)/i"; classtype:credential-access; sid:521275185; rev:1; metadata:mitre_tactic_id TA0006, mitre_technique_id T1555;)
