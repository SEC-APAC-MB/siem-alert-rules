# =============================================================================
# Suricata Rules — Cloud Attack Chain Detection
# Detects multi-step cloud exploitation sequences: SSRF→IMDS→credential theft,
#          container escape→host→cloud metadata, K8s→service account→secret extraction,
#          S3 enumeration→ransom, and more.
# Total rules: 20
# SID range: 2309001 - 2309020
# Reference: MITRE ATT&CK TA0001 Initial Access → TA0006 Credential Access → TA0010 Exfiltration
# =============================================================================

# --- SSRF → IMDSv1 → IAM Role Credential Theft → AssumeRole Chaining ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN CLOUD-001: SSRF to AWS IMDSv1 - Metadata Endpoint Access via Server-Side Request"; flow:established,to_server; pcre:"/(169\.254\.169\.254|metadata\.google\.internal|metadata\.azure\.app|100\.100\.100\.200)/i"; http_uri; pcre:"/\/latest\/(meta-data|dynamic|iam)/i"; classtype:web-application-attack; sid:2309001; rev:1; metadata:chain ssrf-to-imds-credential-theft, mitre T1552.005, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN CLOUD-002: SSRF to AWS IMDSv1 IAM Credential Harvesting - Role Name Extraction"; flow:established,to_server; content:"169.254.169.254"; http_uri; pcre:"/\/latest\/meta-data\/iam\/security-credentials\/[a-zA-Z0-9_-]+/i"; classtype:web-application-attack; sid:2309002; rev:1; metadata:chain ssrf-to-imds-credential-theft, mitre T1552.005, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN CLOUD-003: AWS IAM Credential Exfiltration - AKIA Key in Outbound POST After SSRF"; flow:established,to_server; content:"POST"; http_method; pcre:"/AKIA[A-Z0-9]{16}/i"; http_client_body; classtype:web-application-attack; sid:2309003; rev:1; metadata:chain ssrf-to-imds-credential-theft, mitre T1537, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN CLOUD-004: SSRF to GCP Metadata - Service Account Token Extraction"; flow:established,to_server; pcre:"/(metadata\.google\.internal|169\.254\.169\.254)/i"; http_uri; pcre:"/\/computeMetadata\/v1\/(instance\/service-accounts|instance\/attributes|project\/)/i"; content:"Metadata-Flavor"; http_header; content:"Google"; http_header; classtype:web-application-attack; sid:2309004; rev:1; metadata:chain ssrf-to-gcp-credential-theft, mitre T1552.005, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN CLOUD-005: SSRF to Azure IMDS - Managed Identity Token Extraction"; flow:established,to_server; pcre:"/(169\.254\.169\.254|metadata\.azure\.app)/i"; http_uri; pcre:"/\/metadata\/identity\/oauth2\/token/i"; content:"Metadata"; http_header; content:"true"; http_header; classtype:web-application-attack; sid:2309005; rev:1; metadata:chain ssrf-to-azure-credential-theft, mitre T1552.005, created_at 2026_08_21;)

# --- Container Escape → Host Filesystem → Docker Socket → Cloud Metadata ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN CLOUD-006: Container Escape via Docker Socket Mount Exploitation"; flow:established,to_server; pcre:"/\/var\/run\/docker\.sock|docker%2F|\.docker\s*\.*\s*run|docker\.sock/i"; http_uri; classtype:web-application-attack; sid:2309006; rev:1; metadata:chain container-escape-to-cloud, mitre T1611, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN CLOUD-007: Container Escape via /proc/self/mountinfo or cgroup File Read"; flow:established,to_server; pcre:"/\/proc\/(self|1|self\/mountinfo|self\/cgroup|self\/status|self\/environ|self\/cmdline)/i"; http_uri; classtype:web-application-attack; sid:2309007; rev:1; metadata:chain container-escape-to-host, mitre T1611, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN CLOUD-008: Container Escape to Cloud Metadata - Escape + IMDS Access in Same Request"; flow:established,to_server; pcre:"/\/proc\/self\/(environ|cmdline|mountinfo).*169\.254\.169\.254|169\.254\.169\.254.*\/proc\/self\/(environ|cmdline)/i"; http_uri; classtype:web-application-attack; sid:2309008; rev:1; metadata:chain container-escape-to-cloud-metadata, mitre T1552.005, created_at 2026_08_21;)

# --- Kubernetes Pod → Service Account Token → API Server → Secret Extraction ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN CLOUD-009: K8s Service Account Token Exposure via Pod API or Environment Leak"; flow:established,to_server; pcre:"/\/var\/run\/secrets\/kubernetes\.io\/serviceaccount\/(token|namespace|ca\.crt)|KUBERNETES_SERVICE_HOST/i"; http_uri; classtype:web-application-attack; sid:2309009; rev:1; metadata:chain k8s-service-account-to-secrets, mitre T1552.007, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN CLOUD-010: K8s API Server Access with Stolen Service Account Token"; flow:established,to_server; pcre:"/\/api\/v1\/(namespaces|pods|secrets|configmaps|serviceaccounts)/i"; http_uri; content:"Authorization"; http_header; pcre:"/Bearer\s+eyJ[a-zA-Z0-9_-]+/i"; http_header; classtype:web-application-attack; sid:2309010; rev:1; metadata:chain k8s-service-account-to-secrets, mitre T1552.007, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN CLOUD-011: K8s Secret Exfiltration - base64-encoded Secret in Outbound Request"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/api\/v1\/namespaces\/[^\/]+\/secrets/i"; http_uri; pcre:"/[\"']data[\"']\s*:\s*\{[^}]*[\"']?[a-zA-Z0-9_-]+[\"']?\s*:\s*[\"'][a-zA-Z0-9+\/=]+[\"']/i"; http_client_body; classtype:web-application-attack; sid:2309011; rev:1; metadata:chain k8s-secret-exfiltration, mitre T1537, created_at 2026_08_21;)

# --- S3/Blob Bucket Enumeration → Data Download → Ransom/Extortion ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN CLOUD-012: AWS S3 Bucket Enumeration - ListObjects with Paginator Pattern"; flow:established,to_server; pcre:"/[a-z0-9.-]+\.s3[.-][a-z0-9.-]*amazonaws\.com/i"; http_uri; pcre:"/\/\?(list-type=2&prefix=|prefix=[^&]+&marker=|continuation-token=)/i"; classtype:web-application-attack; sid:2309012; rev:1; metadata:chain s3-enum-to-data-theft, mitre T1580, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN CLOUD-013: S3/Blob Bulk Data Exfiltration After Enumeration - Large Download Volume"; flow:established,to_client; content:"200"; http_stat_code; pcre:"/\.(sql|dump|bak|csv|xlsx?|docx?|pdf|zip|tar|gz|7z)$/i"; http_uri; dsize:>5000000; threshold:type both, track by_src, count 20, seconds 300; classtype:web-application-attack; sid:2309013; rev:1; metadata:chain s3-enum-to-data-theft, mitre T1537, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN CLOUD-014: Cloud Bucket Ransom Note Upload - README with Extortion Pattern"; flow:established,to_server; content:"PUT"; http_method; pcre:"/[a-z0-9.-]+\.s3[.-][a-z0-9.-]*amazonaws\.com/i"; http_uri; pcre:"/README|DECRYPT|INSTRUCTIONS|YOUR_DATA|RESTORE|RECOVER|BITCOIN|WALLET|RANSOM/i"; http_client_body; classtype:web-application-attack; sid:2309014; rev:1; metadata:chain s3-ransom, mitre T1486, created_at 2026_08_21;)

# --- Cloud API Abuse → AssumeRole → Cross-Account Access ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN CLOUD-015: AWS AssumeRole Privilege Escalation Chain - Role Chaining After Credential Theft"; flow:established,to_server; pcre:"/sts\.amazonaws\.com/i"; http_uri; pcre:"/Action=AssumeRole/i"; pcre:"/RoleArn=arn:aws:iam::\d{12}:role\//i"; classtype:web-application-attack; sid:2309015; rev:1; metadata:chain assume-role-privilege-escalation, mitre T1548, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN CLOUD-016: AWS IAM Policy Enumeration After Credential Theft - ListUsers/ListPolicies"; flow:established,to_server; pcre:"/iam\.amazonaws\.com/i"; http_uri; pcre:"/Action=(ListUsers|ListPolicies|ListRoles|ListAccessKeys|GetAccountAuthorizationDetails)/i"; classtype:web-application-attack; sid:2309016; rev:1; metadata:chain iam-enumeration-after-credential-theft, mitre T1580, created_at 2026_08_21;)

# --- Serverless Function Injection → Cloud Resource Access ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN CLOUD-017: AWS Lambda Function Invocation with Injection Payload"; flow:established,to_server; pcre:"/lambda\.[a-z0-9-]+\.amazonaws\.com\/2015-03-31\/functions\//i"; http_uri; pcre:"/(\/invocations|\/invoke)/i"; http_uri; pcre:"/(import\s+os|subprocess\.|eval\s*\(|exec\s*\(|__import__|child_process|require\s*\('child_process'\))/i"; http_client_body; classtype:web-application-attack; sid:2309017; rev:1; metadata:chain lambda-injection-to-rce, mitre T1059, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN CLOUD-018: Azure Function App Injection - Command Execution via HTTP Trigger"; flow:established,to_server; pcre:"/[a-z0-9-]+\.azurewebsites\.net\/api\//i"; http_uri; content:"POST"; http_method; pcre:"/(cmd\.exe|powershell|\/bin\/sh|\/bin\/bash|import\s+os|subprocess\.|eval\s*\(|exec\s*\()/i"; http_client_body; classtype:web-application-attack; sid:2309018; rev:1; metadata:chain azure-function-injection, mitre T1059, created_at 2026_08_21;)

# --- Cloud Metadata Pivot → Cloud CLI/API Abuse → Data Access ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN CLOUD-019: AWS CLI Credential File Exfiltration After SSRF Metadata Access"; flow:established,to_server; pcre:"/\/\.aws\/(credentials|config)|aws_access_key_id|aws_secret_access_key/i"; http_client_body; classtype:web-application-attack; sid:2309019; rev:1; metadata:chain aws-credential-exfiltration, mitre T1552, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN CLOUD-020: GCP Service Account Key JSON Exfiltration After Metadata Pivot"; flow:established,to_server; pcre:"/(\"type\"\s*:\s*\"service_account\"|\"private_key\"\s*:\s*\"-----BEGIN RSA PRIVATE KEY-----|\"project_id\"\s*:\s*\"[a-z])/i"; http_client_body; classtype:web-application-attack; sid:2309020; rev:1; metadata:chain gcp-service-account-exfiltration, mitre T1552, created_at 2026_08_21;)