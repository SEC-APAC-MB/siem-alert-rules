# --- MITRE ATT&CK Technique-Based Rules ---

# T1595.001 - Active Scanning (Reconnaissance)
alert http any any -> $HOME_NET any (msg:"ET RECON Aggressive Web Application Scanner Detected"; flow:to_server,established; http.user_agent; pcre:"/(Nikto|DirBuster|Gobuster|Feroxbuster|WFuzz|Arjun|ffuf|httpx|nuclei)/si"; threshold:type both, track by_src, count 3, seconds 30; reference:mitre,T1595.001; classtype:attempted-recon; sid:5210350; rev:1;)

# T1595.002 - Vulnerability Scanning
alert http any any -> $HOME_NET any (msg:"ET RECON Vulnerability Scanner Fingerprinting Activity"; flow:to_server,established; http.user_agent; pcre:"/(Nessus|OpenVAS|Qualys|Rapid7|Acunetix|BurpSuite|ZAP|w3af)/si"; reference:mitre,T1595.002; classtype:attempted-recon; sid:5210351; rev:1;)

# T1190 - Exploit Public-Facing Application
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Common Web Exploit Kit URI Patterns"; flow:to_server,established; http.uri; pcre:"/(wp-admin|phpmyadmin|/manager/html|/actuator|/console|/solr/|/debug)/Pi"; threshold:type both, track by_src, count 10, seconds 60; reference:mitre,T1190; classtype:attempted-admin; sid:5210352; rev:1;)

# T1133 - External Remote Services
alert http any any -> $HOME_NET any (msg:"ET TROJAN Suspicious External VPN/Proxy Service Connection"; flow:to_server,established; http.host; pcre:"/(nordvpn|expressvpn|surfshark|protonvpn|mullvad|hide\.)\w+\.\w+/si"; reference:mitre,T1133; classtype:trojan-activity; sid:5210353; rev:1;)

# T1078.002 - Domain Accounts
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Suspicious Domain Admin Account Usage from Unusual Source"; flow:to_server,established; http.header; content:"Authorization"; pcre:"/(admin|root|administrator|sa)/i"; threshold:type both, track by_src, count 5, seconds 300; reference:mitre,T1078.002; classtype:attempted-admin; sid:5210354; rev:1;)

# T1059.001 - PowerShell
alert http any any -> $EXTERNAL_NET any (msg:"ET EXPLOIT PowerShell Download Cradle Execution"; flow:to_server,established; http.client_body; content:"IEX"; content:"New-Object"; distance:0; content:"Net.WebClient"; distance:0; reference:mitre,T1059.001; classtype:attempted-admin; sid:5210355; rev:1;)

# T1059.003 - Windows Command Shell
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Suspicious cmd.exe Execution via Web"; flow:to_server,established; http.client_body; pcre:"/(cmd\.exe|cmd\.bat|command\.com).*\/c\s/Pi"; reference:mitre,T1059.003; classtype:attempted-admin; sid:5210356; rev:1;)

# T1059.004 - Unix Shell
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Suspicious Unix Shell Command Injection via Web"; flow:to_server,established; http.client_body; pcre:"/[;|`]\s*(bash|sh|nc|ncat|wget|curl)\s/Pi"; reference:mitre,T1059.004; classtype:attempted-admin; sid:5210357; rev:1;)

# T1071.001 - Web Protocols C2
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET TROJAN Suspicious Beaconing to Unknown Domain with Short Intervals"; flow:to_server,established; http.uri; content:"/api/beacon"; nocase; threshold:type both, track by_src, count 20, seconds 60; reference:mitre,T1071.001; classtype:trojan-activity; sid:5210358; rev:1;)

# T1566.001 - Spearphishing Attachment
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Malicious Document Download with Macro Execution Pattern"; flow:to_server,established; http.uri; pcre:"/\.(docm|xlsm|pptm|doc|xlsx?)\??(utm_source|ref)=/Pi"; http.header; content:"Content-Type"; content:"application/msword"; distance:0; reference:mitre,T1566.001; classtype:attempted-user; sid:5210359; rev:1;)

# T1053.005 - Scheduled Task/Job
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Web-Based Scheduled Task Creation via at/schtasks"; flow:to_server,established; http.client_body; pcre:"/(schtasks|at\s+\d)/Pi"; reference:mitre,T1053.005; classtype:attempted-admin; sid:5210360; rev:1;)

# T1082 - System Information Discovery
alert http any any -> $EXTERNAL_NET any (msg:"ET EXPLOIT System Information Exfiltration via HTTP"; flow:to_server,established; http.client_body; pcre:"/(hostname|uname|systeminfo|whoami|ipconfig|ifconfig)/Pi"; reference:mitre,T1082; classtype:attempted-recon; sid:5210361; rev:1;)

# T1003.001 - OS Credential Dumping: LSASS Memory
alert http any any -> $EXTERNAL_NET any (msg:"ET EXPLOIT LSASS Memory Dump Exfiltration Attempt"; flow:to_server,established; http.uri; pcre:"/(lsass|procdump|comsvcs)\.(dmp|dll|exe)/Pi"; reference:mitre,T1003.001; classtype:attempted-admin; sid:5210362; rev:1;)

# T1048.003 - Exfiltration Over Unencrypted Protocol
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET EXPLOIT Data Exfiltration via Unencrypted HTTP POST"; flow:to_server,established; http.request_body; content:"password="; pcre:"/password=[^&]{20,}/Pi"; threshold:type both, track by_src, count 3, seconds 60; reference:mitre,T1048.003; classtype:attempted-admin; sid:5210363; rev:1;)

# T1021.001 - Remote Services: Remote Desktop Protocol
alert tcp any any -> $HOME_NET 3389 (msg:"ET EXPLOIT RDP Brute Force Attempt"; threshold:type both, track by_src, count 10, seconds 60; reference:mitre,T1021.001; classtype:attempted-admin; sid:5210364; rev:1;)

# T1110.001 - Brute Force: Password Guessing
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Web Login Brute Force Attempt Detected"; flow:to_server,established; http.uri; content:"/login"; nocase; http.status_line; content:"401"; threshold:type both, track by_src, count 20, seconds 120; reference:mitre,T1110.001; classtype:attempted-admin; sid:5210365; rev:1;)

# T1110.003 - Brute Force: Password Spraying
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Password Spraying Attack Detected"; flow:to_server,established; http.uri; content:"/login"; nocase; threshold:type both, track by_src, count 50, seconds 300; reference:mitre,T1110.003; classtype:attempted-admin; sid:5210366; rev:1;)

# T1070.001 - Indicator Removal: Clear Windows Event Logs
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Windows Event Log Clearing via Web Shell"; flow:to_server,established; http.client_body; pcre:"/(wevtutil|Clear-EventLog|Remove-EventLog)/Pi"; reference:mitre,T1070.001; classtype:attempted-admin; sid:5210367; rev:1;)

# T1070.004 - Indicator Removal: File Deletion
alert http any any -> $EXTERNAL_NET any (msg:"ET EXPLOIT Mass File Deletion Command via HTTP"; flow:to_server,established; http.client_body; pcre:"/(rm\s+-rf|del\s+\/[sfq]|rd\s+\/[sfq]|Remove-Item.*-Recurse)/Pi"; reference:mitre,T1070.004; classtype:attempted-admin; sid:5210368; rev:1;)

# T1562.001 - Impair Defenses: Disable or Modify Tools
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Security Tool Disabling via Web Interface"; flow:to_server,established; http.client_body; pcre:"/(netsh\s+advfirewall|iptables\s+-F|Set-MpPreference.*-Disable)/Pi"; reference:mitre,T1562.001; classtype:attempted-admin; sid:5210369; rev:1;)

# T1055 - Process Injection
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Process Injection Command via Web"; flow:to_server,established; http.client_body; pcre:"/(inject|CreateRemoteThread|WriteProcessMemory|NtWriteVirtualMemory)/Pi"; reference:mitre,T1055; classtype:attempted-admin; sid:5210370; rev:1;)

# --- Current Threat Landscape / Emerging Techniques ---

# AI/LLM Prompt Injection
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT AI/LLM Prompt Injection Attack Attempt"; flow:to_server,established; http.client_body; pcre:"/(ignore\s+(previous|above|all)|disregard\s+(instructions|rules)|you\s+are\s+now|act\s+as\s+(admin|root|DAN))/Pi"; classtype:attempted-user; sid:5210371; rev:1;)

# AI/LLM Data Exfiltration
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET EXPLOIT AI/LLM Sensitive Data Exfiltration via Prompt"; flow:to_server,established; http.client_body; pcre:"/(system|api[_-]?key|secret|password|token|credential|private[_-]?key).*(extract|reveal|output|print|display|return)/Pi"; classtype:attempted-admin; sid:5210372; rev:1;)

# Supply Chain - npm/PyPI Package Confusion
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Supply Chain Package Confusion Attack - Suspicious Internal Registry"; flow:to_server,established; http.uri; pcre:"/(npm|pip|gem|cargo)\+(install|publish)/Pi"; http.host; pcre:"/(internal|private|corp|vpn)\./Pi"; reference:mitre,T1195.001; classtype:attempted-user; sid:5210373; rev:1;)

# API Mass Enumeration
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT API Mass Enumeration Attempt Detected"; flow:to_server,established; http.uri; pcre:"/\/api\/v\d+\/(users|accounts|orders|records)\/\d+/Pi"; threshold:type both, track by_src, count 100, seconds 60; reference:mitre,T1592; classtype:attempted-recon; sid:5210374; rev:1;)

# OAuth Token Theft
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT OAuth Token Theft via Phishing Redirect"; flow:to_server,established; http.uri; pcre:"/\/oauth\/(authorize|callback|token).*redirect_uri=https?:\/\/[^\/]*\.(xyz|top|click|tk|ml|ga)/Pi"; classtype:attempted-user; sid:5210375; rev:1;)

# Server-Side Request Forgery (Generic)
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Server-Side Request Forgery via URL Parameter"; flow:to_server,established; http.uri; pcre:"/(url|uri|path|dest|redirect|next|return|continue|callback|feed|img|fetch|load|source|data)=https?:\/\/(169\.254|10\.\d+|172\.(1[6-9]|2\d|3[01])|192\.168|127\.\d+|metadata\.google|169\.254\.169\.254)/Pi"; reference:mitre,T1190; classtype:attempted-recon; sid:5210376; rev:1;)

# Log4Shell Variants
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Log4Shell/JNDI Injection Variant Detected"; flow:to_server,established; http.header; pcre:"/\$\{jndi:(ldap|rmi|dns|nis|iiop|corba|nds|ldaps):\/\//Pi"; reference:mitre,T1190; classtype:attempted-admin; sid:5210377; rev:1;)

# Spring4Shell Variant
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Spring4Shell Class Loader Manipulation Attempt"; flow:to_server,established; http.uri; pcre:"/class\.module\.classLoader\.resources\.context\.parent\.pipeline/Pi"; reference:mitre,T1190; classtype:attempted-admin; sid:5210378; rev:1;)

# Confluence RCE (CVE-2023-22527 variant)
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Confluence Template Injection OGNL RCE"; flow:to_server,established; http.client_body; pcre:"/\$\{.*request|.*T\(java|.*Runtime\.getRuntime/Pi"; reference:mitre,T1190; classtype:attempted-admin; sid:5210379; rev:1;)

# GraphQL Introspection Abuse
alert http any any -> $HOME_NET any (msg:"ET RECON GraphQL Schema Introspection Query Detected"; flow:to_server,established; http.client_body; content:"__schema"; distance:0; content:"queryType"; distance:0; classtype:attempted-recon; sid:5210380; rev:1;)

# JWT Algorithm Confusion Attack
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT JWT Algorithm Confusion/None Algorithm Attack"; flow:to_server,established; http.header; content:"Authorization"; content:"Bearer"; distance:0; pcre:"/eyJ[^.]+\.eyJ[^.]+\./"; http.client_body; pcre:"/"alg"\s*:\s*"none"/Pi"; reference:mitre,T1190; classtype:attempted-user; sid:5210381; rev:1;)

# Deserialization Attack - Java
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Java Deserialization Attack Detected"; flow:to_server,established; http.header; content:"Content-Type"; content:"application/x-java-serialized-object"; distance:0; reference:mitre,T1190; classtype:attempted-admin; sid:5210382; rev:1;)

# Deserialization Attack - PHP
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT PHP Object Injection/Deserialization Attack"; flow:to_server,established; http.client_body; pcre:"/[Oo]:\d+:\"[^\"]+\":\d+:\{/Pi"; reference:mitre,T1190; classtype:attempted-user; sid:5210383; rev:1;)

# CORS Misconfiguration Exploitation
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT CORS Misconfiguration Origin Reflection Abuse"; flow:to_server,established; http.header; content:"Origin"; pcre:"/Origin:\s*https?:\/\/evil\.(com|xyz|io|top)/Pi"; reference:mitre,T1190; classtype:attempted-user; sid:5210384; rev:1;)

# Prototype Pollution
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT JavaScript Prototype Pollution Attack"; flow:to_server,established; http.client_body; pcre:"/__proto__|constructor\[|prototype\[.*\]\s*=/Pi"; reference:mitre,T1190; classtype:attempted-user; sid:5210385; rev:1;)

# HTTP Request Smuggling
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT HTTP Request Smuggling CL.TE Attack"; flow:to_server,established; http.header; content:"Content-Length"; distance:0; content:"Transfer-Encoding"; distance:0; pcre:"/Content-Length:\s*\d+.*Transfer-Encoding:\s*chunked/Pis"; reference:mitre,T1190; classtype:attempted-admin; sid:5210386; rev:1;)

# HTTP/2 Rapid Reset Attack
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT HTTP/2 Rapid Reset DoS Attack Pattern"; flow:to_server,established; threshold:type both, track by_src, count 100, seconds 5; reference:mitre,T1498; classtype:attempted-dos; sid:5210387; rev:1;)

# Cloud Metadata SSRF
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Cloud Instance Metadata SSRF Access Attempt"; flow:to_server,established; http.uri; pcre:"/(169\.254\.169\.254|metadata\.google|100\.100\.100\.200|metadata\.azure)/Pi"; reference:mitre,T1190; classtype:attempted-recon; sid:5210388; rev:1;)

# Container Escape via Host Mount
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Container Escape via Host Filesystem Mount"; flow:to_server,established; http.client_body; pcre:"/(docker|containerd|kubectl).*mount.*\/var\/run|volume.*hostPath.*\/var\/run/Pi"; reference:mitre,T1611; classtype:attempted-admin; sid:5210389; rev:1;)

# Kubernetes API Server Abuse
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Kubernetes API Server Unauthorized Access Attempt"; flow:to_server,established; http.uri; content:"/api/v1/"; nocase; content:"pods"; distance:0; http.header; pcre:"/Authorization:\s*(?:Bearer\s+(?:kubernetes|serviceaccount))/Pi"; reference:mitre,T1078; classtype:attempted-admin; sid:5210390; rev:1;)

# Redis Unauthorized Access
alert tcp any any -> $HOME_NET 6379 (msg:"ET EXPLOIT Redis Unauthorized Command Execution"; flow:to_server,established; content:"CONFIG"; content:"SET"; distance:0; content:"dir"; distance:0; reference:mitre,T1190; classtype:attempted-admin; sid:5210391; rev:1;)

# MongoDB Unauthorized Access
alert tcp any any -> $HOME_NET 27017 (msg:"ET EXPLOIT MongoDB Unauthorized Access Attempt"; flow:to_server,established; content:"admin"; content:"$cmd"; distance:0; reference:mitre,T1078; classtype:attempted-admin; sid:5210392; rev:1;)

# Elasticsearch RCE
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Elasticsearch RCE via _search Script Injection"; flow:to_server,established; http.uri; content:"/_search"; nocase; http.client_body; pcre:"/\"script\".*\"inline\".*Runtime\.getRuntime/Pi"; reference:mitre,T1190; classtype:attempted-admin; sid:5210393; rev:1;)

# Apache Struts RCE
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Apache Struts RCE via OGNL Injection"; flow:to_server,established; http.uri; content:".action"; nocase; http.header; pcre:"/Content-Type:.*%\{.*\}/Pi"; reference:mitre,T1190; classtype:attempted-admin; sid:5210394; rev:1;)

# Web Shell Upload Detection
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Web Shell Upload via Suspicious Extension"; flow:to_server,established; http.request_body; pcre:"/filename=.*\.(php[34567]?|phtml|phar|jsp|jspx|asp|aspx|cfm|cgi)\.(txt|jpg|png|gif|zip)/Pi"; reference:mitre,T1105; classtype:attempted-admin; sid:5210395; rev:1;)

# Reverse Shell via HTTP
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET TROJAN Reverse Shell Connection via HTTP"; flow:to_server,established; http.client_body; pcre:"/(bash\s+-i|nc\s+-e|\/bin\/sh|powershell.*-enc|python.*socket.*connect)/Pi"; reference:mitre,T1059; classtype:trojan-activity; sid:5210396; rev:1;)

# DNS Tunneling
alert dns any any -> any any (msg:"ET TROJAN DNS Tunneling via Excessive Subdomain Length"; dns.query; pcre:"/[a-zA-Z0-9]{40,}\.[a-z]{2,}/i"; threshold:type both, track by_src, count 10, seconds 60; reference:mitre,T1071.004; classtype:trojan-activity; sid:5210397; rev:1;)

# DNS TXT Record Data Exfiltration
alert dns any any -> any any (msg:"ET EXPLOIT DNS TXT Record Data Exfiltration"; dns.query; pcre:"/[a-f0-9]{32,}\./i"; dns.queries; threshold:type both, track by_src, count 5, seconds 60; reference:mitre,T1048; classtype:attempted-admin; sid:5210398; rev:1;)

# ICMP Tunneling
alert icmp any any -> any any (msg:"ET TROJAN ICMP Tunneling Detection via Large Payload"; dsize:>200; threshold:type both, track by_src, count 10, seconds 60; reference:mitre,T1095; classtype:trojan-activity; sid:5210399; rev:1;)

# SQL Injection - Time-Based Blind
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Time-Based Blind SQL Injection Attempt"; flow:to_server,established; http.uri; pcre:"/(SLEEP|WAITFOR|DELAY|BENCHMARK)\s*\(\s*\d+/Pi"; reference:mitre,T1190; classtype:attempted-user; sid:5210400; rev:1;)