alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1485 Mass File Deletion Wiper Malware Pattern"; flow:established; content:"rm -rf"; nocase; content:"/"; threshold:type both, track by_src, count 10, seconds 30; classtype:trojan-activity; sid:52082272; rev:1;)

# === MITRE ATT&CK T1562 - Impair Defenses ===
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1562 Windows Defender Disable via PowerShell Command"; flow:established; content:"Set-MpPreference"; nocase; content:"-DisableRealtimeMonitoring"; nocase; classtype:trojan-activity; sid:52082273; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1562 iptables Firewall Rule Flush via Shell Command"; flow:established; content:"iptables"; nocase; content:"-F"; classtype:trojan-activity; sid:52082274; rev:1;)

# === MITRE ATT&CK T1219 - Remote Access Software ===
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1219 AnyDesk Remote Access Tool C2 Communication"; flow:established,to_server; tls.sni; content:"anydesk"; nocase; classtype:trojan-activity; sid:52082275; rev:1;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1219 TeamViewer Remote Access Anomalous Outbound Connection"; flow:established,to_server; tls.sni; content:"teamviewer"; nocase; classtype:trojan-activity; sid:52082276; rev:1;)

# === MITRE ATT&CK T1105 - Ingress Tool Transfer ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1105 Suspicious Executable Download from File Sharing Service"; flow:established,to_server; http.host; content:"transfer.sh"; http.response_body; content:"MZ"; classtype:trojan-activity; sid:52082277; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1105 Malware Payload Download via Discord CDN"; flow:established,to_server; http.host; content:"cdn.discordapp.com"; http.uri; content:".exe"; nocase; classtype:trojan-activity; sid:52082278; rev:1;)

# === MITRE ATT&CK T1490 - Inhibit System Recovery ===
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1490 VSS Delete Shadow Copies via vssadmin"; flow:established; content:"vssadmin"; nocase; content:"delete"; nocase; content:"shadows"; nocase; classtype:trojan-activity; sid:52082279; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1490 WBADMIN Delete System Backup Catalog"; flow:established; content:"wbadmin"; nocase; content:"delete"; content:"catalog"; nocase; classtype:trojan-activity; sid:52082280; rev:1;)

# === MITRE ATT&CK T1136 - Create Account ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1136 New User Account Creation via NET USER Command"; flow:established,to_server; http.request_body; content:"net user"; nocase; content:"/add"; nocase; classtype:trojan-activity; sid:52082281; rev:1;)

# === MITRE ATT&CK T1543 - Create or Modify System Process ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1543 systemd Service File Creation via Web Shell"; flow:established,to_server; http.request_body; content:"/etc/systemd/system/"; content:".service"; nocase; classtype:trojan-activity; sid:52082282; rev:1;)

# === MITRE ATT&CK T1572 - Protocol Tunneling ===
alert tls $HOME_NET any -> $EXTERNAL_NET 443 (msg:"MITRE T1572 TLS Tunneling via DNS-over-HTTPS Protocol Tunnel"; flow:established,to_server; http.host; content:"dns.google"; http.uri; content:"/resolve"; threshold:type both, track by_src, count 100, seconds 60; classtype:trojan-activity; sid:52082283; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"MITRE T1572 SSH over TLS Tunneling Protocol Encapsulation"; flow:established,to_server; content:"SSH-"; depth:4; classtype:trojan-activity; sid:52082284; rev:1;)

# === MITRE ATT&CK T1090 - Proxy ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1090 Tor Exit Node Traffic Detection via Known Tor Relay"; flow:established,to_server; http.host; content:"torproject"; nocase; classtype:trojan-activity; sid:52082285; rev:1;)

# === MITRE ATT&CK T1055 - Process Injection ===
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1055 Process Injection via CreateRemoteThread API Call Pattern"; flow:established; content:"CreateRemoteThread"; nocase; content:"VirtualAllocEx"; nocase; classtype:trojan-activity; sid:52082286; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1055 DLL Injection via LoadLibrary API Pattern"; flow:established; content:"LoadLibrary"; nocase; content:"WriteProcessMemory"; nocase; classtype:trojan-activity; sid:52082287; rev:1;)

# === MITRE ATT&CK T1048 - Exfiltration Over Alternative Protocol ===
alert http $HOME_NET any -> $EXTERNAL_NET 443 (msg:"MITRE T1048 Data Exfiltration via HTTPS POST to Unknown External Server"; flow:established,to_server; http.method; content:"POST"; dsize:>5000000; threshold:type both, track by_src, count 1, seconds 300; classtype:exfiltration; sid:52082288; rev:1;)
alert dns $HOME_NET any -> $EXTERNAL_NET 53 (msg:"MITRE T1048 DNS Exfiltration via Long Query Name Base64 Encoding"; dns.query.name; pcre:"/^[A-Za-z0-9+/]{60,}=/"; classtype:exfiltration; sid:52082289; rev:1;)

# === MITRE ATT&CK T1068 - Exploitation for Privilege Escalation ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1068 Kernel Exploit via Dirty Pipe Vulnerability Pattern"; flow:established,to_server; http.request_body; content:"/proc/self/mem"; content:"pipe"; nocase; classtype:attempted-privilege-escalation; sid:52082290; rev:1;)

# === MITRE ATT&CK T1555 - Credentials from Password Stores ===
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1555 Browser Credential Theft via Chromium Login Data Access"; flow:established; content:"Login Data"; content:"Chrome"; nocase; classtype:trojan-activity; sid:52082291; rev:1;)

# === MITRE ATT&CK T1112 - Modify Registry ===
