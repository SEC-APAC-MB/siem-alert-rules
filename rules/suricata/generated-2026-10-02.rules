# === MITRE ATT&CK T1571 - Non-Standard Port ===
alert tcp $HOME_NET any -> $EXTERNAL_NET 1337 (msg:"MITRE T1571 Non-Standard Port C2 Communication on 1337"; flow:established,to_server; classtype:trojan-activity; sid:52082293; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 4444 (msg:"MITRE T1571 Non-Standard Port C2 Communication on 4444"; flow:established,to_server; classtype:trojan-activity; sid:52082294; rev:1;)

# === MITRE ATT&CK T1098 - Account Manipulation ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1098 Account Manipulation Add to Admin Group via Net Command"; flow:established,to_server; http.request_body; content:"net localgroup"; nocase; content:"administrators"; nocase; content:"/add"; nocase; classtype:trojan-activity; sid:52082295; rev:1;)

# === MITRE ATT&CK T1204 - User Execution ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1204 Malicious LNK File Delivery via HTTP Download"; flow:established,to_server; http.content_type; content:"application/octet-stream"; http.request_filename; content:".lnk"; nocase; classtype:trojan-activity; sid:52082296; rev:1;)

# === MITRE ATT&CK T1020 - Automated Collection ===
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1020 Automated File Collection via Robocopy Mass Copy Pattern"; flow:established; content:"robocopy"; nocase; content:"/E"; content:"/MIR"; classtype:exfiltration; sid:52082297; rev:1;)

# === MITRE ATT&CK T1568 - Dynamic Resolution ===
alert dns $HOME_NET any -> $EXTERNAL_NET 53 (msg:"MITRE T1568 Dynamic DNS Domain Fast Flux Detection"; dns.query.name; pcre:"/\.ddns\.|\.dyndns\./i"; threshold:type both, track by_src, count 20, seconds 60; classtype:trojan-activity; sid:52082298; rev:1;)

# === MITRE ATT&CK T1059.004 - Unix Shell ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1059.004 Unix Reverse Shell via Netcat Command Injection"; flow:established,to_server; http.request_body; content:"nc -e"; content:"/bin/sh"; classtype:trojan-activity; sid:52082299; rev:1;)
