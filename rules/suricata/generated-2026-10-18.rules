alert http any any -> any any (msg:"Web App Security - SSRF via URL Parameter to Internal IP"; flow:established,to_server; http.uri; pcre:"/(?:url|redirect|target|dest|return)=(?:https?:)?\/\/(?:127\.0\.0\.1|localhost|10\.|192\.168\.|172\.(?:1[6-9]|2[0-9]|3[01])\.)/i"; classtype:web-application-attack; sid:521277992; rev:1;)
