# ---- MITRE ATT&CK Technique-Based Rules ----

# T1059.001 - PowerShell Empire/Stager Detection
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET TROJAN PowerShell stager download from suspicious domain"; flow:established,to_server; http.user_agent; content:"PowerShell"; nocase; http.uri; content:".ps1"; nocase; reference:url,attack.mitre.org/techniques/T1059/001/; classtype:trojan-activity; sid:5000626; rev:1;)

# T1071.001 - Application Layer Protocol: Web Protocols - C2 via HTTPS
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"ET TROJAN potential HTTPS C2 with suspicious TLS SNI pattern - long random subdomain"; tls.sni; pcre:"/^[a-z0-9]{12,}\.[a-z0-9]{4,}\./i"; reference:url,attack.mitre.org/techniques/T1071/001/; classtype:trojan-activity; sid:5000627; rev:1;)

# T1566.001 - Phishing: Spearphishing Attachment - Macro Document
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET PHISHING macro-enabled document download with suspicious VBA indicators"; flow:established,to_client; file_data; content:"Sub "; content:"End Sub"; content:"AutoOpen"; nocase; reference:url,attack.mitre.org/techniques/T1566/001/; classtype:trojan-activity; sid:5000628; rev:1;)

# T1053.005 - Scheduled Task/Job: Scheduled Task - Suspicious schtasks
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK_SCHEDULE Suspicious scheduled task creation via remote schtasks command"; flow:established,to_server; content:"schtasks"; nocase; content:"/create"; nocase; reference:url,attack.mitre.org/techniques/T1053/005/; classtype:attempted-admin; sid:5000629; rev:1;)

# T1110.001 - Brute Force: Password Guessing - HTTP Auth
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET ATTACK_BRUTE Rapid HTTP basic authentication failures from single source"; flow:established,to_server; http.stat_code; content:"401"; threshold:type threshold,track by_src,count 10,seconds 60; reference:url,attack.mitre.org/techniques/T1110/001/; classtype:attempted-admin; sid:5000630; rev:1;)

# T1190 - Exploit Public-Facing Application - Web App Attack
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB_SERVER Exploit attempt against public-facing application - multiple attack patterns"; flow:established,to_server; http.uri; pcre:"/(?:union.*select|exec.*xp_|\.htaccess|wp-config\.php|/etc/passwd|/proc/self)/i"; reference:url,attack.mitre.org/techniques/T1190/; classtype:web-application-attack; sid:5000631; rev:1;)

# T1078.002 - Valid Accounts: Domain Accounts - Unusual Login
