# === MITRE ATT&CK T1133: External Remote Services ===
alert tcp $EXTERNAL_NET any -> $HOME_NET 3389 (msg:"MITRE T1133 External RDP connection from non-corporate IP range"; flow:to_server; flags:S; classtype:trojan-activity; sid:521280273; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"MITRE T1133 External SSH brute force from non-corporate IP"; flow:to_server; flags:S; detection_filter:track by_src, count 10, seconds 60; classtype:attempted-admin; sid:521280274; rev:1;)

# === MITRE ATT&CK T1486: Data Encrypted for Impact ===
alert http any any -> any any (msg:"MITRE T1486 Ransomware indicator - mass file extension change to .locked"; flow:to_server; pcre:"/\.(locked|encrypted|crypto|ransom|locky)/Ui"; detection_filter:track by_src, count 50, seconds 60; classtype:trojan-activity; sid:521280275; rev:1;)

# === MITRE ATT&CK T1490: Inhibit System Recovery ===
alert http any any -> any any (msg:"MITRE T1490 vssadmin delete shadows via web shell command injection"; flow:to_server; pcre:"/vssadmin\s+delete\s+shadows/i"; classtype:trojan-activity; sid:521280276; rev:1;)
alert http any any -> any any (msg:"MITRE T1490 wbadmin delete system state backup via web shell"; flow:to_server; pcre:"/wbadmin\s+delete\s+(systemstatebackup|catalog)/i"; classtype:trojan-activity; sid:521280277; rev:1;)

# === MITRE ATT&CK T1566: Phishing ===
alert http any any -> any any (msg:"MITRE T1566.002 Spearphishing link - credential harvesting fake login page"; flow:to_server; content:"/login"; nocase; pcre:"/(google|office365|microsoft|outlook|aws)[^-]*\.(tk|ml|ga|cf|gq|xyz)/Ui"; classtype:trojan-activity; sid:521280278; rev:1;)

# === MITRE ATT&CK T1027: Obfuscated Files or Information ===
alert http any any -> any any (msg:"MITRE T1027 Base64 encoded payload in web request parameter"; flow:to_server; pcre:"/[?&]\w+=([A-Za-z0-9+\/]{200,}={0,2})/Ui"; classtype:trojan-activity; sid:521280279; rev:1;)
alert http any any -> any any (msg:"MITRE T1027.013 Hex encoding obfuscation in URI path"; flow:to_server; pcre:"/%(2[0-9a-f]|3[0-9a-f]|4[0-9a-f]|5[0-9a-f]|[67][0-9a-f])/i"; detection_filter:track by_src, count 30, seconds 10; classtype:trojan-activity; sid:521280280; rev:1;)

# === MITRE ATT&CK T1620: Reflective Code Loading ===
alert http any any -> any any (msg:"MITRE T1620 Reflective DLL loading via web shell - memory injection pattern"; flow:to_server; pcre:"/(VirtualAlloc|WriteProcessMemory|CreateRemoteThread|NtMapViewOfSection)/Ui"; classtype:trojan-activity; sid:521280281; rev:1;)

# === MITRE ATT&CK T1555: Credentials from Password Stores ===
alert http any any -> any any (msg:"MITRE T1555.003 Chrome credential theft via web shell access to Login Data"; flow:to_server; pcre:"/(Login\s*Data|Cookies|Local\s*State)/Ui"; content:"Chrome"; nocase; classtype:trojan-activity; sid:521280282; rev:1;)

# === MITRE ATT&CK T1572: Protocol Tunneling ===
alert tcp any any -> any 443 (msg:"MITRE T1572 Protocol tunneling - non-TLS traffic on port 443"; flow:to_server; flags:S; pcre:"/^\x16\x03/"; classtype:trojan-activity; sid:521280283; rev:1;)

# === MITRE ATT&CK T1090: Proxy ===
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1090.001 Internal traffic to known TOR exit node"; flow:to_server; pcre:"/(tor|exit-node|relay)/i"; classtype:trojan-activity; sid:521280284; rev:1;)

# === MITRE ATT&CK T1568: Dynamic Resolution ===
alert dns $HOME_NET any -> any 53 (msg:"MITRE T1568.001 Fast flux domain - rapid DNS A record changes"; dns.query; pcre:"/[a-z0-9-]+\.(ru|cn|tk|ml|xyz|top)/i"; detection_filter:track by_src, count 10, seconds 60; classtype:trojan-activity; sid:521280285; rev:1;)

# === MITRE ATT&CK T1505: Server Software Component ===
alert http any any -> any any (msg:"MITRE T1505.003 Web shell upload - PHP file with suspicious function names"; flow:to_server; pcre:"/(eval|assert|system|exec|passthru|shell_exec|base64_decode)\s*\(/Ui"; content:".php"; nocase; classtype:trojan-activity; sid:521280286; rev:1;)
alert http any any -> any any (msg:"MITRE T1505.003 Web shell detection - common webshell names in upload"; flow:to_server; pcre:"/(c99|r57|wso|shell|b374k|indoxploit|weevely)\.php/i"; classtype:trojan-activity; sid:521280287; rev:1;)

# === MITRE ATT&CK T1210: Exploitation of Remote Services ===
alert tcp any any -> any 445 (msg:"MITRE T1210 SMB exploit attempt - suspicious SMB1 negotiate pattern"; flow:to_server; pcre:"/\xffSMB/u"; dsize:>100; classtype:attempted-admin; sid:521280288; rev:1;)

# === MITRE ATT&CK T1055: Process Injection ===
alert http any any -> any any (msg:"MITRE T1055 Process injection via LD_PRELOAD in web request"; flow:to_server; pcre:"/LD_PRELOAD\s*=/Ui"; classtype:trojan-activity; sid:521280289; rev:1;)

# === MITRE ATT&CK T1547: Boot or Logon Autostart Execution ===
alert http any any -> any any (msg:"MITRE T1547.001 Registry Run key modification via web shell reg add"; flow:to_server; pcre:"/reg\s+add\s+.*\\(Run|RunOnce)/i"; classtype:trojan-activity; sid:521280290; rev:1;)
alert http any any -> any any (msg:"MITRE T1547.006 Kernel module loading via web shell insmod"; flow:to_server; pcre:"/(insmod|modprobe)\s+\S+\.ko/Ui"; classtype:trojan-activity; sid:521280291; rev:1;)

# === MITRE ATT&CK T1550: Use Alternate Authentication Material ===
alert tcp any any -> any 88 (msg:"MITRE T1550.002 Kerberos golden ticket - AS-REQ with pre-auth bypass pattern"; flow:to_server; pcre:"/\x6e\x82/u"; classtype:attempted-admin; sid:521280292; rev:1;)

# === MITRE ATT&CK T1485: Data Destruction ===
alert http any any -> any any (msg:"MITRE T1485 Data destruction - rm -rf via web shell command injection"; flow:to_server; pcre:"/rm\s+-rf\s+\//Ui"; classtype:trojan-activity; sid:521280293; rev:1;)
alert http any any -> any any (msg:"MITRE T1485 Data destruction - shred command via web shell"; flow:to_server; pcre:"/shred\s+-u\s+-z/i"; classtype:trojan-activity; sid:521280294; rev:1;)

# === MITRE ATT&CK T1136: Create Account ===
alert http any any -> any any (msg:"MITRE T1136.001 Account creation - useradd via web shell injection"; flow:to_server; pcre:"/useradd\s+-m?\s+-[a-z]*\s+/Ui"; classtype:trojan-activity; sid:521280295; rev:1;)
alert http any any -> any any (msg:"MITRE T1136.002 Windows account creation via net user in web request"; flow:to_server; pcre:"/net\s+user\s+\S+\s+\S+\s+\/add/i"; classtype:trojan-activity; sid:521280296; rev:1;)

# === MITRE ATT&CK T1070: Indicator Removal ===
alert http any any -> any any (msg:"MITRE T1070.002 Clear command history via web shell - history deletion"; flow:to_server; pcre:"/(history\s+-c|unset\s+HISTFILE|cat\s+\/dev\/null\s*>\s*~\/\.bash_history)/Ui"; classtype:trojan-activity; sid:521280297; rev:1;)
alert http any any -> any any (msg:"MITRE T1070.004 File deletion - mass rm via web shell on log files"; flow:to_server; pcre:"/rm\s+.*(\/var\/log|\.log|syslog|messages)/Ui"; classtype:trojan-activity; sid:521280298; rev:1;)

# === Current threat landscape: AI/LLM attacks ===
alert http any any -> any any (msg:"AI LLM prompt injection - attempt to override system instructions via user input"; flow:to_server; content:"/chat/completions"; nocase; pcre:"/(ignore\s+(previous|above|all)\s+instructions|disregard\s+(your|the)\s+(system|rules|guidelines))/Ui"; classtype:web-application-attack; sid:521280299; rev:1;)
alert http any any -> any any (msg:"AI LLM data exfiltration - sensitive data request via crafted prompt"; flow:to_server; content:"/api/v1/prompt"; nocase; pcre:"/(reveal|show|print|output)\s+(your|the|system|api|secret|key|token|password)/Ui"; classtype:web-application-attack; sid:521280300; rev:1;)
