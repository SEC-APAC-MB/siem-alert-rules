alert dns $HOME_NET any -> $EXTERNAL_NET 53 (msg:"MITRE T1008 Fallback channel - DNS TXT record C2 communication"; dns.query.name; pcre:"/[a-z0-9](40,)\./i"; dns.query.type; content:"TXT"; classtype:trojan-activity; sid:521294288; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1132.001 Data encoding base64 - exfiltration with base64 in URI"; flow:established,to_server; http.uri; pcre:"/[A-Za-z0-9+](50,)=(0, 2)/"; classtype:exfiltration; sid:521294289; rev:1;)
alert smb $HOME_NET any -> $EXTERNAL_NET 445 (msg:"MITRE T1039 Data from network shared drive - bulk SMB file read"; flow:established; content:"READ"; dsize:>5000000; classtype:exfiltration; sid:521294290; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1119 Automated collection - batch file archive creation"; flow:established,to_server; http.request_body; content:"tar"; nocase; content:"-czf"; nocase; content:"/home"; nocase; classtype:exfiltration; sid:521294291; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1567.001 Exfiltration to code repository - git push to untrusted host"; flow:established,to_server; http.host; pcre:"/(gitlab\.io|bitbucket\.io|github\.io)/i"; http.method; content:"POST"; dsize:>500000; classtype:exfiltration; sid:521294292; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1498.001 Network denial of service - SYN flood"; flags:S; detection_filter:track_src_ip,count:500,seconds:10; classtype:attempted-dos; sid:521294293; rev:1;)
alert udp $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1498.002 Network DoS reflection amplification - UDP flood"; detection_filter:track_src_ip,count:100,seconds:5; dsize:>500; classtype:attempted-dos; sid:521294294; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1199 Trusted relationship exploitation - MSP remote access"; flow:established,to_server; http.user_agent; content:"AnyDesk"; nocase; classtype:trojan-activity; sid:521294295; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1580 Cloud infrastructure discovery - AWS describe-instances via web"; flow:established,to_server; http.request_body; content:"describe-instances"; nocase; content:"aws ec2"; nocase; classtype:attempted-recon; sid:521294296; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1578.002 Create cloud VM - unauthorized instance launch"; flow:established,to_server; http.request_body; content:"run-instances"; nocase; content:"aws ec2"; nocase; classtype:attempted-admin; sid:521294297; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1578.005 Modify cloud compute infra - security group modification"; flow:established,to_server; http.request_body; content:"authorize-security-group-ingress"; nocase; classtype:attempted-admin; sid:521294298; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1087.004 Cloud account discovery - IAM list-users enumeration"; flow:established,to_server; http.request_body; content:"list-users"; nocase; content:"aws iam"; nocase; classtype:attempted-recon; sid:521294299; rev:1;)
