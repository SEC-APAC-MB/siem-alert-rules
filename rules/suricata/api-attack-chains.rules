# =============================================================================
# Suricata Rules — API Attack Chain Detection
# Detects multi-step API exploitation sequences: GraphQL introspection → depth bomb,
#          IDOR → BOLA mass enumeration → PII extraction, JWT → admin → mass access,
#          OAuth token theft → cross-service takeover, API key leak → privilege escalation
# Total rules: 15
# SID range: 2310001 - 2310015
# Reference: MITRE ATT&CK TA0001 Initial Access → TA0006 Credential Access → TA0010 Exfiltration
# =============================================================================

# --- GraphQL Introspection → Schema Dump → Depth Bomb → Data Extraction ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN API-001: GraphQL Introspection Query - Schema Enumeration Phase"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/graphql\b/i"; http_uri; pcre:"/\{\"query\"\s*:\s*\"[\s{]*(IntrospectionQuery|__schema|__type|__directive)/i"; http_client_body; classtype:web-application-attack; sid:2310001; rev:1; metadata:chain graphql-introspection-to-data-theft, mitre T1592, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN API-002: GraphQL Depth Bomb Attack - Excessively Nested Query for DoS or Data Extraction"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/graphql\b/i"; http_uri; pcre:"/\{\"query\"\s*:\s*\"[\s{]*\{[^}]*(\{[^}]*(\{[^}]*(\{[^}]*(\{[^}]*){3,})*)*)/i"; http_client_body; dsize:>5000; classtype:web-application-attack; sid:2310002; rev:1; metadata:chain graphql-depth-bomb, mitre T1190, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN API-003: GraphQL Mass Data Extraction - Bulk PII Fields in Response After Introspection"; flow:established,to_client; content:"200"; http_stat_code; pcre:"/\"(email|ssn|social_security|phone|address|date_of_birth|credit_card|bank_account|passport|tax_id)\"/i"; http_response_body; pcre:"/\"(users?|accounts?|customers?|employees?|patients?)\"/i"; http_response_body; dsize:>100000; classtype:web-application-attack; sid:2310003; rev:1; metadata:chain graphql-data-extraction, mitre T1530, created_at 2026_08_21;)

# --- IDOR → BOLA Mass Enumeration → PII Extraction ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN API-004: IDOR Sequential Enumeration - Auto-Incrementing IDs in API Requests"; flow:established,to_server; pcre:"/\/api\/v[0-9]+\/(users?|accounts?|orders?|transactions?|profiles?|records?)\/\d{4,}/i"; http_uri; threshold:type both, track by_src, count 20, seconds 60; classtype:web-application-attack; sid:2310004; rev:1; metadata:chain idor-to-bola, mitre T1190, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN API-005: BOLA Mass Enumeration - UUID Pattern with Sequential Different UUIDs per Request"; flow:established,to_server; pcre:"/\/api\/v[0-9]+\/(users?|accounts?|records?)\/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/i"; http_uri; threshold:type both, track by_src, count 30, seconds 120; classtype:web-application-attack; sid:2310005; rev:1; metadata:chain idor-to-bola, mitre T1190, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN API-006: BOLA PII Mass Extraction - Sensitive Fields in API Response After Enumeration"; flow:established,to_client; content:"200"; http_stat_code; pcre:"/\"(email|ssn|social_security|phone|address|date_of_birth|credit_card|bank_account)\"/i"; http_response_body; pcre:"/\[[\s\S]{1000,}\]/i"; http_response_body; classtype:web-application-attack; sid:2310006; rev:1; metadata:chain bola-to-pii-extraction, mitre T1530, created_at 2026_08_21;)

# --- JWT None Algorithm → Admin Role Assignment → Mass Data Access ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN API-007: JWT None Algorithm Bypass - Algorithm Confusion in Authorization Header"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer eyJ"; http_header; pcre:"/eyJ[a-zA-Z0-9_-]+\.eyJ[a-zA-Z0-9_-]+\.(eyJ[a-zA-Z0-9_-]+)?/i"; http_header; pcre:"/\"alg\"\s*:\s*\"(none|None|NONE|nOnE)\"/i"; http_header; classtype:web-application-attack; sid:2310007; rev:1; metadata:chain jwt-none-to-admin, mitre T1606, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN API-008: JWT RS256→HS256 Algorithm Confusion - HMAC Key Recovery Attack"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer eyJ"; http_header; pcre:"/eyJ[a-zA-Z0-9_-]+\.eyJ[a-zA-Z0-9_-]+\.[a-zA-Z0-9_-]+/i"; http_header; pcre:"/\"alg\"\s*:\s*\"HS(256|384|512)\".*\"kid\"\s*:/i"; http_header; classtype:web-application-attack; sid:2310008; rev:1; metadata:chain jwt-algorithm-confusion, mitre T1606, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN API-009: JWT Admin Privilege Escalation - Elevated Role Claim in Token After Auth Bypass"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer eyJ"; http_header; pcre:"/\"(role|isAdmin|privilege|permissions?|access_level)\"\s*:\s*\"?(admin|superadmin|administrator|root|system|elevated|super)\"?/i"; http_uri; pcre:"/\/api\/v[0-9]+\/(users?|accounts?|records?|export|download|backup|dump)/i"; http_uri; classtype:web-application-attack; sid:2310009; rev:1; metadata:chain jwt-admin-to-mass-access, mitre T1606, created_at 2026_08_21;)

# --- OAuth Token Theft → Token Replay → Cross-Service Account Takeover ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN API-010: OAuth Authorization Code Interception - Code in Referer or Redirect URI"; flow:established,to_server; pcre:"/[?&]code=[A-Za-z0-9_-]{20,}/i"; http_uri; content:"Referer"; http_header; pcre:"/[?&]code=[A-Za-z0-9_-]{20,}/i"; http_header; classtype:web-application-attack; sid:2310010; rev:1; metadata:chain oauth-code-interception, mitre T1187, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN API-011: OAuth PKCE Downgrade - Code Verifier Absent or Weak in Token Exchange"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(oauth|auth)\/token/i"; http_uri; pcre:"/(grant_type=authorization_code|code=[A-Za-z0-9_-]+)/i"; http_client_body; pcre:"/redirect_uri=[^&]+.*(?:&|$)/i"; http_client_body; content:!"code_verifier"; classtype:web-application-attack; sid:2310011; rev:1; metadata:chain oauth-pkce-downgrade, mitre T1187, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN API-012: OAuth Token Replay Across Services - Same Token on Different Endpoints"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer eyJ"; http_header; pcre:"/\/api\/v[0-9]+\/(auth|login|oauth|token)/i"; http_uri; threshold:type both, track by_src, count 5, seconds 300; classtype:web-application-attack; sid:2310012; rev:1; metadata:chain oauth-token-replay, mitre T1187, created_at 2026_08_21;)

# --- API Key Leak → Unauthorized Access → Privilege Escalation → Data Dump ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN API-013: API Key Exposure in HTTP Response - AWS/GCP/Azure/Stripe Key Pattern"; flow:established,to_client; pcre:"/(AKIA[A-Z0-9]{16}|AIza[A-Za-z0-9_-]{35}|sk_live_[A-Za-z0-9]{24,}|sk_test_[A-Za-z0-9]{24,}|rhk_[A-Za-z0-9]{20,}|key-[A-Za-z0-9]{32,})/i"; http_response_body; classtype:web-application-attack; sid:2310013; rev:1; metadata:chain api-key-exposure, mitre T1552, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN API-014: API Key Unauthorized Access - Leaked Key Used for Privileged API Endpoint"; flow:established,to_server; pcre:"/\/api\/v[0-9]+\/(admin|config|settings|users?|accounts?|export|download|backup)/i"; http_uri; pcre:"/(api[_-]?key|apikey|key|token|access_key)\s*=\s*[A-Za-z0-9_-]{20,}/i"; http_uri; classtype:web-application-attack; sid:2310014; rev:1; metadata:chain api-key-to-privilege-escalation, mitre T1078, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN API-015: Mass Data Export via Compromised API Key - Bulk Download After Privilege Escalation"; flow:established,to_server; content:"GET"; http_method; pcre:"/\/api\/v[0-9]+\/(export|download|backup|dump|report|generate)/i"; http_uri; pcre:"/(api[_-]?key|apikey|key|token)\s*=\s*[A-Za-z0-9_-]{20,}/i"; http_uri; dsize:>1000000; classtype:web-application-attack; sid:2310015; rev:1; metadata:chain api-key-to-data-dump, mitre T1537, created_at 2026_08_21;)