alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET ATTACK Archive Collection Before Exfil T1560.001"; flow:established,to_server; http.method; content:"POST"; http.request_body; pcre:"/(?:tar\s+czf|zip\s+-r|7z\s+a|rar\s+a)\s+/Pi"; reference:url,attack.mitre.org/techniques/T1560/001; classtype:trojan-activity; sid:5204298; rev:1;)

# --- MITRE ATT&CK T1572: Protocol Tunneling ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET ATTACK Protocol Tunneling DNS-over-HTTPS T1572"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"dns-query"; pcre:"/\/dns-query\?(?:name|type)=/Pi"; reference:url,attack.mitre.org/techniques/T1572; classtype:trojan-activity; sid:5204299; rev:1;)

# --- MITRE ATT&CK T1218.011: System Binary Proxy Execution - Rundll32 ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET ATTACK Rundll32 Proxy Execution T1218.011"; flow:established,to_server; http.method; content:"POST"; http.request_body; pcre:"/rundll32\.exe\s+(?:\S+\.dll|javascript|mshtml|mshta)/Pi"; reference:url,attack.mitre.org/techniques/T1218/011; classtype:trojan-activity; sid:5204300; rev:1;)