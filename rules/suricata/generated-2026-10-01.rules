alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1562.001 Windows Defender disable via Set-MpPreference"; flow:established; pcre:"/Set-MpPreference\s+-DisableRealtimeMonitoring\s+\$true/i"; classtype:defense-evasion; sid:52081590; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1562.001 Windows Defender exclusion path addition"; flow:established; pcre:"/Add-MpPreference\s+-ExclusionPath/i"; classtype:defense-evasion; sid:52081591; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 3333 (msg:"MITRE T1496 Cryptominer Stratum protocol mining pool"; flow:established,to_server; content:"mining.subscribe"; nocase; classtype:trojan-activity; sid:52081592; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 14444 (msg:"MITRE T1496 Cryptominer XMRig default pool port"; flow:established,to_server; classtype:trojan-activity; sid:52081593; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"MITRE T1059.004 Reverse shell via bash to external host"; flow:established,to_server; content:"bash -i"; nocase; content:"/dev/tcp"; nocase; distance:0; within:30; classtype:trojan-activity; sid:52081594; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1059.004 Netcat reverse shell outbound"; flow:established,to_server; content:"nc "; nocase; content:"-e"; nocase; distance:0; within:10; classtype:trojan-activity; sid:52081595; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1105 Tool transfer via curl from external source"; flow:established,to_server; content:"curl"; nocase; content:"-o"; nocase; distance:0; within:10; pcre:"/http:\/\/|https:\/\//i"; classtype:trojan-activity; sid:52081596; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1105 Tool transfer via wget from external source"; flow:established,to_server; content:"wget"; nocase; pcre:"/http:\/\/|https:\/\//i"; classtype:trojan-activity; sid:52081597; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1087.001 Local account enumeration via passwd read"; flow:established; pcre:"/cat\s+\/etc\/passwd|getent\s+passwd/i"; classtype:discovery; sid:52081598; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1087.002 Domain account enumeration via net user"; flow:established; pcre:"/net\s+user\s+\/domain|dsquery\s+\*\s+-scope\s+subtree/i"; classtype:discovery; sid:52081599; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1069.002 Cloud group enumeration via AWS IAM API"; flow:established,to_server; http_uri; content:"/iam/"; nocase; content:"ListGroups"; nocase; classtype:discovery; sid:52081600; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1218.011 Rundll32 suspicious DLL execution from temp"; flow:established; pcre:"/rundll32\s+.*(temp|appdata|programdata)/i"; classtype:defense-evasion; sid:52081601; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1218.005 Mshta executing remote HTA payload"; flow:established; pcre:"/mshta\s+(http|https|ftp):\/\//i"; classtype:defense-evasion; sid:52081602; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1218.010 Regsvr32 scrobj.dll remote script execution"; flow:established; pcre:"/regsvr32\s+.*scrobj\.dll/i"; classtype:defense-evasion; sid:52081603; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1190 SQL injection UNION-based attack"; flow:established,to_server; http_uri; pcre:"/UNION\s+SELECT|UNION\s+ALL\s+SELECT/i"; classtype:web-application-attack; sid:52081604; rev:1;)
