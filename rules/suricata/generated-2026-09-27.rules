# --- MITRE ATT&CK T1046 - Network Service Scanning
alert tcp any any -> any any (msg:"MITRE T1046 Network Service Scanning - Sequential Port Sweep"; flow:stateless; detection_filter:track by_src, count 20, seconds 10; flags:S; reference:url,attack.mitre.org/techniques/T1046/; classtype:network-scan; sid:5208544; rev:1;)

# --- MITRE ATT&CK T1090 - Proxy
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1090 Connection via Known Proxy Port - SOCKS4"; flow:established; pcre:"/^(\x04[\x01-\x05])/"; dsize:8; reference:url,attack.mitre.org/techniques/T1090/; classtype:trojan-activity; sid:5208545; rev:1;)

# --- MITRE ATT&CK T1059 - Command and Scripting Interpreter
alert dns any any -> any any (msg:"MITRE T1059 Command and Scripting - DNS Tunneling via Base64 TXT Queries"; dns.query.name; pcre:"/[a-zA-Z0-9+\/]{60,}={0,2}\./"; dns.query.type; content:"TXT"; reference:url,attack.mitre.org/techniques/T1059/; classtype:trojan-activity; sid:5208546; rev:1;)

# --- MITRE ATT&CK T1071.001 - Web Protocols
alert http any any -> any any (msg:"MITRE T1071.001 C2 Communication via Telegram API from Server"; flow:established,to_server; http.host; content:"api.telegram.org"; nocase; http.request_body; pcre:"/(sendMessage|getUpdates|sendDocument)/"; reference:url,attack.mitre.org/techniques/T1071/001/; classtype:trojan-activity; sid:5208547; rev:1;)

# --- MITRE ATT&CK T1568.002 - DGA
alert dns any any -> any any (msg:"MITRE T1568.002 DGA Detection - High Entropy Domain Query"; dns.query.name; pcre:"/^[a-z0-9]{15,}\.(xyz|top|click|loan|work|date|review|stream)$/"; reference:url,attack.mitre.org/techniques/T1568/002/; classtype:trojan-activity; sid:5208548; rev:1;)

# --- MITRE ATT&CK T1190 - Exploit Public-Facing Application
alert http any any -> any any (msg:"MITRE T1190 Exploit Public Application - Suspicious User-Agent with Exploit Tool"; flow:established,to_server; http.user_agent; pcre:"/(masscan|nuclei|sqlmap|nikto|wpscan|metasploit|hydra|dirbuster|gobuster|ffuf|wfuzz)/i"; reference:url,attack.mitre.org/techniques/T1190/; classtype:attempted-exploit; sid:5208549; rev:1;)

# --- MITRE ATT&CK T1110.001 - Password Guessing
alert http any any -> any any (msg:"MITRE T1110.001 Brute Force Password Guessing - Multiple Failed Login Attempts"; flow:established,to_server; http.uri; content:"/login"; nocase; http.response_code; content:"401"; detection_filter:track by_src, count 10, seconds 60; reference:url,attack.mitre.org/techniques/T1110/001/; classtype:attempted-admin; sid:5208550; rev:1;)

# --- MITRE ATT&CK T1505.003 - Web Shell
alert http any any -> any any (msg:"MITRE T1505.003 Web Shell Detection - Suspicious PHP File Access with POST"; flow:established,to_server; http.method; content:"POST"; http.uri; pcre:"/\.(php|asp|aspx|jsp)$/"; pcre:"/(cmd|shell|eval|base64_decode|system|exec|passthru)/"; reference:url,attack.mitre.org/techniques/T1505/003/; classtype:trojan-activity; sid:5208551; rev:1;)

# --- MITRE ATT&CK T1053.003 - Cron
alert tcp any any -> any any (msg:"MITRE T1053.003 Cron Job Modification - crontab edit"; flow:established; content:"crontab"; nocase; pcre:"/(crontab\s+-e|echo.*\*.*\*.*\*.*\*.*>>.*\/etc\/cron)/"; reference:url,attack.mitre.org/techniques/T1053/003/; classtype:system-call; sid:5208552; rev:1;)

# --- MITRE ATT&CK T1005 - Data from Local System
alert http any any -> any any (msg:"MITRE T1005 Data Staging - Exfiltration of /etc/passwd via HTTP POST"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"root:"; depth:5; content:":/bin/"; reference:url,attack.mitre.org/techniques/T1005/; classtype:exfiltration; sid:5208553; rev:1;)

# --- MITRE ATT&CK T1567.002 - Exfiltration to Cloud Storage
alert http any any -> any any (msg:"MITRE T1567.002 Exfiltration via Cloud Storage - Large Upload to S3 Bucket"; flow:established,to_server; http.host; pcre:"/[a-z0-9-]+\.s3[a-z0-9-]*\.amazonaws\.com/i"; http.method; content:"PUT"; dsize:>10000000; reference:url,attack.mitre.org/techniques/T1567/002/; classtype:exfiltration; sid:5208554; rev:1;)

# --- MITRE ATT&CK T1078.001 - Default Accounts
