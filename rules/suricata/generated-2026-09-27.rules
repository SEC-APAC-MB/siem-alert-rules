# Suricata Detection Rules - Generated 2026-09-27
# Based on: GitHub Advisory Database CVEs (2026-08-27 to 2026-09-27)
# MITRE ATT&CK techniques, current threat landscape
# SIDs: 5208501 - 5208600

# --- CVE-2026-82901: WordPress Ultra Addons for Contact Form 7 - Arbitrary File Upload (CRITICAL CVSS 9.8)
alert http any any -> any any (msg:"CVE-2026-82901 WordPress Ultra Addons CF7 Arbitrary File Upload via PDF Generator"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/wp-json/contact-form-7/v1/contact-forms"; nocase; http.request_body; content:"uacf7_wpcf7_mail_components"; nocase; content:"filename="; nocase; pcre:"/filename=\"[^\"]+\.(php|phtml|php5|php7|pht|phar)\"/i"; reference:url,github.com/advisories/GHSA-m2gh-25xj-89p6; classtype:web-application-attack; sid:5208501; rev:1;)

