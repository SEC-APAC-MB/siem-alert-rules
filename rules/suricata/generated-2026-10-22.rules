alert http any any -> any any (msg:"MITRE T1557.001 LLMNR/NBT-NS Poisoning Response Detection"; flow:established,to_client; http.status_code; content:"301"; http.header; content:"Location"; nocase; pcre:"/Location:\s*https?:\/\/[^\/]+\/wp-login|admin|signin/i"; classtype:trojan-activity; sid:521292164; rev:1;)

# --- MITRE ATT&CK T1027: Obfuscated Files or Information ---
alert http any any -> any any (msg:"MITRE T1027 Obfuscated Payload via Base64 in HTTP Header"; flow:established,to_server; http.header; pcre:"/(Authorization|X-Custom|X-Token|X-Data):\s*[A-Za-z0-9+\/]{200,}={0,2}/i"; classtype:trojan-activity; sid:521292165; rev:1;)
alert http any any -> any any (msg:"MITRE T1027.013 Encrypted/Encoded Payload in Cookie"; flow:established,to_server; http.header; content:"Cookie"; nocase; pcre:"/[a-zA-Z0-9+\/]{100,}={0,2}/W"; classtype:trojan-activity; sid:521292166; rev:1;)

# --- MITRE ATT&CK T1620: Reflective Code Loading ---
alert http any any -> any any (msg:"MITRE T1620 Reflective DLL Loading via HTTP Shellcode Stager"; flow:established,to_server; http.request_body; pcre:"/(VirtualAlloc|WriteProcessMemory|CreateRemoteThread|LoadLibrary|GetProcAddress)/i"; classtype:trojan-activity; sid:521292167; rev:1;)

# --- MITRE ATT&CK T1218: System Binary Proxy Execution ---
alert http any any -> any any (msg:"MITRE T1218.005 MSHTA Remote Script Execution via HTTP"; flow:established,to_server; http.uri; pcre:"/\.(hta|htd)$/i"; http.header; content:"mshta"; nocase; classtype:trojan-activity; sid:521292168; rev:1;)
alert http any any -> any any (msg:"MITRE T1218.010 Regsvr32 scrobj.dll Script Execution"; flow:established,to_server; http.uri; content:"/scrobj.dll"; nocase; http.header; content:"regsvr32"; nocase; classtype:trojan-activity; sid:521292169; rev:1;)

# --- MITRE ATT&CK T1105: Ingress Tool Transfer ---
alert http any any -> any any (msg:"MITRE T1105 Ingress Tool Transfer - Large Binary Download to Server"; flow:established,to_client; http.status_code; content:"200"; http.header; content:"application/octet-stream"; nocase; dsize:>5242880; classtype:trojan-activity; sid:521292170; rev:1;)
alert http any any -> any any (msg:"MITRE T1105 Tool Transfer via curl/wget User-Agent"; flow:established,to_server; http.header; pcre:"/(curl\/|wget\/|python-requests\/|go-http-client\/|okhttp\/)/i"; http.method; content:"GET"; http.uri; pcre:"/\.(exe|dll|sh|py|pl|bin|elf|so)$/i"; classtype:trojan-activity; sid:521292171; rev:1;)

# --- MITRE ATT&CK T1568: Dynamic Resolution ---
alert http any any -> any any (msg:"MITRE T1568.002 Domain Generation Algorithm Pattern"; flow:established,to_server; tls.sni; pcre:"/[a-z0-9]{8,16}\.(ru|cn|tk|ml|ga|cf|xyz|top|info|pw|cc)/i"; classtype:trojan-activity; sid:521292172; rev:1;)
alert http any any -> any any (msg:"MITRE T1568.002 DGA - High Entropy Subdomain"; flow:established,to_server; tls.sni; pcre:"/[a-z0-9]{20,}\./"; classtype:trojan-activity; sid:521292173; rev:1;)

# --- MITRE ATT&CK T1090: Proxy ---
alert http any any -> any any (msg:"MITRE T1090 Proxy Chain Detection via X-Forwarded-For Multi-Hop"; flow:established,to_server; http.header; content:"X-Forwarded-For"; nocase; pcre:"/,\s*(?!127\.|10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)\d+\.\d+\.\d+\.\d+/i"; classtype:trojan-activity; sid:521292174; rev:1;)

# --- MITRE ATT&CK T1559: Inter-Process Communication ---
alert http any any -> any any (msg:"MITRE T1559.001 COM Object Hijack via HTTP DCOM"; flow:established,to_server; http.uri; content:"/__CLR"; nocase; http.header; content:"OPTIONS"; nocase; classtype:trojan-activity; sid:521292175; rev:1;)

# --- MITRE ATT&CK T1486: Data Encrypted for Impact ---
alert http any any -> any any (msg:"MITRE T1486 Ransomware Note Delivery via HTTP Response"; flow:established,to_client; http.response_body; pcre:"/(your files have been encrypted|ransom|bitcoin|wallet|payment|decrypt|RECOVER)/i"; pcre:"/(\.btc|\.wallet|monero|xmr)/i"; classtype:ransomware; sid:521292176; rev:1;)

# --- MITRE ATT&CK T1490: Inhibit System Recovery ---
alert http any any -> any any (msg:"MITRE T1490 VSS Deletion via HTTP C2 Command"; flow:established,to_server; http.request_body; pcre:"/(vssadmin|delete|shadows|wbadmin|bcdedit|recoveryenabled)/i"; classtype:ransomware; sid:521292177; rev:1;)

# --- MITRE ATT&CK T1485: Data Destruction ---
alert http any any -> any any (msg:"MITRE T1485 Mass File Deletion via C2 Command"; flow:established,to_server; http.request_body; pcre:"/(rm\s+-rf|del\s+\/[fqs]|format\s+[a-z]:|shred|wipe)/i"; classtype:ransomware; sid:521292178; rev:1;)

# --- MITRE ATT&CK T1561: Disk Wipe ---
alert http any any -> any any (msg:"MITRE T1561.001 Disk Wipe via dd Command C2"; flow:established,to_server; http.request_body; pcre:"/dd\s+if=\/dev\/(zero|random|urandom)\s+of=\/dev\/(sd|nvme|hd)/i"; classtype:ransomware; sid:521292179; rev:1;)

# --- MITRE ATT&CK T1008: Fallback Channels ---
alert http any any -> any any (msg:"MITRE T1008 Fallback C2 via ICMP Tunnel HTTP Pattern"; flow:established,to_server; http.header; pcre:"/X-ICMP|X-Ping|X-Tunnel/i"; classtype:trojan-activity; sid:521292180; rev:1;)

# --- MITRE ATT&CK T1136: Create Account ---
alert http any any -> any any (msg:"MITRE T1136.002 Account Creation via HTTP to /api/users"; flow:established,to_server; http.method; content:"POST"; http.uri; pcre:"/\/api\/(users|accounts|register|signup)/i"; http.request_body; pcre:"/(username|email|password|role)/i"; classtype:attempted-admin; sid:521292181; rev:1;)

# --- MITRE ATT&CK T1098: Account Manipulation ---
alert http any any -> any any (msg:"MITRE T1098.001 Account Privilege Escalation via API"; flow:established,to_server; http.method; pcre:"/(PUT|PATCH)/"; http.uri; pcre:"/\/api\/users\/[^\/]+\/(role|permissions|groups|admin)/i"; http.request_body; content:"admin"; nocase; classtype:attempted-admin; sid:521292182; rev:1;)

# --- MITRE ATT&CK T1531: Account Access Removal ---
alert http any any -> any any (msg:"MITRE T1531 Account Lockout - Multiple Auth Failures Followed by Success"; flow:established,to_server; http.method; content:"POST"; http.uri; pcre:"/(login|auth|signin)/i"; detection_filter:track by_src, count 20, seconds 300; classtype:attempted-admin; sid:521292183; rev:1;)

# --- MITRE ATT&CK T1528: Steal Application Access Token ---
alert http any any -> any any (msg:"MITRE T1528 OAuth Token Theft via Suspicious Redirect"; flow:established,to_client; http.status_code; content:"302"; http.header; content:"Location"; nocase; pcre:"/(code|token|access_token)=/i"; pcre:"/redirect_uri=https?:\/\/[^\"'\s]+/i"; classtype:trojan-activity; sid:521292184; rev:1;)

# --- MITRE ATT&CK T1557.003 DHCP Spoofing ---
alert http any any -> any any (msg:"MITRE T1557.003 DHCP Spoofing via Rogue DHCP Response"; flow:established,to_client; http.header; content:"DHCP"; nocase; classtype:trojan-activity; sid:521292185; rev:1;)

# --- MITRE ATT&CK T1606: Forge Web Credentials ---
alert http any any -> any any (msg:"MITRE T1606.001 Web Cookie Theft via XSS Exfiltration"; flow:established,to_server; http.request_body; pcre:"/document\.cookie/i"; http.uri; pcre:"/(img|fetch|sendBeacon|XMLHttpRequest)/i"; classtype:trojan-activity; sid:521292186; rev:1;)

# --- MITRE ATT&CK T1059.009 Cloud API Command Execution ---
alert http any any -> any any (msg:"MITRE T1059.009 Cloud API Abuse - AWS CLI via HTTP"; flow:established,to_server; http.header; pcre:"/aws-cli|x-amz-/i"; http.request_body; pcre:"/(RunInstances|CreateUser|AttachRolePolicy|PutBucketPolicy)/i"; classtype:attempted-admin; sid:521292187; rev:1;)

# --- MITRE ATT&CK T1087: Account Discovery ---
alert http any any -> any any (msg:"MITRE T1087.002 Account Discovery via LDAP Query in HTTP"; flow:established,to_server; http.request_body; pcre:"/(objectClass|objectCategory|samAccountName|userPrincipalName|distinguishedName)/i"; classtype:attempted-recon; sid:521292188; rev:1;)

# --- MITRE ATT&CK T1018: Remote System Discovery ---
alert http any any -> any any (msg:"MITRE T1018 Remote System Discovery via Nmap HTTP Script"; flow:established,to_server; http.header; content:"Nmap"; nocase; classtype:network-scan; sid:521292189; rev:1;)

# --- MITRE ATT&CK T1046: Network Service Discovery ---
alert tcp any any -> any any (msg:"MITRE T1046 Network Service Scan - Rapid SYN to Multiple Ports"; flags:S; detection_filter:track by_src, count 20, seconds 5; classtype:network-scan; sid:521292190; rev:1;)

# --- MITRE ATT&CK T1049: System Network Connections Discovery ---
alert http any any -> any any (msg:"MITRE T1049 Netstat Output Exfiltration via HTTP POST"; flow:established,to_server; http.method; content:"POST"; http.request_body; pcre:"/(Active Connections|Proto\s+Local|netstat|ss\s+-|lsof\s+-i)/i"; classtype:exfiltration; sid:521292191; rev:1;)

# --- MITRE ATT&CK T1082: System Information Discovery ---
alert http any any -> any any (msg:"MITRE T1082 System Info Discovery - uname/systeminfo Exfil"; flow:established,to_server; http.method; content:"POST"; http.request_body; pcre:"/(Linux|Darwin|Windows|uname|systeminfo|hostname|kernel)/i"; pcre:"/(x86_64|aarch64|arm64|i386|amd64)/i"; classtype:exfiltration; sid:521292192; rev:1;)

# --- MITRE ATT&CK T1083: File and Directory Discovery ---
alert http any any -> any any (msg:"MITRE T1083 File Discovery via Recursive Listing Exfil"; flow:established,to_server; http.request_body; pcre:"/(drwx|rwx|-rw|total\s+\d+|Filesystem|Size\s+Used)/i"; classtype:exfiltration; sid:521292193; rev:1;)

# --- MITRE ATT&CK T1135: Network Share Discovery ---
alert http any any -> any any (msg:"MITRE T1135 Network Share Discovery via SMB Enum HTTP Exfil"; flow:established,to_server; http.request_body; pcre:"/(\\\\[A-Z]+\\|net share|smbclient|Get-WmiObject.*Win32_Share)/i"; classtype:attempted-recon; sid:521292194; rev:1;)

# --- MITRE ATT&CK T1069: Permission Groups Discovery ---
alert http any any -> any any (msg:"MITRE T1069 Permission Groups Discovery via /etc/group Exfil"; flow:established,to_server; http.request_body; pcre:"/(root:x:0|daemon:x:|bin:x:|sys:x:|wheel:x:|admin:x:)/i"; classtype:exfiltration; sid:521292195; rev:1;)

# --- MITRE ATT&CK T1057: Process Discovery ---
alert http any any -> any any (msg:"MITRE T1057 Process Discovery via ps aux Output Exfil"; flow:established,to_server; http.request_body; pcre:"/(USER\s+PID|ps\s+aux|tasklist|Get-Process)/i"; classtype:exfiltration; sid:521292196; rev:1;)

# --- MITRE ATT&CK T1007: System Service Discovery ---
alert http any any -> any any (msg:"MITRE T1007 Service Discovery via systemctl/sc query Exfil"; flow:established,to_server; http.request_body; pcre:"/(systemctl\s+list|sc\s+query|service\s+--status|chkconfig)/i"; classtype:exfiltration; sid:521292197; rev:1;)

# --- MITRE ATT&CK T1497: Virtualization/Sandbox Evasion ---
alert http any any -> any any (msg:"MITRE T1497.001 VM Detection via MAC Address Check"; flow:established,to_server; http.request_body; pcre:"/(00:0C:29|00:50:56|08:00:27|00:15:5D|00:1C:42)/i"; classtype:trojan-activity; sid:521292198; rev:1;)

# --- MITRE ATT&CK T1496: Resource Hijacking ---
alert http any any -> any any (msg:"MITRE T1496 Cryptocurrency Miner C2 via Stratum Protocol HTTP"; flow:established,to_server; http.uri; content:"/"; depth:1; http.request_body; pcre:"/\"method\":\s*\"(mining\.subscribe|mining\.login|mining\.job)\"/i"; classtype:trojan-activity; sid:521292199; rev:1;)

# --- MITRE ATT&CK T1199: Trusted Relationship ---
alert http any any -> any any (msg:"MITRE T1199 Trusted Third-Party Compromise - Suspicious OAuth Scope"; flow:established,to_server; http.uri; content:"/oauth/"; nocase; http.request_body; pcre:"/(scope|client_id).*(admin|root|full|all|write)/i"; classtype:trojan-activity; sid:521292200; rev:1;)
