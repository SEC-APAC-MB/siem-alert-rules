# MITRE ATT&CK - T1070 Indicator Removal
# ============================================================
alert http any any -> any any (msg:"ET MITRE T1070.002 - Log file clearing via web request"; flow:established,to_server; pcre:"/(?:rm\s+\/var\/log|> \/var\/log|truncate|logrotate.*force)/i"; classtype:attempted-hide; sid:5206068; rev:1;)

alert http any any -> any any (msg:"ET MITRE T1070.004 - File system timestomping via web"; flow:established,to_server; content:"touch"; nocase; pcre:"/touch\s+(?:\-t|\-r|-d)\s/i"; classtype:attempted-hide; sid:5206069; rev:1;)

# ============================================================
# MITRE ATT&CK - T1082 System Information Discovery
# ============================================================
alert http any any -> any any (msg:"ET MITRE T1082 - System info discovery via web shell - uname/systeminfo"; flow:established,to_server; pcre:"/(?:uname\s+-a|systeminfo|cat\s+\/etc\/os-release|cat\s+\/proc\/version)/i"; classtype:attempted-recon; sid:5206070; rev:1;)

# ============================================================
# MITRE ATT&CK - T1083 File and Directory Discovery
# ============================================================
alert http any any -> any any (msg:"ET MITRE T1083 - Directory listing attempt via web shell"; flow:established,to_server; pcre:"/(?:ls\s+-la|dir\s+\/s|find\s+\/|tree\s+\/)/i"; classtype:attempted-recon; sid:5206071; rev:1;)

# ============================================================
# MITRE ATT&CK - T1068 Exploitation for Privilege Escalation
# ============================================================
alert http any any -> any any (msg:"ET MITRE T1068 - Privilege escalation exploit download"; flow:established,to_client; content:"200"; http_stat_code; content:"Content-Disposition"; http_header; content:"exploit"; nocase; pcre:"/(?:dirtycow|cve-202\d|priv-esc|local-root)/i"; classtype:attempted-admin; sid:5206072; rev:1;)

# ============================================================
# MITRE ATT&CK - T1069 Permission Groups Discovery
# ============================================================
alert http any any -> any any (msg:"ET MITRE T1069 - Domain group enumeration via web"; flow:established,to_server; pcre:"/(?:net\s+(?:group|localgroup|user)|ldapsearch|Get-ADGroup|Get-NetGroup)/i"; classtype:attempted-recon; sid:5206073; rev:1;)

# ============================================================
# MITRE ATT&CK - T1021 Remote Services
# ============================================================
alert tcp any any -> any 3389 (msg:"ET MITRE T1021.001 - RDP brute force attempt"; flow:established,to_server; threshold:type both, track by_src, count 10, seconds 60; classtype:unsuccessful-user; sid:5206074; rev:1;)

alert tcp any any -> any 22 (msg:"ET MITRE T1021.004 - SSH brute force attempt"; flow:established,to_server; threshold:type both, track by_src, count 10, seconds 60; classtype:unsuccessful-user; sid:5206075; rev:1;)

# ============================================================
# MITRE ATT&CK - T1562 Impair Defenses
# ============================================================
alert http any any -> any any (msg:"ET MITRE T1562.001 - Firewall rule modification via web"; flow:established,to_server; pcre:"/(?:iptables\s+-F|iptables\s+-D|ufw\s+disable|firewall-cmd\s+--remove|netsh\s+advfirewall\s+delete)/i"; classtype:attempted-admin; sid:5206076; rev:1;)

alert http any any -> any any (msg:"ET MITRE T1562.004 - Disable security tool via web"; flow:established,to_server; pcre:"/(?:kill\s+-9|taskkill|pkill\s+-f)\s+(?:antimalware|defender|crowdstrike|sentinel)/i"; classtype:attempted-admin; sid:5206077; rev:1;)

# ============================================================
# MITRE ATT&CK - T1036 Masquerading
# ============================================================
alert http any any -> any any (msg:"ET MITRE T1036.005 - Masquerading as legitimate binary via web download"; flow:established,to_client; content:"200"; http_stat_code; content:"svchost"; nocase; file_data; content:"Content-Type"; http_header; content:"application/x-msdownload"; classtype:trojan-activity; sid:5206078; rev:1;)

# ============================================================
# MITRE ATT&CK - T1573 Encrypted Channel
# ============================================================
alert tls any any -> any any (msg:"ET MITRE T1573 - Suspicious self-signed TLS certificate for C2"; tls.subject; content:"CN="; pcre:"/CN=(?:localhost|test|unknown|self-signed)/i"; classtype:trojan-activity; sid:5206079; rev:1;)

# ============================================================
# MITRE ATT&CK - T1567 Exfiltration Over Web Service
# ============================================================
alert http any any -> any any (msg:"ET MITRE T1567.001 - Data exfiltration via code repository"; flow:established,to_server; content:"POST"; http_method; content:"github.com"; nocase; http_header; dsize:>500000; classtype:trojan-activity; sid:5206080; rev:1;)

alert http any any -> any any (msg:"ET MITRE T1567.002 - Data exfiltration to cloud storage"; flow:established,to_server; content:"PUT"; http_method; pcre:"/(?:drive\.google|dropbox\.com|onedrive|mega\.nz)/i"; dsize:>1000000; classtype:trojan-activity; sid:5206081; rev:1;)

# ============================================================
# OWASP A01 Broken Access Control
# ============================================================
alert http any any -> any any (msg:"OWASP A01 - IDOR attempt - sequential user ID enumeration"; flow:established,to_server; content:"GET"; http_method; content:"/api/users/"; http_uri; pcre:"/\/api\/users\/\d+$/"; threshold:type both, track by_src, count 20, seconds 60; classtype:web-application-attack; sid:5206082; rev:1;)

alert http any any -> any any (msg:"OWASP A01 - Forced browsing to admin panel"; flow:established,to_server; content:"GET"; http_method; pcre:"/\/(?:admin|administrator|manager|console)(?:\/|$)/i"; classtype:web-application-attack; sid:5206083; rev:1;)

alert http any any -> any any (msg:"OWASP A01 - Privilege escalation via role parameter manipulation"; flow:established,to_server; content:"POST"; http_method; pcre:"/(?:role|permission|group|is_admin|isAdmin|user_type)=(?:admin|administrator|root|superuser)/i"; classtype:web-application-attack; sid:5206084; rev:1;)

# ============================================================
# OWASP A02 Cryptographic Failures
# ============================================================
alert http any any -> any any (msg:"OWASP A02 - Sensitive credential submission over unencrypted HTTP"; flow:established,to_server; content:"POST"; http_method; content:"password"; http_client_body; classtype:web-application-attack; sid:5206085; rev:1;)

# ============================================================
# OWASP A03 Injection
# ============================================================
alert http any any -> any any (msg:"OWASP A03 - SQL injection UNION SELECT with information_schema"; flow:established,to_server; content:"UNION"; nocase; http_uri; content:"SELECT"; nocase; http_uri; content:"information_schema"; nocase; http_uri; classtype:web-application-attack; sid:5206086; rev:1;)

alert http any any -> any any (msg:"OWASP A03 - NoSQL injection - MongoDB operator injection"; flow:established,to_server; content:"POST"; http_method; pcre:"/(?:\$where|\$ne|\$gt|\$regex|\$or|\$and)\s*:/"; classtype:web-application-attack; sid:5206087; rev:1;)

alert http any any -> any any (msg:"OWASP A03 - LDAP injection attempt"; flow:established,to_server; pcre:"/(?:\*\)\(\|/"; http_uri; classtype:web-application-attack; sid:5206088; rev:1;)

alert http any any -> any any (msg:"OWASP A03 - Command injection - chained OS commands"; flow:established,to_server; pcre:"/(?:;|%3b|%26%26|&&|\|\||\|%7c)(?:cat|id|whoami|ls|dir|uname|ping|wget|curl|nc|bash|sh|python|perl|ruby)\b/i"; classtype:web-application-attack; sid:5206089; rev:1;)

alert http any any -> any any (msg:"OWASP A03 - SSTI - Jinja2/Python template injection"; flow:established,to_server; pcre:"/\{\{(?:__class__|__mro__|__subclasses__|config|request|lipsum|cycler|joiner|namespace)/i"; classtype:web-application-attack; sid:5206090; rev:1;)

alert http any any -> any any (msg:"OWASP A03 - SSTI - Freemarker/Java expression injection"; flow:established,to_server; pcre:"/(?:<#assign|<#if|\$\{(?:T\(|freemarker))/i"; classtype:web-application-attack; sid:5206091; rev:1;)

# ============================================================
# OWASP A05 Security Misconfiguration
# ============================================================
alert http any any -> any any (msg:"OWASP A05 - Default credentials attempt on management interface"; flow:established,to_server; content:"POST"; http_method; content:"/login"; http_uri; content:"admin"; http_client_body; content:"admin"; http_client_body; classtype:web-application-attack; sid:5206092; rev:1;)

alert http any any -> any any (msg:"OWASP A05 - Debug mode exposure in response headers"; flow:established,to_client; content:"200"; http_stat_code; content:"X-Debug"; http_header; classtype:web-application-attack; sid:5206093; rev:1;)

alert http any any -> any any (msg:"OWASP A05 - Stack trace exposure in HTTP response"; flow:established,to_client; content:"200"; http_stat_code; pcre:"/(?:Traceback|Exception|at [\w.]+\([\w.]+\.java:\d+\)|stack trace)/i"; classtype:web-application-attack; sid:5206094; rev:1;)

# ============================================================
# OWASP A06 Vulnerable Components
# ============================================================
alert http any any -> any any (msg:"OWASP A06 - Known vulnerable component - Apache Struts .action endpoint"; flow:established,to_server; content:".action"; http_uri; pcre:"/\.action(?:;|\?|$)/"; classtype:web-application-attack; sid:5206095; rev:1;)

# ============================================================
# OWASP A07 Identity and Authentication Failures
# ============================================================
alert http any any -> any any (msg:"OWASP A07 - JWT algorithm none attack"; flow:established,to_server; content:"eyJ"; http_header; content:"alg"; content:"none"; pcre:"/eyJ[^.]+\.[^.]*none/i"; classtype:web-application-attack; sid:5206096; rev:1;)

alert http any any -> any any (msg:"OWASP A07 - JWT key confusion - algorithm swap attempt"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer"; content:"eyJ"; pcre:"/eyJhbGciOiJSUzI1NiI/"; classtype:web-application-attack; sid:5206097; rev:1;)

# ============================================================
# OWASP A08 Software and Data Integrity Failures
# ============================================================
alert http any any -> any any (msg:"OWASP A08 - Insecure deserialization - Java serialization magic bytes"; flow:established,to_server; content:"|0a 0b 0c 0d 0e 0f 10|"; pcre:"/\xac\xed\x00\x05/"; classtype:web-application-attack; sid:5206098; rev:1;)

alert http any any -> any any (msg:"OWASP A08 - Insecure deserialization - PHP object injection"; flow:established,to_server; pcre:"/O:\d+:\"(?:stdClass|WP_Object|Exception|SoapClient)/i"; classtype:web-application-attack; sid:5206099; rev:1;)

# ============================================================
# OWASP A09 Security Logging and Monitoring Failures
# ============================================================
alert http any any -> any any (msg:"OWASP A09 - Suspicious user-agent scanning activity"; flow:established,to_server; content:"User-Agent"; http_header; pcre:"/(?:Nikto|Nmap|masscan|ZAP|w3af|dirbuster|gobuster|ffuf)/i"; classtype:attempted-recon; sid:5206100; rev:1;)
