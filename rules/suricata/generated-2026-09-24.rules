# ============================================================
# CVE-2026-56669 - Elysia DoS via quadratic form data (GHSA-9643-4qgh-g8mx)
# ============================================================
alert http any any -> any any (msg:"CVE-2026-56669 Elysia multipart/form-data DoS - excessive key-value pairs"; flow:established,to_server; content:"Content-Type|3a| multipart/form-data"; http_header; content:"boundary="; http_header; file_data; pcre:"/(\r\nContent-Disposition: form-data; name=\"[^\"]+\"){100,}/"; classtype:attempted-dos; sid:5206001; rev:1;)

alert http any any -> any any (msg:"CVE-2026-56669 Elysia form data normalization DoS - high key count"; flow:established,to_server; content:"Content-Type|3a| multipart/form-data"; http_header; content:"name="; pcre:"/name=\"[^\"]+\"/"; dsize:>500000; classtype:attempted-dos; sid:5206002; rev:1;)

