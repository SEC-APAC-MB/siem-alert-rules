alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - M365 Mail Forwarding Rule Creation via Graph API"; flow:established,to_server; content:"graph.microsoft.com"; http_header; pcre:"/\/users\/[a-z0-9-]+\/mailFolders\/[a-z0-9-]+\/messageRules/i"; http_uri; content:"POST"; http_method; classtype:attempted-admin; sid:2500122; rev:1; metadata:created_at 2026_09_13, mitre_t1114_003, azure_m365_mail_forward;)
