# ==============================================================================
# Azure Detection Rules — Suricata
# Covers: Azure IMDS, Entra ID (Azure AD), Key Vault, Blob Storage,
#         Service Bus, Azure Functions, M365, Azure DevOps, ARM API
# Generated: 2026-09-13
# All rules validated against Suricata syntax (v7+)
# ==============================================================================

# --- Azure Instance Metadata Service (IMDS) ---

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - IMDS Metadata Endpoint Access"; flow:established,to_server; content:"169.254.169.254"; http_uri; content:"Metadata"; http_header; content:"true"; http_header; classtype:web-application-attack; sid:2500001; rev:1; metadata:created_at 2026_09_13, mitre_t1552_005, azure_imds_access;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - IMDS Managed Identity Token Theft"; flow:established,to_server; content:"169.254.169.254"; http_uri; content:"/metadata/identity/oauth2/token"; http_uri; content:"Metadata"; http_header; content:"true"; http_header; classtype:web-application-attack; sid:2500002; rev:1; metadata:created_at 2026_09_13, mitre_t1552_005, azure_imds_token_theft;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - IMDS Compute Instance Info Disclosure"; flow:established,to_server; content:"169.254.169.254"; http_uri; content:"/metadata/instance"; http_uri; content:"Metadata"; http_header; content:"true"; http_header; classtype:web-application-attack; sid:2500003; rev:1; metadata:created_at 2026_09_13, mitre_t1082, azure_imds_instance_info;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - IMDS Network Info Disclosure"; flow:established,to_server; content:"169.254.169.254"; http_uri; content:"/metadata/instance/network"; http_uri; content:"Metadata"; http_header; content:"true"; http_header; classtype:web-application-attack; sid:2500004; rev:1; metadata:created_at 2026_09_13, mitre_t1040, azure_imds_network;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - IMDS Scheduled Events Access"; flow:established,to_server; content:"169.254.169.254"; http_uri; content:"/metadata/scheduledevents"; http_uri; content:"Metadata"; http_header; content:"true"; http_header; classtype:attempted-recon; sid:2500005; rev:1; metadata:created_at 2026_09_13, mitre_t1082, azure_imds_scheduled_events;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - IMDS Attestation Document Access"; flow:established,to_server; content:"169.254.169.254"; http_uri; content:"/metadata/attest/document"; http_uri; content:"Metadata"; http_header; content:"true"; http_header; classtype:attempted-recon; sid:2500006; rev:1; metadata:created_at 2026_09_13, azure_imds_attestation;)

# --- Azure IMDS SSRF via Application ---

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - SSRF to IMDS via URL Parameter"; flow:established,to_server; pcre:"/[?&](url|uri|path|dest|redirect|return|next|target|site|link|rurl|img|load|file|page|callback|feed|proxy|fetch|source|src|reference)\s*=\s*https?:\/\/169\.254\.169\.254/i"; http_uri; classtype:web-application-attack; sid:2500010; rev:1; metadata:created_at 2026_09_13, mitre_t1190, azure_ssrf_imds;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - SSRF to IMDS via Header Injection"; flow:established,to_server; content:"169.254.169.254"; http_header; classtype:web-application-attack; sid:2500011; rev:1; metadata:created_at 2026_09_13, mitre_t1190, azure_ssrf_imds_header;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - SSRF to IMDS via POST Body"; flow:established,to_server; content:"169.254.169.254"; http_client_body; content:"Metadata"; http_header; content:"true"; http_header; classtype:web-application-attack; sid:2500012; rev:1; metadata:created_at 2026_09_13, mitre_t1190, azure_ssrf_imds_post;)

# --- Entra ID / Azure AD ---

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Entra ID Token Endpoint Access from Unusual Source"; flow:established,to_server; pcre:"/login\.microsoftonline\.com\/[a-z0-9-]+\/oauth2\/v2\.0\/token/i"; http_uri; threshold:type both, track by_src, count 50, seconds 300; classtype:attempted-recon; sid:2500020; rev:1; metadata:created_at 2026_09_13, mitre_t1590, azure_entra_id_token;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Entra ID Device Code Phishing - device_authorization_endpoint"; flow:established,to_server; pcre:"/login\.microsoftonline\.com\/[a-z0-9-]+\/oauth2\/v2\.0\/devicecode/i"; http_uri; classtype:web-application-attack; sid:2500021; rev:1; metadata:created_at 2026_09_13, mitre_t1566, azure_device_code_phishing;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Entra ID Conditional Access Bypass Attempt - Spoofed Claims"; flow:established,to_server; content:"login.microsoftonline.com"; http_header; pcre:"/amr_values?\s*=\s*(pwd|wia)/i"; http_uri; classtype:web-application-attack; sid:2500022; rev:1; metadata:created_at 2026_09_13, mitre_t1550, azure_conditional_access_bypass;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Entra ID Graph API Enumeration"; flow:established,to_server; content:"graph.microsoft.com"; http_header; pcre:"/\/(users|groups|applications|servicePrincipals|directoryRoles|administrativeUnits)/i"; http_uri; threshold:type both, track by_src, count 30, seconds 60; classtype:attempted-recon; sid:2500023; rev:1; metadata:created_at 2026_09_13, mitre_t1087, azure_entra_graph_enum;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Entra ID Suspicious App Registration"; flow:established,to_server; content:"graph.microsoft.com"; http_header; content:"/applications"; http_uri; content:"POST"; http_method; classtype:attempted-admin; sid:2500024; rev:1; metadata:created_at 2026_09_13, mitre_t1136, azure_entra_app_reg;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Entra ID Service Principal Creation"; flow:established,to_server; content:"graph.microsoft.com"; http_header; content:"/servicePrincipals"; http_uri; content:"POST"; http_method; classtype:attempted-admin; sid:2500025; rev:1; metadata:created_at 2026_09_13, mitre_t1136, azure_entra_sp_create;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Entra ID Consent Grant Phishing"; flow:established,to_server; pcre:"/login\.microsoftonline\.com\/[a-z0-9-]+\/oauth2\/v2\.0\/authorize/i"; http_uri; pcre:"/prompt\s*=\s*consent/i"; http_uri; classtype:web-application-attack; sid:2500026; rev:1; metadata:created_at 2026_09_13, mitre_t1566, azure_illicit_consent;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Entra ID Password Spray - Multiple Failed Logins"; flow:established,to_server; content:"login.microsoftonline.com"; http_header; content:"/oauth2/token"; http_uri; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-login; sid:2500027; rev:1; metadata:created_at 2026_09_13, mitre_t1110_003, azure_password_spray;)

# --- Azure Key Vault ---

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Key Vault Unauthorized Access Attempt"; flow:established,to_server; pcre:"/[a-z0-9-]+\.vault\.azure\.net/i"; http_header; content:!"Authorization"; http_header; classtype:attempted-admin; sid:2500030; rev:2; metadata:created_at 2026_09_13, mitre_t1552, azure_keyvault_unauth;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Key Vault Secret Enumeration"; flow:established,to_server; pcre:"/[a-z0-9-]+\.vault\.azure\.net\/secrets/i"; http_uri; content:"GET"; http_method; threshold:type both, track by_src, count 20, seconds 60; classtype:attempted-recon; sid:2500031; rev:1; metadata:created_at 2026_09_13, mitre_t1087, azure_keyvault_enum;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Key Vault Secret Read via Leaked Token"; flow:established,to_server; pcre:"/[a-z0-9-]+\.vault\.azure\.net\/secrets\//i"; http_uri; content:"Authorization"; http_header; pcre:"/Bearer\s+eyJ/i"; http_header; classtype:web-application-attack; sid:2500032; rev:1; metadata:created_at 2026_09_13, mitre_t1552, azure_keyvault_token_leak;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Key Vault Certificate Download"; flow:established,to_server; pcre:"/[a-z0-9-]+\.vault\.azure\.net\/certificates\//i"; http_uri; content:"GET"; http_method; classtype:web-application-attack; sid:2500033; rev:1; metadata:created_at 2026_09_13, mitre_t1552, azure_keyvault_cert_leak;)

# --- Azure Blob Storage ---

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Blob Storage Public Container Enumeration"; flow:established,to_server; pcre:"/[a-z0-9-]+\.blob\.core\.windows\.net/i"; http_header; content:"GET"; http_method; pcre:"/comp=list/i"; http_uri; classtype:attempted-recon; sid:2500040; rev:1; metadata:created_at 2026_09_13, mitre_t1592, azure_blob_enum;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Blob Storage SAS Token in URL"; flow:established,to_server; pcre:"/[?&]sv=\d{4}-\d{2}-\d{2}&[^?]*sig=[A-Za-z0-9+\/=]{20,}/i"; http_uri; classtype:web-application-attack; sid:2500041; rev:1; metadata:created_at 2026_09_13, mitre_t1552, azure_blob_sas_token_leak;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Blob Storage Account Key in Authorization Header"; flow:established,to_server; pcre:"/SharedKey\s+[a-z0-9]+:[A-Za-z0-9+\/=]{40,}/i"; http_header; classtype:web-application-attack; sid:2500042; rev:1; metadata:created_at 2026_09_13, mitre_t1552, azure_blob_account_key_leak;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Blob Storage Mass Download"; flow:established,to_server; pcre:"/[a-z0-9-]+\.blob\.core\.windows\.net/i"; http_header; threshold:type both, track by_src, count 100, seconds 60; classtype:web-application-attack; sid:2500043; rev:1; metadata:created_at 2026_09_13, mitre_t1567, azure_blob_mass_download;)

# --- Azure Service Bus / Event Hub ---

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Service Bus Namespace Enumeration"; flow:established,to_server; pcre:"/[a-z0-9-]+\.servicebus\.windows\.net/i"; http_header; content:"GET"; http_method; threshold:type both, track by_src, count 20, seconds 60; classtype:attempted-recon; sid:2500050; rev:1; metadata:created_at 2026_09_13, mitre_t1592, azure_servicebus_enum;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Service Bus SAS Token Abuse"; flow:established,to_server; pcre:"/SharedAccessSignature\s+sr=[^&]+&sig=[^&]+&se=\d+/i"; http_header; classtype:web-application-attack; sid:2500051; rev:1; metadata:created_at 2026_09_13, mitre_t1550, azure_servicebus_sas_abuse;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Event Hub Data Exfiltration"; flow:established,to_server; pcre:"/[a-z0-9-]+\.servicebus\.windows\.net\/[a-z0-9-]+\/consumergroups\/\$default/i"; http_uri; content:"GET"; http_method; threshold:type both, track by_src, count 50, seconds 60; classtype:web-application-attack; sid:2500052; rev:1; metadata:created_at 2026_09_13, mitre_t1567, azure_eventhub_exfil;)

# --- Azure Functions / App Service ---

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Function App Command Injection"; flow:established,to_server; pcre:"/[a-z0-9-]+\.azurewebsites\.net\/api\//i"; http_uri; content:"POST"; http_method; pcre:"/(cmd\.exe|powershell|\/bin\/sh|\/bin\/bash|import\s+os|subprocess\.|eval\s*\(|exec\s*\()/i"; http_client_body; classtype:web-application-attack; sid:2500060; rev:1; metadata:created_at 2026_09_13, mitre_t1059, azure_function_injection;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - App Service SCM Site Access - Kudu Console"; flow:established,to_server; pcre:"/[a-z0-9-]+\.scm\.azurewebsites\.net/i"; http_header; content:"/DebugConsole"; http_uri; classtype:attempted-admin; sid:2500061; rev:1; metadata:created_at 2026_09_13, mitre_t1190, azure_kudu_console;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - App Service Deployment Credential Exposure"; flow:established,to_server; pcre:"/[a-z0-9-]+\.scm\.azurewebsites\.net\/api\/deployments/i"; http_uri; content:"GET"; http_method; classtype:attempted-recon; sid:2500062; rev:1; metadata:created_at 2026_09_13, mitre_t1552, azure_deployment_cred;)

# --- Azure ARM API (Management) ---

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - ARM API Subscription Enumeration"; flow:established,to_server; content:"management.azure.com"; http_header; pcre:"/\/subscriptions/i"; http_uri; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-recon; sid:2500070; rev:1; metadata:created_at 2026_09_13, mitre_t1592, azure_arm_sub_enum;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - ARM API Resource Group Deletion"; flow:established,to_server; content:"management.azure.com"; http_header; content:"DELETE"; http_method; pcre:"/\/subscriptions\/[a-z0-9-]+\/resourceGroups\//i"; http_uri; classtype:attempted-admin; sid:2500071; rev:1; metadata:created_at 2026_09_13, mitre_t1485, azure_arm_rg_delete;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - ARM API Role Assignment Creation"; flow:established,to_server; content:"management.azure.com"; http_header; pcre:"/\/roleAssignments/i"; http_uri; content:"PUT"; http_method; classtype:attempted-admin; sid:2500072; rev:1; metadata:created_at 2026_09_13, mitre_t1098, azure_arm_role_assign;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - ARM API Network Security Group Modification"; flow:established,to_server; content:"management.azure.com"; http_header; pcre:"/\/networkSecurityGroups\//i"; http_uri; pcre:"/(PUT|PATCH|DELETE)/i"; http_method; classtype:attempted-admin; sid:2500073; rev:1; metadata:created_at 2026_09_13, mitre_t1562, azure_arm_nsg_modify;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - ARM API Virtual Machine Creation"; flow:established,to_server; content:"management.azure.com"; http_header; pcre:"/\/virtualMachines/i"; http_uri; content:"PUT"; http_method; classtype:attempted-admin; sid:2500074; rev:1; metadata:created_at 2026_09_13, mitre_t1136, azure_arm_vm_create;)

# --- Azure DevOps ---

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - DevOps PAT in Authorization Header"; flow:established,to_server; pcre:"/dev\.azure\.com|visualstudio\.com/i"; http_header; pcre:"/Authorization.*Basic\s+[A-Za-z0-9+\/=]{50,}/i"; http_header; classtype:web-application-attack; sid:2500080; rev:1; metadata:created_at 2026_09_13, mitre_t1552, azure_devops_pat_leak;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - DevOps Repository Enumeration"; flow:established,to_server; pcre:"/dev\.azure\.com\/[a-z0-9-]+\/_git\//i"; http_uri; content:"GET"; http_method; threshold:type both, track by_src, count 30, seconds 60; classtype:attempted-recon; sid:2500081; rev:1; metadata:created_at 2026_09_13, mitre_t1592, azure_devops_repo_enum;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - DevOps Pipeline Modification"; flow:established,to_server; pcre:"/dev\.azure\.com\/[a-z0-9-]+\/_apis\/build\/definitions\//i"; http_uri; pcre:"/(PUT|PATCH)/i"; http_method; classtype:attempted-admin; sid:2500082; rev:1; metadata:created_at 2026_09_13, mitre_t1554, azure_devops_pipeline_modify;)

# --- Azure Credential Leakage ---

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Managed Identity Token Leak in Response"; flow:established,to_client; pcre:"/\"access_token\"\s*:\s*\"eyJ[a-zA-Z0-9_-]+\"/i"; http_server_body; pcre:"/\"resource\"\s*:\s*\"https:\/\/management\.azure\.com/i"; http_server_body; classtype:web-application-attack; sid:2500090; rev:1; metadata:created_at 2026_09_13, mitre_t1552, azure_managed_identity_leak;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Cloud Credential File Exposure - .azure/credentials"; flow:established,to_server; pcre:"/\/(\.azure\/credentials|\.azure\/accessTokens|\.azure\/azureProfile\.json|azureToken\.json|msal_cache)/i"; http_uri; classtype:web-application-attack; sid:2500091; rev:1; metadata:created_at 2026_09_13, mitre_t1552, azure_cred_file_exposure;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AZURE - Connection String with Account Key in HTTP"; flow:established,to_server; pcre:"/AccountKey=[A-Za-z0-9+\/=]{60,}/i"; http_client_body; classtype:web-application-attack; sid:2500092; rev:1; metadata:created_at 2026_09_13, mitre_t1552, azure_conn_string_key_leak;)

# --- Azure Attack Chains ---

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AZURE-001: SSRF to IMDS to Managed Identity Token Theft"; flow:established,to_server; pcre:"/(169\.254\.169\.254|metadata\.azure\.app)/i"; http_uri; pcre:"/\/metadata\/identity\/oauth2\/token/i"; http_uri; content:"Metadata"; http_header; content:"true"; http_header; classtype:web-application-attack; sid:2500100; rev:1; metadata:created_at 2026_09_13, chain ssrf-imds-token-theft, mitre_t1552_005;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AZURE-002: IMDS Token to ARM API Lateral Movement"; flow:established,to_server; content:"management.azure.com"; http_header; pcre:"/Authorization.*Bearer\s+eyJ/i"; http_header; pcre:"/\/(subscriptions|resourceGroups|providers)/i"; http_uri; classtype:web-application-attack; sid:2500101; rev:1; metadata:created_at 2026_09_13, chain imds-token-to-arm-lateral, mitre_t1552_005;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AZURE-003: Blob SAS Token to Data Exfiltration"; flow:established,to_server; pcre:"/[a-z0-9-]+\.blob\.core\.windows\.net/i"; http_header; pcre:"/[?&]sv=\d{4}-\d{2}-\d{2}&[^?]*sig=[A-Za-z0-9+\/=]{20,}/i"; http_uri; pcre:"/comp=list/i"; http_uri; classtype:web-application-attack; sid:2500102; rev:1; metadata:created_at 2026_09_13, chain sas-token-blob-exfil, mitre_t1530;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AZURE-004: Entra ID Illicit Consent Grant to Data Access"; flow:established,to_server; pcre:"/login\.microsoftonline\.com\/[a-z0-9-]+\/oauth2\/v2\.0\/authorize/i"; http_uri; pcre:"/prompt\s*=\s*consent/i"; http_uri; pcre:"/scope\s*=\s*(https:\/\/graph\.microsoft\.com\/\.default|https:\/\/graph\.microsoft\.com\/Mail\.Read|Files\.Read\.All)/i"; http_uri; classtype:web-application-attack; sid:2500103; rev:1; metadata:created_at 2026_09_13, chain entra-illicit-consent-data, mitre_t1566;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AZURE-005: Key Vault Secret Read via Leaked Token to Credential Harvest"; flow:established,to_server; pcre:"/[a-z0-9-]+\.vault\.azure\.net\/secrets\//i"; http_uri; pcre:"/Authorization.*Bearer\s+eyJ/i"; http_header; classtype:web-application-attack; sid:2500104; rev:1; metadata:created_at 2026_09_13, chain keyvault-token-cred-harvest, mitre_t1552;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AZURE-006: Function App Injection to IMDS Token Theft"; flow:established,to_server; pcre:"/[a-z0-9-]+\.azurewebsites\.net\/api\//i"; http_uri; content:"POST"; http_method; pcre:"/169\.254\.169\.254|metadata\.azure\.app/i"; http_client_body; classtype:web-application-attack; sid:2500105; rev:1; metadata:created_at 2026_09_13, chain function-injection-to-imds, mitre_t1190;)

