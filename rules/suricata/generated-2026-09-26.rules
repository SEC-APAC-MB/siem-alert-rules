alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1505.003 Web Shell Access with Command Execution Pattern"; flow:established,to_server; http_uri; pcre:"/(cmd|exec|shell|eval|system|passthru|popen)\s*[\(\=]/i"; reference:url,attack.mitre.org/techniques/T1505/003; classtype:trojan-activity; sid:5207058; rev:1;)

# === MITRE ATT&CK T1048: Exfiltration Over Alternative Protocol ===
alert tcp $HOME_NET any -> $EXTERNAL_NET 53 (msg:"MITRE T1048.002 DNS Tunneling Exfiltration - High Volume DNS Queries"; flow:established,to_server; dsize:>100; detection_filter:track by_src, count 50, seconds 30; reference:url,attack.mitre.org/techniques/T1048/002; classtype:exfiltration; sid:5207059; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"MITRE T1048.002 HTTPS Exfiltration - Large Outbound Data Transfer"; flow:established,to_server; dsize:>1048576; reference:url,attack.mitre.org/techniques/T1048/002; classtype:exfiltration; sid:5207060; rev:1;)

# === MITRE ATT&CK T1071: Application Layer Protocol ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1071.001 C2 Beacon via HTTP Regular Interval Check-in"; flow:established,to_server; http_method; content:"GET"; detection_filter:track by_src, count 30, seconds 300; reference:url,attack.mitre.org/techniques/T1071/001; classtype:trojan-activity; sid:5207061; rev:1;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1071.001 TLS C2 Certificate with Suspicious Subject"; flow:established,to_server; tls.subject; pcre:"/[a-z0-9]{16,}\.(tk|ml|ga|cf|gq|top|xyz|click)$/i"; reference:url,attack.mitre.org/techniques/T1071/001; classtype:trojan-activity; sid:5207062; rev:1;)

# === MITRE ATT&CK T1566: Phishing ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1566.002 Spearphishing Link - Suspicious Attachment Download URL"; flow:established,to_server; http_uri; pcre:"/.*\.(docm|xlsm|pptm|jar|exe|scr|hta|bat|ps1)$/i"; reference:url,attack.mitre.org/techniques/T1566/002; classtype:trojan-activity; sid:5207063; rev:1;)
alert smtp $EXTERNAL_NET any -> $HOME_NET 25 (msg:"MITRE T1566.001 Spearphishing Email with Malicious Macro Attachment"; flow:established,to_server; content:"Content-Type|3a| application/vnd.openxmlformats"; nocase; pcre:"/filename[\x3d\x22].*\.(docm|xlsm|pptm)/i"; reference:url,attack.mitre.org/techniques/T1566/001; classtype:trojan-activity; sid:5207064; rev:1;)

# === MITRE ATT&CK T1027: Obfuscated Files ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1027 Base64 Encoded Payload in HTTP Header"; flow:established,to_server; http_header; content:"Authorization|3a| Bearer "; nocase; pcre:"/Bearer\s+[A-Za-z0-9+\/]{200,}={0,2}/"; reference:url,attack.mitre.org/techniques/T1027; classtype:trojan-activity; sid:5207065; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1027 Hex-Encoded Command in URI"; flow:established,to_server; http_uri; pcre:"/(\x25[0-9a-f]{2}){15,}/i"; reference:url,attack.mitre.org/techniques/T1027; classtype:trojan-activity; sid:5207066; rev:1;)

# === MITRE ATT&CK T1078: Valid Accounts ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1078 Suspicious Login from New Geo Location"; flow:established,to_server; http_method; content:"POST"; http_uri; pcre:"/(login|auth|signin)/i"; http_header; content:"X-Forwarded-For|3a| "; pcre:"/X-Forwarded-For\x3a\s*\d+\.\d+\.\d+\.\d+/"; reference:url,attack.mitre.org/techniques/T1078; classtype:successful-admin; sid:5207067; rev:1;)
alert ssh $EXTERNAL_NET any -> $HOME_NET 22 (msg:"MITRE T1078 SSH Login from Known Bad IP Range"; flow:established,to_server; content:"SSH-2.0"; pcre:"/^SSH-2\.0-.*/"; reference:url,attack.mitre.org/techniques/T1078; classtype:successful-admin; sid:5207068; rev:1;)

# === MITRE ATT&CK T1133: External Remote Services ===
alert tcp $EXTERNAL_NET any -> $HOME_NET 3389 (msg:"MITRE T1133 RDP Access from External Network"; flow:established,to_server; flags:S; detection_filter:track by_src, count 5, seconds 60; reference:url,attack.mitre.org/techniques/T1133; classtype:attempted-admin; sid:5207069; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 5900 (msg:"MITRE T1133 VNC External Access Attempt"; flow:established,to_server; flags:S; reference:url,attack.mitre.org/techniques/T1133; classtype:attempted-admin; sid:5207070; rev:1;)

# === MITRE ATT&CK T1548: Abuse Elevation Control Mechanism ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1548.001 Setuid/Setgid Binary Execution via Web"; flow:established,to_server; http_client_body; pcre:"/chmod\s+[0-7]?[0-7]?[0-7][67]/"; reference:url,attack.mitre.org/techniques/T1548/001; classtype:attempted-user; sid:5207071; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1548.003 Sudo Exploitation Attempt via Web Interface"; flow:established,to_server; http_client_body; pcre:"/sudo\s+(ALL|NOPASSWD|\-i|\-s|\-l)/"; reference:url,attack.mitre.org/techniques/T1548/003; classtype:attempted-user; sid:5207072; rev:1;)

# === MITRE ATT&CK T1053: Scheduled Task/Job ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1053.003 Cron Job Creation via Web RCE"; flow:established,to_server; http_client_body; pcre:"/crontab\s+(-e|-l)|\*\s+\*\s+\*\s+\*\s+\*/"; reference:url,attack.mitre.org/techniques/T1053/003; classtype:trojan-activity; sid:5207073; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1053.005 Windows Scheduled Task Creation via schtasks"; flow:established,to_server; http_client_body; pcre:"/schtasks\s+\/create/i"; reference:url,attack.mitre.org/techniques/T1053/005; classtype:trojan-activity; sid:5207074; rev:1;)

# === MITRE ATT&CK T1572: Protocol Tunneling ===
alert tcp $HOME_NET any -> $EXTERNAL_NET 8080 (msg:"MITRE T1572 Protocol Tunneling via Uncommon Port 8080"; flow:established,to_server; dsize:>200; reference:url,attack.mitre.org/techniques/T1572; classtype:trojan-activity; sid:5207075; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 993 (msg:"MITRE T1572 IMAPS Tunneling - Suspicious Data Patterns"; flow:established,to_server; dsize:>500; pcre:"/^\x16\x03[0-2]/"; reference:url,attack.mitre.org/techniques/T1572; classtype:trojan-activity; sid:5207076; rev:1;)

# === MITRE ATT&CK T1090: Proxy ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1090 Connection to Known TOR Exit Node"; flow:established,to_server; reference:url,attack.mitre.org/techniques/T1090; classtype:trojan-activity; sid:5207077; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1090.002 VPN/Proxy Service Domain Connection"; flow:established,to_server; http_host; pcre:"/(nordvpn|expressvpn|surfshark|protonvpn|privado|Mullvad)\./i"; reference:url,attack.mitre.org/techniques/T1090/002; classtype:trojan-activity; sid:5207078; rev:1;)

# === MITRE ATT&CK T1557: Adversary-in-the-Middle ===
alert tls $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1557 TLS Interception - Certificate Authority Mismatch"; flow:established,to_client; tls.issuerdn; pcre:"/(OpenSSL|test|fake|intercept|proxy)/i"; reference:url,attack.mitre.org/techniques/T1557; classtype:trojan-activity; sid:5207079; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1557.001 LLMNR/NBT-NS Poisoning Response Pattern"; flow:established,to_client; http_header; content:"Content-Type|3a| "; pcre:"/Content-Type\x3a[^\r\n]*proxy/i"; reference:url,attack.mitre.org/techniques/T1557/001; classtype:trojan-activity; sid:5207080; rev:1;)

# === MITRE ATT&CK T1003: OS Credential Dumping ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1003.001 LSASS Memory Access via Web Shell"; flow:established,to_server; http_client_body; pcre:"/(procdump|lsass|sekurlsa|logonpasswords|mimikatz)/i"; reference:url,attack.mitre.org/techniques/T1003/001; classtype:attempted-admin; sid:5207081; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1003.002 SAM Database Access via reg save"; flow:established,to_server; http_client_body; pcre:"/reg\s+save\s+(HKLM\\SAM|SAM)/i"; reference:url,attack.mitre.org/techniques/T1003/002; classtype:attempted-admin; sid:5207082; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1003.006 DCShadow/DCSync via lsadump"; flow:established,to_server; http_client_body; pcre:"/(dcshadow|dcsync|lsadump|kerberos_asrep)/i"; reference:url,attack.mitre.org/techniques/T1003/006; classtype:attempted-admin; sid:5207083; rev:1;)

# === MITRE ATT&CK T1218: System Binary Proxy Execution ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1218.005 MSHTA Execution of Remote HTA File"; flow:established,to_server; http_client_body; pcre:"/mshta\s+(http|https|ftp):\/\//i"; reference:url,attack.mitre.org/techniques/T1218/005; classtype:trojan-activity; sid:5207084; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1218.010 Regsvr32 Scrobj.dll Execution"; flow:established,to_server; http_client_body; pcre:"/regsvr32\s+.*scrobj\.dll/i"; reference:url,attack.mitre.org/techniques/T1218/010; classtype:trojan-activity; sid:5207085; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1218.011 Rundll32 Execution of Suspicious DLL"; flow:established,to_server; http_client_body; pcre:"/rundll32\s+.*\.(dll|tmp|dat|old)/i"; reference:url,attack.mitre.org/techniques/T1218/011; classtype:trojan-activity; sid:5207086; rev:1;)

# === MITRE ATT&CK T1490: Inhibit System Recovery ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1490 VSS Deletion via vssadmin Delete Shadows"; flow:established,to_server; http_client_body; pcre:"/vssadmin\s+delete\s+shadows/i"; reference:url,attack.mitre.org/techniques/T1490; classtype:trojan-activity; sid:5207087; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1490 WBAdmin Delete System State Backup"; flow:established,to_server; http_client_body; pcre:"/wbadmin\s+delete\s+(systemstatebackup|catalog)/i"; reference:url,attack.mitre.org/techniques/T1490; classtype:trojan-activity; sid:5207088; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1490 BCD Edit to Disable Automatic Repair"; flow:established,to_server; http_client_body; pcre:"/bcdedit\s+\/set\s+\{default\}\s+recoveryenabled\s+no/i"; reference:url,attack.mitre.org/techniques/T1490; classtype:trojan-activity; sid:5207089; rev:1;)

# === MITRE ATT&CK T1486: Data Encrypted for Impact ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1486 Ransomware File Encryption Pattern - Mass File Modification"; flow:established,to_server; http_method; content:"PUT"; detection_filter:track by_src, count 100, seconds 30; reference:url,attack.mitre.org/techniques/T1486; classtype:trojan-activity; sid:5207090; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1486 Ransomware Extension Pattern - Known Ransom Suffixes"; flow:established,to_server; http_uri; pcre:"/.*\.(locked|encrypted|crypt|enc|crypted|ransom|crypto|locky|wcry|ryuk|lockbit|blackcat|akira)$/i"; reference:url,attack.mitre.org/techniques/T1486; classtype:trojan-activity; sid:5207091; rev:1;)

# === MITRE ATT&CK T1195: Supply Chain Compromise ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1195.002 Compromised Software Update - Unsigned Package Download"; flow:established,to_server; http_uri; pcre:"/.*\.(deb|rpm|msi|pkg|dmg)$/i"; http_header; content:"!Content-Signature"; reference:url,attack.mitre.org/techniques/T1195/002; classtype:trojan-activity; sid:5207092; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1195.001 Open-Source Dependency Confusion Attack"; flow:established,to_server; http_uri; content:"/registry/"; nocase; pcre:"/registry\/.*(npm|pypi|maven|rubygems|nuget)/i"; reference:url,attack.mitre.org/techniques/T1195/001; classtype:trojan-activity; sid:5207093; rev:1;)

# === MITRE ATT&CK T1136: Create Account ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1136.001 New Windows Account Creation via net user"; flow:established,to_server; http_client_body; pcre:"/net\s+user\s+\S+\s+\S+\s+\/add/i"; reference:url,attack.mitre.org/techniques/T1136/001; classtype:attempted-admin; sid:5207094; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1136.002 New Linux Account Creation via useradd/adduser"; flow:established,to_server; http_client_body; pcre:"/(useradd|adduser)\s+-m?\s+-s?\s*\/bin\/(bash|sh|zsh)/i"; reference:url,attack.mitre.org/techniques/T1136/002; classtype:attempted-admin; sid:5207095; rev:1;)

# === MITRE ATT&CK T1008: Fallback Channels ===
alert dns $HOME_NET any -> $EXTERNAL_NET 53 (msg:"MITRE T1008 DNS Fallback C2 Channel - TXT Record Abuse"; flow:established,to_server; dns.query; pcre:"/^[a-z0-9]{32,}\./"; dns.query; pcre:"/\.(txt|akamai|cloudflare|edgekey)\./i"; reference:url,attack.mitre.org/techniques/T1008; classtype:trojan-activity; sid:5207096; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 4444 (msg:"MITRE T1008 Meterpreter Fallback C2 on Port 4444"; flow:established,to_server; reference:url,attack.mitre.org/techniques/T1008; classtype:trojan-activity; sid:5207097; rev:1;)

# === Current Threat Landscape: AI/LLM Attacks ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LLM Security - Prompt Injection via API Endpoint"; flow:established,to_server; http_uri; pcre:"/(\/api\/(chat|completion|generate|inference|llm))|\/v[0-9]+\/(messages|completions|chat)/i"; http_client_body; pcre:"/(ignore.*previous|disregard.*above|system.*prompt|new.*instruction|override.*rules)/i"; classtype:attempted-user; sid:5207098; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LLM Security - Model Extraction Attack via High-Volume API Calls"; flow:established,to_server; http_uri; pcre:"/\/api\/(completion|generate|inference|predict)/i"; detection_filter:track by_src, count 500, seconds 60; classtype:attempted-recon; sid:5207099; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LLM Security - Jailbreak Attempt via DAN/Role-Override Pattern"; flow:established,to_server; http_client_body; pcre:"/(DAN|do anything now|developer mode|jailbreak|act as (god|admin|root|unrestricted)|no restrictions|no rules|no filters)/i"; classtype:attempted-user; sid:5207100; rev:1;)
