# =============================================================================
# Suricata Rules — Mobile Attack Chain Detection
# Detects multi-step mobile exploitation sequences: Frida hook→SSL bypass→credential theft,
#          deep link→WebView JS→native bridge→file theft, repackaging→bypassed checks→harvesting
# Total rules: 10
# SID range: 2313001 - 2313010
# Reference: MITRE ATT&CK T1476, T1477, T1478, T1479, T1480
# =============================================================================

# --- Frida Hook → SSL Pinning Bypass → Credential Intercept → API Data Exfiltration ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN MOBILE-001: Frida Framework Injection - Instrumentation Server Detected on Mobile API"; flow:established,to_server; pcre:"/\/(frida|gadget|agent|linjector|frida-server)/i"; http_uri; classtype:trojan-activity; sid:2313001; rev:1; metadata:chain frida-to-ssl-bypass, mitre T1476, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN MOBILE-002: SSL Pinning Bypass After Frida Hook - Proxy/VPN Connection on Mobile API"; flow:established,to_server; pcre:"/\/api\/v[0-9]+\/(login|auth|session|token)/i"; http_uri; pcre:"/(X-Proxy-Connection|X-Forwarded-For|Via|X-Charles|X-Fiddler|Proxy-Authorization)/i"; http_header; classtype:trojan-activity; sid:2313002; rev:1; metadata:chain frida-to-ssl-bypass, mitre T1477, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN MOBILE-003: Credential Intercept After SSL Bypass - Auth Token in Outbound Request via Proxy"; flow:established,to_server; pcre:"/(Authorization|X-Auth-Token|Bearer|Cookie)\s*:\s*(eyJ|token_|sk_|pk_)/i"; http_header; pcre:"/(X-Proxy-Connection|X-Forwarded-For|Via|X-Charles|X-Fiddler)/i"; http_header; classtype:trojan-activity; sid:2313003; rev:1; metadata:chain credential-intercept-after-ssl-bypass, mitre T1539, created_at 2026_08_21;)

# --- Deep Link → WebView JS Execution → Native Bridge → Local File Theft ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN MOBILE-004: Deep Link Hijacking - Scheme Redirect to WebView with JavaScript Interface"; flow:established,to_server; pcre:"/(myapp|app|mobile|sdk|intent):\/\/[^\/]*\/(webview|browser|load|redirect|open)\b/i"; http_uri; pcre:"/(JavascriptInterface|addJavascriptInterface|@JavascriptInterface)/i"; http_client_body; classtype:web-application-attack; sid:2313004; rev:1; metadata:chain deep-link-to-file-theft, mitre T1476, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN MOBILE-005: WebView JavaScript Bridge Exploitation - File Access via Native Bridge"; flow:established,to_server; pcre:"/(AndroidBridge|WebView|JSBridge|NativeBridge|ReactNative|WebViewBridge|window\.\w+Bridge)/i"; http_client_body; pcre:"/(readFile|writeFile|getFiles|listFiles|openFile|downloadFile|accessFile|readLocalStorage)/i"; http_client_body; classtype:web-application-attack; sid:2313005; rev:1; metadata:chain webview-bridge-to-file-theft, mitre T1476, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN MOBILE-006: Local File Exfiltration After WebView Bridge Exploitation - Sensitive Files in Outbound Request"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(upload|send|sync|backup|report|callback|api\/v[0-9]+\/file)/i"; http_uri; pcre:"/(\.db|\.sqlite|\.plist|\.xml|\.json|\.key|\.pem|\.keystore|\.jks)/i"; http_client_body; classtype:web-application-attack; sid:2313006; rev:1; metadata:chain file-theft-after-webview, mitre T1537, created_at 2026_08_21;)

# --- App Repackaging → Modified Binary → Bypassed Checks → Credential Harvesting ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN MOBILE-007: Repackaged App Detection - Different Signature on Same Package Name"; flow:established,to_server; pcre:"/\/api\/v[0-9]+\/(app\/check|signature\/verify|integrity|attestation|play-protect)/i"; http_uri; pcre:"/(signature_mismatch|different_signer|not_original|debug_certificate|test_keys|repackage)/i"; http_client_body; classtype:trojan-activity; sid:2313007; rev:1; metadata:chain repackaged-app-credential-harvest, mitre T1478, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN MOBILE-008: SafetyNet/Play Integrity Bypass - Root or Tampering Indicator in Device Attestation"; flow:established,to_server; pcre:"/\/api\/v[0-9]+\/(attestation|safetynet|play-integrity|device-check|app-attest)/i"; http_uri; pcre:"/(ctsProfileMatch.*false|basicIntegrity.*false|root.*true|bootloader.*unlocked|tampered.*true|emulator.*true)/i"; http_client_body; classtype:trojan-activity; sid:2313008; rev:1; metadata:chain integrity-bypass, mitre T1478, created_at 2026_08_21;)

# --- Screen Overlay / Accessibility Service Abuse → Credential Harvesting ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN MOBILE-009: Accessibility Service Abuse - Permission Request for Overlay and Accessibility"; flow:established,to_server; pcre:"/\/api\/v[0-9]+\/(permission|accessibility|overlay|draw-over|system-alert)/i"; http_uri; pcre:"/(ACCESSIBILITY_SERVICE|SYSTEM_ALERT_WINDOW|BIND_ACCESSIBILITY_SERVICE|drawOverlay|canDrawOverlays)/i"; http_client_body; classtype:trojan-activity; sid:2313009; rev:1; metadata:chain accessibility-service-abuse, mitre T1476, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN MOBILE-010: Overlay Credential Harvesting - Banking App Login Data Sent to Attacker Server"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(login|signin|auth|authenticate|verify|account|payment|transfer)/i"; http_uri; pcre:"/(card|cc|cvv|pin|password|passwd|ssn|account_number|routing)/i"; http_client_body; pcre:"/[a-z0-9-]+\.(xyz|top|buzz|club|info|online|site|live|cc|tk|ml|ga|cf|pw)/i"; http_host; classtype:trojan-activity; sid:2313010; rev:1; metadata:chain overlay-credential-harvesting, mitre T1189, created_at 2026_08_21;)