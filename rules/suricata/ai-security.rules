alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM AI-SEC-007: PII disclosure in AI response - credit card"; flow:established,to_client; http.response_body; pcre:"/\d{4}[\s-]?\d{4}[\s-]?\d{4}[\s-]?\d{4}/"; sid:3008103; rev:1; metadata:mitre_t1552, pci_dss_3.4;)
