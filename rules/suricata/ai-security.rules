alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM AI-SEC-004: Prompt injection - output format manipulation"; flow:established,to_server; http.request_method; content:"POST"; http.uri; content:"/chat"; nocase; http.request_body; pcre:"/(output|respond|return|print|display)\s+(in|as|using)\s+(JSON|XML|HTML|markdown|code|python|javascript|bash|SQL|shell)/i"; sid:3008004; rev:1; metadata:mitre_t1190, pci_dss_6.5;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM AI-SEC-005: Sensitive data disclosure via AI"; flow:established,to_client; http.response_body; pcre:"/(api[_-]?key|secret[_-]?key|private[_-]?key|database[_-]?password|admin[_-]?password|connection[_-]?string)\s*[:=]\s*[\"'][^\"]{8,}/i"; sid:3008101; rev:1; metadata:mitre_t1552, pci_dss_6.5, gdpr_32, hipaa_164.312;)
