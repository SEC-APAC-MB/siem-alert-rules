alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM AI-SEC-001: Prompt injection - system role override"; flow:established,to_server; http.request_method; content:"POST"; http.uri; content:"/chat"; nocase; http.request_body; pcre:"/(ignore\s+(previous|above|all|your)\s+(instructions|rules|guidelines)|disregard\s+(your|all|previous)\s+(instructions|rules|guidelines)|you\s+are\s+now\s+a|new\s+instructions?\s*:/i"; sid:3008001; rev:1; metadata:mitre_t1190, pci_dss_6.5, nist_si_4;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM AI-SEC-002: Prompt injection - jailbreak attempt"; flow:established,to_server; http.request_method; content:"POST"; http.uri; content:"/chat"; nocase; http.request_body; pcre:"/(DAN|JAILBREAK|MODE|BYPASS|UNRESTRICTED|HACKER|EVIL|DARK|SHADOW)\s+(MODE|PROMPT|INSTRUCTIONS?)/i"; sid:3008002; rev:1; metadata:mitre_t1190, pci_dss_6.5;)
