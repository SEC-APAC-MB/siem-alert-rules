alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM LATR-014: Remote command execution via API"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(exec|execute|run|command|shell|cmd|powershell|bash)/i"; http.header; content:"Authorization: Bearer "; sid:3015017; rev:1; metadata:mitre_t1021, pci_dss_8.1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM LATR-015: Remote access API endpoint"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(ssh|rdp|winrm|wmi|remote|connect|terminal)/i"; http.header; content:"Authorization: Bearer "; sid:3015018; rev:1; metadata:mitre_t1021, pci_dss_8.1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM LATR-016: Scheduled task creation with suspicious command"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(scheduled|tasks?|jobs?|cron|timers?)/i"; http.request_body; pcre:"/(command|script|program|executable)[\":\\s]+[\":\\s]+(powershell|cmd\.exe|wscript|cscript|mshta|rundll32|regsvr32|certutil|bitsadmin)/i"; sid:3015019; rev:1; metadata:mitre_t1053, pci_dss_8.1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET [445,139] (msg:"SIEM LATR-017: Remote service/task creation via SMB"; flow:established,to_server; pcre:"/(schtasks|at\.exe|sc\.exe|net\s+start|net\s+stop|Create\s+Service)/i"; sid:3015020; rev:1; metadata:mitre_t1053, pci_dss_8.1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM LATR-018: Privileged account login from unusual source"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/(login|auth|signin|authenticate)/i"; http.header; content:"X-Forwarded-For:"; http.request_body; pcre:"/(admin|root|service|system|operator|manager)/i"; sid:3015021; rev:1; metadata:mitre_t1078, pci_dss_8.1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM LATR-019: Multiple proxy headers - IP manipulation"; flow:established,to_server; http.header; content:"X-Forwarded-For:"; http.header; content:"X-Real-IP:"; sid:3015022; rev:1; metadata:mitre_t1090, pci_dss_8.1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM LATR-020: Registry run key modification via API"; flow:established,to_server; http.request_method; content:"PUT"; http.uri; pcre:"/\/api\/v[0-9]+\/(config|settings|registry|preferences)/i"; http.request_body; pcre:"/(HKEY_LOCAL_MACHINE|HKEY_CURRENT_USER|HKLM|HKCU)\\\\(Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run|Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\RunOnce|SYSTEM\\\\CurrentControlSet\\\\Services)/i"; sid:3015023; rev:1; metadata:mitre_t1547, pci_dss_8.1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET [445,139,135] (msg:"SIEM LATR-021: Authentication relay attempt"; flow:established,to_server; pcre:"/(Negotiate|NTLM|Kerberos)/"; pcre:"/(challenge|response|relay|reflection|pass-the-hash|overpass-the-hash)/i"; sid:3015024; rev:1; metadata:mitre_t1550, pci_dss_8.1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM LATR-022: Suspicious beaconing endpoint with bot user-agent"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/(checkin|poll|heartbeat|beacon|status|report|callback)/i"; http.header; content:"User-Agent:"; pcre:"/(python-requests|curl|wget|Go-http|node-fetch|Custom|Unknown)/i"; sid:3015025; rev:1; metadata:mitre_t1071, nist_si_4;)

