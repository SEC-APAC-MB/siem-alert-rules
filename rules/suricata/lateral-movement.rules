alert tcp $EXTERNAL_NET any -> $HOME_NET 135 (msg:"SIEM LATR-011: DCOM activation detected"; flow:established,to_server; pcre:"/(IUnknown|IDispatch|IClassFactory|IClassActivator|IOleObject|DcomLaunch)/i"; sid:3015014; rev:1; metadata:mitre_t1021.003, pci_dss_8.1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 53 (msg:"SIEM LATR-012: DNS tunneling - long subdomain query"; flow:established,to_server; pcre:"/[a-zA-Z0-9]{30,}.*\.(com|net|org|info|xyz|top|click|online|site|club)/i"; sid:3015015; rev:1; metadata:mitre_t1071, nist_si_4;)
