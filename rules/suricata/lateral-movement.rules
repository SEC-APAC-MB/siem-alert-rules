alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM LATR-026: Credential harvesting via fake login form"; flow:established,to_server; http.uri; pcre:"/\/(secure-login|account-verify|update-account|confirm-identity|security-check|auth-reset)/i"; sid:3015029; rev:1; metadata:mitre_t1056, pci_dss_6.5;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM LATR-027: Lateral movement via SSH key upload"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(keys?|ssh|authorized_keys?)/i"; http.request_body; pcre:"/(ssh-(rsa|ed25519|ecdsa)|BEGIN\s+(RSA|OPENSSH|DSA)\s+PRIVATE\s+KEY)/i"; sid:3015030; rev:1; metadata:mitre_t1021.004, pci_dss_8.1;)