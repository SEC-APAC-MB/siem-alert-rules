alert tcp $EXTERNAL_NET any -> $HOME_NET 135 (msg:"SIEM LATR-005: WMI remote connection detected"; flow:established,to_server; pcre:"/(IEnumWbemClassObject|IWbemServices|IWbemLocator|Win32_Process|Win32_Service|Win32_OperatingSystem)/i"; sid:3015008; rev:1; metadata:mitre_t1047, pci_dss_8.1;)
