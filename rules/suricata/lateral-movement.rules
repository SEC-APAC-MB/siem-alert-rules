alert tcp $EXTERNAL_NET any -> $HOME_NET 445 (msg:"SIEM LATR-001: SMB admin share access"; flow:established,to_server; content:"IPC$"; nocase; sid:3015001; rev:1; metadata:mitre_t1021.002, pci_dss_8.1;)
