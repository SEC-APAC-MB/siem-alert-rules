# === MITRE ATT&CK Technique-based detections ===

# T1046: Network Service Discovery - Nmap SYN scan detection
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1046 Network Service Discovery Nmap SYN Scan"; flags:S,12; detection_filter:track by_src, count 20, seconds 5; reference:url,attack.mitre.org/techniques/T1046; classtype:network-scan; sid:5208935; rev:1;)

# T1046: Network Service Discovery - UDP scan
alert udp $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1046 UDP Service Scan Detection"; dsize:0; detection_filter:track by_src, count 15, seconds 5; reference:url,attack.mitre.org/techniques/T1046; classtype:network-scan; sid:5208936; rev:1;)

# T1595: Active Scanning - vulnerability scanner user agents
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MITRE T1595 Active Scanning Vulnerability Scanner UA Detection"; flow:to_server,established; pcre:"/User-Agent|3a|.*(nikto|nmap|sqlmap|nessus|acunetix|burp|zap|gobuster|dirb|wpscan|nuclei)/i"; http_header; reference:url,attack.mitre.org/techniques/T1595; classtype:network-scan; sid:5208937; rev:1;)

# T1592: Gather Victim Host Info - SNMP bulk enumeration
alert udp $EXTERNAL_NET any -> $HOME_NET 161 (msg:"MITRE T1592 SNMP Bulk Enumeration Host Info Gathering"; content:"|30 29|"; depth:2; byte_test:1,&,0x20,1; reference:url,attack.mitre.org/techniques/T1592; classtype:attempted-recon; sid:5208938; rev:1;)

# T1592: Gather Victim Host Info - LDAP enumeration
alert tcp $EXTERNAL_NET any -> $HOME_NET 389 (msg:"MITRE T1592 LDAP Directory Enumeration Attempt"; flow:to_server,established; content:"|30 84 00 00 00 0a|"; depth:6; reference:url,attack.mitre.org/techniques/T1592; classtype:attempted-recon; sid:5208939; rev:1;)

# T1110: Brute Force - SSH password spraying
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"MITRE T1110 SSH Brute Force Password Spraying"; flow:to_server,established; content:"SSH-"; depth:4; detection_filter:track by_src, count 10, seconds 30; reference:url,attack.mitre.org/techniques/T1110; classtype:attempted-admin; sid:5208940; rev:1;)

# T1110: Brute Force - RDP credential stuffing
alert tcp $EXTERNAL_NET any -> $HOME_NET 3389 (msg:"MITRE T1110 RDP Brute Force Credential Stuffing"; flow:to_server,established; detection_filter:track by_src, count 15, seconds 60; reference:url,attack.mitre.org/techniques/T1110; classtype:attempted-admin; sid:5208941; rev:1;)

# T1110: Brute Force - HTTP basic auth brute force
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MITRE T1110 HTTP Basic Auth Brute Force"; flow:to_server,established; content:"Authorization|3a| Basic"; http_header; detection_filter:track by_src, count 20, seconds 60; reference:url,attack.mitre.org/techniques/T1110; classtype:attempted-admin; sid:5208942; rev:1;)

# T1059: Command and Scripting Interpreter - PowerShell over HTTP
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MITRE T1059 PowerShell Encoded Command via HTTP"; flow:to_server,established; pcre:"/powershell.*-enc|powershell.*-e /i"; http_uri; reference:url,attack.mitre.org/techniques/T1059; classtype:trojan-activity; sid:5208943; rev:1;)

# T1059: Command and Scripting Interpreter - Python reverse shell
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1059 Python Reverse Shell Connection"; flow:to_server,established; content:"import socket"; depth:14; pcre:"/socket\.connect|subprocess|os\.system/i"; reference:url,attack.mitre.org/techniques/T1059; classtype:trojan-activity; sid:5208944; rev:1;)

# T1071: Application Layer Protocol - DNS tunneling detection
alert dns $HOME_NET any -> $EXTERNAL_NET 53 (msg:"MITRE T1071 DNS Tunneling via Long Subdomain Query"; dns.query.name; pcre:"/^[a-zA-Z0-9]{40,}\./"; dns.query.rrtype:A; reference:url,attack.mitre.org/techniques/T1071; classtype:trojan-activity; sid:5208945; rev:1;)

# T1071: Application Layer Protocol - DNS TXT record exfiltration
alert dns $HOME_NET any -> $EXTERNAL_NET 53 (msg:"MITRE T1071 DNS TXT Record Data Exfiltration"; dns.query.rrtype:TXT; dns.query.name; pcre:"/[a-zA-Z0-9+\/]{50,}/"; reference:url,attack.mitre.org/techniques/T1071; classtype:trojan-activity; sid:5208946; rev:1;)

# T1568: Dynamic Resolution - Dynamic DNS C2 callback
alert dns $HOME_NET any -> $EXTERNAL_NET 53 (msg:"MITRE T1568 Dynamic DNS C2 Callback Detection"; dns.query.name; pcre:"/[a-z0-9]{8,}\.(duckdns|no-ip|ddns|dynu|freedns)\./i"; reference:url,attack.mitre.org/techniques/T1568; classtype:trojan-activity; sid:5208947; rev:1;)

# T1041: Exfiltration Over C2 Channel - large outbound HTTPS to suspicious domain
alert tls $HOME_NET any -> $EXTERNAL_NET $HTTPS_PORTS (msg:"MITRE T1041 Exfiltration Over C2 Channel Large HTTPS Upload"; flow:to_server,established; dsize:>1048576; tls.sni; pcre:"/[a-z0-9]{10,}\.(ru|cn|ir|kp|tk|ml|ga|cf)/i"; reference:url,attack.mitre.org/techniques/T1041; classtype:trojan-activity; sid:5208948; rev:1;)

# T1048: Exfiltration Over Alternative Protocol - outbound FTP to unknown host
alert tcp $HOME_NET any -> $EXTERNAL_NET 21 (msg:"MITRE T1048 Exfiltration Over FTP to Unknown External Host"; flow:to_server,established; content:"STOR"; depth:4; dsize:>524288; reference:url,attack.mitre.org/techniques/T1048; classtype:trojan-activity; sid:5208949; rev:1;)

# T1048: Exfiltration Over Alternative Protocol - DNS zone transfer to external
