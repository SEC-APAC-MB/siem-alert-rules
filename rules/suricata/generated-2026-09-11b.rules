alert http any any -> any any (msg:"ET TROJAN C2 Check-in - Minimal Response Body"; flow:established,to_client; dsize:<50; http.status_code; content:"200"; threshold:type threshold, track by_src, count 20, seconds 120; classtype:command-and-control; sid:5200777; rev:1;)

# === Generic: Credential Stuffing ===
alert http any any -> any any (msg:"ET EXPLOIT Credential Stuffing - Multiple Failed Auth Rapid Sequence"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"login"; nocase; threshold:type threshold, track by_src, count 10, seconds 30; classtype:attempted-admin; sid:5200778; rev:1;)

# === Generic: Crypto Mining ===
alert http any any -> any any (msg:"ET POLICY Cryptocurrency Mining Pool Connection"; flow:established,to_server; http.uri; content:"/mining/"; nocase; classtype:policy-violation; sid:5200779; rev:1;)
alert dns any any -> any any (msg:"ET POLICY Cryptocurrency Mining Domain Query"; dns.query; content:"minexmr"; nocase; classtype:policy-violation; sid:5200780; rev:1;)

# === Generic: IoT/MQTT ===
alert tcp any any -> any 1883 (msg:"ET EXPLOIT MQTT Unauthenticated Connect"; flow:established,to_server; content:"\x10"; depth:1; content:"MQTT"; distance:0; classtype:attempted-recon; sid:5200781; rev:1;)

# === Generic: Kubernetes ===
alert http any any -> any any (msg:"ET EXPLOIT Kubernetes API Server Unauthenticated Access"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/api/v1/"; nocase; content:"watch"; nocase; distance:0; classtype:attempted-recon; sid:5200782; rev:1;)
alert http any any -> any any (msg:"ET EXPLOIT Kubernetes Pod Exec via API"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/exec"; nocase; content:"pods"; http.uri; nocase; distance:0; classtype:attempted-admin; sid:5200783; rev:1;)

# === Generic: Container Escape ===
alert http any any -> any any (msg:"ET EXPLOIT Container Escape Attempt via Docker API"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/containers/create"; nocase; content:"Privileged"; http.request_body; nocase; classtype:attempted-admin; sid:5200784; rev:1;)

# === Generic: OAuth/JWT ===
alert http any any -> any any (msg:"ET EXPLOIT JWT Algorithm Confusion - none Algorithm"; flow:established,to_server; http.header; content:"Bearer"; nocase; pcre:"/eyJhbGciOiJub25lIn0/"; classtype:attempted-admin; sid:5200785; rev:1;)
alert http any any -> any any (msg:"ET EXPLOIT JWT none Algorithm in Request Body"; flow:established,to_server; http.request_body; content:"none"; pcre:"/\"alg\"\s*:\s*\"none\"/i"; classtype:attempted-admin; sid:5200786; rev:1;)

# === Generic: Prototype Pollution ===
alert http any any -> any any (msg:"ET EXPLOIT JavaScript Prototype Pollution - __proto__"; flow:established,to_server; http.request_body; content:"__proto__"; nocase; classtype:attempted-user; sid:5200787; rev:1;)
alert http any any -> any any (msg:"ET EXPLOIT JavaScript Prototype Pollution - constructor"; flow:established,to_server; http.request_body; content:"constructor"; nocase; content:"prototype"; nocase; distance:0; classtype:attempted-user; sid:5200788; rev:1;)

# === Generic: Server-Sent Events Abuse ===
alert http any any -> any any (msg:"ET POLICY Server-Sent Events Connection - Unusual Duration"; flow:established,to_client; http.header; content:"text/event-stream"; nocase; threshold:type both, track by_src, count 1, seconds 3600; classtype:policy-violation; sid:5200789; rev:1;)

# === Generic: GraphQL Abuse ===
alert http any any -> any any (msg:"ET EXPLOIT GraphQL Introspection Query"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"graphql"; nocase; http.request_body; content:"__schema"; nocase; classtype:attempted-recon; sid:5200790; rev:1;)
alert http any any -> any any (msg:"ET EXPLOIT GraphQL Batch Query Abuse - Deep Nesting"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"graphql"; nocase; http.request_body; pcre:"/\{[^\}]*\{[^\}]*\{[^\}]*\{/"; classtype:attempted-dos; sid:5200791; rev:1;)

# === Generic: HTTP Desync/Smuggling ===
alert http any any -> any any (msg:"ET EXPLOIT HTTP Request Smuggling - CL.TE Pattern"; flow:established,to_server; http.header; content:"Content-Length"; nocase; content:"Transfer-Encoding"; nocase; distance:0; classtype:attempted-admin; sid:5200792; rev:1;)
alert http any any -> any any (msg:"ET EXPLOIT HTTP Request Smuggling - TE.CL Conflict"; flow:established,to_server; http.header; content:"Transfer-Encoding|3a| chunked"; nocase; http.header; content:"Content-Length|3a| 0"; nocase; classtype:attempted-admin; sid:5200793; rev:1;)

# === Generic: Reverse Shell ===
alert http any any -> any any (msg:"ET TROJAN Reverse Shell via /dev/tcp"; flow:established,to_server; http.request_body; content:"/dev/tcp/"; classtype:trojan-activity; sid:5200794; rev:1;)
alert http any any -> any any (msg:"ET TROJAN Reverse Shell via bash -i Pattern"; flow:established,to_server; http.request_body; content:"bash -i"; classtype:trojan-activity; sid:5200795; rev:1;)

# === Generic: Cloud Metadata ===
alert http any any -> any any (msg:"ET EXPLOIT AWS IMDSv1 Metadata Access Attempt"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"169.254.169.254/latest/meta-data/"; classtype:attempted-recon; sid:5200796; rev:1;)

# === Generic: API Rate Limiting ===
alert http any any -> any any (msg:"ET POLICY API Rate Limit Exceeded - 429 Responses"; flow:established,to_client; http.status_code; content:"429"; threshold:type threshold, track by_src, count 20, seconds 60; classtype:policy-violation; sid:5200797; rev:1;)

# === Generic: Backup File Access ===
alert http any any -> any any (msg:"ET RECON Backup File Access Attempt - .bak/.sql"; flow:established,to_server; http.method; content:"GET"; pcre:"/\.(bak|sql|db|sqlite|dump)(\.(gz|zip|tar))?$/i"; classtype:attempted-recon; sid:5200798; rev:1;)

# === Generic: Admin Panel Discovery ===
alert http any any -> any any (msg:"ET RECON Admin Panel Discovery - WordPress wp-admin Probe"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/wp-admin/"; nocase; threshold:type threshold, track by_src, count 5, seconds 30; classtype:attempted-recon; sid:5200799; rev:1;)

# === Generic: Cloud Bucket Discovery ===
alert http any any -> any any (msg:"ET RECON Cloud Storage Bucket Enumeration"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"s3.amazonaws.com"; nocase; threshold:type threshold, track by_src, count 10, seconds 30; classtype:attempted-recon; sid:5200800; rev:1;)