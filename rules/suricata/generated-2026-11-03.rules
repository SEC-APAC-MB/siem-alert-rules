# --- MITRE ATT&CK T1136: Create Account ---
alert tcp any any -> any any (msg:"MITRE T1136 Create account via net user add for persistence"; flow:established,to_server; content:"net user"; nocase; content:"/add"; nocase; classtype:attempted-admin; sid:521300083; rev:1;)

# --- MITRE ATT&CK T1547: Boot or Logon Autostart Execution ---
alert tcp any any -> any any (msg:"MITRE T1547 Boot or logon autostart via crontab modification"; flow:established,to_server; content:"crontab"; nocase; content:"-e"; nocase; classtype:trojan-activity; sid:521300084; rev:1;)
alert tcp any any -> any any (msg:"MITRE T1547 Boot or logon autostart via systemd service creation"; flow:established,to_server; content:"systemctl"; nocase; content:"enable"; nocase; content:".service"; nocase; classtype:trojan-activity; sid:521300085; rev:1;)

# --- MITRE ATT&CK T1489: Service Stop ---
alert tcp any any -> any any (msg:"MITRE T1489 Service stop via net stop for security services"; flow:established,to_server; content:"net stop"; nocase; content:"antivirus"; nocase; classtype:attempted-dos; sid:521300086; rev:1;)

# --- MITRE ATT&CK T1496: Resource Hijacking ---
alert tcp any any -> any any (msg:"MITRE T1496 Resource hijacking via cryptominer xmrig process"; flow:established; content:"xmrig"; nocase; content:"pool"; nocase; classtype:trojan-activity; sid:521300087; rev:1;)
alert tcp any any -> any any (msg:"MITRE T1496 Resource hijacking via stratum mining protocol connection"; flow:established,to_server; content:"mining.subscribe"; nocase; classtype:trojan-activity; sid:521300088; rev:1;)

# --- MITRE ATT&CK T1078: Valid Accounts ---
alert ssh any any -> any any (msg:"MITRE T1078 Valid accounts via SSH login from new geographic location"; flow:established; content:"SSH-2.0"; nocase; threshold:type:single,track:by_src,count:1,seconds:86400; classtype:attempted-admin; sid:521300089; rev:1;)

# --- MITRE ATT&CK T1133: External Remote Services ---
alert rdp any any -> any any (msg:"MITRE T1133 External remote services via RDP from external IP"; flow:established; content:"|03 00 00 13|"; dsize:>100; classtype:attempted-admin; sid:521300090; rev:1;)

# --- MITRE ATT&CK T1021: Remote Services ---
alert tcp any any -> any any (msg:"MITRE T1021 Remote services via SSH lateral movement internal"; flow:established; content:"SSH-2.0"; nocase; threshold:type:both,track:by_src,count:10,seconds:60; classtype:attempted-admin; sid:521300091; rev:1;)

# --- MITRE ATT&CK T1550: Use Alternate Authentication Material ---
alert tcp any any -> any any (msg:"MITRE T1550 Use alternate auth material via pass-the-hash Windows"; flow:established; content:"NtlmHash"; nocase; content:"pass"; nocase; classtype:credential-theft; sid:521300092; rev:1;)

# --- MITRE ATT&CK T1620: Reflective Code Loading ---
alert tcp any any -> any any (msg:"MITRE T1620 Reflective code loading via DLL injection in memory"; flow:established; content:"VirtualAlloc"; nocase; content:"WriteProcessMemory"; nocase; classtype:trojan-activity; sid:521300093; rev:1;)

# --- MITRE ATT&CK T1623: Two-Factor Authentication Request Generation ---
alert http any any -> any any (msg:"MITRE T1623 Two-factor auth request generation via MFA push bombing"; flow:established,to_server; http.uri; content:"/mfa/push"; nocase; threshold:type:both,track:by_src,count:10,seconds:60; classtype:trojan-activity; sid:521300094; rev:1;)

# --- MITRE ATT&CK T1534: Internal Spearphishing ---
alert smtp any any -> any any (msg:"MITRE T1534 Internal spearphishing via internal email with executable attachment"; flow:established; content:"Content-Type|3a| application/x-msdos-program"; nocase; classtype:trojan-activity; sid:521300095; rev:1;)

# --- MITRE ATT&CK T1053: Scheduled Task/Job ---
alert tcp any any -> any any (msg:"MITRE T1053 Scheduled task creation via schtasks for persistence"; flow:established,to_server; content:"schtasks"; nocase; content:"/create"; nocase; content:"/sc"; nocase; classtype:trojan-activity; sid:521300096; rev:1;)

# --- MITRE ATT&CK T1106: Native API ---
alert tcp any any -> any any (msg:"MITRE T1106 Native API usage via CreateRemoteThread injection"; flow:established; content:"CreateRemoteThread"; nocase; content:"LoadLibrary"; nocase; classtype:trojan-activity; sid:521300097; rev:1;)

# --- MITRE ATT&CK T1498: Network Denial of Service ---
alert udp any any -> any any (msg:"MITRE T1498 Network DoS via UDP flood amplification attack"; dsize:>1024; threshold:type:both,track:by_src,count:500,seconds:10; classtype:attempted-dos; sid:521300098; rev:1;)

# --- MITRE ATT&CK T1611: Escape to Host ---
alert tcp any any -> any any (msg:"MITRE T1611 Escape to host via container breakout privileged mount"; flow:established,to_server; content:"/proc/1/root"; nocase; content:"nsenter"; nocase; classtype:attempted-privilege-escalation; sid:521300099; rev:1;)
