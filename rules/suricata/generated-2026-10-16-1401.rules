# T1129 Shared Modules - DLL injection via SetWindowsHookEx
alert http $HOME_NET any -> any any (msg:"MITRE T1129 DLL injection via SetWindowsHookEx payload"; flow:established,to_server; http.request_body; pcre:"/(SetWindowsHookEx|WH_KEYBOARD|WH_GETMESSAGE|LoadLibrary\s*\()/i"; classtype:trojan-activity; sid:521277267; rev:1;)

# T1546.008 Application Shimming persistence
alert http $HOME_NET any -> any any (msg:"MITRE T1546.008 Application shimming persistence via sdb install"; flow:established,to_server; http.request_body; pcre:"/(sdbinst\.exe|\.sdb|CustomShim)/i"; classtype:trojan-activity; sid:521277268; rev:1;)

# T1547.001 WMI Event Subscription persistence
alert http $HOME_NET any -> any any (msg:"MITRE T1547.001 WMI event subscription persistence via C2"; flow:established,to_server; http.request_body; pcre:"/(__EventFilter|CommandLineEventConsumer|ActiveScriptEventConsumer)/i"; classtype:trojan-activity; sid:521277269; rev:1;)

# T1134.002 Access Token Manipulation - impersonation
alert http $HOME_NET any -> any any (msg:"MITRE T1134.002 Token impersonation via C2 command"; flow:established,to_server; http.request_body; pcre:"/(ImpersonateLoggedOnUser|DuplicateTokenEx|SetThreadToken|SeImpersonatePrivilege)/i"; classtype:attempted-admin; sid:521277270; rev:1;)

# === MITRE ATT&CK Credential Access & Lateral Movement (71-85) ===

# T1003.001 LSASS memory dump via HTTP exfil
alert http $HOME_NET any -> any any (msg:"MITRE T1003.001 LSASS memory dump exfiltration via HTTP"; flow:established,to_server; http.request_body; pcre:"/(lsass\.dmp|procdump.*lsass|comsvcs.*MiniDump)/i"; classtype:attempted-admin; sid:521277271; rev:1;)

# T1003.002 Security Account Manager dump
alert http $HOME_NET any -> any any (msg:"MITRE T1003.002 SAM database dump via C2 channel"; flow:established,to_server; http.request_body; pcre:"/(reg\s+save\s+HKLM\\SAM|sam\.save|SYSTEM\.save|secrets\.dmp)/i"; classtype:attempted-admin; sid:521277272; rev:1;)

# T1003.006 DCShadow / DCSync via LDAP
alert tcp $HOME_NET any -> any 389 (msg:"MITRE T1003.006 DCSync replication request via LDAP"; flow:established,to_server; content:"|30 84|"; depth:2; pcre:"/(DRSUAPI|DsGetNCChanges|DsaGetNCChanges)/i"; classtype:attempted-admin; sid:521277273; rev:1;)

# T1110.002 Windows credential dumping via Mimikatz
alert http $HOME_NET any -> any any (msg:"MITRE T1110.002 Mimikatz credential dumping via HTTP C2"; flow:established,to_server; http.request_body; pcre:"/(mimikatz|sekurlsa::logonpasswords|lsadump::sam|kerberos::ptt)/i"; classtype:attempted-admin; sid:521277274; rev:1;)

# T1528 Steal Application Access Token - bearer token exfil
alert http $HOME_NET any -> any any (msg:"MITRE T1528 Application access token theft via HTTP exfil"; flow:established,to_server; http.request_body; pcre:"/(eyJ[a-zA-Z0-9_-]{10,}\.eyJ[a-zA-Z0-9_-]{10,}\.[a-zA-Z0-9_-]{10,})/"; classtype:attempted-admin; sid:521277275; rev:1;)

# T1557.001 Adversary-in-the-Middle - SSL stripping
alert tls $HOME_NET any -> any 443 (msg:"MITRE T1557.001 SSL stripping - downgrade from HTTPS to HTTP"; flow:established,to_server; tls.handshake.type; content:"1"; threshold:type both, track by_src, count 1, seconds 60; classtype:attempted-admin; sid:521277276; rev:1;)

# T1021.001 Remote Desktop Protocol lateral movement
alert tcp $HOME_NET any -> $HOME_NET 3389 (msg:"MITRE T1021.001 RDP lateral movement - unusual RDP connection"; flow:established,to_server; threshold:type both, track by_src, count 5, seconds 300; classtype:attempted-admin; sid:521277277; rev:1;)

# T1021.002 SMB lateral movement via admin shares
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"MITRE T1021.002 SMB lateral movement via admin share access"; flow:established,to_server; content:"|00 00 00 2f|"; depth:4; pcre:"/(ADMIN\$|C\$|IPC\$)/i"; classtype:attempted-admin; sid:521277278; rev:1;)

# T1021.004 SSH lateral movement
alert tcp $HOME_NET any -> $HOME_NET 22 (msg:"MITRE T1021.004 SSH lateral movement - internal SSH connection"; flow:established,to_server; threshold:type both, track by_src, count 5, seconds 300; classtype:attempted-admin; sid:521277279; rev:1;)

# T1550.002 Pass the Hash - NTLM authentication
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"MITRE T1550.002 Pass the Hash NTLM authentication attempt"; flow:established,to_server; content:"|4e 54 4c 4d|"; nocase; classtype:attempted-admin; sid:521277280; rev:1;)

# T1550.003 Pass the Ticket - Kerberos ticket reuse
alert tcp $HOME_NET any -> $HOME_NET 88 (msg:"MITRE T1550.003 Pass the ticket - Kerberos TGS request with forged ticket"; flow:established,to_server; content:"|6e 82|"; depth:2; classtype:attempted-admin; sid:521277281; rev:1;)

# T1072 Software Deployment Tools - Ansible abuse
alert http $HOME_NET any -> any any (msg:"MITRE T1072 Software deployment tool abuse - Ansible playbook execution"; flow:established,to_server; http.uri; pcre:"/\/api\/v2\/(job_templates|playbooks)\/\d+\/launch/i"; classtype:attempted-admin; sid:521277282; rev:1;)

# T1555.003 Credentials from Web Browsers - Chrome password extraction
alert http $HOME_NET any -> any any (msg:"MITRE T1555.003 Chrome credential extraction via C2 channel"; flow:established,to_server; http.request_body; pcre:"/(Login\s*Data|Cookies|Local\s*State|chrome.*password)/i"; classtype:attempted-admin; sid:521277283; rev:1;)

# T1212 Exploitation for Credential Access - Kerberoasting
alert tcp $HOME_NET any -> any 88 (msg:"MITRE T1212 Kerberoasting - RC4-HMAC Kerberos ticket request"; flow:established,to_server; content:"|6e 82|"; depth:2; pcre:"/\x17\x00\x00\x00/"; classtype:attempted-admin; sid:521277284; rev:1;)

# T1552.001 Unsecured Credentials in Files - SSH key exfil
alert http $HOME_NET any -> any any (msg:"MITRE T1552.001 SSH private key exfiltration via HTTP"; flow:established,to_server; http.request_body; pcre:"/-----BEGIN\s+(RSA|EC|OPENSSH|DSA)\s+PRIVATE\s+KEY-----/i"; classtype:attempted-admin; sid:521277285; rev:1;)

# === Current Threat Landscape & Data Exfiltration (86-100) ===

# T1041 Exfiltration Over C2 Channel - large POST body
alert http $HOME_NET any -> any any (msg:"MITRE T1041 Data exfiltration via large HTTP POST to suspicious domain"; flow:established,to_server; http.method; content:"POST"; nocase; dsize:>1000000; classtype:trojan-activity; sid:521277286; rev:1;)

# T1567.002 Exfiltration to Cloud Storage - AWS S3 upload
alert http $HOME_NET any -> any any (msg:"MITRE T1567.002 Data exfiltration to AWS S3 bucket"; flow:established,to_server; http.host; pcre:"/[a-z0-9-]+\.s3\.amazonaws\.com/i"; http.method; content:"PUT"; nocase; dsize:>500000; classtype:trojan-activity; sid:521277287; rev:1;)

# T1567.002 Exfiltration to Cloud Storage - Azure Blob
alert http $HOME_NET any -> any any (msg:"MITRE T1567.002 Data exfiltration to Azure Blob storage"; flow:established,to_server; http.host; pcre:"/[a-z0-9]+\.blob\.core\.windows\.net/i"; http.method; content:"PUT"; nocase; dsize:>500000; classtype:trojan-activity; sid:521277288; rev:1;)

# T1567.001 Exfiltration to Code Repository - GitHub push
alert http $HOME_NET any -> any any (msg:"MITRE T1567.001 Data exfiltration via GitHub push to external repo"; flow:established,to_server; http.host; content:"github.com"; nocase; http.uri; pcre:"/\/[^\/]+\/[^\/]+\.git\/git-receive-pack/i"; dsize:>100000; classtype:trojan-activity; sid:521277289; rev:1;)

# T1048.002 Exfiltration Over Asymmetric Encrypted Channel - HTTPS to paste site
alert tls $HOME_NET any -> any 443 (msg:"MITRE T1048.002 Encrypted exfiltration to paste service"; flow:established,to_server; tls.sni; pcre:"/(paste\.bin|paste\.ee|hastebin|dpaste|ghostbin|privatebin)/i"; classtype:trojan-activity; sid:521277290; rev:1;)

# T1090.003 Proxy Chain - TOR exit node traffic
alert tls any any -> $HOME_NET 443 (msg:"MITRE T1090.003 TOR exit node inbound connection to internal service"; flow:established,to_server; tls.sni; content:""; classtype:trojan-activity; sid:521277291; rev:1;)

# T1568.002 Domain Generation Algorithm - DGA pattern DNS query
alert dns $HOME_NET any -> any 53 (msg:"MITRE T1568.002 DGA-based DNS query pattern detected"; dns.query.name; pcre:"/^[a-z0-9]{10,20}\.(ru|cn|tk|ml|ga|cf|gq)$/i"; classtype:trojan-activity; sid:521277292; rev:1;)

# T1071.001 Web Protocols - Beaconing pattern to suspicious host
alert http $HOME_NET any -> any any (msg:"MITRE T1071.001 HTTP beaconing pattern - periodic connection"; flow:established,to_server; threshold:type both, track by_src, count 30, seconds 300; classtype:trojan-activity; sid:521277293; rev:1;)

# T1573.002 Encrypted Channel - TLS to newly registered domain
alert tls $HOME_NET any -> any 443 (msg:"MITRE T1573.002 TLS connection to newly registered domain"; flow:established,to_server; tls.sni; pcre:"/(cheap|free|discount|offer|deal|bonus|promo)\.(ru|cn|tk|ml|ga|cf|gq|top|xyz)$/i"; classtype:trojan-activity; sid:521277294; rev:1;)

# T1486 Data Encrypted for Impact - ransomware file extension pattern
alert smb $HOME_NET any -> $HOME_NET any (msg:"MITRE T1486 Ransomware file encryption activity - mass file rename on SMB share"; flow:established,to_server; content:"|00 00 00 2f|"; depth:4; pcre:"/\.(locked|encrypted|crypto|locked|wcry|ryuk|revil|blackcat|lockbit)/i"; threshold:type both, track by_src, count 50, seconds 60; classtype:trojan-activity; sid:521277295; rev:1;)

# T1490 Inhibit System Recovery - vssadmin delete shadows
alert http $HOME_NET any -> any any (msg:"MITRE T1490 Volume shadow copy deletion via C2 channel"; flow:established,to_server; http.request_body; pcre:"/(vssadmin\s+delete\s+shadows|wbadmin\s+delete\s+catalog|bcdedit\s+\/set.*recoveryenabled)/i"; classtype:trojan-activity; sid:521277296; rev:1;)

# T1489 Service Stop - mass service termination
alert http $HOME_NET any -> any any (msg:"MITRE T1489 Mass service termination via C2 command"; flow:established,to_server; http.request_body; pcre:"/(net\s+stop\s+\w+.*\s+\/y|sc\s+stop\s+\w+|taskkill\s+\/f\s+\/im)/i"; threshold:type both, track by_src, count 10, seconds 60; classtype:trojan-activity; sid:521277297; rev:1;)

# T1561.002 Disk Wipe - raw disk write via C2
alert http $HOME_NET any -> any any (msg:"MITRE T1561.002 Raw disk wipe command via C2 channel"; flow:established,to_server; http.request_body; pcre:"/(dd\s+if=\/dev\/zero\s+of=\/dev\/(sd|nvme|hd)|format\s+[a-z]:\s+\/fs:|cipher\s+\/w:)/i"; classtype:trojan-activity; sid:521277298; rev:1;)

# T1070.004 File Deletion - clearing security logs
alert http $HOME_NET any -> any any (msg:"MITRE T1070.004 Security log clearing via C2 command"; flow:established,to_server; http.request_body; pcre:"/(wevtutil\s+cl\s+Security|auditpol\s+\/clear|Remove-EventLog|Clear-EventLog)/i"; classtype:trojan-activity; sid:521277299; rev:1;)

# T1562.002 Impair Defenses - disable security tools via C2
alert http $HOME_NET any -> any any (msg:"MITRE T1562.002 Security tool disablement via C2 channel"; flow:established,to_server; http.request_body; pcre:"/(Set-MpPreference\s+-Disable|netsh\s+advfirewall\s+set.*off|sc\s+config\s+(WinDefend|Sense|MsMpEng).*disabled)/i"; classtype:trojan-activity; sid:521277300; rev:1;)
