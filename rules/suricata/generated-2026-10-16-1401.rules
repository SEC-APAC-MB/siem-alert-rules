# CVE-2026-111391 - SGLang Code Injection in _evaluate_filter()
alert http any any -> any any (msg:"CVE-2026-111391 SGLang _evaluate_filter code injection attempt"; flow:established,to_server; http.uri; content:"/evaluate"; nocase; http.request_body; content:"__import__"; nocase; pcre:"/(__import__|exec|eval|compile|os\.system)/i"; reference:cve,2026-111391; classtype:attempted-user; sid:521277201; rev:1;)

