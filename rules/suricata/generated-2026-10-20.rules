alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"HTTP/2 rapid reset attack"; flow:established,to_server; content:"RST_STREAM"; detection_filter:track by_src, count 100, seconds 1; classtype:attempted-dos; sid:521278602; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Cache poisoning via X-Forwarded-Host"; flow:established,to_server; http.header; content:"X-Forwarded-Host"; http.response_header; content:"X-Cache"; content:"HIT"; classtype:web-application-attack; sid:521278603; rev:1;)
alert dns $HOME_NET any -> any 53 (msg:"DNS rebind attack detection"; flow:established,to_server; dns.query; pcre:"/[a-z0-9]+\.(local|internal|lan)/i"; classtype:trojan-activity; sid:521278604; rev:1;)
