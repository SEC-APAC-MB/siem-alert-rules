# --- Memcached ---
alert udp $EXTERNAL_NET any -> $HOME_NET 11211 (msg:"DB ATTACK - Memcached - Amplification Attack - STATS"; content:"stats"; nocase:true; dsize:<100; threshold:type both, track by_src, count 1, seconds 60; classtype:attempted-dos; sid:2302053; rev:1; metadata:created_at 2026-08-17;)
alert udp $EXTERNAL_NET any -> $HOME_NET 11211 (msg:"DB ATTACK - Memcached - Amplification Attack - VERSION"; content:"version"; nocase:true; dsize:<20; classtype:attempted-dos; sid:2302054; rev:1; metadata:created_at 2026-08-17;)

# --- Generic Database Protocol ---
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"DB ATTACK - Generic - SQL Error Information Disclosure"; flow:established,to_client; pcre:"/(You have an error in your SQL syntax|ORA-\d{5}|PostgreSQL.*ERROR|Microsoft OLE DB Provider|ODBC SQL Server Driver|SQLSTATE\[\w+\]|mysqli_error|sqlite_query\(\))/i"; http_server_body; classtype:web-application-attack; sid:2302055; rev:1; metadata:created_at 2026-08-17;)