# --- ElasticSearch Protocol Attacks ---
alert http $EXTERNAL_NET any -> $HOME_NET 9200 (msg:"DB ATTACK - ElasticSearch - Unauthenticated Access Attempt"; flow:established,to_server; content:"GET"; http_method; pcre:"/^\/(_cat|_cluster|_nodes|_search|_mapping|_aliases)/i"; http_uri; classtype:attempted-login; sid:2302031; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET 9200 (msg:"DB ATTACK - ElasticSearch - Cluster Health Recon"; flow:established,to_server; content:"/_cluster/health"; http_uri; classtype:attempted-recon; sid:2302032; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET 9200 (msg:"DB ATTACK - ElasticSearch - Index Deletion"; flow:established,to_server; content:"DELETE"; http_method; pcre:"/\/[a-z_][a-z0-9_-]*/i"; http_uri; classtype:attempted-admin; sid:2302033; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET 9200 (msg:"DB ATTACK - ElasticSearch - Script Injection via _search"; flow:established,to_server; content:"/_search"; http_uri; pcre:"/\"script\".*\"source\"/i"; http_client_body; classtype:web-application-attack; sid:2302034; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET 9200 (msg:"DB ATTACK - ElasticSearch - Sensitive Index Access - .security"; flow:established,to_server; content:"/.security"; http_uri; classtype:attempted-admin; sid:2302035; rev:1; metadata:created_at 2026-08-17;)

