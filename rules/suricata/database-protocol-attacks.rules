# =============================================================================
# Suricata Rules — Database Protocol Attacks
# Covers: MySQL, PostgreSQL, MongoDB, Redis, ElasticSearch, Memcached,
#          Microsoft SQL Server, Oracle, Cassandra, Neo4j, InfluxDB
# Total rules: 55
# SID range: 2302001 - 2302055
# =============================================================================

# --- MySQL Protocol Attacks ---
alert tcp $EXTERNAL_NET any -> $HOME_NET 3306 (msg:"DB ATTACK - MySQL - Authentication Brute Force"; flow:established,to_server; content:"|00 00 00|"; depth:4; content:"|01|"; within:1; distance:1; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-login; sid:2302001; rev:1; metadata:created_at 2026-08-17;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 3306 (msg:"DB ATTACK - MySQL - Root Login Attempt"; flow:established,to_server; content:"root"; within:30; content:"|00|"; distance:0; classtype:attempted-login; sid:2302002; rev:1; metadata:created_at 2026-08-17;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 3306 (msg:"DB ATTACK - MySQL - Default Account Login - Empty Password"; flow:established,to_server; content:"|00 00 00 00 00|"; classtype:attempted-login; sid:2302003; rev:1; metadata:created_at 2026-08-17;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 3306 (msg:"DB ATTACK - MySQL - UNION SELECT Injection in Query"; flow:established,to_server; content:"UNION"; nocase:true; content:"SELECT"; nocase:true; distance:0; within:50; classtype:web-application-attack; sid:2302004; rev:1; metadata:created_at 2026-08-17;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 3306 (msg:"DB ATTACK - MySQL - LOAD_FILE Data Exfiltration"; flow:established,to_server; content:"LOAD_FILE"; nocase:true; classtype:web-application-attack; sid:2302005; rev:1; metadata:created_at 2026-08-17;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 3306 (msg:"DB ATTACK - MySQL - INTO OUTFILE File Write"; flow:established,to_server; content:"INTO"; nocase:true; content:"OUTFILE"; nocase:true; distance:0; within:20; classtype:web-application-attack; sid:2302006; rev:1; metadata:created_at 2026-08-17;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 3306 (msg:"DB ATTACK - MySQL - SLEEP Benchmark DoS"; flow:established,to_server; content:"SLEEP"; nocase:true; content:"("; distance:0; within:5; classtype:web-application-attack; sid:2302007; rev:1; metadata:created_at 2026-08-17;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 3306 (msg:"DB ATTACK - MySQL - INFORMATION_SCHEMA Access"; flow:established,to_server; content:"INFORMATION_SCHEMA"; nocase:true; classtype:web-application-attack; sid:2302008; rev:1; metadata:created_at 2026-08-17;)

