# === MITRE ATT&CK DEFENSE EVASION (T1027, T1140, T1036) (66-75) ===

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1027 Obfuscated Files - Base64 Encoded Payload"; flow:established,to_server; http.request_body; pcre:"/[A-Za-z0-9+\/]{200,}={0,2}/"; reference:url,attack.mitre.org/techniques/T1027; classtype:attempted-admin; sid:521275365; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1027.002 Software Packing - UPX Executable"; flow:established,to_client; http.response_body; content:"UPX"; depth 100; reference:url,attack.mitre.org/techniques/T1027; classtype:trojan-activity; sid:521275366; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1140 Deobfuscate/Decode - Inline Execution"; flow:established,to_server; http.request_body; pcre:"/(?:base64\s+-d|gunzip|unzip|tar\s+-xzf)\s*\|/i"; reference:url,attack.mitre.org/techniques/T1140; classtype:attempted-admin; sid:521275367; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1036 Masquerading - Rename System Binary"; flow:established,to_server; http.request_body; pcre:"/(?:cp|mv|copy|rename)\s+.*(?:cmd\.exe|powershell|bash|sh|nc|netcat)/i"; reference:url,attack.mitre.org/techniques/T1036; classtype:attempted-admin; sid:521275368; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1070.004 File Deletion - Clearing Logs"; flow:established,to_server; http.request_body; pcre:"/(?:rm\s+-rf|del\s+\/[fq]|shred|wipe)\s+.*(?:\.log|var\/log|eventlog)/i"; reference:url,attack.mitre.org/techniques/T1070; classtype:attempted-admin; sid:521275369; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1562.001 Impair Defenses - Disable Antivirus"; flow:established,to_server; http.request_body; pcre:"/(?:taskkill|kill|sc\s+stop|systemctl\s+stop)\s+.*(?:av|antivirus|defender|clamav|crowdstrike|sentinelone)/i"; reference:url,attack.mitre.org/techniques/T1562; classtype:attempted-admin; sid:521275370; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1112 Modify Registry - Security Setting Tampering"; flow:established,to_server; http.request_body; pcre:"/(?:CurrentVersion\\Policies\\System|EnableLUA|ConsentPromptBehaviorAdmin)/i"; reference:url,attack.mitre.org/techniques/T1112; classtype:attempted-admin; sid:521275371; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1027.013 Encrypted/Encoded Protocol - XOR Pattern"; flow:established,to_server; pcre:"/[\x00-\x1f]{20,}/"; reference:url,attack.mitre.org/techniques/T1027; classtype:trojan-activity; sid:521275372; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1036.005 Masquerading - Match Legitimate Name"; flow:established,to_server; http.request_body; pcre:"/(?:svchost|csrss|lsass|explorer|spoolsv|services)\.(?:exe|dll)/i"; content:"tmp"; nocase; reference:url,attack.mitre.org/techniques/T1036; classtype:trojan-activity; sid:521275373; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1070.006 Timestomp - File Timestamp Modification"; flow:established,to_server; http.request_body; pcre:"/(?:touch\s+-t|touch\s+-r|touch\s+-d)/i"; reference:url,attack.mitre.org/techniques/T1070; classtype:attempted-admin; sid:521275374; rev:1;)

# === MITRE ATT&CK CREDENTIAL ACCESS (T1110, T1056) (76-85) ===

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1110.001 Password Guessing - Multiple Auth Attempts"; flow:established,to_server; threshold:type both, track by_src, count 15, seconds 120; http.uri; content:"/login"; nocase; http.response_code; content:"401"; reference:url,attack.mitre.org/techniques/T1110; classtype:attempted-admin; sid:521275375; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1110.002 Password Cracking - Hash Dump via HTTP"; flow:established,to_server; http.request_body; pcre:"/(?:hashcat|john|--hash-type|samdump|pwdump|secretsdump)/i"; reference:url,attack.mitre.org/techniques/T1110; classtype:attempted-admin; sid:521275376; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1110.003 Kerberoasting - SPN Request Pattern"; flow:established,to_server; http.request_body; pcre:"/(?:GetUserSPNs|requestSPN|kerberoast|Rubeus\s+kerberoast)/i"; reference:url,attack.mitre.org/techniques/T1110; classtype:attempted-admin; sid:521275377; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1110.004 Credential Dumping - LSASS Access"; flow:established,to_server; http.request_body; pcre:"/(?:procdump|MiniDump|comsvcs|CreateMiniDump|lsass\.dmp)/i"; reference:url,attack.mitre.org/techniques/T1110; classtype:attempted-admin; sid:521275378; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1056.004 Input Capture - Keylogger Deployment"; flow:established,to_server; http.request_body; pcre:"/(?:SetWindowsHookEx|GetAsyncKeyState|GetForegroundWindow|keylog)/i"; reference:url,attack.mitre.org/techniques/T1056; classtype:trojan-activity; sid:521275379; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1552.001 Credentials In Files - Accessing Credential Store"; flow:established,to_server; http.request_body; pcre:"/(?:\.ssh\/id_rsa|\.aws\/credentials|\.env|\.git-credentials|\.npmrc)/i"; reference:url,attack.mitre.org/techniques/T1552; classtype:sensitive-data; sid:521275380; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1528 Steal Application Access Token"; flow:established,to_server; http.header; content:"Authorization"; nocase; content:"Bearer"; nocase; pcre:"/eyJ[A-Za-z0-9_-]{10,}/"; reference:url,attack.mitre.org/techniques/T1528; classtype:sensitive-data; sid:521275381; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1110 Brute Force - Credential Stuffing with Breach Data"; flow:established,to_server; threshold:type both, track by_src, count 50, seconds 60; http.uri; content:"/login"; nocase; http.method; content:"POST"; reference:url,attack.mitre.org/techniques/T1110; classtype:attempted-admin; sid:521275382; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1555 Credentials from Password Stores - Browser Credential Access"; flow:established,to_server; http.request_body; pcre:"/(?:Login Data|cookies\.sqlite|key4\.db|Chrome\/.*\/Login Data|Firefox\/.*\/logins\.json)/i"; reference:url,attack.mitre.org/techniques/T1555; classtype:sensitive-data; sid:521275383; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1110.004 AS-REP Roasting - Pre-auth Disabled"; flow:established,to_server; http.request_body; pcre:"/(?:GetNPUsers|asreproast|Rubeus\s+asreproast)/i"; reference:url,attack.mitre.org/techniques/T1110; classtype:attempted-admin; sid:521275384; rev:1;)

# === MITRE ATT&CK LATERAL MOVEMENT & COLLECTION (T1021, T1557) (86-90) ===

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1021.004 Remote Services - SSH Lateral Movement"; flow:established,to_server; http.request_body; pcre:"/(?:ssh\s+-i\s+|ssh\s+-o\s+StrictHostKeyChecking=no)/i"; reference:url,attack.mitre.org/techniques/T1021; classtype:attempted-admin; sid:521275385; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1021.002 SMB/Admin Share Access via HTTP Tunnel"; flow:established,to_server; http.request_body; pcre:"/(?:\\\\ADMIN\$|\\\\C\$|\\\\IPC\$|psexec|wmic)/i"; reference:url,attack.mitre.org/techniques/T1021; classtype:attempted-admin; sid:521275386; rev:1;)
alert tls $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1557 Adversary-in-the-Middle - TLS Interception"; flow:established; tls.cert_subject; pcre:"/CN=[^,]+.*(?!Expected)/"; reference:url,attack.mitre.org/techniques/T1557; classtype:attempted-admin; sid:521275387; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1557.001 LLMNR/NBT-NS Poisoning - Responder Detection"; flow:established,to_server; http.uri; pcre:"/wpad|proxy\.pac/i"; reference:url,attack.mitre.org/techniques/T1557; classtype:attempted-admin; sid:521275388; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1560 Archive Collected Data - Data Staging"; flow:established,to_server; http.request_body; pcre:"/(?:tar\s+czf|zip\s+-r|7z\s+a|rar\s+a)\s+.*(?:\/tmp|\/var\/tmp|C:\\Temp|C:\\Users)/i"; reference:url,attack.mitre.org/techniques/T1560; classtype:attempted-admin; sid:521275389; rev:1;)

# === MITRE ATT&CK EXFILTRATION & C2 (T1041, T1071, T1048) (90-100) ===

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1041 Exfiltration Over C2 Channel - Large HTTP POST"; flow:established,to_server; dsize:>1048576; http.method; content:"POST"; reference:url,attack.mitre.org/techniques/T1041; classtype:exfiltration; sid:521275390; rev:1;)
alert dns $HOME_NET any -> any 53 (msg:"MITRE T1071.004 DNS Tunneling - Long TXT Query"; dns.query.name; pcre:"/[a-z0-9]{50,}\./"; dns.query.type; content:"TXT"; reference:url,attack.mitre.org/techniques/T1071; classtype:trojan-activity; sid:521275391; rev:1;)
alert dns $HOME_NET any -> any 53 (msg:"MITRE T1071.004 DNS Tunneling - High Volume NXDOMAIN"; flow:established; threshold:type both, track by_src, count 100, seconds 60; reference:url,attack.mitre.org/techniques/T1071; classtype:trojan-activity; sid:521275392; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1048.002 Exfiltration Over Alternative Protocol - HTTPS to File Sharing"; flow:established,to_server; http.host; pcre:"/(?:send\.anywhere|wetransfer|filebin|gofile|transfer\.sh|0x0\.st)/i"; reference:url,attack.mitre.org/techniques/T1048; classtype:exfiltration; sid:521275393; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1041 Exfiltration - Beacon to Suspicious Domain"; flow:established,to_server; http.host; pcre:"/^(?:[a-z0-9]{8,}\.(?:tk|ml|ga|cf|gq|xyz|top|cc|ws))$/i"; reference:url,attack.mitre.org/techniques/T1041; classtype:trojan-activity; sid:521275394; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1071.001 Web Service - C2 via Popular Platform"; flow:established,to_server; http.host; pcre:"/(?:api\.telegram|discord\.com\/api|api\.slack|api\.github)\.(?:com|org)/i"; http.method; content:"POST"; threshold:type both, track by_src, count 30, seconds 300; reference:url,attack.mitre.org/techniques/T1071; classtype:trojan-activity; sid:521275395; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1048.003 Exfiltration Over Unencrypted Non-C2 Protocol"; flow:established,to_server; http.host; content:"pastebin"; nocase; http.method; content:"POST"; reference:url,attack.mitre.org/techniques/T1048; classtype:exfiltration; sid:521275396; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1567.002 Exfiltration to Cloud Storage - S3 Upload"; flow:established,to_server; http.host; pcre:"/\.s3\.amazonaws\.com|\.blob\.core\.windows\.net|storage\.googleapis\.com/i"; http.method; content:"PUT"; dsize:>65536; reference:url,attack.mitre.org/techniques/T1567; classtype:exfiltration; sid:521275397; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1071.001 Application Layer Protocol - C2 Heartbeat Pattern"; flow:established,to_server; threshold:type both, track by_src, count 1, seconds 30; pcre:"/^(?:POST|GET)\s+\/(?:beacon|checkin|heartbeat|ping|alive)/i"; reference:url,attack.mitre.org/techniques/T1071; classtype:trojan-activity; sid:521275398; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1041 Exfiltration - Mass Data Transfer to Unknown CDN"; flow:established,to_server; dsize:>5242880; http.host; pcre:"/^(?!.*(google|cloudflare|amazon|azure|akamai|fastly|microsoft|apple)).*\.(?:com|net|org)$/i"; reference:url,attack.mitre.org/techniques/T1041; classtype:exfiltration; sid:521275399; rev:1;)
