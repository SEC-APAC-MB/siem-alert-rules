alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB SSRF via Dict Protocol"; flow:established,to_server; pcre:"/(url|dest|redirect)=dict:\/\//Pi"; classtype:web-application-attack; sid:5203097; rev:1;)

# --- Container escape patterns ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Container Escape via Docker Socket Mount"; flow:established,to_server; content:"POST"; http_method; content:"/containers/create"; http_uri; content:"/var/run/docker.sock"; http_client_body; classtype:attempted-admin; sid:5203098; rev:1;)

# --- Malicious document patterns ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Malicious Macro Document Download"; flow:established,to_server; content:"GET"; http_method; pcre:"/\.(doc|docm|xls|xlsx|xlsm|ppt|pptm)\.php/Pi"; classtype:trojan-activity; sid:5203099; rev:1;)

# --- Firmware injection / IoT ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT IoT Firmware Update without Integrity Check"; flow:established,to_server; content:"POST"; http_method; content:"firmware"; nocase; http_uri; content:"!Content-MD5"; http_header; content:"!X-Checksum"; http_header; classtype:web-application-attack; sid:5203100; rev:1;)