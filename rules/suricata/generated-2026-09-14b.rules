alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET CLOUD Kubernetes API Server Unauthenticated Access"; flow:established,to_server; content:"GET"; http_method; content:"/api/v1/namespaces"; http_uri; content:"!Authorization"; http_header; classtype:web-application-attack; sid:5203065; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET CLOUD Docker API Unauthenticated Container Create"; flow:established,to_server; content:"POST"; http_method; content:"/containers/create"; http_uri; content:"!Authorization"; http_header; classtype:web-application-attack; sid:5203066; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET CLOUD GCP Metadata SSRF Exploitation"; flow:established,to_server; content:"GET"; http_method; content:"/computeMetadata/v1/"; http_uri; content:"Metadata-Flavor"; http_header; content:"Google"; http_header; classtype:web-application-attack; sid:5203067; rev:1;)

# --- Supply chain / Dependency confusion ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET SUPPLY_CHAIN Suspicious Internal Package Registry Pull"; flow:established,to_server; content:"GET"; http_method; content:"/npm/"; http_uri; pcre:"/\.(tgz|whl|jar)/Pi"; threshold:type both, track by_src, count 10, seconds 60; classtype:web-application-attack; sid:5203068; rev:1;)

# --- API abuse patterns ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB API Rate Limiting Evasion via Header Manipulation"; flow:established,to_server; content:"GET"; http_method; content:"X-Forwarded-For"; http_header; threshold:type both, track by_src, count 20, seconds 30; classtype:web-application-attack; sid:5203069; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB GraphQL Mutation Abuse Excessive Data Export"; flow:established,to_server; content:"POST"; http_method; content:"/graphql"; http_uri; content:"mutation"; nocase; http_client_body; content:"export"; nocase; http_client_body; classtype:web-application-attack; sid:5203070; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB JWT Token Forgery Attempt None Algorithm"; flow:established,to_server; content:"POST"; http_method; pcre:"/eyJhbGciOiJub25lIi/gPi"; classtype:web-application-attack; sid:5203071; rev:1;)

# --- Ransomware / extortion patterns ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET RANSOMWARE Possible Ransomware Note Delivery via HTTP"; flow:established,to_client; content:"your files have been encrypted"; nocase; http_client_body; classtype:trojan-activity; sid:5203072; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET RANSOMWARE Crypto Payment Address in HTTP Response"; flow:established,to_client; pcre:"/[13][a-km-zA-HJ-NP-Z1-9]{25,34}|bc1[a-zA-Hm-z0-9]{25,65}/Pi"; content:"pay"; nocase; http_client_body; classtype:trojan-activity; sid:5203073; rev:1;)

# --- Cryptocurrency / DeFi attack patterns ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB CryptoPayment Gateway Unauthorized Admin Access"; flow:established,to_server; content:"POST"; http_method; content:"/wp-admin/admin-ajax.php"; http_uri; content:"action=cryptopay"; nocase; http_client_body; content:"!Cookie"; http_header; classtype:web-application-attack; sid:5203074; rev:1;)

# --- Deserialization attacks ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB Java Deserialization Attack Apache Commons"; flow:established,to_server; content:"POST"; http_method; pcre:"/rO0AB|aced0005|javax\./Pi"; classtype:web-application-attack; sid:5203075; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB PHP Deserialization Object Injection"; flow:established,to_server; pcre:"/(?:^|&)[^=]*=(?:O:\d+:|a:\d+:\{)/Pi"; classtype:web-application-attack; sid:5203076; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB Python Pickle Deserialization Attack"; flow:established,to_server; pcre:"/\x80\x[0-5]/Pi"; classtype:web-application-attack; sid:5203077; rev:1;)

# --- SSRF patterns ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB SSRF via URL Parameter Cloud Metadata"; flow:established,to_server; pcre:"/(url|dest|redirect|return|rurl|image|source|path|file)=https?:\/\/169\.254\.169\.254/Pi"; classtype:web-application-attack; sid:5203078; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB SSRF via URL Parameter Internal Network"; flow:established,to_server; pcre:"/(url|dest|redirect|return|rurl)=https?:\/\/(127\.\d+\.\d+\.\d+|0\.0\.0\.0|localhost|\[::1?\])/Pi"; classtype:web-application-attack; sid:5203079; rev:1;)

# --- XXE patterns ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB XXE External Entity Injection Attempt"; flow:established,to_server; pcre:"/<!DOCTYPE\s[^>]*\s+SYSTEM\s+[\"']https?:/Pi"; classtype:web-application-attack; sid:5203080; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB XXE Parameter Entity Injection"; flow:established,to_server; pcre:"/<!ENTITY\s+\S+\s+SYSTEM\s+[\"']/Pi"; classtype:web-application-attack; sid:5203081; rev:1;)

# --- Template injection ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB Server-Side Template Injection SSTI Attempt"; flow:established,to_server; pcre:"/\{\{.*(__class__|__mro__|__subclasses__|__builtins__|config|request).*\}\}/Pi"; classtype:web-application-attack; sid:5203082; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB Jinja2 SSTI via Expression Language"; flow:established,to_server; pcre:"/\{\{.*(__class__|__bases__|__subclasses__).*\}\}/Pi"; classtype:web-application-attack; sid:5203083; rev:1;)

# --- Prototype pollution ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB JavaScript Prototype Pollution via HTTP POST"; flow:established,to_server; content:"POST"; http_method; content:"__proto__"; nocase; http_client_body; classtype:web-application-attack; sid:5203084; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB Constructor Prototype Pollution Attempt"; flow:established,to_server; content:"constructor"; nocase; http_client_body; content:"prototype"; nocase; http_client_body; classtype:web-application-attack; sid:5203085; rev:1;)

# --- Web shell detection ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB PHP Web Shell Upload Attempt"; flow:established,to_server; content:"POST"; http_method; content:"Content-Disposition"; http_header; content:"filename="; nocase; http_client_body; pcre:"/filename=[\"']?\w+\.(php|phtml|php[0-9])/Pi"; classtype:web-application-attack; sid:5203086; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB ASPX Web Shell Upload Attempt"; flow:established,to_server; content:"POST"; http_method; content:"Content-Disposition"; http_header; content:"filename="; nocase; http_client_body; pcre:"/filename=[\"']?\w+\.aspx?/Pi"; classtype:web-application-attack; sid:5203087; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB JSP Web Shell Upload Attempt"; flow:established,to_server; content:"POST"; http_method; content:"Content-Disposition"; http_header; content:"filename="; nocase; http_client_body; pcre:"/filename=[\"']?\w+\.jsp[x]?/Pi"; classtype:web-application-attack; sid:5203088; rev:1;)

# --- DNS tunneling ---
alert dns $HOME_NET any -> $EXTERNAL_NET any (msg:"ET TROJAN DNS Tunneling High Volume TXT Queries"; content:"TXT"; threshold:type both, track by_src, count 20, seconds 60; classtype:trojan-activity; sid:5203089; rev:1;)
alert dns $HOME_NET any -> $EXTERNAL_NET any (msg:"ET TROJAN DNS Tunneling Long Subdomain Exfiltration"; content:"|00|"; pcre:"/[a-zA-Z0-9]{50,}/"; threshold:type both, track by_src, count 5, seconds 300; classtype:trojan-activity; sid:5203090; rev:1;)

# --- DDoS patterns ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET DOS HTTP Slowloris Connection Exhaustion"; flow:established,to_server; content:"GET"; http_method; threshold:type both, track by_src, count 100, seconds 10; classtype:attempted-dos; sid:5203091; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET DOS HTTP Flood Rapid Request Pattern"; flow:established,to_server; content:"GET"; http_method; threshold:type both, track by_src, count 200, seconds 10; classtype:attempted-dos; sid:5203092; rev:1;)

# --- Living off the land binary abuse ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Living-off-the-Land Certutil Download"; flow:established,to_server; content:"GET"; http_method; pcre:"/(certutil|mshta|bitsadmin|msiexec|mofcomp)\.exe/Pi"; classtype:trojan-activity; sid:5203093; rev:1;)

# --- Memory injection / Process hollowing ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET EXPLOIT Process Hollowing Injection Pattern"; flow:established,to_server; pcre:"/(CreateProcess|VirtualAllocEx|WriteProcessMemory|CreateRemoteThread)/Pi"; classtype:attempted-admin; sid:5203094; rev:1;)

# --- WebSocket abuse ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"ET WEB WebSocket Command Injection via Unauthenticated Endpoint"; flow:established,to_server; content:"Upgrade"; http_header; content:"websocket"; nocase; http_header; content:"cmd"; nocase; http_client_body; pcre:"/cmd[^&]*(%3B|%7C|%60)/Pi"; classtype:web-application-attack; sid:5203095; rev:1;)

# --- SSRF deeper patterns ---
