alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1048 Exfiltration Over Alternative Protocol - data upload to cloud storage"; flow:established,to_server; pcre:"/(?:s3\.amazonaws\.com|storage\.googleapis\.com|blob\.core\.windows\.net)\/[a-z0-9-]+\//i"; dsize:1000000; classtype:exfiltration; sid:521275591; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1567 Exfiltration Over Web Service - data upload to pastebin-like service"; flow:established,to_server; pcre:"/(?:pastebin\.com|paste\.bin|hastebin\.com|0bin\.net|dpaste\.org)\/(?:api\/)?post/i"; classtype:exfiltration; sid:521275592; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1486 Data Encrypted for Impact - ransomware note delivery"; flow:established,to_server; pcre:"/(?:YOUR FILES ARE ENCRYPTED|RANSOM|DECRYPT|bitcoin|wallet address|BTC)/i"; classtype:trojan-activity; sid:521275593; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1490 Inhibit System Recovery - vssadmin delete shadows"; flow:established,to_server; pcre:"/vssadmin\s+delete\s+shadows\s+\/all\s+\/quiet|wbadmin\s+delete\s+catalog/i"; classtype:attempted-admin; sid:521275594; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1498 Network DoS - HTTP flood attack pattern"; flow:established,to_server; threshold:type both, track by_src, count 100, seconds 10; pcre:"/GET\s+\/\s+HTTP\/1\.[01]/i"; classtype:attempted-dos; sid:521275595; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1499 Endpoint DoS - resource exhaustion via large upload"; flow:established,to_server; pcre:"/Content-Length\x3a\s*[1-9]\d{8,}/Hi"; classtype:attempted-dos; sid:521275596; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1485 Data Destruction - rm -rf root filesystem attempt"; flow:established,to_server; pcre:"/rm\s+-rf\s+\/(?:\s|$|\*)|rm\s+-rf\s+\/etc\/|rm\s+-rf\s+\/var\/|rm\s+-rf\s+\/home\//i"; classtype:attempted-admin; sid:521275597; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1561 Disk Wipe - dd to disk device via web injection"; flow:established,to_server; pcre:"/dd\s+if=\/dev\/(?:zero|urandom|random)\s+of=\/dev\/(?:sd|nvme|hd|xvd)/i"; classtype:attempted-admin; sid:521275598; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1489 Service Stop - mass service termination via web injection"; flow:established,to_server; pcre:"/(?:systemctl|service)\s+stop\s+(?:nginx|apache2|httpd|mysql|postgresql|redis|docker)/i"; classtype:attempted-admin; sid:521275599; rev:1;)
