alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1070 Indicator Removal - log clearing via web injection"; flow:established,to_server; pcre:"/(?:history\s+-c|cat\s+\/dev\/null\s+>|truncate\s+-s\s+0\s+\/var\/log|rm\s+-f\s+\/var\/log\/)/i"; classtype:attempted-admin; sid:521275568; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1562 Impair Defenses - disabling security tools via web"; flow:established,to_server; pcre:"/(?:systemctl|service)\s+stop\s+(?:firewalld|iptables|suricata|zeek|auditd)/i"; classtype:attempted-admin; sid:521275569; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1497 Virtualization/Sandbox Evasion - VM detection in payload"; flow:established,to_server; pcre:"/VBoxService|vmware-tools|qemu-ga|xenservice|\/proc\/cpuinfo.*hypervisor/i"; classtype:trojan-activity; sid:521275570; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1620 Reflective Code Loading - .NET assembly loading via web"; flow:established,to_server; pcre:"/Assembly\.Load|ReflectiveDllImport|Invoke-Assembly/i"; classtype:trojan-activity; sid:521275571; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1140 Deobfuscate - Python zlib decompress of embedded payload"; flow:established,to_server; pcre:"/zlib\.decompress|marshal\.loads|code\.CodeType/i"; classtype:trojan-activity; sid:521275572; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1070.004 File Deletion - secure wipe via shred command"; flow:established,to_server; pcre:"/shred\s+-ufz\s+-n\s+\d+\s+\/(?:tmp|var\/tmp|home|usr)/i"; classtype:attempted-admin; sid:521275573; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1562.001 Disable or Modify Tools - AV bypass via AMSI patch"; flow:established,to_server; pcre:"/amsi\.dll\s+\x7b\x00|patch_amsi|bypass_amsi|AmsiScanBuffer/i"; classtype:trojan-activity; sid:521275574; rev:1;)

# === MITRE ATT&CK CREDENTIAL ACCESS (76-82) ===

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1110 Brute Force - HTTP basic auth brute force attempt"; flow:established,to_server; content:"Authorization"; http_header; threshold:type both, track by_src, count 20, seconds 60; classtype:attempted-user; sid:521275575; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1552 Unsecured Credentials - .env file access attempt"; flow:established,to_server; pcre:"/\/(?:\.env|\.env\.local|\.env\.production|\.env\.development)(?:\.(?:bak|old|swp))?$/i"; classtype:web-application-attack; sid:521275576; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1552.001 Credentials In Files - SSH private key exfiltration"; flow:established,to_server; pcre:"/-----BEGIN\s+(RSA|EC|OPENSSH|DSA)\s+PRIVATE\s+KEY-----/i"; classtype:attempted-user; sid:521275577; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1110.003 Password Spraying - multiple user accounts from single IP"; flow:established,to_server; content:"password"; nocase; http_client_body; threshold:type both, track by_src, count 30, seconds 300; classtype:attempted-user; sid:521275578; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1555 Credentials from Password Stores - browser credential theft"; flow:established,to_server; pcre:"/\/(?:AppData|Library)\/Application Support\/(?:Google\/Chrome|Mozilla\/Firefox|Safari)\/(?:Login Data|logins\.json|key4\.db)/i"; classtype:attempted-user; sid:521275579; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1056 Input Capture - keylogger payload delivery"; flow:established,to_server; pcre:"/xinput\s+list|getevent|\/dev\/input\/event|SetWindowsHookEx|WH_KEYBOARD_LL/i"; classtype:trojan-activity; sid:521275580; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1528 Steal Application Access Token - JWT extraction attempt"; flow:established,to_server; pcre:"/eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}/"; classtype:attempted-user; sid:521275581; rev:1;)

# === MITRE ATT&CK LATERAL MOVEMENT & C2 (83-90) ===

alert tcp $EXTERNAL_NET any -> $HOME_NET 3389 (msg:"MITRE T1021.001 Remote Desktop Protocol - suspicious RDP connection from external"; flow:established,to_server; pcre:"/\x03\x00\x00[\x09-\x13]\x00[\x00-\x05]\xe0[\x00-\x00]\x00\x00\x00\x00\x00/"; threshold:type both, track by_src, count 5, seconds 60; classtype:trojan-activity; sid:521275582; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 5985 (msg:"MITRE T1021.006 WinRM - external WinRM access attempt"; flow:established,to_server; content:"WSMAN"; nocase; pcre:"/POST\s+\/wsman\s+HTTP\/1\.[01]/i"; classtype:trojan-activity; sid:521275583; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 5432 (msg:"MITRE T1021.004 PostgreSQL - external database direct access"; flow:established,to_server; pcre:"/\x00\x00\x00\x08\x04\xd2\x16\x2f/"; classtype:trojan-activity; sid:521275584; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1071 Application Layer Protocol - DNS over HTTPS tunneling"; flow:established,to_server; content:"/dns-query"; http_uri; pcre:"/https:\/\/(?:cloudflare-dns\.com|dns\.google|dns\.quad9\.net)\/dns-query/i"; classtype:trojan-activity; sid:521275585; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1105 Ingress Tool Transfer - suspicious file download to temp"; flow:established,to_server; content:"/tmp/"; http_uri; pcre:"/\/tmp\/(?:\.[-_a-z]|\.[a-z]{1,3}$)/i"; classtype:trojan-activity; sid:521275586; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1572 Non-Standard Port - HTTP traffic on non-standard port"; flow:established,to_server; pcre:"/^(?!.*(80|443|8080|8443)).*HTTP\/1\.[01]/"; classtype:trojan-activity; sid:521275587; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1568 Dynamic Resolution - DGA domain pattern in DNS query"; flow:established,to_server; pcre:"/[a-z0-9]{12,20}\.(?:tk|ml|ga|cf|gq|xyz|top|click|loan|club|wang|cyou)/i"; classtype:trojan-activity; sid:521275588; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1090 Proxy - Tor exit node connection to internal service"; flow:established,to_server; pcre:"/Tor|exit.*/i"; content:"User-Agent"; http_header; pcre:"/User-Agent\x3a\s*Tor/i"; classtype:trojan-activity; sid:521275589; rev:1;)

