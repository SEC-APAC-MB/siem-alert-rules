alert http any any -> any any (msg:"MITRE T1059 PowerShell encoded command execution via web"; flow:established,to_server; http.request_body; pcre:"/(powershell|pwsh).*-e(ncodedcommand)?\s+[A-Za-z0-9+/]{100,}/i"; classtype:attempted-admin; sid:52124080; rev:1;)
alert http any any -> any any (msg:"MITRE T1059 Python reverse shell via web request"; flow:established,to_server; http.request_body; pcre:"/(python|python3).*socket.*connect.*exec/i"; classtype:attempted-admin; sid:52124081; rev:1;)
alert http any any -> any any (msg:"MITRE T1059 Ruby command execution via web parameter"; flow:established,to_server; http.uri; pcre:"/(ruby|rb).*-e.*system|`.*`/i"; classtype:attempted-admin; sid:52124082; rev:1;)

# === MITRE ATT&CK T1486: Data Encrypted for Impact ===
alert http any any -> any any (msg:"MITRE T1486 ransomware encryption activity indicator"; flow:established,to_server; http.request_body; pcre:"/(\.locked|\.encrypted|\.crypto|\.ransom|\.encrypted_by)/i"; threshold:type both, count 20, seconds 60, track by_src; classtype:attempted-admin; sid:52124083; rev:1;)

# === MITRE ATT&CK T1567: Exfiltration over Web Service ===
alert http any any -> any any (msg:"MITRE T1567 data exfiltration to cloud storage - large upload"; flow:established,to_server; http.method; content:"PUT"; pcre:"/(s3\.amazonaws|blob\.core\.windows|storage\.googleapis)/i"; dsize:>10485760; classtype:exfiltration; sid:52124084; rev:1;)
alert http any any -> any any (msg:"MITRE T1567 exfiltration to pastebin-like service"; flow:established,to_server; http.method; content:"POST"; pcre:"/(pastebin|hastebin|dpaste|0bin|ghostbin|privatebin)/i"; dsize:>102400; classtype:exfiltration; sid:52124085; rev:1;)

# === MITRE ATT&CK T1199: Trusted Relationship ===
alert http any any -> any any (msg:"MITRE T1199 trusted relationship abuse - OAuth token"; flow:established,to_server; http.header; content:"Authorization"; nocase; content:"Bearer"; nocase; http.uri; content:"/api/admin"; nocase; classtype:attempted-admin; sid:52124086; rev:1;)

# === MITRE ATT&CK T1133: External Remote Services ===
alert http any any -> any any (msg:"MITRE T1133 external remote services VPN brute force"; flow:established,to_server; http.uri; pcre:"/(\/sslvpn|\/remote\/login|\/+ssl_vpn)/i"; threshold:type both, count 20, seconds 60, track by_src; classtype:attempted-user; sid:52124087; rev:1;)

# === MITRE ATT&CK T1531: Account Access Removal ===
alert http any any -> any any (msg:"MITRE T1531 account access removal - mass user deletion"; flow:established,to_server; http.method; content:"DELETE"; http.uri; pcre:"/\/api\/users\//i"; threshold:type both, count 10, seconds 30, track by_src; classtype:attempted-admin; sid:52124088; rev:1;)

# === AI/LLM attacks ===
alert http any any -> any any (msg:"AI-LLM prompt injection attempt via web input"; flow:established,to_server; http.request_body; pcre:"/(ignore.*previous.*instructions|system.*prompt|you\s+are\s+now|DAN|jailbreak)/i"; classtype:attempted-user; sid:52124089; rev:1;)
alert http any any -> any any (msg:"AI-LLM SSRF via tool call to internal endpoint"; flow:established,to_server; http.request_body; pcre:"/(tool_call|function_call|tool_use).*http:\/\/(127\.0\.0\.1|localhost|10\.|192\.168\.)/i"; classtype:attempted-admin; sid:52124090; rev:1;)
alert http any any -> any any (msg:"AI-LLM data exfiltration via generated URL"; flow:established,to_server; http.uri; pcre:"/https?:\/\/[a-z0-9]+\.(?:worker\.dev|ngrok|serveo|loca\.lt)/i"; http.request_body; pcre:"/(exfiltrate|download_data|read_file)/i"; classtype:exfiltration; sid:52124091; rev:1;)

# === Supply chain attacks ===
alert http any any -> any any (msg:"Supply chain attack - npm package typosquatting"; flow:established,to_server; http.uri; pcre:"/\/(npm|registry)\//i"; pcre:"/(lodash-es|reactt|express-session-mongo|mongoose-validat|ract|vu|angualr)/i"; classtype:trojan-activity; sid:52124092; rev:1;)
alert http any any -> any any (msg:"Supply chain attack - PyPI package typosquatting"; flow:established,to_server; http.uri; content:"/pypi/"; nocase; pcre:"/(requets|djang0|flask-restful-api|python-dateutil2|numpyy)/i"; classtype:trojan-activity; sid:52124093; rev:1;)

# === Cloud security ===
alert http any any -> any any (msg:"Cloud IMDSv1 access without IMDSv2 token"; flow:established,to_server; http.uri; content:"/latest/meta-data/"; nocase; http.header; pcre:"/(?!.*X-aws-ec2-metadata-token)/"; classtype:attempted-admin; sid:52124094; rev:1;)
alert http any any -> any any (msg:"Cloud S3 bucket enumeration without authorization"; flow:established,to_server; http.method; content:"GET"; http.uri; pcre:"/https?:\/\/[a-z0-9-]+\.s3[.-](?:amazonaws|amazonaws\.com)/i"; pcre:"/(?!.*[Aa]uthorization)/"; http.stat_code; content:"403"; classtype:attempted-recon; sid:52124095; rev:1;)

# === Container security ===
alert http any any -> any any (msg:"Container escape - Docker socket access via web"; flow:established,to_server; http.uri; pcre:"/\/var\/run\/docker\.sock/i"; classtype:attempted-admin; sid:52124096; rev:1;)
alert http any any -> any any (msg:"Container escape - Kubernetes API with service account token"; flow:established,to_server; http.uri; content:"/api/v1/"; nocase; http.header; content:"Bearer"; nocase; pcre:"/(?!.*[Cc]lient-[Cc]ert)/"; classtype:attempted-admin; sid:52124097; rev:1;)

# === API security ===
alert http any any -> any any (msg:"API IDOR via sequential ID enumeration"; flow:established,to_server; http.uri; pcre:"/\/api\/(users|orders|accounts)\/\d{1,5}$/i"; threshold:type both, count 20, seconds 30, track by_src; classtype:attempted-user; sid:52124098; rev:1;)
alert http any any -> any any (msg:"API mass assignment - role escalation via PUT/PATCH"; flow:established,to_server; http.method; pcre:"/(PUT|PATCH)/i"; http.request_body; pcre:"/(\"role\"|\"isAdmin\"|\"is_admin\"|\"admin\"|\"superuser\").*true/i"; classtype:attempted-admin; sid:52124099; rev:1;)

# === IoT/OT security ===
alert http any any -> any any (msg:"IoT device default credential usage admin/admin"; flow:established,to_server; http.method; content:"POST"; http.uri; pcre:"/(login|auth|signin)/i"; http.request_body; pcre:"/(user|username).*(admin|root).*pass(word|wd).*(admin|root|12345|password)/i"; classtype:attempted-admin; sid:52124100; rev:1;)

# === Mobile security ===
alert http any any -> any any (msg:"Mobile app certificate pinning bypass via Frida"; flow:established,to_server; http.request_body; pcre:"/(frida-server|objection|ssl-pinning-bypass)/i"; classtype:attempted-user; sid:52124101; rev:1;)

# === Zero-day / N-day exploitation ===
alert http any any -> any any (msg:"N-day exploit - Confluence OGNL injection variant"; flow:established,to_server; http.uri; pcre:"/\/server-info\.action/i"; http.request_body; pcre:"/(\$\{|\x24\x7b).*(ognl|@java|@runtime|getClass)/i"; classtype:web-application-attack; sid:52124102; rev:1;)
alert http any any -> any any (msg:"N-day exploit - Ivanti Connect Secure path traversal"; flow:established,to_server; http.uri; pcre:"/(\/.*\.cgi\/.*\.\.\/|\/cgi-bin\/.*%2e%2e)/i"; classtype:web-application-attack; sid:52124103; rev:1;)

# === DNS exfiltration ===
alert dns any any -> any any (msg:"DNS tunneling exfiltration - high entropy subdomain"; dns.query; pcre:"/^[a-z0-9]{30,}\./i"; classtype:exfiltration; sid:52124104; rev:1;)

# === CSRF attacks ===
alert http any any -> any any (msg:"CSRF token missing on state-changing request"; flow:established,to_server; http.method; pcre:"/(POST|PUT|DELETE|PATCH)/i"; http.header; pcre:"/(?!.*[Cc]srf|.*[Xx]-[Cc]srf|.*[Aa]nti-)/"; http.uri; pcre:"/(\/api\/(users|settings|admin|config|password))/i"; classtype:web-application-attack; sid:52124105; rev:1;)

# === XXE attacks ===
alert http any any -> any any (msg:"XXE external entity injection - DOCTYPE entity declaration"; flow:established,to_server; http.request_body; pcre:"/<!DOCTYPE.*<!ENTITY.*SYSTEM/i"; classtype:web-application-attack; sid:52124106; rev:1;)

# === SSRF attacks ===
alert http any any -> any any (msg:"SSRF attempt - internal URL in web parameter"; flow:established,to_server; http.request_body; pcre:"/url=http:\/\/(127\.0\.0\.1|localhost|0\.0\.0\.0|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)/i"; classtype:web-application-attack; sid:52124107; rev:1;)
