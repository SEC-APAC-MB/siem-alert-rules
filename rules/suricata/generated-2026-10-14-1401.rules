alert tcp $EXTERNAL_NET any -> $HOME_NET 47808 (msg:"ICS security - BACnet unauthorized device write"; flow:established,to_server; content:"|01 00|"; depth:2; byte_test:1,=,0x0f,0,relative; classtype:attempted-admin; sid:521275987; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 2404 (msg:"ICS security - IEC 61850 MMS unauthorized control"; flow:established,to_server; content:"|a0|"; depth:1; classtype:attempted-admin; sid:521275988; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 445 (msg:"Network infra - SMBv1 protocol usage detected"; flow:established,to_server; content:"|ff 53 4d 42|"; depth:4; content:"|00 00 00 00|"; offset:4; depth:4; classtype:protocol-command-decode; sid:521275989; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 3389 (msg:"Network infra - RDP brute force connection attempt"; flow:established,to_server; detection_filter:track by_src, count 20, seconds 60; classtype:attempted-user; sid:521275990; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"Network infra - SSH brute force authentication attempts"; flow:established,to_server; detection_filter:track by_src, count 10, seconds 30; classtype:attempted-user; sid:521275991; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Data exfil - large CSV data upload to file sharing service"; flow:established,to_server; http.host; pcre:"/(wetransfer|filebin|send-anywhere|gofile|transfer\.sh)/i"; http.method; content:"POST"; dsize:>1048576; classtype:exfiltration; sid:521275992; rev:1;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"Data exfil - TLS connection to paste service with large payload"; tls.sni; pcre:"/(pastebin|paste\.bin|hastebin|ghostbin|zerobin)/i"; dsize:>512000; classtype:exfiltration; sid:521275993; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Data exfil - DNS over HTTPS tunneling to alternative resolver"; flow:established,to_server; http.host; pcre:"/(cloudflare-dns|dns\.google|quad9|dns\.quad9)/i"; http.uri; content:"/dns-query"; classtype:trojan-activity; sid:521275994; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Privilege escalation - sudo command execution via web shell"; flow:established,to_server; http.request_body; pcre:"/sudo\s+(su|bash|sh|cat|vi|nano)\s/i"; classtype:attempted-admin; sid:521275995; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Privilege escalation - setuid binary creation attempt"; flow:established,to_server; http.request_body; pcre:"/chmod\s+[4-7][0-7][0-7][0-7]/"; classtype:attempted-admin; sid:521275996; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Privilege escalation - /etc/passwd or /etc/shadow access via HTTP"; flow:established,to_server; http.request_body; pcre:"/\/etc\/(passwd|shadow|sudoers)/i"; classtype:attempted-admin; sid:521275997; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Reconnaissance - directory traversal via dirsearch pattern"; flow:established,to_server; http.uri; pcre:"/(\.git\/|\.env|\.svn\/|\.DS_Store|web\.config|\.htaccess)/i"; classtype:attempted-recon; sid:521275998; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Reconnaissance - security camera DVR default credential attempt"; flow:established,to_server; http.uri; content:"/login"; nocase; http.request_body; pcre:"/(admin|root|support)\/(admin|root|12345|password|support)/i"; classtype:attempted-user; sid:521275999; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Reconnaissance - WordPress version disclosure via generator meta"; flow:established,to_server; http.uri; content:"/wp-login.php"; nocase; http.request_body; pcre:"/generator.*WordPress\s+\d/i"; classtype:attempted-recon; sid:521276000; rev:1;)
