# =============================================================================
# Suricata Rules — Web Application Attack Chain Detection
# Detects multi-step web exploitation sequences where individual techniques
# are chained together to achieve full compromise.
# Total rules: 25
# SID range: 2308001 - 2308025
# Reference: MITRE ATT&CK TA0001 Initial Access → TA0003 Persistence → TA0009 Collection
# =============================================================================

# --- SQLi → Information Schema → Credential Dump → Privilege Escalation ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-001: SQLi UNION SELECT information_schema Enumeration - Schema Extraction Phase"; flow:established,to_server; pcre:"/(\bUNION\b\s*\bSELECT\b.*\binformation_schema\b|\bSELECT\b.*\bFROM\b\s+information_schema\.(tables|columns|schemata))/i"; http_uri; classtype:web-application-attack; sid:2308001; rev:1; metadata:chain sqli-to-privilege-escalation, mitre T1190, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-002: SQLi Credential Extraction - Password Hash Dump from User Table"; flow:established,to_server; pcre:"/\b(SELECT|UNION\s+SELECT)\b.*\bFROM\b\s*(users?|accounts?|logins?|sys\.sql_logins|mysql\.user|pg_shadow|dba_users)\b.*\b(password|passwd|pwd|pass_hash|password_hash|credential|secret|token)\b/i"; http_uri; classtype:web-application-attack; sid:2308002; rev:1; metadata:chain sqli-to-privilege-escalation, mitre T1552, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-003: SQLi xp_cmdshell or LOAD_FILE OS Command Execution - RCE Phase"; flow:established,to_server; pcre:"/(xp_cmdshell|LOAD_FILE|INTO\s+OUTFILE|INTO\s+DUMPFILE|COPY\s+.*\s+TO\s+PROGRAM|UTL_FILE|UTL_HTTP|DBMS_SCHEDULER)/i"; http_uri; classtype:web-application-attack; sid:2308003; rev:1; metadata:chain sqli-to-rce, mitre T1059, created_at 2026_08_21;)

# --- XSS → Cookie Theft → Session Hijacking → Account Takeover ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-004: XSS Cookie Theft - Script Injection Accessing document.cookie"; flow:established,to_server; pcre:"/(document\.cookie|document\.location|window\.location|navigator\.__cookie|__utmz)\s*[;)\]]/i"; http_uri; classtype:web-application-attack; sid:2308004; rev:1; metadata:chain xss-to-session-hijack, mitre T1189, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-005: XSS Session Token Exfiltration via Image Tag or Fetch Request"; flow:established,to_server; pcre:"/(new\s+Image\(\)|\.src\s*=|fetch\s*\(|XMLHttpRequest|\.open\s*\().*(document\.cookie|session_id|auth_token|_sid|PHPSESSID|JSESSIONID|ASP\.NET_SessionId)/i"; http_uri; classtype:web-application-attack; sid:2308005; rev:1; metadata:chain xss-to-session-hijack, mitre T1539, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN WEB-006: Session Token in Outbound Request - Hijacked Session Exfiltration"; flow:established,to_client; pcre:"/(PHPSESSID|JSESSIONID|ASP\.NET_SessionId|session_id|_sid|auth_token|access_token)\s*=\s*[A-Za-z0-9+\/=]{16,}/i"; http_uri; classtype:web-application-attack; sid:2308006; rev:1; metadata:chain xss-to-session-hijack, mitre T1539, created_at 2026_08_21;)

# --- SSRF → Cloud Metadata → IAM Credential Theft → Data Exfiltration ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-007: SSRF Cloud Metadata Endpoint Access - Credential Harvesting Phase"; flow:established,to_server; pcre:"/(169\.254\.169\.254|metadata\.google\.internal|metadata\.azure\.app|100\.100\.100\.200).*(\/latest\/meta-data\/|\/computeMetadata\/v1\/|\/metadata\/instance|\/identity-credentials\/)/i"; http_uri; classtype:web-application-attack; sid:2308007; rev:1; metadata:chain ssrf-to-cloud-credential-theft, mitre T1552.005, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-008: SSRF IAM Role Credential Request via IMDSv1 - Token Extraction"; flow:established,to_server; content:"169.254.169.254"; http_uri; pcre:"/\/latest\/meta-data\/iam\/security-credentials\//i"; classtype:web-application-attack; sid:2308008; rev:1; metadata:chain ssrf-to-cloud-credential-theft, mitre T1552.005, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN WEB-009: AWS IAM Credential Exfiltration After SSRF - Access Key in Outbound Request"; flow:established,to_server; pcre:"/AKIA[A-Z0-9]{16}/i"; http_client_body; classtype:web-application-attack; sid:2308009; rev:1; metadata:chain ssrf-to-cloud-credential-theft, mitre T1537, created_at 2026_08_21;)

# --- Path Traversal → Config File Read → Database Credential Extraction ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-010: Path Traversal Config File Access - Credential Harvesting Phase"; flow:established,to_server; pcre:"/(\.\.\/|\.\.\\|%2e%2e%2f|%252e%252e).*(\/etc\/passwd|\/etc\/shadow|\/\.env|wp-config\.php|config\.(yml|yaml|json|xml|ini|php|py)|database\.(yml|yaml|json)|appsettings\.(json|yml)|\.htpasswd|\.env\.local|credentials|secrets\.(yml|json|py))/i"; http_uri; classtype:web-application-attack; sid:2308010; rev:1; metadata:chain path-traversal-to-credential-theft, mitre T1083, created_at 2026_08_21;)
alert http $HOME_NET any -> $HOME_NET any (msg:"CHAIN WEB-011: Database Credential in HTTP Response After Path Traversal - JDBC/MySQL/PostgreSQL/Redis"; flow:established,to_client; pcre:"/(jdbc:(mysql|postgresql|oracle|sqlserver|mongodb):\/\/|ConnectionString.*Password=|DB_PASSWORD=|DATABASE_URL=|redis:\/\/:.*@|mysql:\/\/.*:.*@|postgres:\/\/.*:.*@)/i"; http_response_body; classtype:web-application-attack; sid:2308011; rev:1; metadata:chain path-traversal-to-credential-theft, mitre T1552, created_at 2026_08_21;)

# --- File Upload → Web Shell → Reverse Shell → Lateral Movement ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-012: Web Shell Upload - PHP/JSP/ASP Shell via File Upload"; flow:established,to_server; content:"POST"; http_method; pcre:"/filename\s*=\s*\"[^\"]+\.(php|jsp|aspx?|cfm|py|rb|pl|sh)\"/i"; http_header; pcre:"/(c99|r57|b374k|wso|alfa|filesman|mini|cmd|shell|backdoor|webshell|upload|execute)/i"; http_client_body; classtype:web-application-attack; sid:2308012; rev:1; metadata:chain upload-to-rce, mitre T1105, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-013: Reverse Shell via Web Shell - Command Execution After Upload"; flow:established,to_server; pcre:"/(bash\s+-i\s+>&\s*\/dev\/tcp|nc\s+-[elsv]+\s+\d+\.\d+\.\d+\.\d+\s+\d+|python\s+-c\s+.*socket.*connect|perl\s+-e\s+.*socket.*connect|ruby\s+-e\s+.*socket.*connect|powershell.*reverse.*tcp|\/bin\/sh\s+-i|cmd\.exe.*\/c.*powershell)/i"; http_client_body; classtype:web-application-attack; sid:2308013; rev:1; metadata:chain upload-to-rce, mitre T1059, created_at 2026_08_21;)

# --- Request Smuggling → Cache Poisoning → Account Takeover ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-014: HTTP Request Smuggling - CL.TE Conflict with Double Content-Length"; flow:established,to_server; content:"Content-Length"; http_header; pcre:"/Content-Length\s*:\s*\d+[\r\n]+.*Content-Length\s*:\s*\d+/i"; http_header; classtype:web-application-attack; sid:2308014; rev:1; metadata:chain request-smuggling, mitre T1133, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-015: HTTP Request Smuggling - TE.CL Conflict with Chunked Transfer Encoding"; flow:established,to_server; content:"Transfer-Encoding"; http_header; content:"chunked"; http_header; content:"Content-Length"; http_header; classtype:web-application-attack; sid:2308015; rev:1; metadata:chain request-smuggling, mitre T1133, created_at 2026_08_21;)

# --- JWT None Algorithm → Admin Role Assignment → Mass Data Access ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-016: JWT None Algorithm Exploit - Algorithm Confusion for Auth Bypass"; flow:established,to_server; pcre:"/(eyJ[a-zA-Z0-9_-]+\.eyJ[a-zA-Z0-9_-]+\.[a-zA-Z0-9_-]*|alg[\"']\s*:\s*[\"']none[\"'])/i"; http_header; classtype:web-application-attack; sid:2308016; rev:1; metadata:chain jwt-to-privilege-escalation, mitre T1606, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-017: JWT Admin Role Claim After None Algorithm - Mass IDOR Access"; flow:established,to_server; pcre:"/(eyJ[a-zA-Z0-9_-]+\.eyJ[a-zA-Z0-9_-]+\.[a-zA-Z0-9_-]*)/i"; http_header; pcre:"/(\"role\"\s*:\s*\"(admin|superadmin|administrator|root|system)\"|\"isAdmin\"\s*:\s*true|\"privilege\"\s*:\s*\"(elevated|super|root)\")/i"; http_uri; classtype:web-application-attack; sid:2308017; rev:1; metadata:chain jwt-to-privilege-escalation, mitre T1606, created_at 2026_08_21;)

# --- IDOR → BOLA → Mass Data Extraction ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-018: IDOR Sequential Enumeration - Auto-incrementing User/Order IDs"; flow:established,to_server; pcre:"/\/api\/v[0-9]+\/(users?|accounts?|orders?|transactions?|records?|profiles?)\/\d{4,}/i"; http_uri; threshold:type both, track by_src, count 20, seconds 60; classtype:web-application-attack; sid:2308018; rev:1; metadata:chain idor-to-mass-extraction, mitre T1190, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN WEB-019: BOLA Mass Data Extraction After IDOR - PII Fields in Response"; flow:established,to_client; content:"200"; http_stat_code; pcre:"/\"(email|ssn|social_security|phone|address|date_of_birth|credit_card|bank_account|passport|tax_id)\"/i"; http_response_body; threshold:type both, track by_src, count 10, seconds 120; classtype:web-application-attack; sid:2308019; rev:1; metadata:chain idor-to-mass-extraction, mitre T1190, created_at 2026_08_21;)

# --- XXE OOB → Server-Side File Read → SSRF → Internal Service Access ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-020: XXE OOB Exfiltration - External Entity with DNS/HTTP Callback"; flow:established,to_server; pcre:"/<!ENTITY\s+\w+\s+SYSTEM\s+[\"'](?:http|https|ftp):\/\/[^\s\"']+>|<!ENTITY\s+\w+\s+PUBLIC\s+[\"'][^\s\"']+[\"']\s+[\"'](?:http|https|ftp):\/\/[^\s\"']+/i"; http_client_body; classtype:web-application-attack; sid:2308020; rev:1; metadata:chain xxe-to-ssrf, mitre T1190, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-021: XXE Parameter Entity Injection - Internal File Read via DTD"; flow:established,to_server; pcre:"/<!ENTITY\s+%\s+\w+\s+SYSTEM\s+[\"'](?:file|ftp|gopher|dict|ldap):\/\/[^\s\"']+>|%\s*\w+;/i"; http_client_body; classtype:web-application-attack; sid:2308021; rev:1; metadata:chain xxe-to-ssrf, mitre T1190, created_at 2026_08_21;)

# --- Prototype Pollution → Gadget Chain → RCE ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-022: Prototype Pollution via JSON Body - __proto__ or constructor.prototype"; flow:established,to_server; content:"POST"; http_method; pcre:"/(\"__proto__\"|constructor\[\"prototype\"\]|constructor\.prototype|\[\"__proto__\"\])/i"; http_client_body; classtype:web-application-attack; sid:2308022; rev:1; metadata:chain prototype-pollution-to-rce, mitre T1059, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN WEB-023: Prototype Pollution to RCE - Polluted Prototype with Command Execution Gadget"; flow:established,to_server; pcre:"/\"__proto__\"\s*:\s*\{[^}]*\"(isAdmin|role|command|exec|shell|spawn|child_process|require|eval|Function)\"/i"; http_client_body; classtype:web-application-attack; sid:2308023; rev:1; metadata:chain prototype-pollution-to-rce, mitre T1059, created_at 2026_08_21;)

# --- CORS Misconfiguration → Credential Theft → API Access → Data Exfiltration ---
alert http $HOME_NET any -> $HOME_NET any (msg:"CHAIN WEB-024: CORS Null Origin Allow with Credentials - Credential Theft Vector"; flow:established,to_client; content:"Access-Control-Allow-Origin"; http_header; content:"null"; http_header; content:"Access-Control-Allow-Credentials"; http_header; content:"true"; http_header; classtype:web-application-attack; sid:2308024; rev:1; metadata:chain cors-to-data-exfil, mitre T1530, created_at 2026_08_21;)
alert http $HOME_NET any -> $HOME_NET any (msg:"CHAIN WEB-025: CORS Reflected Origin with Wildcard Credentials - Cross-Origin Data Theft"; flow:established,to_client; content:"Access-Control-Allow-Credentials"; http_header; content:"true"; http_header; pcre:"/Access-Control-Allow-Origin\s*:\s*https?:\/\/[^\r\n]+/i"; http_header; pcre:"/Access-Control-Allow-Methods\s*:\s*(GET|POST|PUT|DELETE|PATCH)/i"; http_header; classtype:web-application-attack; sid:2308025; rev:1; metadata:chain cors-to-data-exfil, mitre T1530, created_at 2026_08_21;)