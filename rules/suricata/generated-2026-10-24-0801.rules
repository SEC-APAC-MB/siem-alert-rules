alert http any any -> any any (msg:"MITRE T1046 Network Service Discovery - port scan via HTTP proxy"; flow:established,to_server; http.uri; pcre:"/(\x3a\d{2,5}\/|proxy\?(host|url|target)\x3d)/i"; threshold:type threshold, track by_src, count 20, seconds 60; classtype:attempted-recon; sid:521293182; rev:1;)
alert http any any -> any any (msg:"MITRE T1049 System Network Connections - netstat via webshell"; flow:established,to_server; http.request_body; pcre:"/(netstat|ss\s+-|lsof\s+-i)/i"; classtype:attempted-recon; sid:521293183; rev:1;)
alert http any any -> any any (msg:"MITRE T1018 Remote System Discovery - arp scan via webshell"; flow:established,to_server; http.request_body; pcre:"/(arp\s+-a|nmap|masscan|arping)/i"; classtype:attempted-recon; sid:521293184; rev:1;)
alert http any any -> any any (msg:"MITRE T1021 Remote Services - SSH lateral movement via web"; flow:established,to_server; http.request_body; pcre:"/ssh\s+(-i|-p|-L|-R)\s+/i"; classtype:trojan-activity; sid:521293185; rev:1;)
alert http any any -> any any (msg:"MITRE T1072 Software Deployment Tools - Ansible playbook execution"; flow:established,to_server; http.request_body; content:"ansible"; nocase; pcre:"/ansible-playbook[^\n]*\x2d/i"; classtype:attempted-admin; sid:521293186; rev:1;)
alert http any any -> any any (msg:"MITRE T1550 Use Alternate Authentication Material - pass-the-hash"; flow:established,to_server; http.header; content:"Authorization"; content:"NTLM"; pcre:"/NTLM\s+[A-Za-z0-9+\/]{32,}/i"; classtype:trojan-activity; sid:521293187; rev:1;)
alert http any any -> any any (msg:"MITRE T1570 Lateral Tool Transfer - SMB file copy via HTTP tunnel"; flow:established,to_server; http.request_body; pcre:"/(smbclient|copy\s+\\\\|xcopy\s+\\\\)/i"; classtype:trojan-activity; sid:521293188; rev:1;)
alert http any any -> any any (msg:"MITRE T1082 System Information Discovery - systeminfo via webshell"; flow:established,to_server; http.request_body; pcre:"/(systeminfo|uname\s+-a|hostname|whoami)/i"; classtype:attempted-recon; sid:521293189; rev:1;)
alert http any any -> any any (msg:"MITRE T1087 Account Discovery - enumeration via LDAP query"; flow:established,to_server; http.request_body; pcre:"/(ldapsearch|net\s+(user|group)|dsquery)/i"; classtype:attempted-recon; sid:521293190; rev:1;)
alert http any any -> any any (msg:"MITRE T1485 Data Destruction - ransomware encryption via web channel"; flow:established,to_server; http.request_body; pcre:"/(vssadmin|wbadmin|bcdedit|cipher)/i"; classtype:trojan-activity; sid:521293191; rev:1;)

# === Current Threat Landscape & AI/LLM Security (91-100) ===

alert http any any -> any any (msg:"AI/LLM - prompt injection via API endpoint"; flow:established,to_server; http.uri; content:"/chat"; nocase; http.request_body; pcre:"/(ignore|disregard|forget)[^\n]*(previous|above|prior)[^\n]*(instructions?|prompt)/i"; classtype:attempted-user; sid:521293192; rev:1;)
alert http any any -> any any (msg:"AI/LLM - model extraction attack via repeated queries"; flow:established,to_server; http.uri; content:"/predict"; nocase; threshold:type threshold, track by_src, count 100, seconds 60; classtype:attempted-recon; sid:521293193; rev:1;)
alert http any any -> any any (msg:"AI/LLM - jailbreak attempt via DAN or role-play bypass"; flow:established,to_server; http.request_body; pcre:"/(DAN|do anything now|act as|pretend you are)[^\n]*(no restrictions|no rules|no limits)/i"; classtype:attempted-user; sid:521293194; rev:1;)
alert http any any -> any any (msg:"Threat Landscape - QR code phishing (quishing) via email-linked image"; flow:established,to_client; http.response_header; content:"image/png"; http.response_body; content:"QR"; depth:500; classtype:phishing; sid:521293195; rev:1;)
alert http any any -> any any (msg:"Threat Landscape - MFA fatigue / push bombing authentication pattern"; flow:established,to_server; http.uri; content:"/mfa"; nocase; http.method; content:"POST"; threshold:type threshold, track by_src, count 10, seconds 60; classtype:attempted-user; sid:521293196; rev:1;)
alert http any any -> any any (msg:"Threat Landscape - SSRF via metadata endpoint 169.254.169.254"; flow:established,to_server; http.uri; pcre:"/(169\.254\.169\.254|metadata\.google\.internal|metadata\.azure\.com)/i"; classtype:web-application-attack; sid:521293197; rev:1;)
alert http any any -> any any (msg:"Threat Landscape - Kubernetes API server unauthorized access"; flow:established,to_server; http.uri; content:"/api/v1/namespaces"; http.header; content:"kubernetes"; classtype:attempted-admin; sid:521293198; rev:1;)
alert http any any -> any any (msg:"Threat Landscape - OAuth consent phishing via malicious app"; flow:established,to_server; http.uri; content:"/oauth/authorize"; pcre:"/client_id[^\n]*\x3d[^\n]*\x26redirect_uri/i"; classtype:phishing; sid:521293199; rev:1;)
alert http any any -> any any (msg:"Threat Landscape - AI model poisoning data injection via training API"; flow:established,to_server; http.uri; content:"/train"; nocase; http.request_body; pcre:"/(poison|backdoor|trigger|label_flip)/i"; classtype:attempted-admin; sid:521293200; rev:1;)
alert http any any -> any any (msg:"Threat Landscape - deepfake video/audio upload to sharing platform"; flow:established,to_server; http.uri; content:"/upload"; nocase; http.header; content:"video/mp4"; pcre:"/(deepfake|face_swap|voice_clone)/i"; classtype:trojan-activity; sid:521293201; rev:1;)
