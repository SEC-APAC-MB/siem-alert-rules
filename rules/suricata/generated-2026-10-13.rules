# Suricata Detection Rules - Generated 2026-10-13
# Based on: GitHub Advisory Database CVEs (2026-08-27+), MITRE ATT&CK, current threat landscape
# SID range: 521275300 - 521275399

# === CVE-Based Rules (from GitHub Advisory fetch 2026-10-13) ===

# CVE-2026-89110 - SAP NetWeaver Visual Composer auth bypass (CRITICAL)
alert http any any -> any any (msg:"CVE-2026-89110 SAP NetWeaver Visual Composer Authorization Bypass Attempt"; flow:established,to_server; content:"/VC"; http_uri; content:"composer"; http_uri; nocase; content:"action="; http_uri; nocase; pcre:"/action=(?![a-z]*(login|auth))[a-z]+/Ui"; flowbits:set,sap.vc.auth_bypass; flowbits:noalert; classtype:attempted-admin; sid:521275300; rev:1;)

# CVE-2026-89108 - SAP Manufacturing Integration auth bypass (CRITICAL)
alert http any any -> any any (msg:"CVE-2026-89108 SAP MII Authentication Bypass - Unauthenticated Resource Access"; flow:established,to_server; content:"/XMII/"; http_uri; nocase; content:"Servlet"; http_uri; nocase; content:"Command="; http_uri; nocase; pcre:"/Command=(Execute|GetPropertyList)/Ui"; classtype:attempted-admin; sid:521275301; rev:1;)

# CVE-2026-89105 - SAP Cloud SDK Python OAuth2 SSRF (CRITICAL)
alert http any any -> any any (msg:"CVE-2026-89105 SAP Cloud SDK Python OAuth2 SSRF Attempt"; flow:established,to_server; content:"token"; http_uri; nocase; content:"redirect_uri"; http_client_body; nocase; pcre:"/redirect_uri=(file|gopher|dict|ftp|http):\/\//Ui"; classtype:attempted-admin; sid:521275302; rev:1;)

