alert sip any any -> any any (msg:"ET EXPLOIT sngrep SIP Stack Buffer Overflow Oversized X-Call-ID Header CVE-2026-90558"; flow:established,to_server; content:"X-Call-ID|3a|"; nocase; pcre:"/X-Call-ID\s*:\s*[^\r\n]{256,}/i"; reference:cve,2026-90558; classtype:attempted-admin; sid:5202402; rev:1;)

