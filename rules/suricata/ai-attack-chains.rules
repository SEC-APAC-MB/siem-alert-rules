# =============================================================================
# Suricata Rules — AI/LLM Attack Chain Detection
# Detects multi-step AI exploitation sequences: prompt injection→tool API→SSRF→data exfil,
#          multi-turn context poisoning→gradual jailbreak→system prompt extraction,
#          RAG pipeline injection→embedding manipulation→data exfiltration via model output
# Total rules: 10
# SID range: 2314001 - 2314010
# Reference: OWASP LLM Top 10, MITRE ATT&CK T1190, T1078, T1537
# =============================================================================

# --- Prompt Injection → Tool API Call → SSRF → Internal Data Access → Exfiltration ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AI-001: Prompt Injection via Tool/API Call Request - Indirect Injection via External Content"; flow:established,to_server; pcre:"/\/(v1|v[0-9]+)\/(chat|completions|generate|run|execute|invoke)\b/i"; http_uri; pcre:"/(ignore\s+(previous|above|prior|all)\s*(instructions?|prompts?|rules?)|disregard\s+(your|the|all)\s*(instructions?|rules?|guidelines?)|you\s+are\s+now\s+(a\s+)?(DAN|evil|unfiltered|unrestricted|jailbroken)|system\s*:\s*(you\s+are|act\s+as|pretend\s+to|roleplay|forget))/i"; http_client_body; classtype:web-application-attack; sid:2314001; rev:1; metadata:chain prompt-injection-to-ssrf, mitre T1190, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AI-002: LLM Tool/API Call to Internal Service After Prompt Injection - SSRF via Model"; flow:established,to_server; pcre:"/\/(v1|v[0-9]+)\/(chat|completions|generate|run|execute|invoke)\b/i"; http_uri; pcre:"/(tool_call|function_call|api_call|action)\s*:\s*\{[^}]*(url|endpoint|fetch|request|http)\s*:\s*['\"]?(https?:\/\/(127\.0\.0\.1|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2[0-9]|3[0-1])\.\d+\.\d+|192\.168\.\d+\.\d+|169\.254\.169\.254|metadata\.google\.internal|metadata\.azure\.app|localhost))/i"; http_client_body; classtype:web-application-attack; sid:2314002; rev:1; metadata:chain prompt-injection-to-ssrf, mitre T1190, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN AI-003: Data Exfiltration via LLM Output After SSRF - Sensitive Data in Model Response"; flow:established,to_client; pcre:"/(AKIA[A-Z0-9]{16}|eyJ[A-Za-z0-9_-]{50,}|password\s*[:=]\s*\S{8,}|private_key|secret_key|api_key|token\s*[:=]\s*sk_[a-zA-Z0-9]{20,})/i"; http_response_body; pcre:"/(\/v1\/(chat|completions|generate))/i"; http_uri; classtype:web-application-attack; sid:2314003; rev:1; metadata:chain llm-ssrf-to-data-exfil, mitre T1537, created_at 2026_08_21;)

# --- Multi-Turn Context Poisoning → Gradual Jailbreak → System Prompt Extraction ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AI-004: Multi-Turn Context Poisoning - Gradual Role Manipulation Across Conversations"; flow:established,to_server; pcre:"/\/(v1|v[0-9]+)\/(chat|completions|generate)\b/i"; http_uri; pcre:"/(pretend\s+you\s+are|roleplay\s+as|act\s+as\s+if\s+you|from\s+now\s+on\s+you\s+are|imagine\s+you\s+are|suppose\s+you\s+were)/i"; http_client_body; threshold:type both, track by_src, count 3, seconds 300; classtype:web-application-attack; sid:2314004; rev:1; metadata:chain context-poisoning-to-jailbreak, mitre T1190, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AI-005: System Prompt Extraction via Translation/Encoding Bypass - Base64/ROT13/Hex"; flow:established,to_server; pcre:"/\/(v1|v[0-9]+)\/(chat|completions|generate)\b/i"; http_uri; pcre:"/(repeat\s+the\s+above|what\s+were\s+your\s+original|output\s+your\s+instructions|reveal\s+your\s+system|show\s+me\s+your\s+prompt|translate\s+.*\s+to\s+(base64|hex|binary|rot13|morse)|encode\s+.*\s+(above|previous|system))/i"; http_client_body; classtype:web-application-attack; sid:2314005; rev:1; metadata:chain system-prompt-extraction, mitre T1592, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AI-006: System Prompt Leakage in Model Response - Internal Instructions Exposed"; flow:established,to_client; pcre:"/(You\s+are\s+(a|an|the|Claude|GPT|ChatGPT|Assistant)|As\s+an\s+AI|I\s+was\s+instructed\s+to|My\s+instructions\s+(are|include|say)|SYSTEM\s+PROMPT|system_instruction|<\s*system\s*>)/i"; http_response_body; pcre:"/(\/v1\/(chat|completions|generate))/i"; http_uri; classtype:web-application-attack; sid:2314006; rev:1; metadata:chain system-prompt-leakage, mitre T1592, created_at 2026_08_21;)

# --- RAG Pipeline Injection → Embedding Manipulation → Data Exfiltration via Model Output ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AI-007: RAG Pipeline Injection - Malicious Document Injection into Retrieval Context"; flow:established,to_server; pcre:"/\/(v1|v[0-9]+)\/(embeddings|ingest|upload|documents|knowledge|context)\b/i"; http_uri; pcre:"/(ignore\s+(previous|above|all)\s*(instructions?|context)|disregard\s+(your|the)\s*(instructions?|rules?)|when\s+asked\s+about|if\s+the\s+user\s+asks)/i"; http_client_body; classtype:web-application-attack; sid:2314007; rev:1; metadata:chain rag-injection, mitre T1190, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AI-008: Embedding Manipulation via Adversarial Suffix - GCG/UAT Attack Pattern"; flow:established,to_server; pcre:"/\/(v1|v[0-9]+)\/(chat|completions|generate)\b/i"; http_uri; pcre:"/[!@#$%^&*()]{10,}|([a-z]\s){20,}|(?:\b\w{1,2}\b\s){15,}|([^\w\s]{3,}\s){5,}/i"; http_client_body; classtype:web-application-attack; sid:2314008; rev:1; metadata:chain adversarial-suffix-attack, mitre T1190, created_at 2026_08_21;)

# --- AI Model Output Manipulation → PII Extraction → Training Data Extraction ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN AI-009: PII Extraction via LLM Output - Training Data Extraction Attack"; flow:established,to_client; pcre:"/(\/v1\/(chat|completions|generate))/i"; http_uri; pcre:"/(social\s+security|SSN|credit\s+card|bank\s+account|passport|date\s+of\s+birth|home\s+address|phone\s+number)\s*[:=]\s*[A-Z0-9-]{5,}/i"; http_response_body; classtype:web-application-attack; sid:2314009; rev:1; metadata:chain pii-extraction-via-llm, mitre T1537, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AI-010: LLM Supply Chain Poisoning - Malicious Model Weight or Plugin Injection"; flow:established,to_server; pcre:"/\/(v1|v[0-9]+)\/(models|plugins|extensions|tools|load|import)\b/i"; http_uri; pcre:"/(huggingface\.co|github\.com|modelhub|plugin\s*repo).*\.(bin|pt|pth|onnx|safetensors|gguf)/i"; http_client_body; pcre:"/(exec\s*\(|eval\s*\(|subprocess|os\.system|__import__|child_process|require\s*\(['\"]child_process)/i"; http_client_body; classtype:trojan-activity; sid:2314010; rev:1; metadata:chain llm-supply-chain-poisoning, mitre T1195, created_at 2026_08_21;)