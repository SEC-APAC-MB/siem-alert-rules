alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"MITRE T1048.002 Data exfiltration via HTTPS - large outbound transfer to unknown host"; flow:established,to_server; dsize:>1000000; threshold:type both, track by_src, count 5, seconds 300; classtype:trojan-activity; sid:52082056; rev:1; metadata:created_at 2026_10_01, mitre T1048.002;)
alert http $HOME_NET any -> $EXTERNAL_NET [8080,8888,9999] (msg:"MITRE T1048.001 Data exfiltration via HTTP - suspicious large POST to non-standard port"; flow:established,to_server; http.method; content:"POST"; dsize:>500000; classtype:trojan-activity; sid:52082057; rev:1; metadata:created_at 2026_10_01, mitre T1048.001;)

# === MITRE ATT&CK: T1071 Application Layer Protocol ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1071.001 C2 beacon via HTTP - regular interval GET requests with no response body"; flow:established,to_server; http.method; content:"GET"; threshold:type both, track by_src, count 30, seconds 600; dsize:<500; classtype:trojan-activity; sid:52082058; rev:1; metadata:created_at 2026_10_01, mitre T1071.001;)

# === MITRE ATT&CK: T1552 Unsecured Credentials ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1552.001 Credentials in URL - API keys or passwords passed in query string"; flow:established,to_server; http.uri; pcre:"/(api[_-]?key|secret|password|passwd|token|credential|auth)\s*=\s*[a-zA-Z0-9_\-]{8,}/i"; classtype:attempted-recon; sid:52082059; rev:1; metadata:created_at 2026_10_01, mitre T1552.001;)

# === MITRE ATT&CK: T1083 File and Directory Discovery ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1083 File discovery via web - path traversal targeting /etc/passwd or /etc/shadow"; flow:established,to_server; http.uri; pcre:"/(etc\/passwd|etc\/shadow|etc\/hosts|proc\/self\/environ)/i"; classtype:attempted-recon; sid:52082060; rev:1; metadata:created_at 2026_10_01, mitre T1083;)

# === MITRE ATT&CK: T1046 Network Service Discovery ===
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1046 Network service scan - rapid TCP SYN to multiple ports"; flow:stateless; flags:S; threshold:type both, track by_src, count 50, seconds 10; classtype:network-scan; sid:52082061; rev:1; metadata:created_at 2026_10_01, mitre T1046;)

# === MITRE ATT&CK: T1082 System Information Discovery ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1082 System info discovery via web shell - uname or systeminfo command"; flow:established,to_server; http.uri; pcre:"/(uname|systeminfo|whoami|id|hostname|ver|wmic)/i"; classtype:attempted-recon; sid:52082062; rev:1; metadata:created_at 2026_10_01, mitre T1082;)

# === MITRE ATT&CK: T1499 Endpoint DoS ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1499.004 Application exhaustion - slowloris pattern with partial HTTP requests"; flow:to_server; threshold:type both, track by_src, count 100, seconds 30; dsize:<100; classtype:attempted-dos; sid:52082063; rev:1; metadata:created_at 2026_10_01, mitre T1499.004;)

# === MITRE ATT&CK: T1606 Forge Web Credentials ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1606.002 SAML token forging - Response with unexpected issuer"; flow:established,to_server; http.request_body; content:"SAMLResponse"; nocase; pcre:"/<saml:Issuer[^>]*>[^<]+<\/saml:Issuer>/i"; classtype:attempted-admin; sid:52082064; rev:1; metadata:created_at 2026_10_01, mitre T1606.002;)

# === MITRE ATT&CK: T1189 Drive-by Compromise ===
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1189 Drive-by compromise - malicious iframe injection in HTTP response"; flow:established,to_client; http.response_body; pcre:"/<iframe[^>]+src=[\"']https?:\/\/(?!.*\.(com|org|net|edu|gov))/i"; classtype:trojan-activity; sid:52082065; rev:1; metadata:created_at 2026_10_01, mitre T1189;)

# === MITRE ATT&CK: T1068 Exploitation for Privilege Escalation ===
