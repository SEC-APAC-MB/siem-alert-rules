alert tcp $EXTERNAL_NET any -> $HOME_NET 443 (msg:"Identity - MFA fatigue via repeated push notifications"; flow:established,to_server; content:"/mfa/push"; nocase; http_uri; detection_filter:track by_src, count 10, seconds 60; classtype:attempted-user; sid:521292596; rev:1;)
