alert tcp $EXTERNAL_NET any -> $HOME_NET 443 (msg:"Identity - OAuth2 grant type abuse via password grant"; flow:established,to_server; content:"grant_type=password"; nocase; http_client_body; classtype:attempted-user; sid:521292588; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 443 (msg:"Identity - SAML response injection attempt"; flow:established,to_server; content:"SAMLResponse"; nocase; http_client_body; pcre:"/<saml[23]?:Response/i"; content:"Issuer"; nocase; classtype:attempted-admin; sid:521292589; rev:1;)
