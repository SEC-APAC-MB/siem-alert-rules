alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1547 Registry Run Key Modification via web"; flow:established,to_server; http.request_body; pcre:"/(HKLM|HKCU)\\(Software\\Microsoft\\Windows\\CurrentVersion\\Run)/i"; classtype:trojan-activity; sid:521296264; rev:1;)

# === MITRE ATT&CK T1005: Data from Local System ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1005 Data Collection - Access to credentials file"; flow:established,to_server; http.uri; pcre:"/(passwd|shadow|sam|ntds\.dit|credentials)/i"; classtype:sensitive-data; sid:521296265; rev:1;)

# === MITRE ATT&CK T1552: Unsecured Credentials ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1552 Unsecured Credentials - .htpasswd access"; flow:established,to_server; http.uri; content:".htpasswd"; nocase; classtype:sensitive-data; sid:521296266; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1552 Unsecured Credentials - id_rsa access"; flow:established,to_server; http.uri; content:"id_rsa"; nocase; classtype:sensitive-data; sid:521296267; rev:1;)

# === MITRE ATT&CK T1486: Data Encrypted for Impact ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1486 Ransomware Activity - Mass File Extension Change Pattern"; flow:established,to_server; http.request_body; pcre:"/(\.encrypted|\.locked|\.crypto|\.ransom|\.crypted)/i"; classtype:trojan-activity; sid:521296268; rev:1;)

# === MITRE ATT&CK T1567: Exfiltration Over Web Service ===
alert http $HOME_NET any -> any (msg:"MITRE T1567 Exfiltration to Telegram API"; flow:established,to_server; http.host; content:"api.telegram.org"; nocase; http.method; content:"POST"; dsize:>10240; classtype:exfiltration; sid:521296269; rev:1;)
alert http $HOME_NET any -> any (msg:"MITRE T1567 Exfiltration to Discord Webhook"; flow:established,to_server; http.host; content:"discord.com"; nocase; http.uri; content:"/webhooks/"; nocase; http.method; content:"POST"; dsize:>10240; classtype:exfiltration; sid:521296270; rev:1;)

# === MITRE ATT&CK T1078: Valid Accounts ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1078 Valid Account Abuse - Login from New Geographic Region"; flow:established,to_server; http.uri; content:"/login"; nocase; http.method; content:"POST"; threshold:type limit, track by_src, count 1, seconds 3600; classtype:attempted-admin; sid:521296271; rev:1;)

# === MITRE ATT&CK T1213: Data from Information Repositories ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1213 Data from Information Repositories - Confluence API Bulk Export"; flow:established,to_server; http.uri; content:"/rest/api/content/export"; nocase; http.method; content:"GET"; classtype:exfiltration; sid:521296272; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1213 Data from Information Repositories - Jira Bulk Issue Export"; flow:established,to_server; http.uri; content:"/sr/jira.issueviews:searchrequest"; nocase; classtype:exfiltration; sid:521296273; rev:1;)

# === MITRE ATT&CK T1133: External Remote Services ===
alert tcp $HOME_NET any -> $EXTERNAL_NET 3389 (msg:"MITRE T1133 External RDP Access Attempt"; flow:to_server; content:"|03 00 00 13|"; dsize:>200; classtype:attempted-admin; sid:521296274; rev:1;)

# === MITRE ATT&CK T1046: Network Service Discovery ===
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1046 Network Service Scanning - Rapid TCP SYN to multiple ports"; flow:stateless; detection_filter:track by_src, count 50, seconds 10; classtype:attempted-recon; sid:521296275; rev:1;)

# === MITRE ATT&CK T1090: Proxy ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1090 Proxy Chain - Tor Exit Node HTTP Traffic"; flow:established,to_server; tls.sni; pcre:"/(tor|onion)/i"; classtype:trojan-activity; sid:521296276; rev:1;)

# === MITRE ATT&CK T1557: Adversary-in-the-Middle ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1557 AitM - SSL Stripping Detection"; flow:established,to_client; http.response_body; content:"http://"; nocase; content:"login"; nocase; classtype:attempted-admin; sid:521296277; rev:1;)

# === MITRE ATT&CK T1620: Reflective Code Loading ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1620 Reflective DLL Loading via web shell"; flow:established,to_server; http.request_body; pcre:"/(LoadLibrary|VirtualAlloc|WriteProcessMemory|CreateRemoteThread)/i"; classtype:trojan-activity; sid:521296278; rev:1;)

# === MITRE ATT&CK T1490: Inhibit System Recovery ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1490 Inhibit Recovery - vssadmin delete shadows"; flow:established,to_server; http.request_body; content:"vssadmin"; nocase; content:"delete"; nocase; content:"shadows"; nocase; classtype:trojan-activity; sid:521296279; rev:1;)
