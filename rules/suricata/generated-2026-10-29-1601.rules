# === MITRE ATT&CK T1562: Impair Defenses ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1562 Impair Defenses - Disable Windows Defender via web"; flow:established,to_server; http.request_body; content:"Set-MpPreference"; nocase; content:"DisableRealtimeMonitoring"; nocase; classtype:trojan-activity; sid:521296282; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1562 Impair Defenses - Stop iptables via web"; flow:established,to_server; http.request_body; content:"iptables"; nocase; pcre:"/iptables.*-F|service\s+iptables\s+stop/i"; classtype:trojan-activity; sid:521296283; rev:1;)

# === MITRE ATT&CK T1087: Account Discovery ===
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1087 Account Discovery - net user via web shell"; flow:established,to_server; http.request_body; content:"net user"; nocase; classtype:attempted-recon; sid:521296284; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1087 Account Discovery - /etc/passwd via web"; flow:established,to_server; http.uri; content:"/etc/passwd"; nocase; classtype:attempted-recon; sid:521296285; rev:1;)

