alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (content:"systemctl"; pcre:"/enable|create|daemon-reload/i"; flow:established,to_server;) msg:"MITRE T1543.002 Systemd service creation via SSH"; classtype:trojan-activity; sid:521296689; rev:1;
alert tcp $EXTERNAL_NET any -> $HOME_NET 389 (content:"objectClass"; pcre:"/user|person/i"; flow:established,to_server;) msg:"MITRE T1087.001 Active Directory user enumeration via LDAP"; classtype:attempted-recon; sid:521296690; rev:1;
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (content:"/etc/passwd"; flow:established,to_server;) msg:"MITRE T1087.002 Linux account enumeration via SSH"; classtype:attempted-recon; sid:521296691; rev:1;
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (content:"netstat"; pcre:"/-an|-tn/i"; flow:established,to_server;) msg:"MITRE T1049 Netstat execution via remote shell"; classtype:attempted-recon; sid:521296692; rev:1;
