alert http $HOME_NET any -> $EXTERNAL_NET 80 (content:"curl/"; http_user_agent; pcre:"/curl\/[\d.]+|Wget\//i"; content:"/tmp/"; http_uri; flow:to_server;) msg:"MITRE T1105 Tool download via HTTP - curl/wget user agent"; classtype:trojan-activity; sid:521296710; rev:1;
alert http $HOME_NET any -> $EXTERNAL_NET 80 (content:"transfer.sh"; http_host; pcre:"/\.sh|\.bin|\.elf/i"; flow:to_server;) msg:"MITRE T1105 Suspicious binary download from file sharing site"; classtype:trojan-activity; sid:521296711; rev:1;
alert http $EXTERNAL_NET any -> $HOME_NET 80 (pcre:"/[A-Za-z0-9+\/=]{200,}/"; flow:established,to_server;) msg:"MITRE T1027 Base64 encoded payload delivery over HTTP"; classtype:trojan-activity; sid:521296712; rev:1;
alert http $EXTERNAL_NET any -> $HOME_NET 80 (pcre:"/\\x[0-9a-f]{2}\\x[0-9a-f]{2}/i"; flow:established,to_server;) msg:"MITRE T1027 Hex encoded command delivery"; classtype:trojan-activity; sid:521296713; rev:1;
