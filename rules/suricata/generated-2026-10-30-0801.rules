alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (content:"uname"; flow:established,to_server;) msg:"MITRE T1082 System info discovery via SSH - uname/uname -a"; classtype:attempted-recon; sid:521296694; rev:1;
alert tcp $EXTERNAL_NET any -> $HOME_NET 445 (content:"systeminfo"; flow:established,to_server;) msg:"MITRE T1082 System info discovery via SMB - systeminfo"; classtype:attempted-recon; sid:521296695; rev:1;
alert ip $EXTERNAL_NET any -> $HOME_NET any (content:"|08 00|"; depth:2; ttl:64; threshold:threshold,count:50,seconds=10,by_src;) msg:"MITRE T1018 Network scan via ICMP sweep pattern"; classtype:attempted-recon; sid:521296696; rev:1;
alert tcp $EXTERNAL_NET any -> $HOME_NET 389 (content:"base"; pcre:"/objectClass\*=\*/i"; flow:established,to_server;) msg:"MITRE T1018 LDAP directory tree enumeration"; classtype:attempted-recon; sid:521296697; rev:1;
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (content:"ps aux"; flow:established,to_server;) msg:"MITRE T1057 Process enumeration via SSH - ps aux"; classtype:attempted-recon; sid:521296698; rev:1;
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (content:"find"; pcre:"/-name|-type/i"; flow:established,to_server;) msg:"MITRE T1083 File system enumeration via SSH - find/locate"; classtype:attempted-recon; sid:521296699; rev:1;
alert tcp $EXTERNAL_NET any -> $HOME_NET 445 (content:"\pipe\srvsvc"; pcre:"/NetShareEnumAll/i"; flow:established,to_server;) msg:"MITRE T1135 Network share enumeration via SMB"; classtype:attempted-recon; sid:521296700; rev:1;
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (content:"tcpdump"; flow:established,to_server;) msg:"MITRE T1040 Packet capture tool deployed - tcpdump via SSH"; classtype:trojan-activity; sid:521296701; rev:1;
alert udp $HOME_NET any -> $EXTERNAL_NET 53 (threshold:threshold,count:200,seconds=30,by_src;) msg:"MITRE T1008 DNS fallback channel - excessive queries to alternative DNS"; classtype:trojan-activity; sid:521296702; rev:1;
alert ip $HOME_NET any -> $EXTERNAL_NET any (content:"|08 00|"; depth:2; dsize:>1000; flow:to_server;) msg:"MITRE T1095 ICMP tunneling - large ICMP packets"; classtype:trojan-activity; sid:521296703; rev:1;
alert tcp $HOME_NET any -> $EXTERNAL_NET any (dsize:<100; flow:to_server; threshold:threshold,count:30,seconds=60,by_dst;) msg:"MITRE T1095 Raw TCP C2 channel - beaconing pattern"; classtype:trojan-activity; sid:521296704; rev:1;
alert tcp $EXTERNAL_NET any -> $HOME_NET 8080 (content:"HTTP/1."; depth:8; flow:to_server;) msg:"MITRE T1571 HTTP traffic on non-standard port"; classtype:trojan-activity; sid:521296705; rev:1;
