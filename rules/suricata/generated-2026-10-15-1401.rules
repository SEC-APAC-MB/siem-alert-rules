alert http any any -> $HOME_NET any (msg:"API Security - Mass Assignment Exploitation"; flow:to_server,established; pcre:"/(is_admin|role|permission|user_type)=/i"; classtype:web-application-attack; sid:521276693; rev:1;)
alert http any any -> $HOME_NET any (msg:"API Security - GraphQL Introspection Query"; flow:to_server,established; content:"__schema"; nocase; content:"__type"; nocase; classtype:web-application-attack; sid:521276694; rev:1;)
alert tcp $HOME_NET any -> any any (msg:"Data Exfiltration - Suspicious Outbound to Pastebin"; flow:to_server,established; content:"pastebin.com"; nocase; classtype:data-leak; sid:521276695; rev:1;)
alert tcp $HOME_NET any -> any any (msg:"Data Exfiltration - DNS Tunneling Long Query"; flow:to_server; dsize:>200; classtype:data-leak; sid:521276696; rev:1;)
alert http any any -> $HOME_NET any (msg:"Web App - SSRF via URL Parameter"; flow:to_server,established; pcre:"/url=(file|gopher|dict|ldap|http):/i"; classtype:web-application-attack; sid:521276697; rev:1;)
alert http any any -> $HOME_NET any (msg:"Web App - XXE External Entity Injection"; flow:to_server,established; pcre:"/<!ENTITY.+SYSTEM/i"; classtype:web-application-attack; sid:521276698; rev:1;)
alert http any any -> $HOME_NET any (msg:"Recon - Directory Listing via dirbuster pattern"; flow:to_server,established; pcre:"/(admin|backup|config|test|dev|staging|phpinfo|\.git)/i"; detection_filter:track by_src, count 20, seconds 30; classtype:network-scan; sid:521276699; rev:1;)
