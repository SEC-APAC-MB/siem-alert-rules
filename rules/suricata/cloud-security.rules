# =============================================================================
# Suricata Rules — Cloud Security
# Covers: AWS/Azure/GCP metadata endpoint abuse, cloud API attacks,
#          IAM credential theft, S3/blob bucket abuse, cloud misconfigurations
# Total rules: 55
# SID range: 2306001 - 2306055
# =============================================================================

# --- AWS Metadata Endpoint Abuse ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - AWS Metadata Endpoint Access - IMDSv1"; flow:established,to_server; content:"169.254.169.254"; http_uri; pcre:"/^\/latest\/(meta-data|dynamic|user-data)/i"; http_uri; classtype:web-application-attack; sid:2306001; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - AWS Metadata - IAM Credential Theft"; flow:established,to_server; content:"169.254.169.254"; http_uri; content:"/latest/meta-data/iam/security-credentials/"; http_uri; classtype:web-application-attack; sid:2306002; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - AWS Metadata - User Data Access"; flow:established,to_server; content:"169.254.169.254"; http_uri; content:"/latest/user-data"; http_uri; classtype:web-application-attack; sid:2306003; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - AWS Metadata - IMDSv2 Token Bypass"; flow:established,to_server; content:"169.254.169.254"; http_uri; content:! "X-aws-ec2-metadata-token"; http_header; classtype:web-application-attack; sid:2306004; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - AWS Metadata - Spot Instance Action Detection"; flow:established,to_server; content:"169.254.169.254"; http_uri; content:"/latest/meta-data/spot/instance-action"; http_uri; classtype:web-application-attack; sid:2306005; rev:1; metadata:created_at 2026-08-17;)

# --- Azure Metadata Endpoint Abuse ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Azure Metadata Endpoint Access - IMDS"; flow:established,to_server; content:"169.254.169.254"; http_uri; content:"Metadata"; http_header; content:"true"; http_header; classtype:web-application-attack; sid:2306006; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Azure Metadata - Managed Identity Token Theft"; flow:established,to_server; content:"169.254.169.254"; http_uri; content:"/metadata/identity/oauth2/token"; http_uri; content:"Metadata"; http_header; classtype:web-application-attack; sid:2306007; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Azure Metadata - Compute Information Disclosure"; flow:established,to_server; content:"169.254.169.254"; http_uri; content:"/metadata/instance"; http_uri; content:"Metadata"; http_header; content:"true"; http_header; classtype:web-application-attack; sid:2306008; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Azure Metadata - Network Information Access"; flow:established,to_server; content:"169.254.169.254"; http_uri; content:"/metadata/instance/network"; http_uri; classtype:web-application-attack; sid:2306009; rev:1; metadata:created_at 2026-08-17;)

# --- GCP Metadata Endpoint Abuse ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - GCP Metadata Endpoint Access - Compute Metadata"; flow:established,to_server; content:"metadata.google.internal"; http_header; pcre:"/^\/computeMetadata\/v1\//i"; http_uri; classtype:web-application-attack; sid:2306010; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - GCP Metadata - Service Account Token Theft"; flow:established,to_server; content:"metadata.google.internal"; http_header; content:"/computeMetadata/v1/instance/service-accounts/default/token"; http_uri; classtype:web-application-attack; sid:2306011; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - GCP Metadata - Project ID and Numeric Project ID Access"; flow:established,to_server; content:"metadata.google.internal"; http_header; pcre:"/\/computeMetadata\/v1\/project\/(numeric-project-id|project-id)/i"; http_uri; classtype:web-application-attack; sid:2306012; rev:1; metadata:created_at 2026-08-17;)

# --- SSRF to Cloud Metadata ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - SSRF to AWS Metadata via URL Parameter"; flow:established,to_server; pcre:"/(url|uri|path|dest|redirect|return|next|target|site|link|rurl|img|load|file|page|feed|callback|src|reference)\s*=\s*https?:\/\/169\.254\.169\.254/i"; http_uri; classtype:web-application-attack; sid:2306013; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - SSRF to Azure Metadata via URL Parameter"; flow:established,to_server; pcre:"/(url|uri|path|dest|redirect|return|next|target|site|link|rurl|img|load|file|page)\s*=\s*https?:\/\/169\.254\.169\.254\/metadata/i"; http_uri; classtype:web-application-attack; sid:2306014; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - SSRF to GCP Metadata via URL Parameter"; flow:established,to_server; pcre:"/(url|uri|path|dest|redirect|return|next|target|site|link|rurl|img|load|file|page)\s*=\s*https?:\/\/metadata\.google\.internal/i"; http_uri; classtype:web-application-attack; sid:2306015; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - SSRF to Cloud Metadata via DNS Rebinding"; flow:established,to_server; pcre:"/(url|uri|path|dest|redirect)\s*=\s*https?:\/\/(169\.254\.169\.254|[0-9a-f]+\.nip\.io|metadata\.[a-z]+\.com)/i"; http_uri; classtype:web-application-attack; sid:2306016; rev:1; metadata:created_at 2026-08-17;)

# --- AWS S3 Bucket Abuse ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - AWS S3 - Public Bucket Enumeration"; flow:established,to_server; pcre:"/[a-z0-9.-]+\.s3[.-][a-z0-9.-]*amazonaws\.com/i"; http_header; content:"GET"; http_method; content:"ListBucketResult"; http_server_body; classtype:web-application-attack; sid:2306017; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - AWS S3 - Bucket Data Exfiltration"; flow:established,to_server; pcre:"/[a-z0-9.-]+\.s3[.-][a-z0-9.-]*amazonaws\.com/i"; http_header; content:"GET"; http_method; threshold:type both, track by_src, count 100, seconds 300; classtype:web-application-attack; sid:2306018; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - AWS S3 - Bucket Write by Unauthenticated User"; flow:established,to_server; pcre:"/[a-z0-9.-]+\.s3[.-][a-z0-9.-]*amazonaws\.com/i"; http_header; content:"PUT"; http_method; content:! "Authorization"; http_header; classtype:web-application-attack; sid:2306019; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - AWS S3 - Sensitive File Access"; flow:established,to_server; pcre:"/[a-z0-9.-]+\.s3[.-][a-z0-9.-]*amazonaws\.com\/.*(env|config|backup|database|secret|credential|key|password|\.sql|\.dump|\.bak)/i"; http_uri; classtype:web-application-attack; sid:2306020; rev:1; metadata:created_at 2026-08-17;)

# --- AWS IAM Credential Theft ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - AWS IAM - Leaked Access Key in HTTP"; flow:established,to_server; pcre:"/AKIA[A-Z0-9]{16}/"; http_client_body; classtype:web-application-attack; sid:2306021; rev:1; metadata:created_at 2026-08-17;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CLOUD - AWS IAM - Access Key in Server Response"; flow:established,to_client; pcre:"/AKIA[A-Z0-9]{16}/"; http_server_body; classtype:web-application-attack; sid:2306022; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - AWS IAM - Secret Access Key in HTTP"; flow:established,to_server; pcre:"/[A-Za-z0-9\/+=]{40}/"; http_client_body; pcre:"/(aws_secret_access_key|secret_key|secretaccesskey)\s*[=:]\s*[A-Za-z0-9\/+=]{40}/i"; http_client_body; classtype:web-application-attack; sid:2306023; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - AWS IAM - AssumeRole Privilege Escalation"; flow:established,to_server; pcre:"/sts\.amazonaws\.com/i"; http_header; pcre:"/Action=AssumeRole/i"; http_uri; classtype:attempted-admin; sid:2306024; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - AWS IAM - Unauthorized API Call - iam:CreateUser"; flow:established,to_server; pcre:"/iam\.amazonaws\.com/i"; http_header; pcre:"/Action=CreateUser/i"; http_uri; classtype:attempted-admin; sid:2306025; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - AWS IAM - Unauthorized API Call - iam:CreateAccessKey"; flow:established,to_server; pcre:"/iam\.amazonaws\.com/i"; http_header; pcre:"/Action=CreateAccessKey/i"; http_uri; classtype:attempted-admin; sid:2306026; rev:1; metadata:created_at 2026-08-17;)

# --- Azure Specific ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Azure - Blob Storage Public Enumeration"; flow:established,to_server; pcre:"/[a-z0-9-]+\.blob\.core\.windows\.net/i"; http_header; content:"GET"; http_method; classtype:attempted-recon; sid:2306027; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Azure - SAS Token in URL"; flow:established,to_server; pcre:"/[?&]sv=\d{4}-\d{2}-\d{2}&[^?]*sig=[A-Za-z0-9+\/=]{20,}/i"; http_uri; classtype:web-application-attack; sid:2306028; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Azure - Managed Identity Token Leak in Response"; flow:established,to_client; pcre:"/\"access_token\"\s*:\s*\"eyJ[a-zA-Z0-9_-]+\"/i"; http_server_body; pcre:"/\"resource\"\s*:\s*\"https:\/\/management\.azure\.com/i"; http_server_body; classtype:web-application-attack; sid:2306029; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Azure - Key Vault Unauthorized Access"; flow:established,to_server; pcre:"/[a-z0-9-]+\.vault\.azure\.net/i"; http_header; content:! "Authorization"; http_header; classtype:attempted-admin; sid:2306030; rev:1; metadata:created_at 2026-08-17;)

# --- GCP Specific ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - GCP - Cloud Storage Bucket Public Access"; flow:established,to_server; pcre:"/storage\.googleapis\.com\/[a-z0-9-]+\//i"; http_uri; content:"GET"; http_method; classtype:attempted-recon; sid:2306031; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - GCP - Service Account Key in HTTP"; flow:established,to_server; pcre:"/\"type\"\s*:\s*\"service_account\"/i"; http_client_body; pcre:"/\"private_key\"\s*:\s*\"-----BEGIN/i"; http_client_body; classtype:web-application-attack; sid:2306032; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - GCP - Firestore Unauthorized Access"; flow:established,to_server; pcre:"/firestore\.googleapis\.com/i"; http_header; content:! "Authorization"; http_header; classtype:attempted-admin; sid:2306033; rev:1; metadata:created_at 2026-08-17;)

# --- Cloud API Attacks ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - API - Kubernetes API Server Unauthenticated Access"; flow:established,to_server; content:"/api/v1"; http_uri; content:"/namespaces/"; http_uri; content:! "Authorization"; http_header; classtype:attempted-admin; sid:2306034; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - API - Kubernetes Dashboard Unauthenticated Access"; flow:established,to_server; pcre:"/\/api\/v1\/(namespaces|pods|secrets|configmaps|serviceaccounts)/i"; http_uri; content:! "Authorization"; http_header; classtype:attempted-admin; sid:2306035; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - API - Docker API Unauthenticated Access"; flow:established,to_server; content:"/containers/json"; http_uri; content:! "Authorization"; http_header; classtype:attempted-admin; sid:2306036; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - API - Docker API Create Container Escape"; flow:established,to_server; content:"POST"; http_method; content:"/containers/create"; http_uri; pcre:"/(privileged|host_pid|host_ipc|volumes|mounts)/i"; http_client_body; classtype:attempted-admin; sid:2306037; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - API - Consul API Unauthenticated Access"; flow:established,to_server; pcre:"/\/v1\/(kv|catalog|health|agent|session|status)/i"; http_uri; content:! "X-Consul-Token"; http_header; classtype:attempted-admin; sid:2306038; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - API - etcd Unauthenticated Access"; flow:established,to_server; pcre:"/\/v[23]\/keys\//i"; http_uri; content:! "Authorization"; http_header; classtype:attempted-admin; sid:2306039; rev:1; metadata:created_at 2026-08-17;)

# --- Cloud Misconfiguration ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Misconfig - S3 Bucket Public Access Block Disabled"; flow:established,to_client; content:"200"; http_stat_code; pcre:"/<PublicAccessBlockConfiguration>.*<BlockPublicAcls>false<\/BlockPublicAcls>/i"; http_server_body; classtype:web-application-attack; sid:2306040; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Misconfig - Open CORS Policy on Cloud API"; flow:established,to_client; content:"Access-Control-Allow-Origin"; http_header; content:"*"; http_header; pcre:"/(amazonaws\.com|windows\.net|googleapis\.com)/i"; http_header; classtype:web-application-attack; sid:2306041; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Misconfig - Kubernetes Service Account Token in Response"; flow:established,to_client; pcre:"/eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/"; http_server_body; pcre:"/\"kubernetes.io\"/i"; http_server_body; classtype:web-application-attack; sid:2306042; rev:1; metadata:created_at 2026-08-17;)

# --- Cloud Secret Exposure ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Secrets - .env File Exposure on Cloud"; flow:established,to_server; content:"/.env"; http_uri; classtype:web-application-attack; sid:2306043; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Secrets - Terraform State File Exposure"; flow:established,to_server; pcre:"/\.(terraform\.tfstate|tfstate\.backup|tfstate\.json)/i"; http_uri; classtype:web-application-attack; sid:2306044; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Secrets - Cloud Credential File Exposure"; flow:established,to_server; pcre:"/\/(\.aws\/credentials|\.aws\/config|\.azure\/credentials|\.gcp\/credentials|\.boto|credentials\.json|service-account\.json|cloud-config\.yml)/i"; http_uri; classtype:web-application-attack; sid:2306045; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Secrets - Kubernetes Secret in etcd"; flow:established,to_server; content:"/registry/secrets/"; http_uri; classtype:web-application-attack; sid:2306046; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Secrets - Docker Registry Unauthorized Access"; flow:established,to_server; content:"/v2/"; http_uri; content:! "Authorization"; http_header; classtype:attempted-admin; sid:2306047; rev:1; metadata:created_at 2026-08-17;)

# --- Container Escapes ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Container - Path Traversal to Host Filesystem"; flow:established,to_server; pcre:"/(proc\/self|sys\/kernel|dev\/shm|var\/run\/docker\.sock|run\/containerd|\.dockerenv)/i"; http_uri; classtype:attempted-admin; sid:2306048; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Container - Docker Socket Mount Exposure"; flow:established,to_server; pcre:"/\/var\/run\/docker\.sock/i"; http_uri; classtype:attempted-admin; sid:2306049; rev:1; metadata:created_at 2026-08-17;)

# --- Serverless Attacks ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Serverless - AWS Lambda Function URL Invocation"; flow:established,to_server; pcre:"/[a-z0-9-]+\.lambda-url\.[a-z0-9-]+\.on\.aws/i"; http_header; pcre:"/\/(invoke|function|execution|run|process)/i"; http_uri; classtype:web-application-attack; sid:2306050; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Serverless - AWS Lambda Event Injection"; flow:established,to_server; pcre:"/[a-z0-9-]+\.lambda-url\.[a-z0-9-]+\.on\.aws/i"; http_header; pcre:"/(curl|wget|nc|bash|python|node|require\(|import\s|subprocess|os\.system|eval)/i"; http_client_body; classtype:web-application-attack; sid:2306051; rev:1; metadata:created_at 2026-08-17;)

# --- Cloud Reconnaissance ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Recon - AWS S3 Bucket Discovery"; flow:established,to_server; pcre:"/[a-z0-9.-]+\.s3[.-][a-z0-9.-]*amazonaws\.com/i"; http_header; content:"GET"; http_method; threshold:type both, track by_src, count 20, seconds 60; classtype:attempted-recon; sid:2306052; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Recon - Azure Subscription Enumeration"; flow:established,to_server; pcre:"/management\.azure\.com\/subscriptions/i"; http_uri; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-recon; sid:2306053; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - Recon - GCP Project Enumeration"; flow:established,to_server; pcre:"/cloudresourcemanager\.googleapis\.com\/v[0-9]+\/projects/i"; http_uri; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-recon; sid:2306054; rev:1; metadata:created_at 2026-08-17;)

# --- Cloud API Key Exposure ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CLOUD - API Key - Google API Key in URL"; flow:established,to_server; pcre:"/[?&]key=AIza[A-Za-z0-9_-]{35}/i"; http_uri; classtype:web-application-attack; sid:2306055; rev:1; metadata:created_at 2026-08-17;)