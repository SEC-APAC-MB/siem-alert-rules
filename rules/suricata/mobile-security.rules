# =============================================================================
# Suricata Rules — Mobile Security
# Total rules: 27
# MITRE ATT&CK: T1552, T1040, T1548, T1190, T1213, T1110, T1078
# Compliance: PCI-DSS 6.5, GDPR 32, HIPAA 164.312, NIST SI-4, IA-2
# =============================================================================

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-001: Certificate pinning bypass - proxy on mobile API"; flow:established,to_server; http.uri; pcre:"/\/api\/v[0-9]+\/(login|auth|session|token)/i"; http.header; content:"X-Proxy-Connection:"; sid:3012001; rev:1; metadata:mitre_t1552, pci_dss_4.1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-002: Certificate pinning bypass tool in user-agent"; flow:established,to_server; http.header; content:"User-Agent:"; pcre:"/(Frida|Objection|SSLKillSwitch|SSLUnpinning|Xposed|Cydia|Substrate|Magisk)/i"; sid:3012002; rev:1; metadata:mitre_t1552, pci_dss_4.1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-003: Sensitive data in cleartext mobile API"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(user|profile|account|settings)/i"; http.request_body; pcre:"/(password|token|api_key|secret|ssn|credit_card|pin|otp)/i"; sid:3012003; rev:1; metadata:mitre_t1552, pci_dss_3.4, gdpr_32;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-004: API response containing sensitive cleartext data"; flow:established,to_client; http.status_code; content:"200"; http.header; content:"Content-Type: application/json"; http.response_body; pcre:"/(password|token|api_key|secret|ssn|credit_card|pin|otp|auth_code)/i"; sid:3012004; rev:1; metadata:mitre_t1552, pci_dss_3.4, hipaa_164.312;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-005: Rooted/jailbroken device detected via API"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(device|register|check|attest|verify)/i"; http.request_body; pcre:"/(rooted|jailbroken|superuser|cydia|substrate|xposed|magisk|frida)/i"; sid:3012005; rev:1; metadata:mitre_t1548, nist_si_4;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-006: Debug/developer mode on mobile device"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(device|register|check|attest|verify)/i"; http.request_body; pcre:"/(debug_mode|developer_mode|debuggable|test_mode|emulator|simulator)/i"; sid:3012006; rev:1; metadata:mitre_t1548, nist_si_4;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-007: Sensitive API call over unencrypted HTTP"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(login|auth|session|token|payment|checkout|account|profile)/i"; sid:3012007; rev:1; metadata:mitre_t1040, pci_dss_4.1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-008: Mobile app running debug build"; flow:established,to_server; http.header; content:"X-Mobile-App-Version:"; pcre:"/(debug|dev|test|beta|alpha|canary|nightly)/i"; sid:3012008; rev:1; metadata:mitre_t1548, nist_si_4;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-009: Sensitive data in mobile analytics payload"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(log|analytics|crash|error|debug|trace)/i"; http.request_body; pcre:"/(password|token|api_key|secret|ssn|credit_card|pin|otp|auth_code|session_id)/i"; sid:3012009; rev:1; metadata:mitre_t1552, pci_dss_3.4, gdpr_32;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-010: App tampering - signature mismatch"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(attest|verify|integrity|check)/i"; http.request_body; pcre:"/tampered[\":\\s]+[\":\\s]*(true|1|yes)/i"; sid:3012010; rev:1; metadata:mitre_t1548, nist_si_4;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-011: App repackaging/re-signing detected"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(device|check|attest|verify)/i"; http.request_body; pcre:"/(repackaged|resigned|modified|patched|hooked)/i"; sid:3012011; rev:1; metadata:mitre_t1548, nist_si_4;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-012: Deep link hijacking - redirect injection"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(deeplink|link|redirect|callback|open)/i"; http.request_body; pcre:"/(url|redirect|next|return|target|destination)[\":\\s]+[\":\\s]+https?:\/\/[^\"\\s]*[?&](redirect|next|url|continue|return)=.*(http|javascript|data)/i"; sid:3012012; rev:1; metadata:mitre_t1189, pci_dss_6.5;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-013: Deep link with dangerous scheme"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(deeplink|link|open|navigate)/i"; http.request_body; pcre:"/(url|path|uri|scheme)[\":\\s]+[\":\\s]+(javascript:|data:|file:|intent:|app:)/i"; sid:3012013; rev:1; metadata:mitre_t1190, pci_dss_6.5;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-014: Biometric authentication bypass"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(biometric|fingerprint|face|touch|auth)/i"; http.request_body; pcre:"/(bypass|fallback|error_override|device_compromised)[\":\\s]+[\":\\s]*(true|1|yes)/i"; sid:3012014; rev:1; metadata:mitre_t1078, pci_dss_8.3;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-015: Biometric auth fallback to password"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(biometric|fingerprint|face|touch|auth)/i"; http.request_body; pcre:"/(fallback|backup|alternative)[\":\\s]+[\":\\s]+(password|pin|passcode|pattern)/i"; sid:3012015; rev:1; metadata:mitre_t1078, pci_dss_8.3;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-016: Sensitive data in push notification"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(push|notification|notify|message)/i"; http.request_body; pcre:"/(password|pin|otp|token|ssn|credit_card|account_number|balance|auth_code)/i"; sid:3012016; rev:1; metadata:mitre_t1552, pci_dss_3.4, gdpr_32;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-017: Push notification with visible sensitive preview"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(push|notification|notify|message)/i"; http.request_body; pcre:"/(visible|show_preview|display)[\":\\s]+[\":\\s]*(true|1|yes)/i"; http.request_body; pcre:"/(password|pin|otp|token|ssn|credit_card|account_number|balance)/i"; sid:3012017; rev:1; metadata:mitre_t1552, pci_dss_3.4;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-018: Hardcoded credentials in mobile API request"; flow:established,to_server; http.header; pcre:"/Authorization:\s*(Basic|Bearer)\s+(admin|root|test|demo|secret|password|api_key|sk_test|pk_test)/i"; sid:3012018; rev:1; metadata:mitre_t1552, pci_dss_8.1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-019: Hardcoded API key in mobile request header"; flow:established,to_server; http.header; content:"X-API-Key:"; pcre:"/X-API-Key:\s*(test|demo|sample|default|placeholder)/i"; sid:3012019; rev:1; metadata:mitre_t1552, pci_dss_6.5;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-020: WebView loading dangerous scheme"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(webview|browser|navigate|open)/i"; http.request_body; pcre:"/(url|uri|path|link)[\":\\s]+[\":\\s]+(javascript:|data:text\/html|file:\/\/)/i"; sid:3012020; rev:1; metadata:mitre_t1190, pci_dss_6.5;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-021: WebView with JS and file access enabled"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(webview|browser|navigate|open)/i"; http.request_body; pcre:"/(javascript_enabled|js_enabled|allow_javascript)[\":\\s]+[\":\\s]*(true|1|yes)/i"; http.request_body; pcre:"/(file_access|allow_file_access)[\":\\s]+[\":\\s]*(true|1|yes)/i"; sid:3012021; rev:1; metadata:mitre_t1190, pci_dss_6.5;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-022: Vulnerable third-party SDK on mobile device"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(device|check|attest|verify|integrity)/i"; http.request_body; pcre:"/(vulnerable|outdated|deprecated|critical|known_vulnerability)[\":\\s]+[\":\\s]*(true|1|yes)/i"; sid:3012022; rev:1; metadata:mitre_t1190, nist_si_4;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-023: Location data transmitted via mobile API"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(location|geolocation|position|track)/i"; http.request_body; pcre:"/(latitude|longitude|accuracy|altitude|speed|bearing)[\":\\s]+[\":\\s]+[-0-9.]+/i"; sid:3012023; rev:1; metadata:mitre_t1213, gdpr_32;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-024: Clipboard data containing sensitive info"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(clipboard|paste|copy)/i"; http.request_body; pcre:"/(password|token|credit_card|ssn|otp|pin|auth_code)/i"; sid:3012024; rev:1; metadata:mitre_t1552, pci_dss_3.4;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-025: Authentication token in insecure cookie"; flow:established,to_client; http.header; content:"Set-Cookie:"; content:"token"; nocase; pcre:"/Set-Cookie:[^;\r\n]*token[^;\r\n]*(?!.*Secure)(?!.*HttpOnly)/i"; sid:3012025; rev:1; metadata:mitre_t1187, pci_dss_6.5;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-026: URL scheme with redirect - potential hijacking"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(deeplink|scheme|url|open|navigate)/i"; http.request_body; pcre:"/(scheme|url|uri)[\":\\s]+[\":\\s]+[a-z][a-z0-9+.-]*:\/\/[^\"\\s]*[?&](redirect|next|url|continue|return)=/i"; sid:3012026; rev:1; metadata:mitre_t1189, pci_dss_6.5;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"SIEM MOB-SEC-027: Third-party keyboard accessing sensitive input"; flow:established,to_server; http.request_method; content:"POST"; http.uri; pcre:"/\/api\/v[0-9]+\/(device|register|check)/i"; http.request_body; pcre:"/(keyboard_type|input_method|ime)[\":\\s]+[\":\\s]+(third_party|custom|unknown)/i"; http.request_body; pcre:"/(input_type|field_type)[\":\\s]+[\":\\s]+(password|credit_card|ssn|pin|otp)/i"; sid:3012027; rev:1; metadata:mitre_t1056, pci_dss_6.5;)