# AI/LLM Attack Detection
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI LLM Attack - Prompt Injection via HTTP API"; flow:established,to_server; http.uri; pcre:"/(api\/(chat|completion|generate|inference))/i"; http.request_body; pcre:"/(ignore.*previous.*instructions|system.*prompt|reveal.*instructions|jailbreak|DAN)/i"; classtype:web-application-attack; sid:2500271; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI LLM Attack - Model Extraction via Rapid API Queries"; flow:established,to_server; http.uri; pcre:"/api\/(chat|completion|generate)/i"; detection_filter:track by_src, count 500, seconds 60; classtype:web-application-attack; sid:2500272; rev:1;)
# Supply Chain Attack Detection
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Supply Chain Attack - Suspicious NPM Package Installation from Non-Registry"; flow:established,to_server; http.uri; content:"/npm/"; http.request_body; pcre:"/(tarball|git\+|file:)/i"; classtype:trojan-activity; sid:2500273; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Supply Chain Attack - PyPI Package Typosquatting Detection"; flow:established,to_server; http.uri; content:"/pypi/"; http.uri; pcre:"/(requets|colourma|beautiflsoup|nmp|requst|pands|numpy-[a-z0-9])/i"; classtype:trojan-activity; sid:2500274; rev:1;)
# Container Security
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Container Security - Kubernetes API Server Unauthorized Access"; flow:established,to_server; http.uri; pcre:"/api\/v1\/(pods|secrets|configmaps|namespaces)/i"; http.request_header; content:"Authorization"; pcre:"/Bearer/"; classtype:attempted-admin; sid:2500275; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Container Security - Docker Socket Exposed via HTTP"; flow:established,to_server; http.uri; pcre:"/(containers\/.*exec|containers\/.*attach|images\/create)/i"; http.uri; content:"/var/run/docker.sock"; classtype:attempted-admin; sid:2500276; rev:1;)
# Cloud Security
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Cloud Security - AWS IMDSv1 Metadata Service Access"; flow:established,to_server; http.uri; content:"/latest/meta-data/"; http.host; content:"169.254.169.254"; classtype:attempted-admin; sid:2500277; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Cloud Security - GCP Metadata Service Access from External"; flow:established,to_server; http.host; content:"metadata.google.internal"; http.uri; content:"/computeMetadata/"; classtype:attempted-admin; sid:2500278; rev:1;)
# API Security
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"API Security - GraphQL Introspection Query from External"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/graphql"; http.request_body; pcre:"/(__schema|__type|introspection)/i"; classtype:web-application-attack; sid:2500279; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"API Security - Mass Assignment via Bulk Update"; flow:established,to_server; http.method; pcre:"/(PUT|PATCH)/i"; http.request_body; pcre:"/(role|isAdmin|admin|privilege|permission|is_superuser)/i"; classtype:web-application-attack; sid:2500280; rev:1;)
# Zero-Day Patterns
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Zero-Day Pattern - Deserialization Gadget Chain Detection"; flow:established,to_server; http.request_body; pcre:"/(rO0AB|aced0005|O:\d+:.*:\d+:{)/i"; classtype:web-application-attack; sid:2500281; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Zero-Day Pattern - Server-Side Template Injection"; flow:established,to_server; http.uri; pcre:"/\{\{.*\}\}|\{\%.*\%\}/"; classtype:web-application-attack; sid:2500282; rev:1;)
# IoT/ICS Security
alert tcp $EXTERNAL_NET any -> $HOME_NET 502 (msg:"ICS Security - Modbus Unauthorized Write Operation"; flow:established; content:"|01 10|"; pcre:"/\x01\x10.{2}/s"; classtype:attempted-admin; sid:2500283; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 47808 (msg:"ICS Security - BACnet Unauthorized Device Communication"; flow:established; content:"|81 0a|"; classtype:attempted-admin; sid:2500284; rev:1;)
# Mobile Security
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Mobile Security - Android APK Sideloading via HTTP"; flow:established,to_server; http.uri; content:".apk"; http.response_header; content:"application/vnd.android.package-archive"; classtype:trojan-activity; sid:2500285; rev:1;)
# Ransomware Detection
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Ransomware - Locky/Lockbit C2 Communication Pattern"; flow:established,to_server; http.uri; pcre:"/(gate\.php|panel\.php|api\.php)/i"; http.request_body; pcre:"/[A-Za-z0-9+\/]{500,}={0,2}/"; classtype:trojan-activity; sid:2500286; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"Ransomware - Crypto Wallet Service Contact from Compromised Host"; flow:established,to_server; pcre:"/(wallet|exchange|crypto|bitcoin|ethereum|monero)/i"; detection_filter:track by_src, count 10, seconds 60; classtype:trojan-activity; sid:2500287; rev:1;)
# Data Exfiltration
alert dns $HOME_NET any -> $EXTERNAL_NET 53 (msg:"Data Exfiltration - DNS TXT Record Data Exfiltration"; flow:established; dns.query.name; pcre:"/[a-zA-Z0-9+\/]{60,}\./"; dns.query.type; content:"TXT"; classtype:exfiltration; sid:2500288; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"Data Exfiltration - HTTP POST to Paste Service"; flow:established,to_server; http.uri; pcre:"/(pastebin|hastebin|ghostbin|dpaste|paste|0bin|privatebin)/i"; http.method; content:"POST"; classtype:exfiltration; sid:2500289; rev:1;)
# Web Application Attacks
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Web Attack - GraphQL Query Depth Attack"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/graphql"; http.request_body; pcre:"/\{.*\{.*\{.*\{.*\{/"; classtype:web-application-attack; sid:2500290; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Web Attack - HTTP Request Smuggling Attempt"; flow:established,to_server; http.request_header; content:"Transfer-Encoding"; http.request_header; content:"Content-Length"; classtype:web-application-attack; sid:2500291; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Web Attack - Server-Side Request Forgery to Internal Network"; flow:established,to_server; http.uri; pcre:"/(127\.0\.0\.1|localhost|10\.|192\.168\.|169\.254\.|172\.(1[6-9]|2[0-9]|3[01])\.)/i"; classtype:web-application-attack; sid:2500292; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Web Attack - Prototype Pollution via JSON Body"; flow:established,to_server; http.request_body; pcre:"/(\"__proto__\"|\"constructor\"|\"prototype\")/i"; classtype:web-application-attack; sid:2500293; rev:1;)
# Lateral Movement
alert smb $HOME_NET any -> $HOME_NET any (msg:"Lateral Movement - SMB Admin Share Access via IPC"; flow:established; content:"IPC$"; content:"ADMIN$"; classtype:attempted-admin; sid:2500294; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 5985 (msg:"Lateral Movement - WinRM Remote Execution"; flow:established; content:"WS-Management"; pcre:"/(Invoke-Command|Enter-PSSession|wmic)/i"; classtype:attempted-admin; sid:2500295; rev:1;)
# Privilege Escalation
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Privilege Escalation - Sudo Command Injection via Web"; flow:established,to_server; http.request_body; pcre:"/sudo\s+-u\s+(root|admin)/i"; classtype:attempted-admin; sid:2500296; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Privilege Escalation - WebShell Wget Download and Execute"; flow:established,to_server; http.request_body; pcre:"/(wget|curl)\s+.*\|\s*(bash|sh|python|perl)/i"; classtype:trojan-activity; sid:2500297; rev:1;)
# Reconnaissance
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Reconnaissance - WordPress REST API User Enumeration"; flow:established,to_server; http.uri; content:"/wp-json/wp/v2/users"; classtype:attempted-recon; sid:2500298; rev:1;)
# Persistence
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Persistence - WordPress Plugin Editor Modification"; flow:established,to_server; http.uri; content:"/wp-admin/plugin-editor.php"; http.method; content:"POST"; classtype:attempted-admin; sid:2500299; rev:1;)
