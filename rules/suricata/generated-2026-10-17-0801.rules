# CVE-2026-110653 - LatePoint WordPress Auth Bypass via Race Condition (CRITICAL, CVSS 9.1)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CVE-2026-110653 LatePoint WordPress OTP Race Condition Auth Bypass Attempt"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/wp-admin/admin-ajax.php"; http.request_body; content:"action=auth__verify_otp"; pcre:"/otp_verify_otp_nonce=[a-f0-9]+/"; detection_filter:track by_src, count 10, seconds 5; classtype:attempted-user; sid:2500200; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CVE-2026-110653 LatePoint WordPress Concurrent OTP Verification Brute Force"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/wp-admin/admin-ajax.php"; http.request_body; content:"action=auth__verify_otp"; flowbits:set,latepoint.otp.race; flowbits:expires 30; detection_filter:track by_src, count 5, seconds 2; classtype:attempted-user; sid:2500201; rev:1;)
