# === CVE-2026-82158: Dell Wyse Management Suite Critical XSS (CVSS 9.8) ===
alert http any any -> any any (msg:"CVE-2026-82158 Dell Wyse Management Suite XSS - Script Tag Injection"; flow:established,to_server; content:"/wms/"; nocase; content:"<script"; nocase; http_uri; pcre:"/(<script|onerror|onload|javascript:)/Ui"; reference:cve,2026-82158; classtype:web-application-attack; sid:521400600; rev:1;)
alert http any any -> any any (msg:"CVE-2026-82158 Dell Wyse XSS - DOM Injection Pattern"; flow:established,to_server; content:"innerHTML"; nocase; content:"document"; nocase; http_client_body; pcre:"/(innerHTML\s*=|document\.write)/i"; reference:cve,2026-82158; classtype:web-application-attack; sid:521400601; rev:1;)
alert http any any -> any any (msg:"CVE-2026-82158 Dell Wyse XSS - Event Handler Injection"; flow:established,to_server; content:"onerror="; nocase; content:"onload="; nocase; http_uri; pcre:"/(on(error|load|click|mouseover)\s*=)/Ui"; reference:cve,2026-82158; classtype:web-application-attack; sid:521400602; rev:1;)

