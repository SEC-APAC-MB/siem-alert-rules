# =============================================================================
# Suricata Rules — Authentication Attacks
# Covers: brute force, credential stuffing, default credentials, MFA bypass,
#          password spraying, session hijacking, OAuth abuse
# Total rules: 55
# SID range: 2303001 - 2303055
# =============================================================================

# --- Brute Force Attacks ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Brute Force - High Login Failure Rate"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(login|signin|auth|authenticate|session|api\/auth|api\/login|api\/v[0-9]+\/auth)/i"; http_uri; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-login; sid:2303001; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Brute Force - Distributed Login Attempts from Multiple IPs"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(login|signin|auth|authenticate|session)/i"; http_uri; threshold:type both, track by_src, count 20, seconds 300; classtype:attempted-login; sid:2303002; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Brute Force - Password Spraying Common Passwords"; flow:established,to_server; content:"POST"; http_method; pcre:"/(password|passwd|pwd|secret|pass)\s*=\s*(Password1!|password123|Welcome1|P@ssw0rd|admin123|12345678|qwerty123|letmein!)/i"; http_client_body; classtype:attempted-login; sid:2303003; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Brute Force - Sequential Username Enumeration"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(login|signin|auth)/i"; http_uri; pcre:"/(user|username|email|login|account)\s*=\s*(admin|root|test|user\d+|guest|operator)/i"; http_client_body; threshold:type both, track by_src, count 8, seconds 120; classtype:attempted-login; sid:2303004; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Brute Force - SSH-style Password List in HTTP"; flow:established,to_server; content:"POST"; http_method; pcre:"/(password|passwd|pwd|secret|pass)\s*=\s*(admin|root|toor|password|123456|qwerty|abc123|letmein|monkey|master|dragon|login|princess|football|shadow|sunshine|trustno1)/i"; http_client_body; classtype:attempted-login; sid:2303005; rev:1; metadata:created_at 2026-08-17;)

# --- Credential Stuffing ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Credential Stuffing - Automated Login Tool User-Agent"; flow:established,to_server; pcre:"/(Hydra|Ncrack|Medusa|BurpSuite|sqlmap|DirBuster|wfuzz|ffuf|Nikto|python-requests|curl\/7\.|httpclient|Apache-HttpClient|Go-http-client|reqwest)/i"; http_header; pcre:"/\/(login|signin|auth|authenticate|session)/i"; http_uri; classtype:attempted-login; sid:2303006; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Credential Stuffing - Fast Sequential Login Attempts"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(login|signin|auth|authenticate|session|api\/auth)/i"; http_uri; threshold:type both, track by_src, count 30, seconds 60; classtype:attempted-login; sid:2303007; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Credential Stuffing - Known Breached Credential Pattern"; flow:established,to_server; content:"POST"; http_method; pcre:"/(email|username|user|login)\s*=\s*[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}/i"; http_client_body; threshold:type both, track by_src, count 15, seconds 300; classtype:attempted-login; sid:2303008; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Credential Stuffing - Bulk Account Check API"; flow:established,to_server; pcre:"/\/api\/v[0-9]+\/(auth\/check|accounts\/validate|users\/verify|login\/check)/i"; http_uri; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-login; sid:2303009; rev:1; metadata:created_at 2026-08-17;)

# --- Default Credentials ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Default Credentials - admin/admin Login"; flow:established,to_server; content:"POST"; http_method; pcre:"/(user|username|login|email)\s*=\s*admin[^@]*&(password|passwd|pwd|secret|pass)\s*=\s*admin/i"; http_client_body; classtype:attempted-login; sid:2303010; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Default Credentials - Common IoT Default Login"; flow:established,to_server; content:"POST"; http_method; pcre:"/(user|username|login)\s*=\s*(root|admin|user|guest|default|pi|ubnt|support|service|operator)&(password|passwd|pwd|secret|pass)\s*=\s*(root|admin|password|1234|12345|default|ubnt|blank|changeme|welcome)/i"; http_client_body; classtype:attempted-login; sid:2303011; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Default Credentials - Tomcat Manager Login"; flow:established,to_server; content:"/manager/html"; http_uri; content:"Authorization"; http_header; content:"Basic"; http_header; classtype:attempted-login; sid:2303012; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Default Credentials - WordPress admin Login"; flow:established,to_server; content:"/wp-login.php"; http_uri; pcre:"/(log|user|username)\s*=\s*admin[^@]*&(pwd|password|pass)\s*=/i"; http_client_body; classtype:attempted-login; sid:2303013; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Default Credentials - phpMyAdmin Login"; flow:established,to_server; pcre:"/\/(phpmyadmin|pma|phpmyadmin\/index\.php)/i"; http_uri; pcre:"/(pma_username|username)\s*=\s*root/i"; http_client_body; classtype:attempted-login; sid:2303014; rev:1; metadata:created_at 2026-08-17;)

# --- MFA Bypass Attempts ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - MFA Bypass - OTP Brute Force"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(mfa|2fa|otp|verify|challenge|two-factor)/i"; http_uri; threshold:type both, track by_src, count 10, seconds 120; classtype:attempted-login; sid:2303015; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - MFA Bypass - Replay of Used OTP Token"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(mfa|2fa|otp|verify|challenge)/i"; http_uri; pcre:"/(otp|token|code|pin)\s*=\s*\d{4,8}/i"; http_client_body; classtype:attempted-login; sid:2303016; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - MFA Bypass - Backup Code Enumeration"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(mfa|2fa|backup|recovery)/i"; http_uri; pcre:"/(backup|recovery|code)\s*=\s*[a-zA-Z0-9]{4,8}/i"; http_client_body; threshold:type both, track by_src, count 5, seconds 300; classtype:attempted-login; sid:2303017; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - MFA Bypass - Session Token Without MFA Validation"; flow:established,to_server; pcre:"/(session_id|auth_token|access_token|jwt)=eyJ[a-zA-Z0-9_-]+/i"; http_uri; content:! "mfa_verified"; http_header; classtype:attempted-login; sid:2303018; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - MFA Bypass - Direct API Access Skipping MFA Step"; flow:established,to_server; pcre:"/\/api\/v[0-9]+\/(user|account|profile|dashboard|admin)/i"; http_uri; content:! "X-MFA-Verified"; http_header; content:"Authorization"; http_header; threshold:type both, track by_src, count 3, seconds 60; classtype:attempted-login; sid:2303019; rev:1; metadata:created_at 2026-08-17;)

# --- Session Hijacking ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Session Hijacking - Multiple IPs Same Session Token"; flow:established,to_server; content:"Cookie"; http_header; pcre:"/(sessionid|session_id|PHPSESSID|JSESSIONID|ASP\.NET_SessionId|connect\.sid|_session_id)=\w{16,}/i"; http_header; threshold:type both, track by_src, count 2, seconds 60; classtype:attempted-login; sid:2303020; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Session Hijacking - Session Token in URL"; flow:established,to_server; pcre:"/[?&](sessionid|session_id|PHPSESSID|JSESSIONID|sid|token)=\w{16,}/i"; http_uri; classtype:web-application-attack; sid:2303021; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Session Fixation - Pre-Set Session ID in Login"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(login|signin|auth)/i"; http_uri; pcre:"/(sessionid|session_id|PHPSESSID|JSESSIONID)=\w{16,}/i"; http_client_body; classtype:web-application-attack; sid:2303022; rev:1; metadata:created_at 2026-08-17;)

# --- JWT Attacks ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - JWT None Algorithm Bypass"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer"; http_header; pcre:"/eyJ[a-zA-Z0-9_-]+\.eyJ[a-zA-Z0-9_-]*\./"; http_header; pcre:"/\"alg\"\s*:\s*\"none\"/i"; classtype:web-application-attack; sid:2303023; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - JWT Algorithm Confusion - RS256 to HS256"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer"; http_header; pcre:"/eyJhbGciOiJI/i"; http_header; classtype:web-application-attack; sid:2303024; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - JWT Empty Signature"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer"; http_header; pcre:"/eyJ[a-zA-Z0-9_-]+\.eyJ[a-zA-Z0-9_-]+\.$/"; http_header; classtype:web-application-attack; sid:2303025; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - JWT jku/x5u Header Injection"; flow:established,to_server; content:"Authorization"; http_header; pcre:"/(jku|x5u)\s*:\s*\"https?:\/\//i"; http_header; classtype:web-application-attack; sid:2303026; rev:1; metadata:created_at 2026-08-17;)

# --- OAuth / OIDC Abuse ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - OAuth - Authorization Code Interception"; flow:established,to_server; pcre:"/\/(oauth|authorize|auth)\/.*code=[a-zA-Z0-9_-]+/i"; http_uri; threshold:type both, track by_src, count 3, seconds 30; classtype:web-application-attack; sid:2303027; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - OAuth - Open Redirect in Redirect URI"; flow:established,to_server; pcre:"/redirect_uri=https?:\/\/(?!([^\/]+\.)?trusthost\.tld)/i"; http_uri; classtype:web-application-attack; sid:2303028; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - OAuth - PKCE Downgrade Attack"; flow:established,to_server; pcre:"/\/(oauth|authorize|auth)\/.*code_challenge_method=(plain|S256)/i"; http_uri; pcre:"/code_challenge_method=plain/i"; http_uri; classtype:web-application-attack; sid:2303029; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - OAuth - Token Replay Across Applications"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer"; http_header; threshold:type both, track by_src, count 5, seconds 120; classtype:attempted-login; sid:2303030; rev:1; metadata:created_at 2026-08-17;)

# --- Password Attacks ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Password Reset Token Enumeration"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(reset|forgot|recover|change)\w*\/(password|passwd|pwd|pass)/i"; http_uri; threshold:type both, track by_src, count 10, seconds 300; classtype:attempted-login; sid:2303031; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Password Reset Token in URL Exposed"; flow:established,to_server; pcre:"/[?&](token|reset_token|verify_token|recovery_key)=[a-zA-Z0-9_-]{16,}/i"; http_uri; classtype:web-application-attack; sid:2303032; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Credential Prediction - Sequential User IDs"; flow:established,to_server; pcre:"/\/api\/v[0-9]+\/users\/\d+/i"; http_uri; threshold:type both, track by_src, count 20, seconds 60; classtype:attempted-recon; sid:2303033; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Account Lockout Bypass - IP Rotation"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(login|signin|auth|authenticate)/i"; http_uri; pcre:"/X-Forwarded-For|X-Real-IP|X-Client-IP|CF-Connecting-IP/i"; http_header; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-login; sid:2303034; rev:1; metadata:created_at 2026-08-17;)

# --- API Key / Token Abuse ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - API Key in URL Parameter"; flow:established,to_server; pcre:"/[?&](api_key|apikey|key|token|access_token|secret)=[a-zA-Z0-9_-]{16,}/i"; http_uri; classtype:web-application-attack; sid:2303035; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Leaked API Key Pattern - AWS"; flow:established,to_server; pcre:"/AKIA[A-Z0-9]{16}/"; http_client_body; classtype:web-application-attack; sid:2303036; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Leaked API Key Pattern - GitHub Token"; flow:established,to_server; pcre:"/(ghp|gho|ghu|ghs|ghr)_[a-zA-Z0-9]{36,}/"; http_client_body; classtype:web-application-attack; sid:2303037; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Leaked API Key Pattern - Stripe"; flow:established,to_server; pcre:"/(sk|pk)_(test|live)_[a-zA-Z0-9]{24,}/"; http_client_body; classtype:web-application-attack; sid:2303038; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Leaked API Key Pattern - Slack Token"; flow:established,to_server; pcre:"/xox[bpors]-[a-zA-Z0-9-]{10,}/"; http_client_body; classtype:web-application-attack; sid:2303039; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Leaked Private Key in HTTP"; flow:established,to_server; content:"-----BEGIN RSA PRIVATE KEY-----"; http_client_body; classtype:web-application-attack; sid:2303040; rev:1; metadata:created_at 2026-08-17;)

# --- SAML Attacks ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - SAML XML Signature Wrapping"; flow:established,to_server; content:"SAMLResponse"; http_client_body; pcre:"/<ds:Signature.*<\/ds:Signature>.*<ds:Signature/si"; http_client_body; classtype:web-application-attack; sid:2303041; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - SAML Comment Injection"; flow:established,to_server; content:"SAMLResponse"; http_client_body; pcre:"/<!--.*-->/i"; http_client_body; classtype:web-application-attack; sid:2303042; rev:1; metadata:created_at 2026-08-17;)

# --- Kerberos Attacks ---
alert tcp $EXTERNAL_NET any -> $HOME_NET 88 (msg:"AUTH ATTACK - Kerberos - AS-REP Roasting"; flow:established,to_server; content:"|00 00|"; depth:2; content:"|0a|"; within:1; distance:5; content:"krbtgt"; nocase:true; classtype:attempted-login; sid:2303043; rev:1; metadata:created_at 2026-08-17;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 88 (msg:"AUTH ATTACK - Kerberos - Golden Ticket Forged TGT"; flow:established,to_server; dsize:>500; content:"krbtgt"; nocase:true; classtype:attempted-admin; sid:2303044; rev:1; metadata:created_at 2026-08-17;)

# --- NTLM / Windows Auth ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - NTLM Relay Attempt"; flow:established,to_server; content:"Authorization"; http_header; content:"NTLM"; http_header; pcre:"/Authorization:\s*NTLM\s+[A-Za-z0-9+\/=]{50,}/i"; http_header; classtype:attempted-login; sid:2303045; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - NTLM Hash in HTTP Traffic"; flow:established,to_server; content:"Authorization"; http_header; content:"NTLM"; http_header; classtype:attempted-login; sid:2303046; rev:1; metadata:created_at 2026-08-17;)

# --- Authentication Anomalies ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Impossible Travel - Token Used from Distant IP"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer"; http_header; threshold:type both, track by_src, count 1, seconds 1; classtype:attempted-login; sid:2303047; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Suspicious Basic Auth over HTTP"; flow:established,to_server; content:"Authorization"; http_header; content:"Basic"; http_header; classtype:web-application-attack; sid:2303048; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Authentication Bypass via HTTP Method Tampering"; flow:established,to_server; pcre:"/\/(login|signin|auth|authenticate)\s*$/i"; http_uri; content:"GET"; http_method; classtype:attempted-login; sid:2303049; rev:1; metadata:created_at 2026-08-17;)

# --- Account Manipulation ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Account Enumeration via Error Messages"; flow:established,to_client; pcre:"/(user|username|email|account)\s+(not found|does not exist|is not registered|is invalid|doesn't exist|no account)/i"; http_server_body; classtype:attempted-recon; sid:2303050; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Mass Account Registration"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(register|signup|create.*account|api.*users)/i"; http_uri; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-admin; sid:2303051; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Password Policy Violation - Weak Password"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(register|signup|change.*password|reset.*password|api.*users)/i"; http_uri; pcre:"/(password|passwd|pwd|pass)\s*=\s*.{1,7}[\s&]/i"; http_client_body; classtype:attempted-login; sid:2303052; rev:1; metadata:created_at 2026-08-17;)

# --- CAPTCHA Bypass ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - CAPTCHA Bypass - Missing CAPTCHA Token on Login"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(login|signin|auth|register|signup)/i"; http_uri; content:! "captcha"; http_client_body; content:! "recaptcha"; http_client_body; content:! "h-captcha-response"; http_client_body; threshold:type both, track by_src, count 5, seconds 30; classtype:attempted-login; sid:2303053; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - CAPTCHA Solving Service API Call"; flow:established,to_server; pcre:"/(2captcha|rucaptcha|anti-captcha|deathbycaptcha|captchasolver|ez-ga|captchaai)/i"; http_header; classtype:attempted-login; sid:2303054; rev:1; metadata:created_at 2026-08-17;)

# --- Token Theft ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AUTH ATTACK - Stolen Token - Token Used from Anomalous User-Agent"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer"; http_header; pcre:"/(python-requests|curl|wget|httpclient|Apache-HttpClient|Go-http-client|reqwest|axios)/i"; http_header; classtype:attempted-login; sid:2303055; rev:1; metadata:created_at 2026-08-17;)