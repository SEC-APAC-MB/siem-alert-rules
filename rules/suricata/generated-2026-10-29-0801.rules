alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"MITRE T1572 Encrypted C2 channel beaconing pattern"; flow:established,to_server; dsize:<200; detection_filter:track by_src, count:10, seconds:60; classtype:trojan-activity; sid:521295188; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1567.002 Exfiltration to cloud storage provider"; flow:established,to_server; http_uri; content:".s3.amazonaws.com|7c|.blob.core.windows.net|7c|storage.googleapis.com"; http_method; content:"PUT"; dsize:>10000; classtype:exfiltration; sid:521295189; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MITRE T1550.003 Pass the Hash Windows authentication"; flow:established,to_server; http_header; content:"Authorization"; content:"NTLM "; pcre:"/Authorization:\s*NTLM\s+TlRMTVNTUA/"; classtype:credential-access; sid:521295190; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MITRE T1555.003 Windows Credential Manager access via web"; flow:established,to_server; http_client_body; content:"cmdkey"; content:"/list"; classtype:credential-access; sid:521295191; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MITRE T1219 Remote Access Tool TeamViewerAnyDesk abuse"; flow:established,to_server; http_uri; content:"/teamviewer|7c|/anydesk"; content:"download"; classtype:trojan-activity; sid:521295192; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MITRE T1566.002 Phishing Spearphishing Link suspicious redirect"; flow:established,to_server; http_uri; pcre:"/(bit\.ly|t\.co|tinyurl|shorte\.st)/"; http_uri; content:"login|7c|account|7c|verify"; classtype:trojan-activity; sid:521295193; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MITRE T1078 Valid Accounts default credential login attempt"; flow:established,to_server; http_uri; content:"/login"; http_client_body; content:"admin|7c|root|7c|test"; content:"password|7c|123456|7c|admin123"; classtype:attempted-admin; sid:521295194; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MITRE T1486 Data Encrypted for Impact ransomware via web"; flow:established,to_server; http_client_body; content:"encrypt"; content:".locked|7c|.encrypted|7c|.crypto"; classtype:trojan-activity; sid:521295195; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MITRE T1490 Inhibit System Recovery via vssadmin delete"; flow:established,to_server; http_client_body; content:"vssadmin"; content:"delete"; content:"shadows"; classtype:trojan-activity; sid:521295196; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MITRE T1562 Impair Defenses disable Windows Defender"; flow:established,to_server; http_client_body; content:"Set-MpPreference"; content:"DisableRealtimeMonitoring"; classtype:trojan-activity; sid:521295197; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MITRE T1136 Create Account via web application"; flow:established,to_server; http_method; content:"POST"; http_uri; content:"/api/users"; content:"role=admin"; http_client_body; content!"Authorization"; classtype:attempted-admin; sid:521295198; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"MITRE T1531 Account Access Removal mass deletion"; flow:established,to_server; http_method; content:"DELETE"; http_uri; content:"/api/users"; detection_filter:track by_src, count:10, seconds:30; classtype:attempted-admin; sid:521295199; rev:1;)
