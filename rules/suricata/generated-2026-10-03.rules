alert http any any -> any any (msg:"MITRE T1082 System Info Discovery via Web - OS Fingerprinting"; flow:established,to_server; http.request_body; pcre:"/(uname|systeminfo|hostname|ver|whoami\/all)/i"; classtype:attempted-recon; sid:52100677; rev:1;)

# === MITRE ATT&CK T1018 - Remote System Discovery ===
alert http any any -> any any (msg:"MITRE T1018 Remote System Discovery - Network Scan via Web Shell"; flow:established,to_server; http.request_body; pcre:"/(nmap|masscan|zmap|arp-scan|netdiscover|fping)/i"; classtype:attempted-recon; sid:52100678; rev:1;)

# === MITRE ATT&CK T1069 - Permission Groups Discovery ===
alert http any any -> any any (msg:"MITRE T1069 Active Directory Group Enumeration via Web"; flow:established,to_server; http.request_body; pcre:"/(net\s+group|dsquery\s+group|Get-ADGroup|Get-ADGroupMember)/i"; classtype:attempted-recon; sid:52100679; rev:1;)

# === MITRE ATT&CK T1087 - Account Discovery ===
alert http any any -> any any (msg:"MITRE T1087 Account Discovery - User Enumeration via Web"; flow:established,to_server; http.request_body; pcre:"/(net\s+user|dsquery\s+user|Get-ADUser|enum4linux|rpcclient)/i"; classtype:attempted-recon; sid:52100680; rev:1;)

# === MITRE ATT&CK T1136 - Create Account ===
alert http any any -> any any (msg:"MITRE T1136 Account Creation via Web Request - Suspicious New User"; flow:established,to_server; http.request_body; pcre:"/(useradd|net\s+user\s+\/add|adduser|user\s+-add|dsadd\s+user)/i"; classtype:attempted-admin; sid:52100681; rev:1;)

# === MITRE ATT&CK T1543 - Create or Modify System Process ===
alert http any any -> any any (msg:"MITRE T1543 Systemd Service Creation via Web"; flow:established,to_server; http.request_body; pcre:"/(systemctl\s+(create|enable|start)|\.service\s*\[Unit\]|systemd)/i"; classtype:attempted-admin; sid:52100682; rev:1;)

# === MITRE ATT&CK T1572 - Protocol Tunneling ===
alert tcp any any -> any 443 (msg:"MITRE T1572 Protocol Tunneling - Non-HTTPS Traffic on Port 443"; flow:established,to_server; content:"SSH-"; within:4; classtype:trojan-activity; sid:52100683; rev:1;)
alert http any any -> any any (msg:"MITRE T1572 DNS over HTTPS Tunneling - Suspicious DoH Provider"; flow:established,to_server; http.host; pcre:"/(cloudflare-dns\.com|dns\.google|dns\.quad9\.net|doh\.powerdns\.org)/i"; classtype:trojan-activity; sid:52100684; rev:1;)

# === MITRE ATT&CK T1090 - Proxy ===
alert tcp any any -> any [1080,3128,8080,8118,9050] (msg:"MITRE T1090 Proxy Chain - Connection to Known Proxy Service"; flow:established; classtype:trojan-activity; sid:52100685; rev:1;)
alert tcp any any -> any 9050 (msg:"MITRE T1090 Tor Exit Node Connection"; flow:established; classtype:trojan-activity; sid:52100686; rev:1;)

# === MITRE ATT&CK T1078 - Valid Accounts ===
alert http any any -> any any (msg:"MITRE T1078 Valid Account Abuse - Login from Unusual Geographic Location"; flow:established,to_server; http.uri; content:"/login"; nocase; http.method; content:"POST"; http.response_body; content:"200"; detection_filter:track by_src, count 5, seconds 300; classtype:trojan-activity; sid:52100687; rev:1;)

# === MITRE ATT&CK T1098 - Account Manipulation ===
alert http any any -> any any (msg:"MITRE T1098 Account Manipulation - Privilege Escalation via Web"; flow:established,to_server; http.request_body; pcre:"/(net\s+localgroup\s+administrators|usermod\s+-aG\s+sudo|Add-ADGroupMember)/i"; classtype:attempted-admin; sid:52100688; rev:1;)

# === MITRE ATT&CK T1134 - Access Token Manipulation ===
alert http any any -> any any (msg:"MITRE T1134 Access Token Manipulation - impersonation via Web"; flow:established,to_server; http.request_body; pcre:"/(Invoke-ImpersonationUser|incognito|steal_token|token::elevate)/i"; classtype:trojan-activity; sid:52100689; rev:1;)

# === MITRE ATT&CK T1557 - Adversary-in-the-Middle ===
alert tcp any any -> any any (msg:"MITRE T1557 AitM - ARP Spoofing Detection Pattern"; flow:established; dsize:<100; classtype:trojan-activity; sid:52100690; rev:1;)

# === MITRE ATT&CK T1555 - Credentials from Password Stores ===
alert http any any -> any any (msg:"MITRE T1555 Credential Store Access - Browser Password Extraction"; flow:established,to_server; http.request_body; pcre:"/(Chrome\+Login\+Data|cookies\.sqlite|key4\.db|logins\.json)/i"; classtype:trojan-activity; sid:52100691; rev:1;)

# === MITRE ATT&CK T1539 - Steal Web Session Cookie ===
alert http any any -> any any (msg:"MITRE T1539 Session Cookie Theft - Suspicious Cookie Exfiltration"; flow:established,to_server; http.request_body; pcre:"/(JSESSIONID|PHPSESSID|ASP\.NET_SessionId|_ga|session_token)/i"; dsize:>500; classtype:trojan-activity; sid:52100692; rev:1;)

# === MITRE ATT&CK T1528 - Steal Application Access Token ===
alert http any any -> any any (msg:"MITRE T1528 OAuth Token Theft - Suspicious Token in URL Parameter"; flow:established,to_server; http.uri; pcre:"/(access_token|bearer|jwt|id_token)=eyJ/i"; classtype:trojan-activity; sid:52100693; rev:1;)

# === MITRE ATT&CK T1556 - Modify Authentication Process ===
alert http any any -> any any (msg:"MITRE T1556 Authentication Process Modification - PAM Backdoor"; flow:established,to_server; http.request_body; pcre:"/(pam\.so|nsswitch\.conf|SSO|kerberos.*config)/i"; classtype:attempted-admin; sid:52100694; rev:1;)

# === MITRE ATT&CK T1571 - Non-Standard Port ===
alert tcp any any -> any [4444,5555,6666,7777,8888,9999,1337,31337] (msg:"MITRE T1571 Non-Standard Port C2 Communication"; flow:established; classtype:trojan-activity; sid:52100695; rev:1;)

# === MITRE ATT&CK T1573 - Encrypted Channel ===
alert tls any any -> any any (msg:"MITRE T1573 Encrypted Channel - Self-Signed Certificate C2"; flow:established; tls.subject; content:"CN="; tls.issuer; content:"CN="; classtype:trojan-activity; sid:52100696; rev:1;)

# === MITRE ATT&CK T1059.004 - Cloud API ===
alert http any any -> any any (msg:"MITRE T1059.004 Cloud API Abuse - AWS CLI via Web Shell"; flow:established,to_server; http.request_body; pcre:"/(aws\s+s3|aws\s+ec2|aws\s+iam|aws\s+sts|gcloud|az\s+vm)/i"; classtype:command-execution; sid:52100697; rev:1;)

# === MITRE ATT&CK T1485 - Data Destruction ===
alert http any any -> any any (msg:"MITRE T1485 Data Destruction - Mass Delete via Web Request"; flow:established,to_server; http.request_body; pcre:"/(rm\s+-rf|del\s+\/[fqs]|format\s+[a-z]:|shred|wipe)/i"; classtype:trojan-activity; sid:52100698; rev:1;)

# === MITRE ATT&CK T1490 - Inhibit System Recovery ===
alert http any any -> any any (msg:"MITRE T1490 Inhibit Recovery - VSS Deletion via Web Shell"; flow:established,to_server; http.request_body; pcre:"/(vssadmin\s+delete|wbadmin\s+delete|bcdedit|recoveryenabled)/i"; classtype:trojan-activity; sid:52100699; rev:1;)

# === MITRE ATT&CK T1561 - Disk Wipe ===
alert http any any -> any any (msg:"MITRE T1561 Disk Wipe - Raw Disk Access via Web Shell"; flow:established,to_server; http.request_body; pcre:"/(dd\s+if=\/dev\/(zero|random)|shred\s+-|dd\s+of=\/dev\/(sda|hda|nvme))/i"; classtype:trojan-activity; sid:52100700; rev:1;)
