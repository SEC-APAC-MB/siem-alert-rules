# === MITRE ATT&CK T1071.001 - Application Layer Protocol: Web (C2) ===
alert http any any -> any any (msg:"MITRE T1071.001 C2 via HTTP - beaconing pattern regular interval"; flow:established,to_server; pcre:"/\/(beacon|checkin|callback)\/[a-f0-9]{16}/i"; reference:url,attack.mitre.org/techniques/T1071/001/; classtype:trojan-activity; sid:5208355; rev:1;)
alert http any any -> any any (msg:"MITRE T1071.001 C2 via HTTP - suspicious POST with encrypted payload"; flow:established,to_server; content:"POST"; http_method; pcre:"/Content-Type:\s*application\/octet-stream/i"; dsize:>4096; reference:url,attack.mitre.org/techniques/T1071/001/; classtype:trojan-activity; sid:5208356; rev:1;)

# === MITRE ATT&CK T1568 - Dynamic Resolution (C2 Infrastructure) ===
alert dns any any -> any any (msg:"MITRE T1568.002 Dynamic DNS domain lookup - suspicious free DDNS provider"; dns_query; pcre:"/(duckdns\.org|no-ip\.com|ddns\.net|freedns\.afraid\.org)/i"; reference:url,attack.mitre.org/techniques/T1568/002/; classtype:trojan-activity; sid:5208357; rev:1;)

# === MITRE ATT&CK T1041 - Exfiltration Over C2 Channel ===
alert http any any -> any any (msg:"MITRE T1041 Exfiltration over C2 - large HTTP POST to suspicious endpoint"; flow:established,to_server; content:"POST"; http_method; dsize:>100000; pcre:"/\/(upload|exfil|data|report)\//i"; reference:url,attack.mitre.org/techniques/T1041/; classtype:exfiltration; sid:5208358; rev:1;)

# === MITRE ATT&CK T1048.002 - Exfiltration Over Alternative Protocol: Exfil Over Unencrypted Non-C2 ===
alert tcp any any -> any any (msg:"MITRE T1048.002 Exfiltration over unencrypted FTP to external server"; flow:established,to_server; content:"STOR"; pcre:"/STOR\s+.*(archive|backup|dump|export)/i"; dsize:>1000000; reference:url,attack.mitre.org/techniques/T1048/002/; classtype:exfiltration; sid:5208359; rev:1;)

# === MITRE ATT&CK T1027 - Obfuscated Files or Information ===
alert http any any -> any any (msg:"MITRE T1027 Obfuscated payload - Base64 encoded content in HTTP header"; flow:established,to_server; pcre:"/(Authorization|X-Data|X-Token):\s*Bearer\s+[A-Za-z0-9+\/]{200,}=/i"; reference:url,attack.mitre.org/techniques/T1027/; classtype:trojan-activity; sid:5208360; rev:1;)

# === MITRE ATT&CK T1140 - Deobfuscate/Decode Files or Information ===
alert tcp any any -> any any (msg:"MITRE T1140 Deobfuscation - base64 decode command execution"; flow:established; pcre:"/base64\s+(-d|--decode)\s+.*\|\s*(sh|bash|python)/i"; reference:url,attack.mitre.org/techniques/T1140/; classtype:trojan-activity; sid:5208361; rev:1;)

# === MITRE ATT&CK T1030 - Data Transfer Size Limits ===
alert tcp any any -> any any (msg:"MITRE T1030 Data transfer size limit bypass - chunked file split pattern"; flow:established,to_server; pcre:"/split.*-b.*\d+.*\|\s*(scp|curl|nc)/i"; reference:url,attack.mitre.org/techniques/T1030/; classtype:exfiltration; sid:5208362; rev:1;)

# === MITRE ATT&CK T1078 - Valid Accounts (Defense Evasion/Persistence) ===
alert tcp any any -> any any (msg:"MITRE T1078.002 Valid accounts - admin login from unusual geographic source"; flow:established; pcre:"/ssh.*Accepted.*(password|publickey).*root.*from/i"; reference:url,attack.mitre.org/techniques/T1078/002/; classtype:successful-admin; sid:5208363; rev:1;)
alert tcp any any -> any any (msg:"MITRE T1078.004 Valid accounts - cloud API key usage from new IP"; flow:established,to_server; pcre:"/Authorization:\s*Bearer\s+AKIA[A-Z0-9]{16}/i"; reference:url,attack.mitre.org/techniques/T1078/004/; classtype:successful-admin; sid:5208364; rev:1;)

# === MITRE ATT&CK T1110 - Brute Force (Credential Access) ===
alert tcp any any -> any any (msg:"MITRE T1110.001 Brute force - password guessing SSH multiple failures"; flow:established; pcre:"/ssh.*Failed.*password/i"; threshold:type threshold, track by_src, count 20, seconds 60; reference:url,attack.mitre.org/techniques/T1110/001/; classtype:attempted-admin; sid:5208365; rev:1;)
alert http any any -> any any (msg:"MITRE T1110.003 Brute force - credential stuffing HTTP form multiple attempts"; flow:established,to_server; content:"POST"; http_method; pcre:"/(login|signin|auth).*(password|passwd|pass)=/i"; threshold:type threshold, track by_src, count 30, seconds 300; reference:url,attack.mitre.org/techniques/T1110/003/; classtype:attempted-admin; sid:5208366; rev:1;)

# === MITRE ATT&CK T1053 - Scheduled Task/Job (Execution/Persistence) ===
alert tcp any any -> any any (msg:"MITRE T1053.003 Cron job creation for persistence via HTTP"; flow:established,to_server; pcre:"/(crontab|cron\.d).*(\*.*\*.*\*.*\*).*(nc|curl|wget|bash)/i"; reference:url,attack.mitre.org/techniques/T1053/003/; classtype:trojan-activity; sid:5208367; rev:1;)
alert tcp any any -> any any (msg:"MITRE T1053.005 systemd service unit creation for persistence"; flow:established; pcre:"/\[Unit\].*\[Service\].*ExecStart=.*(\/tmp|\/dev\/shm)/i"; reference:url,attack.mitre.org/techniques/T1053/005/; classtype:trojan-activity; sid:5208368; rev:1;)

# === MITRE ATT&CK T1547.001 - Boot or Logon Autostart Execution: Registry Run Keys ===
alert tcp any any -> any any (msg:"MITRE T1547.001 Registry Run key modification for persistence"; flow:established; pcre:"/HKLM\\Software\\Microsoft\\Windows\\CurrentVersion\\Run/i"; reference:url,attack.mitre.org/techniques/T1547/001/; classtype:trojan-activity; sid:5208369; rev:1;)

# === MITRE ATT&CK T1003 - OS Credential Dumping ===
alert tcp any any -> any any (msg:"MITRE T1003.001 Credential dumping - LSASS memory access via Mimikatz pattern"; flow:established; pcre:"/sekurlsa::(logonpasswords|tickets|minidump)/i"; reference:url,attack.mitre.org/techniques/T1003/001/; classtype:attempted-admin; sid:5208370; rev:1;)
alert tcp any any -> any any (msg:"MITRE T1003.006 Credential dumping - /etc/shadow file access via HTTP"; flow:established,to_server; pcre:"/etc\/shadow|etc\/passwd.*root/i"; reference:url,attack.mitre.org/techniques/T1003/006/; classtype:attempted-admin; sid:5208371; rev:1;)

# === MITRE ATT&CK T1555 - Credentials from Password Stores ===
alert tcp any any -> any any (msg:"MITRE T1555.003 Credentials from password stores - keychain access attempt"; flow:established; pcre:"/security\s+find-generic-password|security\s+find-internet-password/i"; reference:url,attack.mitre.org/techniques/T1555/003/; classtype:credential-access; sid:5208372; rev:1;)

# === MITRE ATT&CK T1566 - Phishing (Initial Access) ===
alert http any any -> any any (msg:"MITRE T1566.002 Spearphishing link - suspicious redirect with credential harvest URL"; flow:established,to_server; pcre:"/(login|signin|account|verify).*(\.tk|\.ml|\.ga|\.cf)/i"; reference:url,attack.mitre.org/techniques/T1566/002/; classtype:phishing; sid:5208373; rev:1;)

# === MITRE ATT&CK T1059.001 - PowerShell (Execution) ===
alert tcp any any -> any any (msg:"MITRE T1059.001 PowerShell - encoded command execution via HTTP"; flow:established,to_server; pcre:"/powershell.*-enc\s+[A-Za-z0-9+\/]{50,}=/i"; reference:url,attack.mitre.org/techniques/T1059/001/; classtype:trojan-activity; sid:5208374; rev:1;)
alert tcp any any -> any any (msg:"MITRE T1059.001 PowerShell - download cradle execution pattern"; flow:established; pcre:"/(IEX|Invoke-Expression).*(New-Object\s+Net\.WebClient|DownloadString)/i"; reference:url,attack.mitre.org/techniques/T1059/001/; classtype:trojan-activity; sid:5208375; rev:1;)

# === MITRE ATT&CK T1218 - System Binary Proxy Execution ===
alert tcp any any -> any any (msg:"MITRE T1218.005 System binary proxy - mshta.exe executing remote script"; flow:established; pcre:"/mshta\s+(http|https):\/\//i"; reference:url,attack.mitre.org/techniques/T1218/005/; classtype:trojan-activity; sid:5208376; rev:1;)
alert tcp any any -> any any (msg:"MITRE T1218.010 System binary proxy - regsvr32 scrobj.dll remote"; flow:established; pcre:"/regsvr32\s+.*\/s\s+.*scrobj\.dll/i"; reference:url,attack.mitre.org/techniques/T1218/010/; classtype:trojan-activity; sid:5208377; rev:1;)

# === MITRE ATT&CK T1021 - Remote Services (Lateral Movement) ===
alert tcp any any -> any any (msg:"MITRE T1021.004 Remote services - SSH lateral movement from compromised host"; flow:established,to_server; pcre:"/ssh\s+.*-i\s+.*(id_rsa|id_ecdsa|id_ed25519)/i"; reference:url,attack.mitre.org/techniques/T1021/004/; classtype:lateral-movement; sid:5208378; rev:1;)

# === MITRE ATT&CK T1090 - Proxy (Command and Control) ===
alert tcp any any -> any any (msg:"MITRE T1090.002 Tor exit node connection to internal service"; flow:established,to_server; pcre:"/tor.*exit.*node|tor2web|onion\.to/i"; reference:url,attack.mitre.org/techniques/T1090/002/; classtype:trojan-activity; sid:5208379; rev:1;)

# === MITRE ATT&CK T1567 - Exfiltration Over Web Service ===
alert http any any -> any any (msg:"MITRE T1567.002 Exfiltration over web service - large upload to cloud storage"; flow:established,to_server; pcre:"/(s3\.amazonaws\.com|blob\.core\.windows\.net|storage\.googleapis\.com)\/.*(backup|dump|archive)/i"; dsize:>5000000; reference:url,attack.mitre.org/techniques/T1567/002/; classtype:exfiltration; sid:5208380; rev:1;)

# === MITRE ATT&CK T1105 - Ingress Tool Transfer ===
alert http any any -> any any (msg:"MITRE T1105 Ingress tool transfer - executable download from suspicious URL"; flow:established,to_client; pcre:"/\/.*\.(exe|dll|sh|bin|elf)$/"; content:"Content-Type|3a| application/octet-stream"; http_header; reference:url,attack.mitre.org/techniques/T1105/; classtype:trojan-activity; sid:5208381; rev:1;)
alert http any any -> any any (msg:"MITRE T1105 Ingress tool transfer - curl/wget downloading script to tmp"; flow:established; pcre:"/(curl|wget).*\/tmp\/|curl.*\/dev\/shm\//i"; reference:url,attack.mitre.org/techniques/T1105/; classtype:trojan-activity; sid:5208382; rev:1;)

# === MITRE ATT&CK T1136 - Create Account (Persistence) ===
alert tcp any any -> any any (msg:"MITRE T1136.001 Create account - new user creation via useradd/adduser over SSH"; flow:established; pcre:"/(useradd|adduser)\s+.*(-m|-p|--create-home)/i"; reference:url,attack.mitre.org/techniques/T1136/001/; classtype:attempted-admin; sid:5208383; rev:1;)

# === MITRE ATT&CK T1543.002 - Create or Modify System Process: Systemd Service ===
alert tcp any any -> any any (msg:"MITRE T1543.002 Systemd service creation with suspicious ExecStart"; flow:established; pcre:"/ExecStart=.*\/(tmp|dev|var\/tmp)\/.*\.sh/i"; reference:url,attack.mitre.org/techniques/T1543/002/; classtype:trojan-activity; sid:5208384; rev:1;)

# === MITRE ATT&CK T1550 - Use Alternate Authentication Material ===
alert tcp any any -> any any (msg:"MITRE T1550.002 Use alternate auth material - Pass-the-Hash Windows event"; flow:established; pcre:"/NTLM.*hash.*authentication|pth.*NTLM/i"; reference:url,attack.mitre.org/techniques/T1550/002/; classtype:credential-access; sid:5208385; rev:1;)

# === MITRE ATT&CK T1486 - Data Encrypted for Impact (Ransomware) ===
alert tcp any any -> any any (msg:"MITRE T1486 Ransomware - mass file encryption activity pattern"; flow:established; pcre:"/(encrypt|crypt)\s+.*\.(txt|docx|xlsx|pdf|jpg|png)/i"; threshold:type threshold, track by_src, count 100, seconds 30; reference:url,attack.mitre.org/techniques/T1486/; classtype:trojan-activity; sid:5208386; rev:1;)
alert tcp any any -> any any (msg:"MITRE T1486 Ransomware - ransom note file creation detected"; flow:established; pcre:"/(README|HOW_TO|DECRYPT|RECOVER).*\.(txt|html|hta)/i"; reference:url,attack.mitre.org/techniques/T1486/; classtype:trojan-activity; sid:5208387; rev:1;)

# === MITRE ATT&CK T1490 - Inhibit System Recovery ===
alert tcp any any -> any any (msg:"MITRE T1490 Inhibit system recovery - vssadmin delete shadows"; flow:established; pcre:"/vssadmin\s+delete\s+shadows\s+.*\/all/i"; reference:url,attack.mitre.org/techniques/T1490/; classtype:attempted-admin; sid:5208388; rev:1;)
alert tcp any any -> any any (msg:"MITRE T1490 Inhibit system recovery - wbadmin delete system state backup"; flow:established; pcre:"/wbadmin\s+delete\s+(systemstatebackup|catalog)/i"; reference:url,attack.mitre.org/techniques/T1490/; classtype:attempted-admin; sid:5208389; rev:1;)

# === MITRE ATT&CK T1562 - Impair Defenses ===
alert tcp any any -> any any (msg:"MITRE T1562.001 Impair defenses - disabling firewall via iptables flush"; flow:established; pcre:"/iptables\s+(-F|--flush|.*DROP\s+.*INPUT)/i"; reference:url,attack.mitre.org/techniques/T1562/001/; classtype:attempted-admin; sid:5208390; rev:1;)
alert tcp any any -> any any (msg:"MITRE T1562.004 Impair defenses - disabling antivirus or EDR via kill"; flow:established; pcre:"/(kill|killall|pkill)\s+.*(defender|symantec|kaspersky|crowdstrike|sentinel)/i"; reference:url,attack.mitre.org/techniques/T1562/004/; classtype:attempted-admin; sid:5208391; rev:1;)

# === MITRE ATT&CK T1087 - Account Discovery (Discovery) ===
alert tcp any any -> any any (msg:"MITRE T1087.001 Account discovery - enumeration via net commands"; flow:established; pcre:"/net\s+(user|localgroup|group)\s+.*\/(domain|all)/i"; reference:url,attack.mitre.org/techniques/T1087/001/; classtype:attempted-recon; sid:5208392; rev:1;)
alert tcp any any -> any any (msg:"MITRE T1087.001 Account discovery - LDAP query for all users"; flow:established; pcre:"/ldapsearch.*objectClass.*user|dsquery\s+\*\s+.*user/i"; reference:url,attack.mitre.org/techniques/T1087/001/; classtype:attempted-recon; sid:5208393; rev:1;)

# === MITRE ATT&CK T1069 - Active Directory Discovery ===
alert tcp any any -> any any (msg:"MITRE T1069 Active Directory groups discovery via BloodHound pattern"; flow:established; pcre:"/bloodhound|sharp*hound|Get-*AD*Group/i"; reference:url,attack.mitre.org/techniques/T1069/; classtype:attempted-recon; sid:5208394; rev:1;)

# === MITRE ATT&CK T1482 - Domain Trust Discovery ===
alert tcp any any -> any any (msg:"MITRE T1482 Domain trust discovery - nltest domain trust query"; flow:established; pcre:"/nltest\s+.*\/domain_trusts/i"; reference:url,attack.mitre.org/techniques/T1482/; classtype:attempted-recon; sid:5208395; rev:1;)

# === MITRE ATT&CK T1135 - Network Share Discovery ===
alert tcp any any -> any any (msg:"MITRE T1135 Network share discovery - SMB share enumeration pattern"; flow:established; pcre:"/net\s+share|smbclient\s+.*-L\s+|enum4linux/i"; reference:url,attack.mitre.org/techniques/T1135/; classtype:attempted-recon; sid:5208396; rev:1;)

# === MITRE ATT&CK T1518 - Software Discovery ===
alert tcp any any -> any any (msg:"MITRE T1518.001 Software discovery - security tool enumeration via wmic"; flow:established; pcre:"/wmic\s+.*process\s+.*where|tasklist.*\/svc/i"; reference:url,attack.mitre.org/techniques/T1518/001/; classtype:attempted-recon; sid:5208397; rev:1;)

# === MITRE ATT&CK T1082 - System Information Discovery ===
alert tcp any any -> any any (msg:"MITRE T1082 System information discovery - uname and hostname chain"; flow:established; pcre:"/uname\s+-a.*hostname|systeminfo\s+.*\|\s*findstr/i"; reference:url,attack.mitre.org/techniques/T1082/; classtype:attempted-recon; sid:5208398; rev:1;)

# === MITRE ATT&CK T1083 - File and Directory Discovery ===
alert tcp any any -> any any (msg:"MITRE T1083 File directory discovery - recursive find for sensitive files"; flow:established; pcre:"/find\s+.*\/.*\(-name.*\.(pdf|docx|xlsx|key|pem|pfx)\)/i"; reference:url,attack.mitre.org/techniques/T1083/; classtype:attempted-recon; sid:5208399; rev:1;)

# === MITRE ATT&CK T1005 - Data from Local System (Collection) ===
alert tcp any any -> any any (msg:"MITRE T1005 Data from local system - bulk file copy to staging directory"; flow:established; pcre:"/(cp|copy|rsync)\s+.*\/(home|Users|Documents).*(\/tmp|\/dev\/shm|C:\\Temp)/i"; reference:url,attack.mitre.org/techniques/T1005/; classtype:exfiltration; sid:5208400; rev:1;)
