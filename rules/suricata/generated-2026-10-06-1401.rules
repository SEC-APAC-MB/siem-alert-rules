alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1550.003 Use Alternate Auth Material - Pass-the-Hash via NTLM"; flow:established,to_server; http.request_header; content:"Authorization"; nocase; content:"NTLM"; distance:0; classtype:attempted-admin; sid:52111677; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1550.001 Use Alternate Auth Material - Pass-the-Ticket via Kerberos"; flow:established,to_server; http.request_header; content:"Authorization"; nocase; content:"Kerberos"; distance:0; classtype:attempted-admin; sid:52111678; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1555 Credentials from Password Stores - browser credential extraction"; flow:established,to_server; http.request_body; content:"Login Data"; nocase; content:"Chrome"; distance:0; classtype:credential-theft; sid:52111679; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1110.004 Brute Force - credential stuffing with breach corpus"; flow:established,to_server; http.request_body; content:"password"; nocase; http.response_body; content:"incorrect"; distance:0; detection_filter:track by_src, count:30, seconds:60; classtype:attempted-user; sid:52111680; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1056.004 Input Capture - credential harvesting via fake login page"; flow:established,to_server; http.uri; content:"/login"; nocase; http.response_body; content:"<form"; distance:0; content:"password"; distance:0; pcre:"/action=[\"']?https?:\/\/[^\/]*\.(tk|ml|ga|cf|gq)/i"; classtype:credential-theft; sid:52111681; rev:1;)

# === MITRE ATT&CK - Exfiltration & C2 (82-100) ===

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1041 Exfiltration Over C2 Channel - large data POST to suspicious domain"; flow:established,to_server; http.request_body; dsize:>1000000; http.host; pcre:"/^[a-z0-9]{10,}\.(ru|cn|tk|ml|ga|cf|gq|xyz|top)/"; classtype:exfiltration; sid:52111682; rev:1;)
alert dns $HOME_NET any -> any 53 (msg:"MITRE T1048.002 Exfiltration Over Alternative Protocol - DNS exfiltration via TXT queries"; dns.query.name; pcre:"/[a-z0-9]{40,}\./"; classtype:exfiltration; sid:52111683; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1048.003 Exfiltration Over Unencrypted Non-C2 - HTTP file upload to file sharing"; flow:established,to_server; http.host; pcre:"/(sendspace|filebin|transfer\.sh|0x0\.st|filetransfer\.io)/"; classtype:exfiltration; sid:52111684; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1567.002 Exfiltration to Cloud Storage - AWS S3 upload from internal"; flow:established,to_server; http.host; pcre:"/\.s3\.amazonaws\.com/"; http.method; content:"PUT"; distance:0; classtype:exfiltration; sid:52111685; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1567.002 Exfiltration to Cloud Storage - Azure Blob upload from internal"; flow:established,to_server; http.host; pcre:"/\.blob\.core\.windows\.net/"; http.method; content:"PUT"; distance:0; classtype:exfiltration; sid:52111686; rev:1;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1071.001 Web Protocols - C2 beaconing via HTTPS to suspicious domain"; flow:established,to_server; tls.sni; pcre:"/^[a-z0-9]{15,}\.(ru|cn|ir|kp|sy)/"; classtype:trojan-activity; sid:52111687; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1105 Ingress Tool Transfer - executable download from file sharing"; flow:established,to_server; http.response_body; content:"MZ"; offset:0; depth:2; http.host; pcre:"/(mediafire|mega\.nz|rapidshare|dropbox|wetransfer)/"; classtype:trojan-activity; sid:52111688; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1105 Ingress Tool Transfer - suspicious binary download with fake extension"; flow:established,to_server; http.uri; pcre:"/\.(txt|jpg|png|gif|pdf|doc)$/"; http.response_header; content:"Content-Type"; nocase; content:"application/octet-stream"; distance:0; classtype:trojan-activity; sid:52111689; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1090.003 Proxy - Tor exit node traffic to internal service"; flow:established,to_server; http.request_header; content:"X-Tor"; nocase; classtype:trojan-activity; sid:52111690; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1568.002 Dynamic Resolution - domain generation algorithm pattern"; flow:established,to_server; http.host; pcre:"/^[a-z0-9]{8,16}\.(ru|cn|tk|ml|ga|cf|gq|xyz|top|pw|cc|su)$/"; classtype:trojan-activity; sid:52111691; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1486 Data Encrypted for Impact - ransomware file extension pattern"; flow:established,to_server; http.request_body; pcre:"/\.(locked|encrypted|crypt|crypted|lock|crypto|ransom|pay|wannacry|ryk|ryuk|locky)$/"; classtype:ransomware; sid:52111692; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1490 Inhibit System Recovery - vssadmin delete shadows via web shell"; flow:established,to_server; http.request_body; content:"vssadmin"; nocase; content:"delete"; distance:0; content:"shadows"; distance:0; classtype:ransomware; sid:52111693; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1496 Resource Hijacking - cryptominer download from browser"; flow:established,to_server; http.response_body; content:"stratum+tcp"; nocase; content:"pool"; distance:0; classtype:trojan-activity; sid:52111694; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1496 Resource Hijacking - XMRig cryptocurrency miner C2 communication"; flow:established,to_server; http.uri; content:"/pool/"; nocase; http.request_body; content:"xmr"; distance:0; classtype:trojan-activity; sid:52111695; rev:1;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1071.004 Application Layer Protocol - DNS over HTTPS tunneling to non-standard DoH"; flow:established,to_server; http.host; pcre:"/(dns\.google|cloudflare-dns\.com|dns\.quad9\.net|doh\.dns\.sb|dns\.adguard\.com)/"; http.uri; content:"/dns-query"; nocase; classtype:trojan-activity; sid:52111696; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1566.002 Phishing - credential harvesting link in email-redirect pattern"; flow:established,to_server; http.uri; pcre:"/(email|inbox|verify|account|secure|update|login|confirm|reset).*(redirect|callback|return|next)=/i"; classtype:credential-theft; sid:52111697; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1566.001 Phishing - malicious attachment download with macro-enabled Office file"; flow:established,to_server; http.uri; pcre:"/\.(docm|xlsm|pptm|xlsb)$/"; classtype:trojan-activity; sid:52111698; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1027 Obfuscated Files - base64 encoded payload in HTTP header"; flow:established,to_server; http.request_header; pcre:"/(Authorization|X-Custom|X-Token): [A-Za-z0-9+\/]{200,}={0,2}/"; classtype:trojan-activity; sid:52111699; rev:1;)
