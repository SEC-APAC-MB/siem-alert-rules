# MITRE ATT&CK T1053 - Scheduled Task/Job
alert http any any -> any any (msg:"MITRE T1053.005 Scheduled Task creation via HTTP web shell"; http.request_body; content:"schtasks"; nocase; http.request_body; content:"/create"; nocase; classtype:attempted-user; sid:521297395; rev:1;)

# MITRE ATT&CK T1547 - Boot or Logon Autostart Execution
alert http any any -> any any (msg:"MITRE T1547.001 Registry Run key modification via web request"; http.request_body; content:"HKLM"; nocase; http.request_body; content:"Software\\Microsoft\\Windows\\CurrentVersion\\Run"; nocase; classtype:attempted-user; sid:521297396; rev:1;)

# MITRE ATT&CK T1048 - Exfiltration Over Alternative Protocol
alert udp any any -> any 53 (msg:"MITRE T1048.002 Exfiltration Over Alternative Protocol - DNS tunneling large TXT queries"; dns.query.name; pcre:"/[a-z0-9]{50,}\./i"; dsize:>512; classtype:exfiltration; sid:521297397; rev:1;)

# MITRE ATT&CK T1090 - Proxy
alert tcp any any -> any any (msg:"MITRE T1090 Proxy - connection to known TOR exit node"; classtype:trojan-activity; sid:521297398; rev:1;)

# MITRE ATT&CK T1566 - Phishing
alert http any any -> any any (msg:"MITRE T1566.002 Spearphishing Link - suspicious redirect to credential harvest"; http.response_header; content:"Location"; http.response_header; pcre:"/(bit\.ly|tinyurl|t\.co)\/[a-zA-Z0-9]+/i"; http.response_header; content:"login"; nocase; classtype:trojan-activity; sid:521297399; rev:1;)

# MITRE ATT&CK T1550 - Use Alternate Authentication Material
alert tcp any any -> any 88 (msg:"MITRE T1550.003 Use Alternate Auth Material - Kerberos ticket request anomaly"; dsize:>1000; detection_filter:track by_src, count 5, seconds 60; classtype:attempted-user; sid:521297400; rev:1;)

# MITRE ATT&CK T1484 - Domain Policy Modification
alert tcp any any -> any 389 (msg:"MITRE T1484.001 Domain Policy Modification - LDAP modify on Group Policy"; content:"modify"; nocase; classtype:attempted-admin; sid:521297401; rev:1;)

# MITRE ATT&CK T1008 - Fallback Channels
alert tcp any any -> any 4444 (msg:"MITRE T1008 Fallback Channels - beaconing on non-standard port 4444"; flags:S,12; detection_filter:track by_src, count 10, seconds 60; classtype:trojan-activity; sid:521297402; rev:1;)

# MITRE ATT&CK T1136 - Create Account
alert http any any -> any any (msg:"MITRE T1136.002 Create Account - suspicious user registration via web"; http.method; content:"POST"; http.uri; pcre:"/(register|signup|create-user|adduser)/i"; http.request_body; content:"role"; nocase; http.request_body; content:"admin"; nocase; classtype:attempted-admin; sid:521297403; rev:1;)

# MITRE ATT&CK T1611 - Escape to Host
alert http any any -> any any (msg:"MITRE T1611 Escape to Host - container escape via privileged mount access"; http.request_body; content:"/proc/1/root"; nocase; http.request_body; content:"/host"; nocase; classtype:attempted-admin; sid:521297404; rev:1;)

# MITRE ATT&CK T1490 - Inhibit System Recovery
alert http any any -> any any (msg:"MITRE T1490 Inhibit System Recovery - vssadmin delete shadows via web shell"; http.request_body; content:"vssadmin"; nocase; http.request_body; content:"delete"; nocase; http.request_body; content:"shadows"; nocase; classtype:attempted-admin; sid:521297405; rev:1;)

# MITRE ATT&CK T1087 - Account Discovery
alert tcp any any -> any 445 (msg:"MITRE T1087.002 Account Discovery - SMB enumeration of domain users via IPC"; content:"IPC"; nocase; detection_filter:track by_src, count 20, seconds 60; classtype:attempted-recon; sid:521297406; rev:1;)

# MITRE ATT&CK T1213 - Data from Information Repositories
alert http any any -> any any (msg:"MITRE T1213.001 Data from Information Repositories - Confluence mass page download"; http.uri; content:"/rest/api/content"; http.uri; content:"limit=500"; nocase; dsize:>10485760; classtype:exfiltration; sid:521297407; rev:1;)

# MITRE ATT&CK T1068 - Exploitation for Privilege Escalation
alert http any any -> any any (msg:"MITRE T1068 Exploitation for Privilege Escalation - sudo/PKEXEC exploit payload"; http.request_body; content:"sudo"; nocase; http.request_body; content:"pkexec"; nocase; classtype:attempted-user; sid:521297408; rev:1;)

# MITRE ATT&CK T1534 - Internal Spearphishing
alert http any any -> any any (msg:"MITRE T1534 Internal Spearphishing - lateral email with suspicious attachment"; http.request_body; content:"application/vnd.ms-excel"; http.request_body; content:".xlsm"; nocase; http.request_body; content:"macro"; nocase; classtype:trojan-activity; sid:521297409; rev:1;)

# MITRE ATT&CK T1059.001 - PowerShell
alert http any any -> any any (msg:"MITRE T1059.001 PowerShell execution via web shell - encoded command"; http.request_body; content:"powershell"; nocase; http.request_body; content:"-enc"; nocase; http.request_body; pcre:"/[A-Za-z0-9+/]{200,}={0,2}/"; classtype:attempted-user; sid:521297410; rev:1;)

# MITRE ATT&CK T1105 - Ingress Tool Transfer
alert http any any -> any any (msg:"MITRE T1105 Ingress Tool Transfer - suspicious binary download via HTTP"; http.method; content:"GET"; http.uri; pcre:"/\.(exe|dll|sh|bin|elf|py|pl)$/i"; http.response_header; content:"application/octet-stream"; classtype:trojan-activity; sid:521297411; rev:1;)

# MITRE ATT&CK T1572 - Protocol Encapsulation
alert tcp any any -> any 443 (msg:"MITRE T1572 Protocol Encapsulation - non-TLS traffic on port 443"; flags:S,12; flow:to_server,established; classtype:trojan-activity; sid:521297412; rev:1;)

# MITRE ATT&CK T1620 - Reflective Code Loading
alert http any any -> any any (msg:"MITRE T1620 Reflective Code Loading - DLL injection via reflective loading pattern"; http.request_body; content:"ReflectiveDLL"; nocase; http.request_body; content:"LoadLibrary"; nocase; http.request_body; content:"VirtualAlloc"; nocase; classtype:attempted-user; sid:521297413; rev:1;)

# MITRE ATT&CK T1496 - Resource Hijacking
alert http any any -> any any (msg:"MITRE T1496 Resource Hijacking - cryptominer pool connection via HTTP"; http.uri; pcre:"/(stratum\+tcp|xmrig|moneroocean|nanopool|hashrate)/i"; classtype:trojan-activity; sid:521297414; rev:1;)

# MITRE ATT&CK T1059.009 Cloud API
alert http any any -> any any (msg:"MITRE T1059.009 Cloud API - suspicious AWS CLI command via web request"; http.request_body; content:"aws"; nocase; http.request_body; content:"s3"; nocase; http.request_body; content:"cp"; nocase; classtype:exfiltration; sid:521297415; rev:1;)

# MITRE ATT&CK T1528 - Steal Application Access Token
alert http any any -> any any (msg:"MITRE T1528 Steal Application Access Token - OAuth token in URL parameter"; http.uri; pcre:"/[?&](access_token|token|bearer)=eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/i"; classtype:attempted-creds; sid:521297416; rev:1;)

# MITRE ATT&CK T1195 - Supply Chain Compromise
alert http any any -> any any (msg:"MITRE T1195.002 Supply Chain Compromise - npm package typosquating detection"; http.uri; content:"registry.npmjs.org"; http.uri; pcre:"/(lodasht|reactt|expresss|axioss|chalkk)/i"; classtype:trojan-activity; sid:521297417; rev:1;)

# MITRE ATT&CK T1555 - Credentials from Password Stores
alert http any any -> any any (msg:"MITRE T1555.001 Credentials from Password Stores - browser credential extraction via web shell"; http.request_body; content:"Login Data"; nocase; http.request_body; content:"Chrome"; nocase; http.request_body; content:"sqlite3"; nocase; classtype:attempted-creds; sid:521297418; rev:1;)

# MITRE ATT&CK T1606 - Forge Web Credentials
alert http any any -> any any (msg:"MITRE T1606.001 Forge Web Credentials - AWS STS temporary credential creation via web"; http.request_body; content:"sts"; nocase; http.request_body; content:"GetSessionToken"; nocase; http.request_body; content:"AssumeRole"; nocase; classtype:attempted-creds; sid:521297419; rev:1;)

# MITRE ATT&CK T1098 - Account Manipulation
alert http any any -> any any (msg:"MITRE T1098.004 Account Manipulation - SSH key addition via web shell"; http.request_body; content:"authorized_keys"; nocase; http.request_body; content:"ssh-rsa"; nocase; classtype:attempted-user; sid:521297420; rev:1;)

# MITRE ATT&CK T1482 - Domain Trust Discovery
alert tcp any any -> any 389 (msg:"MITRE T1482 Domain Trust Discovery - LDAP domain trust enumeration"; content:"nltest"; nocase; content:"domain_trusts"; nocase; classtype:attempted-recon; sid:521297421; rev:1;)
