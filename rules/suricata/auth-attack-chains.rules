# =============================================================================
# Suricata Rules — Authentication Attack Chain Detection
# Detects multi-step auth exploitation sequences: credential stuffing→MFA bypass→account takeover,
#          OAuth code intercept→token replay→cross-service takeover,
#          JWT confusion→admin→mass IDOR, Kerberoasting→golden ticket→domain admin,
#          NTLM relay→SMB signing→credential capture→lateral movement
# Total rules: 15
# SID range: 2312001 - 2312015
# Reference: MITRE ATT&CK TA0006 Credential Access → TA0008 Lateral Movement
# =============================================================================

# --- Credential Stuffing → MFA Bypass → Account Takeover → Privilege Escalation ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AUTH-001: Credential Stuffing with Automated Tool - Known Password Pairs"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(login|signin|auth|authenticate)\b/i"; http_uri; pcre:"/(Hydra|BurpSuite|ffuf|SentryMBA|Snipr|AccountSurf|STORM|OpenBullet|SilverBullet)/i"; http_header; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-login; sid:2312001; rev:1; metadata:chain credential-stuffing-to-mfa-bypass, mitre T1110.004, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AUTH-002: MFA OTP Brute Force - Rapid OTP Submission After Successful Password"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(mfa|verify-otp|2fa|totp|otp|challenge)\b/i"; http_uri; threshold:type both, track by_src, count 10, seconds 120; classtype:attempted-login; sid:2312002; rev:1; metadata:chain mfa-brute-force, mitre T1110.004, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AUTH-003: MFA Bypass via Backup Code Enumeration - Sequential Code Submission"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(backup-codes|recovery-codes|backup-2fa|recovery-2fa)\b/i"; http_uri; threshold:type both, track by_src, count 5, seconds 300; classtype:attempted-login; sid:2312003; rev:1; metadata:chain mfa-backup-code-enum, mitre T1110.004, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AUTH-004: Account Takeover After Credential Stuffing - Admin Role Access with New Session"; flow:established,to_server; pcre:"/\/(admin|dashboard|manage|config|console|settings)\b/i"; http_uri; content:"Authorization"; http_header; content:"Bearer"; http_header; threshold:type both, track by_src, count 3, seconds 600; classtype:attempted-admin; sid:2312004; rev:1; metadata:chain account-takeover-to-privilege-escalation, mitre T1078, created_at 2026_08_21;)

# --- OAuth Authorization Code Interception → Token Exchange → Cross-Service Takeover ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AUTH-005: OAuth Authorization Code Interception - Code in Unencrypted Referer or Log"; flow:established,to_server; pcre:"/[?&]code=[A-Za-z0-9_-]{20,}/i"; http_uri; pcre:"/(Referer|X-Forwarded-Proto):\s*http:\/\//i"; http_header; classtype:attempted-login; sid:2312005; rev:1; metadata:chain oauth-code-interception, mitre T1187, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AUTH-006: OAuth Token Replay - Same Bearer Token Across Multiple Services"; flow:established,to_server; content:"Authorization"; http_header; pcre:"/Bearer\s+eyJ[A-Za-z0-9_-]+/i"; http_header; pcre:"/\/(google|github|microsoft|apple|facebook|okta|auth0)\.com\/(oauth|auth|token)/i"; http_uri; threshold:type both, track by_src, count 3, seconds 600; classtype:attempted-login; sid:2312006; rev:1; metadata:chain oauth-token-replay, mitre T1187, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN AUTH-007: OAuth Access Token Exfiltration - Token in Outbound Request to Attacker Domain"; flow:established,to_server; pcre:"/Bearer\s+eyJ[A-Za-z0-9_-]+/i"; http_header; pcre:"/[a-z0-9-]+\.(xyz|top|buzz|club|info|online|site|live|cc|tk|ml|ga|cf|pw)/i"; http_host; classtype:web-application-attack; sid:2312007; rev:1; metadata:chain oauth-token-exfiltration, mitre T1187, created_at 2026_08_21;)

# --- JWT Algorithm Confusion → Admin Token → Mass IDOR → Data Exfiltration ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AUTH-008: JWT None Algorithm Attack - Forged Token Without Signature"; flow:established,to_server; content:"Authorization"; http_header; pcre:"/eyJhbGciOiJub25lIn0\./i"; http_header; classtype:attempted-admin; sid:2312008; rev:1; metadata:chain jwt-none-to-admin, mitre T1606, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AUTH-009: JWT RS256→HS256 Key Confusion - Algorithm Downgrade in Token Header"; flow:established,to_server; content:"Authorization"; http_header; pcre:"/eyJhbGciOiJIUzI1NiJ9\./i"; http_header; pcre:"/\"kid\"\s*:\s*\"/i"; http_header; classtype:attempted-admin; sid:2312009; rev:1; metadata:chain jwt-key-confusion, mitre T1606, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AUTH-010: JWT jku/x5u Header Injection - External Key URL for Signature Verification Bypass"; flow:established,to_server; content:"Authorization"; http_header; pcre:"/(\"jku\"\s*:\s*\"https?:\/\/[^\"]+\"|\"x5u\"\s*:\s*\"https?:\/\/[^\"]+\")/i"; http_header; classtype:attempted-admin; sid:2312010; rev:1; metadata:chain jwt-jku-injection, mitre T1606, created_at 2026_08_21;)

# --- Kerberoasting → Offline Hash Crack → Golden Ticket → Domain Admin ---
alert tcp $EXTERNAL_NET any -> $HOME_NET 88 (msg:"CHAIN AUTH-011: Kerberoasting - Service Principal Name Request for Offline Hash Crack"; flow:established,to_server; content:"TGS-REQ"; pcre:"/(MSSQLSvc|HTTP|cifs|HOST|ldap|RPC|krbtgt|MSSQL|CIFS|HTTP\/)/i"; classtype:attempted-admin; sid:2312011; rev:1; metadata:chain kerberoasting-to-golden-ticket, mitre T1558.003, created_at 2026_08_21;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 88 (msg:"CHAIN AUTH-012: Golden Ticket Creation - TGT with 10-Year Lifetime and krbtgt Account"; flow:established,to_server; content:"krbtgt"; pcre:"/(10y|10\s*years|3650\s*days|315360000)/i"; classtype:attempted-admin; sid:2312012; rev:1; metadata:chain golden-ticket-domain-admin, mitre T1558.001, created_at 2026_08_21;)

# --- NTLM Relay → SMB Signing Disabled → Credential Capture → Lateral Movement ---
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"CHAIN AUTH-013: NTLM Relay via SMB - Auth Challenge Without Signing to Exploit Signing Disabled"; flow:established,to_server; content:"NTLMSSP"; content:"Type 2"; content:!"NTLMSSP_NEGOTIATE_SIGNING"; classtype:attempted-admin; sid:2312013; rev:1; metadata:chain ntlm-relay-to-lateral, mitre T1557, created_at 2026_08_21;)
alert http $HOME_NET any -> $HOME_NET any (msg:"CHAIN AUTH-014: NTLM Relay via HTTP - Captured Auth Forwarded to Internal Service"; flow:established,to_server; content:"Authorization"; http_header; content:"NTLM"; http_header; pcre:"/NTLM\s+[A-Za-z0-9+\/=]{50,}/i"; http_header; classtype:attempted-admin; sid:2312014; rev:1; metadata:chain ntlm-relay-http, mitre T1557, created_at 2026_08_21;)

# --- SAML Signature Wrapping → Admin Access ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN AUTH-015: SAML Signature Wrapping Attack - Duplicate Assertion with Different Subject"; flow:established,to_server; pcre:"/<samlp:Response[^>]*>.*<saml:Assertion[^>]*>.*<ds:Signature[^>]*>.*<saml:Assertion[^>]*>/is"; http_client_body; classtype:attempted-admin; sid:2312015; rev:1; metadata:chain saml-signature-wrapping, mitre T1606, created_at 2026_08_21;)