# Total Rules: 100
# --- CVE-based detections (from GitHub Advisory Database 2026-10-19) ---
# CVE-2026-102503 - Missing Authentication for Critical Function
alert http any any -> $HOME_NET any (msg:"CVE-2026-102503 Missing Authentication Critical Function Access Attempt"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/admin"; nocase; classtype:attempted-admin; sid:521278101; rev:1;)
# CVE-2026-103091 - Missing Authorization with Insecure Default
alert http any any -> $HOME_NET any (msg:"CVE-2026-103091 Missing Authorization Insecure Default Access"; flow:established,to_server; http.uri; content:"/config/setup"; nocase; http.method; content:"GET"; classtype:attempted-admin; sid:521278102; rev:1;)
# CVE-2026-108983 - GeoWebServer Unauthenticated Access
alert http any any -> $HOME_NET any (msg:"CVE-2026-108983 GeoWebServer Unauthenticated Remote Access"; flow:established,to_server; http.uri; content:"/geoserver"; nocase; pcre:"/\/geoserver\/(web|ows|wfs|wms|wmts)/i"; classtype:attempted-admin; sid:521278103; rev:1;)
