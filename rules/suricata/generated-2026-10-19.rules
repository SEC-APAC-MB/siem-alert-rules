alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1620 Reflective DLL Loading - Memory Module Injection"; flow:established; content:"VirtualAlloc"; nocase; content:"WriteProcessMemory"; within:50; content:"CreateRemoteThread"; within:100; classtype:trojan-activity; sid:521278181; rev:1;)
# T1620 - Reflective Code Loading via ReflectiveLoader
alert http any any -> $HOME_NET any (msg:"MITRE T1620 ReflectiveLoader Export in DLL Transfer"; flow:established,to_client; file_data; content:"ReflectiveLoader"; nocase; classtype:trojan-activity; sid:521278182; rev:1;)
# T1090.003 - Proxy: Internal Proxy
alert tcp $HOME_NET any -> $HOME_NET any (msg:"MITRE T1090.003 Internal Proxy Pivot - SOCKS Traffic"; flow:established; content:"|05 01 00|"; depth:3; classtype:trojan-activity; sid:521278183; rev:1;)
# T1090.004 - Proxy: External Proxy
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1090.004 External Proxy Communication - TOR Exit Node"; flow:established,to_server; http.host; pcre:"/(tor2web|onion\.ly|onion\.pet|onion\.sh)/i"; classtype:trojan-activity; sid:521278184; rev:1;)
# T1571 - Non-Standard Port
alert tcp $HOME_NET any -> $EXTERNAL_NET 4444 (msg:"MITRE T1571 Non-Standard Port C2 Communication - 4444"; flow:established,to_server; dsize:>100; classtype:trojan-activity; sid:521278185; rev:1;)
# T1571 - Non-Standard Port 1337
alert tcp $HOME_NET any -> $EXTERNAL_NET 1337 (msg:"MITRE T1571 Non-Standard Port C2 - 1337"; flow:established,to_server; dsize:>64; classtype:trojan-activity; sid:521278186; rev:1;)
# T1571 - Non-Standard Port 31337
alert tcp $HOME_NET any -> $EXTERNAL_NET 31337 (msg:"MITRE T1571 Non-Standard Port C2 - 31337 Elite"; flow:established,to_server; dsize:>64; classtype:trojan-activity; sid:521278187; rev:1;)
# T1021.001 - Remote Services: RDP
alert tcp $EXTERNAL_NET any -> $HOME_NET 3389 (msg:"MITRE T1021.001 RDP Brute Force from External Source"; flow:stateless; flags:S; detection_filter:track by_src, count 20, seconds 60; classtype:attempted-admin; sid:521278188; rev:1;)
# T1021.004 - Remote Services: SSH
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"MITRE T1021.004 SSH Brute Force from External Source"; flow:stateless; flags:S; detection_filter:track by_src, count 30, seconds 60; classtype:attempted-admin; sid:521278189; rev:1;)
# T1021.002 - Remote Services: SMB
alert tcp $EXTERNAL_NET any -> $HOME_NET 445 (msg:"MITRE T1021.002 SMB External Access Attempt"; flow:established; content:"|00 00 00 2f ff smb|"; depth:5; classtype:trojan-activity; sid:521278190; rev:1;)
# T1021.006 - Remote Services: VNC
alert tcp $EXTERNAL_NET any -> $HOME_NET 5900 (msg:"MITRE T1021.006 VNC External Access from Non-Internal IP"; flow:established,to_server; content:"RFB 00"; depth:7; classtype:trojan-activity; sid:521278191; rev:1;)
# T1550.002 - Use Alternate Auth Material: Pass the Hash
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"MITRE T1550.002 Pass the Hash Attack - SMB NTLM Hash"; flow:established; content:"NTLMv2"; nocase; content:"hash"; nocase; within:50; classtype:credential-theft; sid:521278192; rev:1;)
# T1550.001 - Use Alternate Auth Material: Application Access Token
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1550.001 Application Access Token Exfiltration"; flow:established,to_server; http.request_header; content:"X-Api-Key"; nocase; pcre:"/[A-Za-z0-9_-]{32,}/"; classtype:credential-theft; sid:521278193; rev:1;)
# T1550.003 - Use Alternate Auth Material: Kerberos Ticket
alert tcp $HOME_NET any -> $HOME_NET 88 (msg:"MITRE T1550.003 Kerberos Ticket Anomaly - Golden Ticket Pattern"; flow:established; content:"krbtgt"; nocase; dsize:>1200; classtype:credential-theft; sid:521278194; rev:1;)
# T1550.004 - Use Alternate Auth Material: Web Session Cookie
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1550.004 Web Session Cookie Exfiltration"; flow:established,to_server; http.request_header; content:"Cookie"; nocase; pcre:"/(session|auth|token|jwt)=[A-Za-z0-9._-]{40,}/i"; classtype:credential-theft; sid:521278195; rev:1;)
# T1210 - Exploitation of Remote Services
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"MITRE T1210 Remote Service Exploitation - EternalBlue Pattern"; flow:established; content:"|ff smb|"; depth:3; content:"|41 00 00 00 00 00 00 00|"; within:20; classtype:attempted-admin; sid:521278196; rev:1;)
# T1210 - Exploitation of Remote Services - BlueKeep
alert tcp $HOME_NET any -> $HOME_NET 3389 (msg:"MITRE T1210 Remote Service Exploitation - BlueKeep RDP"; flow:established; content:"|03 00 00 0c|"; depth:4; content:"|ea 03 00 00|"; within:10; classtype:attempted-admin; sid:521278197; rev:1;)
# T1195.002 - Supply Chain Compromise: Compromise Software Supply Chain
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1195.002 Supply Chain Attack - Suspicious Package Registry Push"; flow:established,to_server; http.uri; content:"/npm/"; nocase; http.method; content:"PUT"; http.request_body; pcre:"/(preinstall|postinstall).*curl.*\|.*sh/i"; classtype:trojan-activity; sid:521278198; rev:1;)
# T1195.001 - Supply Chain Compromise: Compromise Software Dependencies
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"MITRE T1195.001 Supply Chain Dependency Confusion Attack"; flow:established,to_server; http.host; pcre:"/registry\.(npmjs|pypi|rubygems|maven)/i"; http.request_body; pcre:"/(version|versions).*\d+\.\d+\.\d+(rc|alpha|beta|dev)/i"; classtype:trojan-activity; sid:521278199; rev:1;)
