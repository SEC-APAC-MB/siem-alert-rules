# --- MITRE ATT&CK Technique-based detections ---
# T1595.001 - Active Scanning: Scanning IP Blocks
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"MITRE T1595.001 Active Scanning IP Block - Single Source Multiple Ports"; flow:stateless; flags:S; detection_filter:track by_src, count 50, seconds 10; classtype:attempted-recon; sid:521278117; rev:1;)
# T1595.002 - Active Scanning: Vulnerability Scanning
