alert http any any -> any any (msg:"MITRE T1069 Permission groups discovery via web shell"; flow:to_server,established; pcre:"/(?:net\s+group|net\s+localgroup|get-localgroup|get-adgroup|groups|id|getent\s+group)/i"; classtype:attempted-recon; sid:521292992; rev:1;)
alert http any any -> any any (msg:"MITRE T1082 System information discovery via web shell"; flow:to_server,established; pcre:"/(?:uname|systeminfo|hostname|ver|lsb_release|cat.*\/etc\/os-release)/i"; classtype:attempted-recon; sid:521292993; rev:1;)
alert http any any -> any any (msg:"MITRE T1083 File directory discovery - recursive listing via web shell"; flow:to_server,established; pcre:"/(?:find\s+\/|ls\s+-laR|tree|dir\s+\/s|Get-ChildItem.*-Recurse)/i"; classtype:attempted-recon; sid:521292994; rev:1;)
alert http any any -> any any (msg:"MITRE T1007 System service discovery via web shell"; flow:to_server,established; pcre:"/(?:systemctl.*list|service.*--status|sc\s+query|Get-Service|wmic.*service)/i"; classtype:attempted-recon; sid:521292995; rev:1;)
alert tcp any any -> any any (msg:"MITRE T1046 Network service discovery - nmap masscan fingerprint"; flow:to_server; flags:S; pcre:"/(?:Nmap|masscan|ZGrab)/"; threshold:type threshold, track by_src, count 10, seconds 30; classtype:network-scan; sid:521292996; rev:1;)
alert http any any -> any any (msg:"MITRE T1497.001 Virtualization sandbox evasion - VM detection checks"; flow:to_server,established; pcre:"/(?:vmware|virtualbox|qemu|hyperv|xen|docker|containerd)/i"; classtype:trojan-activity; sid:521292997; rev:1;)
alert http any any -> any any (msg:"MITRE T1497.003 Time based evasion - execution timing checks"; flow:to_server,established; pcre:"/(?:time.*check|sleep.*random|if.*hour|if.*date)/i"; classtype:trojan-activity; sid:521292998; rev:1;)
alert http any any -> any any (msg:"MITRE T1127 Trusted developer utility - MSBuild inline task execution"; flow:to_server,established; pcre:"/msbuild.*\.(?:csproj|vbproj|vcxproj)/i"; classtype:trojan-activity; sid:521292999; rev:1;)
alert http any any -> any any (msg:"MITRE T1218.005 Mshta proxy execution of HTA file"; flow:to_server,established; pcre:"/mshta.*\.(?:hta|html)/i"; classtype:trojan-activity; sid:521293000; rev:1;)
alert http any any -> any any (msg:"MITRE T1036 Masquerading - process named as legitimate system binary"; flow:to_server,established; pcre:"/(?:svchost|explorer|csrss|lsass|wininit|services)\.(?:exe|sh|py)/i"; content:"cmd="; classtype:trojan-activity; sid:521293001; rev:1;)
