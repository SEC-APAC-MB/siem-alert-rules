# =============================================================================
# Suricata Rules — Supply Chain Attack Chain Detection
# Detects multi-step supply chain exploitation sequences: dependency confusion→malicious package→RCE,
#          CI/CD pipeline poisoning→build artifact injection→backdoored deployment,
#          Docker image tampering→container breakout→host access
# Total rules: 10
# SID range: 2316001 - 2316010
# Reference: MITRE ATT&CK T1195, T1199, T1059
# =============================================================================

# --- Dependency Confusion → Malicious Package Install → RCE ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN SUPPLY-001: Dependency Confusion Attack - Internal Package Name Queried on Public Registry"; flow:established,to_server; pcre:"/\/(npm|pypi|rubygems|maven|nuget|packagist|crates)\.(org|io|com)\/(search|package|versions|resolve)/i"; http_uri; pcre:"/(@company-|@internal-|@private-|@corp-|mycompany-|internal-|private-)/i"; http_uri; classtype:web-application-attack; sid:2316001; rev:1; metadata:chain dependency-confusion-to-rce, mitre T1195.002, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN SUPPLY-002: Malicious Package Installation After Dependency Confusion - Pre/Post Install Script Execution"; flow:established,to_server; pcre:"/\/(npmjs|pypi|rubygems|maven|nuget)\.(com|org|io)\/(package|download|simple)/i"; http_uri; pcre:"/(preinstall|postinstall|prebuild|postbuild|prepare|install\.sh|setup\.py|configure)/i"; http_client_body; classtype:web-application-attack; sid:2316002; rev:1; metadata:chain dependency-confusion-to-rce, mitre T1195.002, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN SUPPLY-003: Typosquatting Package Installation - Misspelled Popular Package Name"; flow:established,to_server; pcre:"/\/(npmjs|pypi|rubygems)\.(com|org)\/(package|pypi)\/(reqests|djang|boto3-core|express-js|reactt|lodhash|crytpo|pyton-mongo|nodsjs)/i"; http_uri; classtype:web-application-attack; sid:2316003; rev:1; metadata:chain typosquatting-to-rce, mitre T1195.002, created_at 2026_08_21;)

# --- CI/CD Pipeline Poisoning → Build Artifact Injection → Backdoored Deployment ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN SUPPLY-004: CI/CD Pipeline Injection - Malicious Commit/Push to Build Pipeline via API"; flow:established,to_server; pcre:"/\/(api\/v[0-9]+\/(repos|projects|pipeline|jobs|builds|trigger))\b/i"; http_uri; pcre:"/(curl|wget|powershell|cmd\.exe|bash|sh|python|perl|ruby).*?(http|https):\/\/[^\s]*\.(sh|py|pl|rb|ps1|bat)/i"; http_client_body; classtype:web-application-attack; sid:2316004; rev:1; metadata:chain cicd-injection, mitre T1195.001, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN SUPPLY-005: CI/CD Secret Extraction - Environment Variable/Secret File Access in Pipeline"; flow:established,to_server; pcre:"/\/api\/v[0-9]+\/(jobs|builds|pipelines|runs|workflows)\b/i"; http_uri; pcre:"/(\$\{?SECRETS?\}|AWS_SECRET|GITHUB_TOKEN|GITLAB_TOKEN|DOCKER_TOKEN|NPM_TOKEN|PYPI_TOKEN|VAULT_TOKEN|K8S_SECRET)/i"; http_client_body; classtype:web-application-attack; sid:2316005; rev:1; metadata:chain cicd-secret-extraction, mitre T1552, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN SUPPLY-006: Build Artifact Exfiltration - Compiled Binary Uploaded to External Server After CI/CD Poisoning"; flow:established,to_server; content:"PUT"; http_method; pcre:"/\.(exe|dll|so|dylib|bin|jar|war|apk|ipa|msi|deb|rpm)/i"; http_uri; pcre:"/(transfer\.sh|file\.io|0x0\.st|uguu\.se|catbox\.moe|tmpfiles\.org)/i"; http_header; classtype:web-application-attack; sid:2316006; rev:1; metadata:chain build-artifact-exfiltration, mitre T1195, created_at 2026_08_21;)

# --- Docker Image Tampering → Container Breakout → Host Access → Cloud Metadata ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN SUPPLY-007: Docker Image Tampering - Malicious Base Image with Backdoor Package"; flow:established,to_server; pcre:"/\/v[0-9]+\/(images\/create|build)/i"; http_uri; pcre:"/(curl|wget|apt-get|yum|apk\s+add).*?(reverse|backdoor|shell|c2|beacon|bind|connect-back)/i"; http_client_body; classtype:web-application-attack; sid:2316007; rev:1; metadata:chain docker-image-tampering, mitre T1195.002, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN SUPPLY-008: Container Breakout via Docker Socket Mount - Host Access After Image Tampering"; flow:established,to_server; pcre:"/\/var\/run\/docker\.sock|\/run\/docker\.sock|docker\.sock/i"; http_uri; classtype:web-application-attack; sid:2316008; rev:1; metadata:chain container-breakout-via-docker-socket, mitre T1611, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN SUPPLY-009: Container Escape to Cloud Metadata After Breakout - IMDS Access from Container"; flow:established,to_server; pcre:"/(169\.254\.169\.254|metadata\.google\.internal|metadata\.azure\.app)/i"; http_uri; pcre:"/\/latest\/(meta-data|dynamic|iam)|\/computeMetadata\/v1\/|\/metadata\/instance/i"; classtype:web-application-attack; sid:2316009; rev:1; metadata:chain container-escape-to-cloud-metadata, mitre T1552.005, created_at 2026_08_21;)

# --- Backdoored NPM/PyPI Package → Install Hook → Crypto Miner ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN SUPPLY-010: Crypto Miner Installation via Backdoored Package - Coinhive/XMRig Download After Package Install"; flow:established,to_server; pcre:"/\/(npmjs|pypi|rubygems)\.(com|org)\/(package|download)/i"; http_uri; pcre:"/(xmrig|coinhive|cryptonight|minerd|cpuminer|nicehash|nanopool|stratum\+tcp)/i"; http_client_body; classtype:trojan-activity; sid:2316010; rev:1; metadata:chain backdoored-package-to-crypto-miner, mitre T1496, created_at 2026_08_21;)