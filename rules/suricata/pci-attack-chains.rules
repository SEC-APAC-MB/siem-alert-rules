# =============================================================================
# Suricata Rules — PCI-DSS Attack Chain Detection
# Detects multi-step PCI-DSS violation sequences: card skimming→exfil,
#          unauthorized DB access→PAN dump→exfil, POS malware→C2→card data exfil,
#          payment page tampering→card skimmer→exfil
# Total rules: 10
# SID range: 2317001 - 2317010
# Reference: PCI-DSS v4.0 Requirements 1,3,4,6,7,8,10,11,12
# =============================================================================

# --- Web Skimmer → Card Data Harvesting → Exfiltration to C2 ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN PCI-001: Web Skimmer Injection - Malicious JavaScript in Payment Page Loading Remote Script"; flow:established,to_server; pcre:"/<script[^>]+src\s*=\s*['\"]https?:\/\/[^\s'\"]*(\.js\?|\/js\/|analytics|tracking|monitor|widget|chat)[^'\"]*['\"][^>]*>/i"; http_client_body; pcre:"/\/(checkout|payment|cart|billing|order|purchase|pay|card|transaction)\b/i"; http_uri; classtype:web-application-attack; sid:2317001; rev:1; metadata:chain web-skimmer-to-card-exfil, pci_dss_6.2, mitre T1189, created_at 2026_08_21;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN PCI-002: Web Skimmer Mutation - eval/Function/atob Obfuscated Card Harvesting Code"; flow:established,to_server; pcre:"/(eval\s*\(|new\s+Function\s*\(|atob\s*\(|String\.fromCharCode\s*\(|\\x[0-9a-f]{2}|\\u[0-9a-f]{4})/i"; http_client_body; pcre:"/\/(checkout|payment|cart|billing|order|purchase|pay)\b/i"; http_uri; pcre:"/(document\.forms|document\.querySelector|getElementById|getElementsByClassName|querySelectorAll)\s*[\.\[]\s*['\"]*(cc|card|cvv|exp|pan|account|routing|payment)/i"; http_client_body; classtype:web-application-attack; sid:2317002; rev:1; metadata:chain web-skimmer-obfuscated, pci_dss_6.2, mitre T1189, created_at 2026_08_21;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN PCI-003: Card Data Exfiltration After Skimmer - PAN/CVV in Outbound POST to Attacker Domain"; flow:established,to_server; content:"POST"; http_method; pcre:"/\b\d{4}[\s-]?\d{4}[\s-]?\d{4}[\s-]?\d{4}\b/i"; http_client_body; pcre:"/[a-z0-9-]+\.(xyz|top|buzz|club|info|online|site|live|cc|tk|ml|ga|cf|pw)/i"; http_host; classtype:web-application-attack; sid:2317003; rev:1; metadata:chain card-data-exfiltration, pci_dss_3.4, mitre T1189, created_at 2026_08_21;)

# --- Unauthorized DB Access → PAN Extraction → Encrypted Exfiltration ---
alert tcp $EXTERNAL_NET any -> $HOME_NET [3306,5432,1433,1521,27017] (msg:"CHAIN PCI-004: SQL Injection for PAN Extraction - UNION SELECT on Cardholder Data Tables"; flow:established,to_server; pcre:"/\bUNION\b\s*\bSELECT\b.*\bFROM\b\s*(cardholder|payment|transaction|orders?|customers?|accounts?|billing)\b.*\b(card|pan|cc|credit|cvv|cv2|exp|expiry|account|routing)\b/i"; classtype:web-application-attack; sid:2317004; rev:1; metadata:chain sqli-to-pan-extraction, pci_dss_6.5, mitre T1190, created_at 2026_08_21;)
alert tcp $HOME_NET [3306,5432,1433,1521,27017] -> $EXTERNAL_NET any (msg:"CHAIN PCI-005: Bulk PAN Dump in Outbound Database Connection - Card Number Pattern in Response"; flow:established,to_client; pcre:"/\b\d{4}[\s-]?\d{4}[\s-]?\d{4}[\s-]?\d{4}\b.*\b\d{3,4}\b.*\b(0[1-9]|1[0-2])\/?\d{2,4}\b/i"; threshold:type both, track by_src, count 5, seconds 60; classtype:web-application-attack; sid:2317005; rev:1; metadata:chain pan-dump-exfiltration, pci_dss_3.4, mitre T1537, created_at 2026_08_21;)

# --- POS Malware → RAM Scraping → C2 Communication → Card Data Exfiltration ---
alert tcp $HOME_NET any -> $EXTERNAL_NET [80,443,8080,8443] (msg:"CHAIN PCI-006: POS RAM Scraper Memory Access Pattern - LSASS/Process Memory Read Before Card Harvest"; flow:established,to_server; pcre:"/(OpenProcess|ReadProcessMemory|VirtualQueryEx|NtReadVirtualMemory|NtQueryVirtualMemory)/i"; classtype:trojan-activity; sid:2317006; rev:1; metadata:chain pos-ram-scraper, pci_dss_5.3, mitre T1057, created_at 2026_08_21;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN PCI-007: POS Malware C2 Beacon - Periodic POST with Track Data Pattern to Suspicious Domain"; flow:established,to_server; content:"POST"; http_method; pcre:"/\b\d{4}[\s-]?\d{4}[\s-]?\d{4}[\s-]?\d{4}\b/i"; http_client_body; pcre:"/[a-z0-9-]+\.(xyz|top|buzz|club|info|online|site|live|cc|tk|ml|ga|cf|pw)/i"; http_host; threshold:type both, track by_src, count 3, seconds 300; classtype:trojan-activity; sid:2317007; rev:1; metadata:chain pos-c2-exfiltration, pci_dss_5.3, mitre T1071, created_at 2026_08_21;)

# --- Payment Page Tampering → Magecart → Card Skimmer → Data Exfiltration ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CHAIN PCI-008: Payment Page Tampering - Unexpected Script Injection in Checkout Flow"; flow:established,to_server; pcre:"/\/(checkout|payment|cart|billing|order|purchase|pay|onepage|onestepcheckout)\b/i"; http_uri; pcre:"/<script[^>]*(src\s*=\s*['\"]https?:\/\/(?!fonts\.googleapis|ajax\.googleapis|cdnjs\.cloudflare|stackpath|jsdelivr|cloudfront\.net\/ajax)[^'\"]*['\"]|onerror\s*=|onload\s*=)[^>]*>/i"; http_response_body; classtype:web-application-attack; sid:2317008; rev:1; metadata:chain payment-page-tampering, pci_dss_6.2, mitre T1189, created_at 2026_08_21;)
alert http $HOME_NET any -> $HOME_NET any (msg:"CHAIN PCI-009: Card Skimmer Form Action Hijacking - Payment Form POST to External Domain"; flow:established,to_client; pcre:"/<form[^>]*action\s*=\s*['\"]https?:\/\/[^\s'\"]*(?!localhost|127\.0\.0\.1|pay\.paypal|stripe|checkout\.shopify|square)[^'\"]*['\"][^>]*>/i"; http_response_body; pcre:"/(card_number|cc_number|pan|cvv|cv2|expiry|exp_date|card_expiry|payment_method)/i"; http_response_body; classtype:web-application-attack; sid:2317009; rev:1; metadata:chain form-action-hijacking, pci_dss_6.2, mitre T1189, created_at 2026_08_21;)

# --- Clear Text Card Data in Logs → Unauthorized Access ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CHAIN PCI-010: Clear Text PAN in Application Log Exfiltration - Card Number in Log Data Sent Externally"; flow:established,to_server; content:"POST"; http_method; pcre:"/\b\d{4}[\s-]?\d{4}[\s-]?\d{4}[\s-]?\d{4}\b/i"; http_client_body; pcre:"/(log|trace|debug|error|event|metric|monitor|telemetry|apm|sentry|datadog|newrelic|splunk|elastic)/i"; http_uri; pcre:"/^(?!.*mask).*(card|pan|cc|credit|cvv|cv2)/i"; http_client_body; classtype:web-application-attack; sid:2317010; rev:1; metadata:chain clear-text-pan-in-logs, pci_dss_3.4, mitre T1537, created_at 2026_08_21;)