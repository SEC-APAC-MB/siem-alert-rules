alert http any any -> any any (msg:"MITRE T1082 System information discovery - uname/systeminfo via HTTP"; flow:established,to_server; pcre:"/(uname\s+-a|systeminfo|hostname)/i"; classtype:discovery; sid:521297206; rev:1;)

# === MITRE ATT&CK T1069: Permission Groups Discovery ===
alert http any any -> any any (msg:"MITRE T1069 Permission groups discovery - net group/whoami via HTTP"; flow:established,to_server; pcre:"/(net\s+group|net\s+localgroup|id\s+-aG|whoami\s+\/groups)/i"; classtype:discovery; sid:521297207; rev:1;)

# === MITRE ATT&CK T1135: Network Share Discovery ===
alert http any any -> any any (msg:"MITRE T1135 Network share discovery - net share/smbclient via HTTP"; flow:established,to_server; pcre:"/(net\s+share|smbclient|smbmap)/i"; classtype:discovery; sid:521297208; rev:1;)

# === MITRE ATT&CK T1049: System Network Connections Discovery ===
alert http any any -> any any (msg:"MITRE T1049 Network connections discovery - netstat via web shell"; flow:established,to_server; content:"netstat"; nocase; pcre:"/(-an|-tuln|-ano)/i"; classtype:discovery; sid:521297209; rev:1;)

# === MITRE ATT&CK T1059.009 Cloud API ===
alert http any any -> any any (msg:"MITRE T1059.009 Cloud API enumeration - AWS CLI via HTTP"; flow:established,to_server; content:"aws"; nocase; content:"sts"; nocase; content:"get-caller-identity"; nocase; classtype:discovery; sid:521297210; rev:1;)

# === MITRE ATT&CK T1530: Data from Cloud Storage Object ===
alert http any any -> any any (msg:"MITRE T1530 Cloud storage object enumeration - S3 bucket listing"; flow:established,to_server; pcre:"/(s3|aws|gs|azure).*list/i"; content:"ListObjects"; nocase; classtype:discovery; sid:521297211; rev:1;)

# === MITRE ATT&CK T1613: Container and Resource Discovery ===
alert http any any -> any any (msg:"MITRE T1613 Container discovery - docker/kubectl via web shell"; flow:established,to_server; pcre:"/(docker\s+ps|kubectl\s+get|crictl\s+ps)/i"; classtype:discovery; sid:521297212; rev:1;)

# === MITRE ATT&CK T1525: Implant Internal Image ===
alert http any any -> any any (msg:"MITRE T1525 Implant internal image - container registry tampering"; flow:established,to_server; content:"docker"; nocase; content:"push"; nocase; pcre:"/(registry|harbor|ecr)/i"; classtype:supply-chain; sid:521297213; rev:1;)

# === MITRE ATT&CK T1609: Container and Resource Discovery ===
alert http any any -> any any (msg:"MITRE T1609 Container execution via kubectl exec"; flow:established,to_server; content:"kubectl"; nocase; content:"exec"; nocase; pcre:"/--|sh|bash/i"; classtype:attempted-rce; sid:521297214; rev:1;)

# === MITRE ATT&CK T1611: Escape to Host ===
alert http any any -> any any (msg:"MITRE T1611 Container escape to host - privileged container detection"; flow:established,to_server; content:"privileged"; nocase; content:"--pid"; nocase; content:"/host"; nocase; classtype:container-escape; sid:521297215; rev:1;)

# === MITRE ATT&CK T1610: Deploy Container ===
alert http any any -> any any (msg:"MITRE T1610 Deploy container for execution - docker run with suspicious image"; flow:established,to_server; content:"docker"; nocase; content:"run"; nocase; pcre:"/(alpine|busybox|ubuntu):latest/i"; pcre:"/(--rm|--privileged|--net=host)/i"; classtype:malware-deployment; sid:521297216; rev:1;)

# === MITRE ATT&CK T1008: Fallback Channels ===
alert tcp $HOME_NET any -> $EXTERNAL_NET 4444 (msg:"MITRE T1008 Fallback C2 channel - default Metasploit port"; flow:to_server; flags:S; classtype:c2-activity; sid:521297217; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 8080 (msg:"MITRE T1008 Fallback C2 channel - alternative HTTP port beacon"; flow:established,to_server; content:"POST"; nocase; http_method; dsize:<100; threshold:rate:track by_src, count 10, seconds 60; classtype:c2-activity; sid:521297218; rev:1;)

# === MITRE ATT&CK T1098: Account Manipulation ===
alert http any any -> any any (msg:"MITRE T1098.001 Account manipulation - adding SSH authorized key via web"; flow:established,to_server; content:"authorized_keys"; nocase; pcre:"/(ssh-rsa|ssh-ed25519|ecdsa-sha2)/i"; classtype:account-manipulation; sid:521297219; rev:1;)
alert http any any -> any any (msg:"MITRE T1098.005 Account manipulation - adding user to admin group via HTTP"; flow:established,to_server; pcre:"/(usermod|net\s+localgroup\s+administrators|gpasswd)/i"; content:"admin"; nocase; classtype:account-manipulation; sid:521297220; rev:1;)

# === MITRE ATT&CK T1136: Create Account ===
alert http any any -> any any (msg:"MITRE T1136.001 Create local account via web shell - useradd/net user"; flow:established,to_server; pcre:"/(useradd|net\s+user\s+\S+\s+\S+\/add)/i"; classtype:account-creation; sid:521297221; rev:1;)
