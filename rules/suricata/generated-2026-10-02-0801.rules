alert dns any any -> any 53 (msg:"Subdomain takeover potential - dangling CNAME record query"; dns_query; pcre:"/(?:herokuapp|github\.io|s3\.amazonaws|azureedge|cloudfront)\.com/i"; classtype:attempted-recon; sid:52100289; rev:1;)
alert http any any -> $HOME_NET any (msg:"API rate limit bypass - rotating X-Forwarded-For header"; flow:established,to_server; content:"X-Forwarded-For"; http_header; threshold:type both, track by_src, count 100, seconds 60; classtype:web-application-attack; sid:52100290; rev:1;)
alert http any any -> $HOME_NET any (msg:"Mass assignment vulnerability - role/is_admin parameter injection"; flow:established,to_server; pcre:"/(?:role|is_admin|isAdmin|is_superuser|user_type)\s*[:=]\s*(?:admin|superuser|root|1|true)/i"; classtype:web-application-attack; sid:52100291; rev:1;)
alert http any any -> $HOME_NET any (msg:"Web cache poisoning via X-Forwarded-Host header"; flow:established,to_server; content:"X-Forwarded-Host"; http_header; pcre:"/(?:evil|attacker|spoof)/i"; classtype:web-application-attack; sid:52100292; rev:1;)
alert http any any -> $HOME_NET any (msg:"SSRF via gopher protocol - internal port scanning attempt"; flow:established,to_server; pcre:"/gopher:\/\//i"; classtype:web-application-attack; sid:52100293; rev:1;)
alert http any any -> $HOME_NET any (msg:"LDAP injection attack via HTTP parameter"; flow:established,to_server; pcre:"/(?:\)|\(|\*).*(?:uid|cn|dc|ou|objectClass)/i"; classtype:web-application-attack; sid:52100294; rev:1;)
alert http any any -> $HOME_NET any (msg:"HTTP header injection - CRLF in parameter value"; flow:established,to_server; pcre:"/%0d%0a|%0D%0A|\r\n/i"; classtype:web-application-attack; sid:52100295; rev:1;)
alert http $HOME_NET any -> any any (msg:"Data exfiltration via Discord webhook API"; flow:established,to_server; content:"discord.com/api/webhooks"; http_uri; dsize:>1000; classtype:exfiltration; sid:52100296; rev:1;)
alert http $HOME_NET any -> any any (msg:"Data exfiltration via Telegram Bot API"; flow:established,to_server; content:"api.telegram.org"; http_host; content:"sendMessage"; http_uri; dsize:>500; classtype:exfiltration; sid:52100297; rev:1;)
alert tcp any any -> $HOME_NET 445 (msg:"MITRE T1550.002 Pass the hash attack on SMB service"; flow:established; content:"NTLM"; dsize:>100; classtype:attempted-admin; sid:52100298; rev:1;)
alert tcp any any -> $HOME_NET 88 (msg:"MITRE T1550.003 Pass the ticket Kerberos attack pattern"; flow:established; content:"Kerberos"; content:"TGS"; dsize:>200; classtype:attempted-admin; sid:52100299; rev:1;)
