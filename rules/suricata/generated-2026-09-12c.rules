alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"ET TROJAN Possible Ransomware File Extension Rename Bulk Pattern"; flow:established,to_server; content:"Content-Type"; http_header; content:"encrypted"; nocase; threshold:type both, track by_src, count 5, seconds 60; classtype:trojan-activity; sid:5201649; rev:1;)

# --- Supply Chain: Package Confusion ---
alert dns $HOME_NET any -> any any (msg:"ET DNS Typosquatting Domain - Similar to Popular Package"; dns.query; pcre:"/\b(npmjs|pypi|mvnrepository)\.[a-z]{2,4}\b/i"; classtype:trojan-activity; sid:5201650; rev:1;)

