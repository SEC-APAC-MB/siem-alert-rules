# === MITRE ATT&CK: T1059.001 - PowerShell ===
alert tcp any any -> any any (msg:"ET ATTACK T1059.001 Suspicious PowerShell Encoded Command Execution"; flow:established,to_server; content:"powershell"; nocase; content:"-enc"; nocase; pcre:"/powershell.*-e[nc]*\s+[A-Za-z0-9+/=]{40,}/i"; classtype:trojan-activity; sid:5203838; rev:1;)

# === MITRE ATT&CK: T1059.003 - Windows Command Shell ===
alert tcp any any -> any any (msg:"ET ATTACK T1059.003 Suspicious cmd.exe with Pipe Chain"; flow:established,to_server; content:"cmd.exe"; nocase; content:"|26|"; pcre:"/cmd\.exe.*\|.*\|/"; classtype:trojan-activity; sid:5203839; rev:1;)

# === MITRE ATT&CK: T1053.005 - Scheduled Task ===
alert tcp any any -> any any (msg:"ET ATTACK T1053.005 Suspicious Scheduled Task Creation from Remote"; flow:established,to_server; content:"schtasks"; nocase; content:"/create"; nocase; content:"/s"; nocase; classtype:trojan-activity; sid:5203840; rev:1;)

# === MITRE ATT&CK: T1071.001 - Web Protocols C2 ===
alert tcp any any -> any any (msg:"ET ATTACK T1071.001 Suspicious Beaconing Pattern to HTTPS C2"; flow:established,to_server; content:"Host|3a|"; http_header; threshold:type both, track by_src, count 5, seconds 30; reference:url,attack.mitre.org/techniques/T1071/001; classtype:trojan-activity; sid:5203841; rev:1;)

# === MITRE ATT&CK: T1566.001 - Spearphishing Attachment ===
alert tcp any any -> any any (msg:"ET ATTACK T1566.001 Malicious Document with Macro Execution"; flow:established,to_client; content:"Content-Disposition"; http_header; content:"filename="; nocase; pcre:"/filename=.*\.(docm|xlsm|pptm)/i"; content:"macro"; nocase; classtype:trojan-activity; sid:5203842; rev:1;)

# === MITRE ATT&CK: T1078.002 - Valid Accounts Domain ===
alert tcp any any -> any any (msg:"ET ATTACK T1078.002 Multiple Failed Login Attempts Brute Force"; flow:established,to_server; content:"login"; nocase; content:"401"; threshold:type both, track by_src, count 10, seconds 60; reference:url,attack.mitre.org/techniques/T1078/002; classtype:attempted-admin; sid:5203843; rev:1;)

# === MITRE ATT&CK: T1190 - Exploit Public-Facing Application ===
alert tcp any any -> any any (msg:"ET ATTACK T1190 Exploit Attempt Against Public-Facing App"; flow:established,to_server; content:"/api/"; http_uri; pcre:"/[\x27\x22].*(?:OR|UNION|SELECT|DROP|INSERT)/si"; classtype:web-application-attack; sid:5203844; rev:1;)

# === MITRE ATT&CK: T1133 - External Remote Services ===
alert tcp any any -> any any (msg:"ET ATTACK T1133 Unusual VPN Session from New Geographic Region"; flow:established,to_server; content:"VPN"; nocase; threshold:type both, track by_src, count 3, seconds 300; reference:url,attack.mitre.org/techniques/T1133; classtype:suspicious-login; sid:5203845; rev:1;)

# === MITRE ATT&CK: T1486 - Data Encrypted for Impact (Ransomware) ===
alert tcp any any -> any any (msg:"ET ATTACK T1486 Mass File Encryption Activity Samba Share"; flow:established,to_server; content:".encrypted"; nocase; content:".locked"; nocase; threshold:type both, track by_src, count 20, seconds 30; reference:url,attack.mitre.org/techniques/T1486; classtype:trojan-activity; sid:5203846; rev:1;)

# === MITRE ATT&CK: T1562.001 - Impair Defenses Disable Security Tools ===
alert tcp any any -> any any (msg:"ET ATTACK T1562.001 Security Tool Disablement via netsh"; flow:established,to_server; content:"netsh"; nocase; content:"advfirewall"; nocase; content:"off"; nocase; classtype:trojan-activity; sid:5203847; rev:1;)

# === MITRE ATT&CK: T1070.004 - File Deletion Indicator Removal ===
alert tcp any any -> any any (msg:"ET ATTACK T1070.004 Suspicious Mass File Deletion Command"; flow:established,to_server; content:"rm"; content:"-rf"; content:"/"; pcre:"/rm\s+-rf\s+\//"; classtype:trojan-activity; sid:5203848; rev:1;)

# === MITRE ATT&CK: T1021.002 - SMB/Windows Admin Shares ===
alert tcp any any -> any 445 (msg:"ET ATTACK T1021.002 SMB Admin Share Access from Unusual Source"; flow:established,to_server; content:"|FF|SMB"; content:"C$"; nocase; reference:url,attack.mitre.org/techniques/T1021/002; classtype:attempted-admin; sid:5203849; rev:1;)

# === MITRE ATT&CK: T1048 - Exfiltration Over Alternative Protocol ===
alert tcp $HOME_NET any -> any any (msg:"ET ATTACK T1048 DNS Exfiltration Large TXT Record Query"; flow:established,to_server; content:"|00 01|"; offset:12; content:"TXT"; nocase; dsize:>100; reference:url,attack.mitre.org/techniques/T1048; classtype:trojan-activity; sid:5203850; rev:1;)

