alert tcp any any -> any any (msg:"ET EXPLOIT Apache Storm Logviewer ListLogs Without Auth"; flow:established,to_server; content:"/listLogs"; http_uri; content:"user="; nocase; reference:cve,CVE-2026-82437; classtype:attempted-recon; sid:5203853; rev:1;)

