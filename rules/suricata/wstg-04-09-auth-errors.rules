# =============================================================================
# Suricata Rules — WSTG 04-09 Authentication Error Detection (Network Layer)
# Covers: brute force, credential stuffing, password attacks, session attacks,
#          auth bypass, MFA abuse, OAuth/OIDC attacks, token manipulation,
#          password reset abuse, API auth attacks, SSO attacks
# Total rules: 42
# SID range: 2305001 - 2305042
# Reference: OWASP WSTG v4.2 — Authentication Testing (04-09)
# =============================================================================

# --- Brute Force Detection (Network Layer) ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Brute Force - Rapid POST to Login Endpoint from Single IP"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(login|signin|auth|authenticate|session|api\/v[0-9]+\/auth)\b/i"; http_uri; threshold:type both, track by_src, count 15, seconds 60; classtype:attempted-login; sid:2305001; rev:1; metadata:mitre T1110, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Brute Force - Password Spray Common Passwords Across Accounts"; flow:established,to_server; content:"POST"; http_method; pcre:"/(password|passwd|pwd|pass)\s*=\s*(Password1!|Welcome1|P@ssw0rd|Summer2026|Changeme1!)/i"; http_client_body; threshold:type both, track by_src, count 8, seconds 120; classtype:attempted-login; sid:2305002; rev:1; metadata:mitre T1110.003, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Brute Force - Sequential Username Pattern Attempt"; flow:established,to_server; content:"POST"; http_method; pcre:"/(user|username|email|login)\s*=\s*(admin\d*|test\d*|user\d*|operator\d*)/i"; http_client_body; threshold:type both, track by_src, count 10, seconds 300; classtype:attempted-login; sid:2305003; rev:1; metadata:mitre T1110.001, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Brute Force - Login Attempts with Rotating User-Agents"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(login|signin|auth)\b/i"; http_uri; threshold:type both, track by_src, count 20, seconds 60; classtype:attempted-login; sid:2305004; rev:1; metadata:mitre T1110, created_at 2026_08_17;)

# --- Credential Stuffing ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Credential Stuffing - Automated Tool User-Agent String"; flow:established,to_server; pcre:"/(Hydra|Ncrack|Medusa|BurpSuite|sqlmap|ffuf|Nikto|DirBuster|wfuzz|python-requests\/[0-9]|Go-http-client\/[0-9]|Apache-HttpClient|httpclient|reqwest|aiohttp)/i"; http_header; pcre:"/\/(login|signin|auth|authenticate)\b/i"; http_uri; classtype:attempted-login; sid:2305005; rev:1; metadata:mitre T1110.004, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Credential Stuffing - High-Speed Sequential Login Attempts"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(login|signin|auth|api\/auth)\b/i"; http_uri; threshold:type both, track by_src, count 30, seconds 60; classtype:attempted-login; sid:2305006; rev:1; metadata:mitre T1110.004, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Credential Stuffing - Known Breached Credential Combo Detection"; flow:established,to_server; content:"POST"; http_method; pcre:"/(email|username|user|login)\s*=\s*[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}/i"; http_client_body; pcre:"/(password|passwd|pwd|pass)\s*=\s*[a-zA-Z0-9!@#$%^&*]{8,}/i"; http_client_body; threshold:type both, track by_src, count 12, seconds 300; classtype:attempted-login; sid:2305007; rev:1; metadata:mitre T1110.004, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Credential Stuffing - Bulk Account Validation API Probe"; flow:established,to_server; pcre:"/\/api\/v[0-9]+\/(auth\/check|accounts\/validate|users\/verify|login\/check|password\/reset\/validate)\b/i"; http_uri; threshold:type both, track by_src, count 5, seconds 60; classtype:attempted-login; sid:2305008; rev:1; metadata:mitre T1110.004, created_at 2026_08_17;)

# --- Default Credentials ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Default Credentials - admin/admin or root/root Login Attempt"; flow:established,to_server; content:"POST"; http_method; pcre:"/(user|username|login|email)\s*=\s*(admin|root)[^@]*&(password|passwd|pwd|pass)\s*=\s*(admin|root|password|1234)/i"; http_client_body; classtype:attempted-login; sid:2305009; rev:1; metadata:mitre T1078.001, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Default Credentials - IoT Device Default Login Attempt"; flow:established,to_server; content:"POST"; http_method; pcre:"/(user|username|login)\s*=\s*(root|admin|user|guest|pi|ubnt|support|service|operator|daemon)&(password|passwd|pwd|pass)\s*=\s*(root|admin|password|1234|12345|default|ubnt|blank|changeme|welcome|micro)/i"; http_client_body; classtype:attempted-login; sid:2305010; rev:1; metadata:mitre T1078.001, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Default Credentials - Tomcat Manager Default Auth"; flow:established,to_server; content:"/manager/html"; http_uri; content:"Authorization"; http_header; content:"Basic"; http_header; classtype:attempted-login; sid:2305011; rev:1; metadata:mitre T1078.001, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Default Credentials - phpMyAdmin root Login Attempt"; flow:established,to_server; pcre:"/\/(phpmyadmin|pma|phpmyadmin\/index\.php)\b/i"; http_uri; pcre:"/(pma_username|username)\s*=\s*root/i"; http_client_body; classtype:attempted-login; sid:2305012; rev:1; metadata:mitre T1078.001, created_at 2026_08_17;)

# --- MFA Bypass ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH MFA Bypass - OTP Brute Force on Verification Endpoint"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(mfa|2fa|otp|verify|challenge|two-factor)\b/i"; http_uri; threshold:type both, track by_src, count 10, seconds 120; classtype:attempted-login; sid:2305013; rev:1; metadata:mitre T1111, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH MFA Bypass - Reuse of Expired OTP Token"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(mfa|2fa|otp|verify|challenge)\b/i"; http_uri; pcre:"/(otp|token|code|pin)\s*=\s*\d{4,8}/i"; http_client_body; classtype:attempted-login; sid:2305014; rev:1; metadata:mitre T1111, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH MFA Bypass - Backup/Recovery Code Enumeration Attempt"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(mfa|2fa|backup|recovery)\b/i"; http_uri; pcre:"/(backup|recovery|code)\s*=\s*[a-zA-Z0-9]{4,8}/i"; http_client_body; threshold:type both, track by_src, count 5, seconds 300; classtype:attempted-login; sid:2305015; rev:1; metadata:mitre T1111, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH MFA Bypass - Session Token Without MFA Validation Marker"; flow:established,to_server; pcre:"/(session_id|auth_token|access_token|jwt)=eyJ[a-zA-Z0-9_-]+/i"; http_uri; content:! "mfa_verified"; http_header; classtype:attempted-login; sid:2305016; rev:1; metadata:mitre T1111, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH MFA Bypass - Direct API Access Skipping MFA Step"; flow:established,to_server; pcre:"/\/api\/v[0-9]+\/(user|account|profile|dashboard|admin)\b/i"; http_uri; content:! "X-MFA-Verified"; http_header; content:"Authorization"; http_header; threshold:type both, track by_src, count 3, seconds 60; classtype:attempted-login; sid:2305017; rev:1; metadata:mitre T1111, created_at 2026_08_17;)

# --- Session Attacks ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Session Hijacking - Same Session Token from Multiple Source IPs"; flow:established,to_server; content:"Cookie"; http_header; pcre:"/(sessionid|session_id|PHPSESSID|JSESSIONID|ASP\.NET_SessionId|connect\.sid|_session_id)=\w{16,}/i"; http_header; threshold:type both, track by_src, count 2, seconds 60; classtype:attempted-login; sid:2305018; rev:1; metadata:mitre T1187, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Session Fixation - Pre-Set Session ID in Login POST Body"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(login|signin|auth)\b/i"; http_uri; pcre:"/(sessionid|session_id|PHPSESSID|JSESSIONID)=\w{16,}/i"; http_client_body; classtype:web-application-attack; sid:2305019; rev:1; metadata:mitre T1534, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Session Token Exposed in URL Query String"; flow:established,to_server; pcre:"/[?&](sessionid|session_id|PHPSESSID|JSESSIONID|sid|token|auth_key)=\w{16,}/i"; http_uri; classtype:web-application-attack; sid:2305020; rev:1; metadata:mitre T1187, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Insecure Session Cookie - Missing HttpOnly Flag"; flow:established,to_server; content:"Set-Cookie"; http_header; pcre:"/(sessionid|PHPSESSID|JSESSIONID|ASP\.NET_SessionId|connect\.sid)=[^;]+(?![^;]*HttpOnly)/i"; http_header; classtype:web-application-attack; sid:2305021; rev:1; metadata:mitre T1539, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Insecure Session Cookie - Missing Secure Flag on HTTPS"; flow:established,to_server; content:"Set-Cookie"; http_header; pcre:"/(sessionid|PHPSESSID|JSESSIONID|ASP\.NET_SessionId|connect\.sid)=[^;]+(?![^;]*Secure)/i"; http_header; classtype:web-application-attack; sid:2305022; rev:1; metadata:mitre T1539, created_at 2026_08_17;)

# --- JWT Attacks ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH JWT None Algorithm Bypass Attempt"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer"; http_header; pcre:"/eyJhbGciOiJub25lI/i"; http_header; classtype:web-application-attack; sid:2305023; rev:1; metadata:mitre T1606, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH JWT Algorithm Confusion RS256 to HS256"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer"; http_header; pcre:"/eyJhbGciOiJIUzI1Ni/i"; http_header; classtype:web-application-attack; sid:2305024; rev:1; metadata:mitre T1606, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH JWT Empty Signature Segment"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer"; http_header; pcre:"/eyJ[a-zA-Z0-9_-]+\.eyJ[a-zA-Z0-9_-]+\.$/"; http_header; classtype:web-application-attack; sid:2305025; rev:1; metadata:mitre T1606, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH JWT jku/x5u Header Injection Attempt"; flow:established,to_server; content:"Authorization"; http_header; pcre:"/(jku|x5u)\s*:\s*\"https?:\/\//i"; http_header; classtype:web-application-attack; sid:2305026; rev:1; metadata:mitre T1606, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH JWT Claim Manipulation - kid Path Traversal"; flow:established,to_server; content:"Authorization"; http_header; pcre:"/eyJ[a-zA-Z0-9_-]+\.eyJ[a-zA-Z0-9_-]+\./"; http_header; pcre:"/\"kid\"\s*:\s*\"[.\/]+\//i"; classtype:web-application-attack; sid:2305027; rev:1; metadata:mitre T1606, created_at 2026_08_17;)

# --- OAuth / OIDC Abuse ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH OAuth Authorization Code Interception/Reuse"; flow:established,to_server; pcre:"/\/(oauth|authorize|auth)\/.*code=[a-zA-Z0-9_-]+/i"; http_uri; threshold:type both, track by_src, count 3, seconds 30; classtype:web-application-attack; sid:2305028; rev:1; metadata:mitre T1528, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH OAuth Open Redirect in Redirect URI"; flow:established,to_server; pcre:"/redirect_uri=https?:\/\/(?!([^\/]+\.)?trusted-site\.tld)/i"; http_uri; classtype:web-application-attack; sid:2305029; rev:1; metadata:mitre T1528, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH OAuth PKCE Downgrade to Plain Code Challenge"; flow:established,to_server; pcre:"/\/(oauth|authorize|auth)\/.*code_challenge_method=plain/i"; http_uri; classtype:web-application-attack; sid:2305030; rev:1; metadata:mitre T1528, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH OAuth Token Scope Escalation Attempt"; flow:established,to_server; pcre:"/\/(oauth|auth)\/token\b/i"; http_uri; pcre:"/scope=(admin|root|superuser|write|delete|manage)/i"; http_client_body; classtype:web-application-attack; sid:2305031; rev:1; metadata:mitre T1528, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH OAuth Client Credentials Abuse - Impersonation Attempt"; flow:established,to_server; pcre:"/\/(oauth|auth)\/token\b/i"; http_uri; content:"grant_type=client_credentials"; http_client_body; pcre:"/scope=(openid|profile|email|admin)/i"; http_client_body; classtype:web-application-attack; sid:2305032; rev:1; metadata:mitre T1528, created_at 2026_08_17;)

# --- Password Reset Abuse ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Password Reset - Token Enumeration via Rapid Attempts"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(reset|forgot|recover|password)\b/i"; http_uri; threshold:type both, track by_src, count 10, seconds 60; classtype:attempted-login; sid:2305033; rev:1; metadata:mitre T1110, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Password Reset - Host Header Injection in Reset Link"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(reset|forgot|recover)\b/i"; http_uri; pcre:"/^Host:\s*[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/im"; http_header; classtype:web-application-attack; sid:2305034; rev:1; metadata:mitre T1190, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Password Reset - Predictable Token Pattern Detection"; flow:established,to_server; pcre:"/\/(reset|forgot|recover)\/[a-f0-9]{32,}/i"; http_uri; pcre:"/[?&]token=[a-f0-9]{8,}/i"; http_uri; threshold:type both, track by_src, count 5, seconds 120; classtype:web-application-attack; sid:2305035; rev:1; metadata:mitre T1110, created_at 2026_08_17;)

# --- API Authentication Abuse ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH API Key Exposure in URL Query Parameter"; flow:established,to_server; pcre:"/[?&](api_key|apikey|api-key|access_key|secret_key|token|key)=[a-zA-Z0-9_-]{20,}/i"; http_uri; classtype:web-application-attack; sid:2305036; rev:1; metadata:mitre T1187, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH API Key in Authorization Header - Common Leaked Patterns"; flow:established,to_server; content:"Authorization"; http_header; pcre:"/(AKIA|AIza|sk_live|sk_test|pk_live|pk_test|ghp_|gho_|github_pat_|glpat-|xox[bpsa]-)/i"; http_header; classtype:web-application-attack; sid:2305037; rev:1; metadata:mitre T1187, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Bearer Token Manipulation - Modified Payload Claims"; flow:established,to_server; content:"Authorization"; http_header; content:"Bearer"; http_header; pcre:"/eyJ[a-zA-Z0-9_-]+\./"; http_header; pcre:"/(\"role\"\s*:\s*\"(admin|root|superuser)\"|\"iss\"\s*:\s*\"(attacker|evil)\")/i"; http_header; classtype:web-application-attack; sid:2305038; rev:1; metadata:mitre T1606, created_at 2026_08_17;)

# --- SSO / Federation Attacks ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH SAML Assertion Replay Attempt"; flow:established,to_server; content:"POST"; http_method; pcre:"/\/(saml|acs|sso|assertion)\b/i"; http_uri; pcre:"/SAMLResponse=/i"; http_client_body; threshold:type both, track by_src, count 3, seconds 60; classtype:web-application-attack; sid:2305039; rev:1; metadata:mitre T1606, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH SAML XML Signature Wrapping Attack"; flow:established,to_server; pcre:"/<ds:Signature[^>]*>.*<ds:Signature/i"; http_client_body; classtype:web-application-attack; sid:2305040; rev:1; metadata:mitre T1606, created_at 2026_08_17;)

# --- Authentication Bypass Patterns ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Auth Bypass - Force Browse to Admin Endpoint Without Auth"; flow:established,to_server; pcre:"/\/(admin|administrator|dashboard|manage|console|cpanel|control)\b/i"; http_uri; content:! "Cookie"; http_header; content:! "Authorization"; http_header; classtype:attempted-admin; sid:2305041; rev:1; metadata:mitre T1078, created_at 2026_08_17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"WSTG-AUTH Auth Bypass - HTTP Method Tampering on Auth-Protected Endpoint"; flow:established,to_server; pcre:"/^(PUT|PATCH|DELETE|TRACE|OPTIONS|HEAD)/i"; http_method; pcre:"/\/(admin|api|users|config|settings|manage)\b/i"; http_uri; classtype:attempted-admin; sid:2305042; rev:1; metadata:mitre T1078, created_at 2026_08_17;)