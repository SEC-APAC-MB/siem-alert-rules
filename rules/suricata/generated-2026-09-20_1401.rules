# --- MITRE ATT&CK Technique-Based Rules (not yet covered) ---

# T1078.004 - Valid Accounts: Cloud Accounts
alert http any any -> $HOME_NET any (msg:"ET TROJAN Possible Cloud Credential Stuffing Rapid Login Attempts"; flow:to_server,established; http.uri; content:"/login"; nocase; threshold:type both, track by_src, count 10, seconds 60; reference:mitre,T1078.004; classtype:attempted-admin; sid:5210126; rev:1;)

# T1190 - Exploit Public-Facing Application: GraphQL Introspection
alert http any any -> $HOME_NET any (msg:"ET WEB_SERVER GraphQL Introspection Query Detection"; flow:to_server,established; http.uri; content:"/graphql"; nocase; http.request_body; content:"__schema"; nocase; reference:mitre,T1190; classtype:attempted-recon; sid:5210127; rev:1;)

# T1190 - Exploit Public-Facing Application: Swagger/OpenAPI Exposure
alert http any any -> $HOME_NET any (msg:"ET WEB_SERVER Swagger/OpenAPI Documentation Exposure Detection"; flow:to_server,established; http.uri; content:"/swagger-ui/"; nocase; reference:mitre,T1190; classtype:attempted-recon; sid:5210128; rev:1;)

# T1059.001 - Command and Scripting Interpreter: PowerShell Obfuscation
alert http any any -> $HOME_NET any (msg:"ET TROJAN PowerShell Obfuscation via Encoded Command"; flow:to_server,established; http.request_body; content:"-enc"; nocase; pcre:"/\-enco[a-z]*\s+[A-Za-z0-9+\/=]{20,}/si"; reference:mitre,T1059.001; classtype:trojan-activity; sid:5210129; rev:1;)

# T1059.004 - Command and Scripting Interpreter: Unix Shell Reverse Shell
alert tcp any any -> $HOME_NET any (msg:"ET TROJAN Unix Reverse Shell Pattern Detection"; flow:established; content:"/bin/sh"; content:"-i"; distance:0; pcre:"/\/bin\/(ba)?sh\s+-[ic]\s+.*[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/s"; reference:mitre,T1059.004; classtype:trojan-activity; sid:5210130; rev:1;)

# T1021.001 - Remote Services: RDP Brute Force
alert tcp any any -> $HOME_NET 3389 (msg:"ET PROTOCOL_RDP Possible Brute Force RDP Login Attempts"; flow:to_server; threshold:type both, track by_src, count 10, seconds 60; reference:mitre,T1021.001; classtype:attempted-admin; sid:5210131; rev:1;)

# T1071.001 - Application Layer Protocol: Web Protocols - HTTP Long URL
alert http any any -> $HOME_NET any (msg:"ET WEB_SERVER Excessively Long HTTP Request URI Possible Buffer Overflow"; flow:to_server,established; http.uri; len:>4000; reference:mitre,T1071.001; classtype:attempted-admin; sid:5210132; rev:1;)

# T1110.003 - Brute Force: Password Spraying
alert http any any -> $HOME_NET any (msg:"ET WEB_SERVER Password Spraying Attack Pattern Detection"; flow:to_server,established; http.uri; content:"/login"; nocase; http.request_body; content:"password="; nocase; threshold:type both, track by_src, count 20, seconds 300; reference:mitre,T1110.003; classtype:attempted-admin; sid:5210133; rev:1;)

# T1566.001 - Phishing: Spearphishing Attachment - Macro Document
alert http any any -> $HOME_NET any (msg:"ET TROJAN Possible Macro-Enabled Document Download"; flow:to_server,established; http.response_line; content:"200"; http.content_type; content:"application/vnd.openxmlformats-officedocument.wordprocessingml.document"; nocase; http.header; content:"Content-Disposition"; pcre:"/filename=[^\"']*\\.(docm|xlsm|pptm)/si"; reference:mitre,T1566.001; classtype:trojan-activity; sid:5210134; rev:1;)

# T1053.005 - Scheduled Task/Job: Scheduled Task
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Windows Scheduled Task Creation via schtasks"; flow:to_server,established; http.request_body; content:"schtasks"; nocase; content:"/create"; distance:0; nocase; reference:mitre,T1053.005; classtype:trojan-activity; sid:5210135; rev:1;)

# T1569.002 - System Services: Service Execution
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Windows Service Creation via sc.exe"; flow:to_server,established; http.request_body; content:"sc.exe"; nocase; content:"create"; distance:0; nocase; reference:mitre,T1569.002; classtype:trojan-activity; sid:5210136; rev:1;)

# T1005 - Data from Local System: Suspicious Archive Creation
alert http any any -> $EXTERNAL_NET any (msg:"ET EXFIL Possible Data Archiving Before Exfiltration"; flow:to_server,established; http.request_body; pcre:"/(7z|rar|tar|zip)\s+[a-zA-Z]:\\\\|arcive|\.7z|\.rar/si"; reference:mitre,T1005; classtype:attempted-admin; sid:5210137; rev:1;)

# T1048.003 - Exfiltration Over Alternative Protocol: Exfiltration Over Unencrypted Non-C2 Protocol
alert http any any -> $EXTERNAL_NET any (msg:"ET EXFIL Large Data Upload to Cloud Storage Service"; flow:to_server,established; http.uri; content:"drive.google.com"; nocase; http.content_len; len:>10485760; reference:mitre,T1048.003; classtype:attempted-admin; sid:5210138; rev:1;)

# T1070.002 - Indicator Removal: Clear Linux Logs
alert http any any -> $HOME_NET any (msg:"ET TROJAN Suspicious Linux Log Clearing Activity"; flow:to_server,established; http.request_body; content:"/var/log"; pcre:"/(echo\s+[^\n]*>\s*\/var\/log|truncate\s+-s\s+0.*\/var\/log|>\s*\/var\/log)/si"; reference:mitre,T1070.002; classtype:trojan-activity; sid:5210139; rev:1;)

# T1070.004 - Indicator Removal: File Deletion Suspicious
alert http any any -> $HOME_NET any (msg:"ET TROJAN Suspicious Bulk File Deletion Command"; flow:to_server,established; http.request_body; pcre:"/(rm\s+-rf\s+\/|del\s+\/[sS]\s+\/[qQ]\s+C:\\|Remove-Item\s+-Recurse\s+-Force\s+C:\\)/si"; reference:mitre,T1070.004; classtype:trojan-activity; sid:5210140; rev:1;)

# T1087.002 - Account Discovery: Domain Account Enumeration
alert http any any -> $HOME_NET any (msg:"ET TROJAN Active Directory User Enumeration via LDAP"; flow:to_server,established; http.request_body; content:"(&(objectClass=user)(objectCategory=person))"; nocase; reference:mitre,T1087.002; classtype:attempted-recon; sid:5210141; rev:1;)

# T1018 - Remote System Discovery: Network Scanning
alert http any any -> $HOME_NET any (msg:"ET RECON Network Scanning Tool User-Agent Detection"; flow:to_server,established; http.user_agent; pcre:"/(Nmap|Masscan|ZMap|RustScan)/si"; reference:mitre,T1018; classtype:attempted-recon; sid:5210142; rev:1;)

# T1083 - File and Directory Discovery: Sensitive File Access
alert http any any -> $HOME_NET any (msg:"ET WEB_SERVER Sensitive Configuration File Access Attempt"; flow:to_server,established; http.uri; pcre:"/\/(\.env|wp-config\.php|web\.config|application\.config|database\.yml)/si"; reference:mitre,T1083; classtype:attempted-recon; sid:5210143; rev:1;)

# T1068 - Exploitation for Privilege Escalation
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Potential Privilege Escalation via sudo Misconfiguration"; flow:to_server,established; http.request_body; content:"sudo"; content:"NOPASSWD"; distance:0; nocase; reference:mitre,T1068; classtype:attempted-privilege-escalation; sid:5210144; rev:1;)

# T1548.001 - Abuse Elevation Control Mechanism: Setuid/Setgid
alert http any any -> $HOME_NET any (msg:"ET TROJAN Suspicious setuid Binary Execution"; flow:to_server,established; http.request_body; pcre:"/(find\s+\/.*-perm\s+-4000|find\s+\/.*-perm\s+-2000)/si"; reference:mitre,T1548.001; classtype:attempted-privilege-escalation; sid:5210145; rev:1;)

# T1134 - Access Token Manipulation
alert http any any -> $HOME_NET any (msg:"ET TROJAN Windows Access Token Manipulation via runas"; flow:to_server,established; http.request_body; content:"runas"; nocase; content:"/user:"; distance:0; nocase; reference:mitre,T1134; classtype:attempted-privilege-escalation; sid:5210146; rev:1;)

# T1482 - Domain Trust Discovery
alert http any any -> $HOME_NET any (msg:"ET TROJAN Domain Trust Discovery via nltest"; flow:to_server,established; http.request_body; content:"nltest"; nocase; content:"/domain_trusts"; distance:0; nocase; reference:mitre,T1482; classtype:attempted-recon; sid:5210147; rev:1;)

# T1486 - Data Encrypted for Impact: Ransomware Indicator
alert http any any -> $HOME_NET any (msg:"ET TROJAN Possible Ransomware Activity Encrypted File Extension"; flow:to_server,established; http.uri; pcre:"/\.[a-z]{8,12}$/si"; http.uri; pcre:"/(\.encrypted|\.locked|\.crypto|\.cry|\.locky|\.zepto|\.cerber|\.sage|\.globe|\.purge)/si"; reference:mitre,T1486; classtype:trojan-activity; sid:5210148; rev:1;)

# T1498 - Network Denial of Service: Slowloris Detection
alert http any any -> $HOME_NET any (msg:"ET DOS Possible Slowloris Attack Pattern"; flow:to_server,established; http.header; content:"X-a:"; threshold:type threshold, track by_src, count 20, seconds 10; reference:mitre,T1498; classtype:attempted-dos; sid:5210149; rev:1;)

# T1098 - Account Manipulation
alert http any any -> $HOME_NET any (msg:"ET TROJAN Account Manipulation via net user Command"; flow:to_server,established; http.request_body; content:"net user"; nocase; pcre:"/net\s+user\s+\S+\s+\S+\s+\/(add|domain|active)/si"; reference:mitre,T1098; classtype:attempted-admin; sid:5210150; rev:1;)

# T1136 - Create Account
alert http any any -> $HOME_NET any (msg:"ET TROJAN Suspicious Account Creation Activity"; flow:to_server,established; http.request_body; pcre:"/(useradd|adduser|net\s+user\s+\S+\s+\S+\s*\/add)/si"; reference:mitre,T1136; classtype:attempted-admin; sid:5210151; rev:1;)

# --- Current Threat Landscape Rules ---

# AI/LLM Prompt Injection Detection
alert http any any -> $HOME_NET any (msg:"ET AI_PROMPT_INJECTION LLM System Prompt Override Attempt"; flow:to_server,established; http.request_body; pcre:"/(ignore\s+(previous|above|all)\s+instructions|disregard\s+(your|all)\s+(previous|training)|you\s+are\s+now\s+a|new\s+instructions?\s*:)/si"; classtype:attempted-admin; sid:5210152; rev:1;)

# AI/LLM Data Exfiltration via Prompt
alert http any any -> $EXTERNAL_NET any (msg:"ET AI_DATA_EXFIL LLM Response Containing Sensitive Data Patterns"; flow:to_server,established; http.request_body; pcre:"/(api[_-]?key|secret[_-]?key|password|token|credential).*(prompt|instruction|system)/si"; classtype:trojan-activity; sid:5210153; rev:1;)

# SSRF via Cloud Metadata Endpoint
alert http any any -> $HOME_NET any (msg:"ET WEB_SERVER SSRF Attempt to Cloud Metadata Endpoint"; flow:to_server,established; http.uri; pcre:"/(169\.254\.169\.254|metadata\.google\.internal|metadata\.azure\.com)/si"; reference:mitre,T1190; classtype:attempted-recon; sid:5210154; rev:1;)

# OAuth Token Theft via Phishing
alert http any any -> $EXTERNAL_NET any (msg:"ET TROJAN OAuth Token Submission to Suspicious Endpoint"; flow:to_server,established; http.uri; content:"/token"; nocase; http.request_body; content:"access_token"; nocase; pcre:"/access_token=[^&]{50,}/s"; reference:mitre,T1528; classtype:trojan-activity; sid:5210155; rev:1;)

# DNS Tunneling Detection
alert dns any any -> any any (msg:"ET TROJAN Possible DNS Tunneling Long Subdomain Query"; dns.query; pcre:"/^[a-z0-9]{30,}\.[a-z0-9]{10,}\.[a-z]+\.[a-z]+$/si"; reference:mitre,T1071.004; classtype:trojan-activity; sid:5210156; rev:1;)

# Kubernetes API Server Unauthorized Access
alert http any any -> $HOME_NET any (msg:"ET CLOUD Kubernetes API Server Unauthorized Access Attempt"; flow:to_server,established; http.uri; content:"/api/v1/"; http.response_line; content:"401"; reference:mitre,T1078; classtype:attempted-admin; sid:5210157; rev:1;)

# Container Escape via Docker Socket
alert http any any -> $HOME_NET any (msg:"ET EXPLOIT Docker Socket Escape Attempt"; flow:to_server,established; http.uri; content:"/var/run/docker.sock"; nocase; reference:mitre,T1611; classtype:attempted-admin; sid:5210158; rev:1;)

# Server-Side Template Injection (SSTI)
alert http any any -> $HOME_NET any (msg:"ET WEB_ATTACK Server-Side Template Injection Detection"; flow:to_server,established; http.request_body; pcre:"/\{\{.*(__class__|__mro__|__subclasses__|config|request|lipsum|cycler|joiner|namespace)/si"; classtype:attempted-admin; sid:5210159; rev:1;)

# Prototype Pollution Detection
