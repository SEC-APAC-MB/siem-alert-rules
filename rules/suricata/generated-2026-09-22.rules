# === OWASP - Cryptographic Failures (A02:2021) ===
alert http any any -> any any (msg:"ET WEB_SERVER Sensitive Data Over HTTP - Credit Card Pattern"; flow:established,to_client; file.data; pcre:"/\b4\d{12}\d{3}\b|\b5[1-5]\d{14}\b/"; classtype:data-theft; sid:5204176; rev:1;)
alert http any any -> any any (msg:"ET WEB_SERVER Sensitive Data Over HTTP - SSN Pattern"; flow:established,to_client; file.data; pcre:"/\b\d{3}-\d{2}-\d{4}\b/"; classtype:data-theft; sid:5204177; rev:1;)

# === OWASP - Security Misconfiguration (A05:2021) ===
alert http any any -> any any (msg:"ET WEB_SERVER Default Credentials Attempt"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/login"; nocase; http.json_body; pcre:"/(admin|root)[\":,\s]+(admin|root|password|1234)/i"; classtype:attempted-admin; sid:5204178; rev:1;)
alert http any any -> any any (msg:"ET WEB_SERVER Debug Mode Exposure"; flow:established,to_client; file.data; content:"debug"; nocase; content:"stack"; nocase; content:"trace"; nocase; classtype:informational; sid:5204179; rev:1;)

# === OWASP - SSRF (A10:2021 variant) ===
alert http any any -> any any (msg:"ET WEB_SERVER SSRF Internal Network Access Attempt"; flow:established,to_server; http.uri; pcre:"/(url|uri|path|dest|redirect|return|next|target|out|link|rurl|src|fetch|source)=(https?:\/\/)?(10\.\d+\.\d+\.\d+|172\.(1[6-9]|2\d|3[01])\.\d+\.\d+|192\.168\.\d+\.\d+|127\.\d+\.\d+\.\d+)/i"; classtype:web-application-attack; sid:5204180; rev:1;)
alert http any any -> any any (msg:"ET WEB_SERVER SSRF Cloud Metadata Endpoint Access"; flow:established,to_server; http.uri; pcre:"/(url|uri|path|dest|redirect|return)=(https?:\/\/)?(169\.254\.169\.254|metadata\.google\.internal)/i"; classtype:web-application-attack; sid:5204181; rev:1;)

# === OWASP - XSS (A03:2021 variant) ===
alert http any any -> any any (msg:"ET WEB_CLIENT Reflected XSS Attempt - Script Tag Injection"; flow:established,to_server; http.uri; pcre:"/<script[\s>]|javascript\s*:|on(error|load|click|mouseover)\s*=/i"; classtype:web-application-attack; sid:5204182; rev:1;)
alert http any any -> any any (msg:"ET WEB_CLIENT Stored XSS via Rich Content Upload"; flow:established,to_server; http.method; content:"POST"; http.content_type; content:"multipart/form-data"; file.data; content:"<script"; nocase; classtype:web-application-attack; sid:5204183; rev:1;)

# === OWASP - XML External Entity (A05 variant) ===
alert http any any -> any any (msg:"ET WEB_SERVER XXE Injection Attempt"; flow:established,to_server; http.method; content:"POST"; http.content_type; content:"xml"; nocase; file.data; pcre:"/<!ENTITY\s+\w+\s+SYSTEM\s+[\"']/i"; classtype:web-application-attack; sid:5204184; rev:1;)

# === Cloud Security - AWS/IAM ===
alert http any any -> any any (msg:"ET CLOUD AWS IAM AssumeRole Privilege Escalation Pattern"; flow:established,to_server; http.uri; content:"/sts/"; nocase; content:"AssumeRole"; nocase; classtype:attempted-admin; sid:5204185; rev:1;)
alert http any any -> any any (msg:"ET CLOUD AWS S3 Bucket Enumeration"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/list"; nocase; http.header; content:"s3"; nocase; threshold:type threshold, track by_src, count 20, seconds 30; classtype:network-recon; sid:5204186; rev:1;)

# === Container Security ===
alert http any any -> any any (msg:"ET CLOUD Docker API Unauthenticated Access"; flow:established,to_server; http.uri; content:"/containers/json"; nocase; http.method; content:"GET"; classtype:attempted-admin; sid:5204187; rev:1;)
alert http any any -> any any (msg:"ET CLOUD Kubernetes API Server Unauthenticated Access"; flow:established,to_server; http.uri; content:"/api/v1/"; nocase; http.method; content:"GET"; classtype:attempted-admin; sid:5204188; rev:1;)

# === API Security ===
alert http any any -> any any (msg:"ET WEB_SERVER API Mass Data Enumeration - High Request Rate"; flow:established,to_server; http.method; content:"GET"; http.uri; pcre:"/\/api\/v\d+\//i"; threshold:type threshold, track by_src, count 100, seconds 60; classtype:network-recon; sid:5204189; rev:1;)
alert http any any -> any any (msg:"ET WEB_SERVER API Broken Authentication Token Reuse"; flow:established,to_server; http.header; content:"Authorization"; content:"Bearer"; threshold:type threshold, track by_src, count 50, seconds 300; classtype:credential-access; sid:5204190; rev:1;)
alert http any any -> any any (msg:"ET WEB_SERVER API GraphQL Introspection Query"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"graphql"; nocase; http.json_body; content:"__schema"; nocase; classtype:network-recon; sid:5204191; rev:1;)

# === Supply Chain / Dependency Confusion ===
alert dns any any -> any any (msg:"ET C2 Dependency Confusion - Internal Package Query to External Registry"; dns.query; pcre:"/^[a-z0-9\-]+\.internal\./i"; classtype:command-and-control; sid:5204192; rev:1;)

# === Authentication Attacks ===
alert http any any -> any any (msg:"ET WEB_SERVER OAuth Token Theft via Redirect URI Manipulation"; flow:established,to_server; http.uri; content:"redirect_uri"; nocase; pcre:"/redirect_uri=[^&]*%(25)*3[a-fA-F0-9]{2}/i"; classtype:credential-access; sid:5204193; rev:1;)
alert http any any -> any any (msg:"ET WEB_SERVER MFA Bypass via OTP Replay"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/mfa"; nocase; threshold:type threshold, track by_src, count 3, seconds 30; classtype:credential-access; sid:5204194; rev:1;)

# === HTTP Anomaly Detection ===
alert http any any -> any any (msg:"ET WEB_SERVER HTTP Request Smuggling - CL.TE Variant"; flow:established,to_server; http.header; content:"Content-Length"; http.header; content:"Transfer-Encoding"; content:"chunked"; classtype:web-application-attack; sid:5204195; rev:1;)
alert http any any -> any any (msg:"ET WEB_SERVER HTTP Request Smuggling - TE.CL Variant"; flow:established,to_server; http.header; content:"Transfer-Encoding"; content:"chunked"; pcre:"/Transfer-Encoding\s*:\s*[\x20\x09]*chunked/i"; classtype:web-application-attack; sid:5204196; rev:1;)

# === Web Shell Detection ===
alert http any any -> any any (msg:"ET WEB_SERVER Web Shell Upload via Multipart POST"; flow:established,to_server; http.method; content:"POST"; http.content_type; content:"multipart/form-data"; file.data; pcre:"/<\?php\s+(eval|system|exec|shell_exec|passthru|base64_decode|assert)\s*\(/i"; classtype:trojan-activity; sid:5204197; rev:1;)
alert http any any -> any any (msg:"ET WEB_SERVER Web Shell Access - Common Shell Filenames"; flow:established,to_server; http.uri; pcre:"/(cmd|shell|c99|r57|webshell|b374k|wso|alfa)\.(php|jsp|asp|aspx)/i"; classtype:trojan-activity; sid:5204198; rev:1;)

# === Data Exfiltration Patterns ===
alert http any any -> any any (msg:"ET EXFIL DNS-over-HTTPS Tunneling via Public Resolvers"; flow:established,to_server; http.uri; pcre:"/\/dns-query\?dns=/i"; http.header; content:"Host"; pcre:"/dns\.google|cloudflare-dns\.com|dns\.quad9\.net/i"; classtype:command-and-control; sid:5204199; rev:1;)
alert http any any -> any any (msg:"ET EXFIL Large Outbound Data Transfer via HTTP POST"; flow:established,to_server; http.method; content:"POST"; dsize:>10485760; classtype:data-theft; sid:5204200; rev:1;)