alert tcp $EXTERNAL_NET any -> $HOME_NET 9200 (msg:"Elasticsearch unauthenticated access from external"; flow:established,to_server; http.uri; content:"/_cluster/health"; nocase; http.header; content:"Authorization"; neg; classtype:attempted-admin; sid:52111694; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"XXE external entity injection - file://"; flow:established,to_server; http.request_body; content:"<!ENTITY"; nocase; content:"file://"; nocase; classtype:web-application-attack; sid:52111695; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"XXE external entity injection - http://"; flow:established,to_server; http.request_body; content:"<!ENTITY"; nocase; content:"http://"; nocase; classtype:web-application-attack; sid:52111696; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"NoSQL injection - MongoDB operator injection"; flow:established,to_server; http.request_body; content:"$where"; nocase; content:"$ne"; nocase; classtype:web-application-attack; sid:52111697; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"HTTP request smuggling CL.TE attempt"; flow:established,to_server; http.header; content:"Content-Length"; content:"Transfer-Encoding"; classtype:web-application-attack; sid:52111698; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"HTTP request smuggling TE.CL attempt"; flow:established,to_server; http.header; content:"Transfer-Encoding: chunked"; content:"Content-Length"; classtype:web-application-attack; sid:52111699; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"CORS misconfiguration exploitation - wildcard origin"; flow:established,to_server; http.header; content:"Origin"; content:"*"; http.response_header; content:"Access-Control-Allow-Origin: *"; nocase; classtype:web-application-attack; sid:52111700; rev:1;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Websocket hijacking - cross-site WS attempt"; flow:established,to_server; http.header; content:"Upgrade: websocket"; content:"Sec-WebSocket-Key"; classtype:web-application-attack; sid:52111701; rev:1;)
