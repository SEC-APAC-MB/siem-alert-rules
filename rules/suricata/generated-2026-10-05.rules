alert http any any -> any any (msg:"GCP service account key creation abuse"; flow:established,to_server; http.method; content:"POST"; http.host; content:"iam.googleapis.com"; http.uri; pcre:"/\/serviceAccounts\/.*\/keys/i"; classtype:credential-access; sid:52111492; rev:1;)

alert http any any -> any any (msg:"OAuth token reuse from anomalous source - possible token theft"; flow:established,to_server; http.request_header; content:"Authorization|3a| Bearer"; detection_filter:track by_src, count 1, seconds 1; classtype:credential-access; sid:52111493; rev:1;)

alert http any any -> any any (msg:"JWT none algorithm bypass attempt"; flow:established,to_server; http.request_header; content:"Authorization|3a| Bearer"; pcre:"/eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0/i"; classtype:web-application-attack; sid:52111494; rev:1;)

alert http any any -> any any (msg:"SSRF internal network probe via web application"; flow:established,to_server; http.uri; pcre:"/(url|uri|target|redirect|next|callback|dest|return)=(https?:\/\/)?(127\.0\.0\.1|localhost|10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)/i"; classtype:web-application-attack; sid:52111495; rev:1;)

alert http any any -> any any (msg:"SSRF cloud metadata access via open redirect"; flow:established,to_server; http.uri; pcre:"/(redirect|url|return)=(https?:\/\/)?169\.254\.169\.254/i"; classtype:web-application-attack; sid:52111496; rev:1;)

alert http any any -> any any (msg:"API mass enumeration - sequential ID access pattern"; flow:established,to_server; http.uri; pcre:"/\/api\/.*\/\d+$/"; detection_filter:track by_src, count 200, seconds 60; classtype:attempted-recon; sid:52111497; rev:1;)

alert http any any -> any any (msg:"GraphQL introspection query abuse in production"; flow:established,to_server; http.request_body; pcre:"/(__schema|__type|introspection)/i"; http.uri; content:"graphql"; nocase; classtype:attempted-recon; sid:52111498; rev:1;)

alert http any any -> any any (msg:"WebSocket C2 channel - suspicious upgrade with binary frames"; flow:established,to_server; http.request_header; content:"Upgrade|3a| websocket"; content:"Sec-WebSocket-Protocol|3a| binary"; classtype:command-and-control; sid:52111499; rev:1;)
