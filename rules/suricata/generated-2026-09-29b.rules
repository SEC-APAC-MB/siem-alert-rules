alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"MITRE T1195.001 Supply chain attack - PyPI package typo-squatting detection"; flow:established,to_server; content:"files.pythonhosted.org"; http_host; pcre:"/(reqeusts|colourama|beautifusoup|nmap-python|cryptograpy)/i"; classtype:trojan-activity; sid:5208789; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 80 (msg:"MITRE T1505.003 Web shell detection - suspicious PHP file access on web server"; flow:established,to_server; pcre:"/(cmd|shell|c99|r57|wso|b374k)\.(php|jsp|asp)/Ui"; classtype:web-application-attack; sid:5208790; rev:1;)
alert tcp $EXTERNAL_NET any -> $HOME_NET 25 (msg:"MITRE T1193 Spearphishing email with suspicious URL link - credential harvesting"; flow:established,to_server; content:"http"; depth:500; pcre:"/(login|verify|account|secure|update)\.(html|php)/Ui"; classtype:trojan-activity; sid:5208791; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"MITRE T1112 Registry modification - suspicious registry key write via SMB"; flow:established; content:"|FF S M B|"; depth:4; content:"reg.exe"; within:100; content:"add"; within:50; classtype:attempted-user; sid:5208792; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"MITRE T1089 Disabling security tools - Defender disable via SMB command"; flow:established; content:"|FF S M B|"; depth:4; content:"Defender"; within:200; content:"disable"; within:100; classtype:trojan-activity; sid:5208793; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"MITRE T1562.001 Impair defenses - Windows Defender exclusion path added via SMB"; flow:established; content:"|FF S M B|"; depth:4; content:"Add-MpPreference"; within:200; content:"ExclusionPath"; within:100; classtype:trojan-activity; sid:5208794; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"MITRE T1562.006 Clearing Windows event log - wevtutil cl via SMB"; flow:established; content:"|FF S M B|"; depth:4; content:"wevtutil"; within:200; content:"cl"; within:50; classtype:trojan-activity; sid:5208795; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"MITRE T1070.004 File deletion - suspicious del command for log or evidence files"; flow:established; content:"|FF S M B|"; depth:4; content:"del"; within:100; content:".log"; within=100; content:"/f"; within:50; classtype:trojan-activity; sid:5208796; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"MITRE T1070.001 Clear event log - event log clearing followed by data exfiltration"; flow:established,to_server; content:"wevtutil"; depth:50; dsize:>10000; classtype:trojan-activity; sid:5208797; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"MITRE T1550.002 Pass the hash attack - NTLM auth with mismatched account name"; flow:established; content:"|FF S M B|"; depth:4; content:"NTLM"; within:100; pcre:"/NTLMv2 Response [A-Fa-f0-9]48/"; classtype:attempted-admin; sid:5208798; rev:1;)
alert tcp $HOME_NET any -> $HOME_NET 88 (msg:"MITRE T1550.003 Pass the ticket - Kerberos ticket with unusual source"; flow:established; content:"|60 37|"; depth:2; dsize:>1000; classtype:attempted-admin; sid:5208799; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"MITRE T1098.001 Additional cloud credentials - AWS access key creation via IAM"; flow:established,to_server; content:"iam.amazonaws.com"; http_host; content:"Action=CreateAccessKey"; http_uri; classtype:attempted-admin; sid:5208800; rev:1;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"MITRE T1213.002 SharePoint data exfiltration - mass document download pattern"; flow:established,to_server; content:"sharepoint.com"; http_host; content:"/sites/"; http_uri; dsize:>1000000; classtype:exfiltration; sid:5208801; rev:1;)
