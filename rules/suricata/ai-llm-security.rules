# =============================================================================
# Suricata Rules — AI/LLM Security
# Covers: prompt injection, model API abuse, data exfiltration via LLM,
#          jailbreak patterns, system prompt extraction, adversarial attacks
# Total rules: 55
# SID range: 2300001 - 2300055
# =============================================================================

# --- Prompt Injection (Direct) ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Direct Prompt Injection - Ignore Instructions"; flow:established,to_server; content:"ignore"; nocase:true; http_uri; content:"instruction"; nocase:true; http_uri; pcre:"/ignore\s+(all\s+)?previous\s+instruction/i"; classtype:web-application-attack; sid:2300001; rev:1; metadata:mitre_attack_tactic_id T1190, mitre_attack_technique_id T1190, created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Direct Prompt Injection - Disregard Constraints"; flow:established,to_server; content:"disregard"; nocase:true; http_client_body; content:"constraint"; nocase:true; http_client_body; pcre:"/disregard\s+(all\s+)?(safety|security|content)\s+(policy|guideline|constraint|rule)/i"; classtype:web-application-attack; sid:2300002; rev:1; metadata:mitre_attack_tactic_id T1190, created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Prompt Injection via System Role Override"; flow:established,to_server; content:"system"; nocase:true; http_client_body; content:"prompt"; nocase:true; http_client_body; pcre:"/\bsystem\b.*\bprompt\b.*\b(you\s+are|act\s+as|role)\b/i"; classtype:web-application-attack; sid:2300003; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - DAN Jailbreak Pattern"; flow:established,to_server; content:"DAN"; http_client_body; pcre:"/(do\s+anything\s+now|dan\s+mode|jailbreak)/i"; classtype:web-application-attack; sid:2300004; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Prompt Injection - Output Formatting Escape"; flow:established,to_server; pcre:"/(output|respond|reply)\s+(the\s+)?(following|above|next)\s*:?\s*\[.*\]/iU"; classtype:web-application-attack; sid:2300005; rev:1; metadata:created_at 2026-08-17;)

# --- Prompt Injection (Indirect) ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Indirect Prompt Injection via HTML/Markdown"; flow:established,to_server; pcre:"/<(img|a|iframe|script|svg)\s+[^>]*(alt|title|href|src)\s*=\s*\"[^\"]*ignore\s+previous/iU"; classtype:web-application-attack; sid:2300006; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Indirect Prompt Injection via Email Headers"; flow:established,to_server; content:"X-Prompt-Injection"; http_header; classtype:web-application-attack; sid:2300007; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Indirect Prompt Injection via URL Parameters"; flow:established,to_server; pcre:"/[?&](prompt|instruction|system_msg|context)=.*?(ignore|bypass|override|disregard)/i"; classtype:web-application-attack; sid:2300008; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Indirect Prompt Injection via Base64 Payload"; flow:established,to_server; pcre:"/data:text\/html;base64,[A-Za-z0-9+\/]{20,}/i"; classtype:web-application-attack; sid:2300009; rev:1; metadata:created_at 2026-08-17;)

# --- Jailbreak Patterns ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Jailbreak - Developer Mode Activation"; flow:established,to_server; pcre:"/(developer|dev|debug)\s*(mode|access|level|override)/i"; http_client_body; classtype:web-application-attack; sid:2300010; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Jailbreak - Character Role-Play Escape"; flow:established,to_server; pcre:"/(pretend|imagine|act\s+as|roleplay|role-play|you\s+are\s+now)\s+(you\s+are\s+)?(an?\s+)?(unfiltered|unrestricted|free|evil|malicious)/i"; http_client_body; classtype:web-application-attack; sid:2300011; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Jailbreak - Token Smuggling with Special Characters"; flow:established,to_server; pcre:"/[\x00-\x08\x0b\x0c\x0e-\x1f\x7f\uffff].*(?:ignore|bypass|override)/i"; http_client_body; classtype:web-application-attack; sid:2300012; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Jailbreak - Multi-Turn Context Manipulation"; flow:established,to_server; content:"remember"; nocase:true; http_client_body; content:"we"; nocase:true; http_client_body; content:"agreed"; nocase:true; http_client_body; pcre:"/remember\s+(that\s+)?we\s+(agreed|discussed|established)/i"; classtype:web-application-attack; sid:2300013; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Jailbreak - Adversarial Suffix Attack"; flow:established,to_server; pcre:"/[!@#$%^&*]{10,}/"; http_client_body; classtype:web-application-attack; sid:2300014; rev:1; metadata:created_at 2026-08-17;)

# --- System Prompt Extraction ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - System Prompt Extraction Attempt"; flow:established,to_server; pcre:"/(what|show|reveal|repeat|output|print|display)\s+(are\s+)?(your|the|this)\s+(system|initial|original|base|hidden)\s+(prompt|instruction|message|directive)/i"; http_client_body; classtype:web-application-attack; sid:2300015; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - System Prompt Extraction via Translation Trick"; flow:established,to_server; pcre:"/translate\s+(your|the)\s+(system|initial|original)\s+prompt\s+(to|into)\s+/i"; http_client_body; classtype:web-application-attack; sid:2300016; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - System Prompt Extraction via Base64 Request"; flow:established,to_server; pcre:"/(encode|base64|hex|rot13|reverse)\s+(your|the)\s+(system|initial|original|hidden)\s+prompt/i"; http_client_body; classtype:web-application-attack; sid:2300017; rev:1; metadata:created_at 2026-08-17;)

# --- Model API Abuse ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Unauthorized Model API Access - OpenAI"; flow:established,to_server; content:"/v1/chat/completions"; http_uri; content:"Authorization"; http_header; content:"Bearer sk-"; http_header; pcre:"/Bearer\s+sk-[a-zA-Z0-9]{20,}/"; classtype:web-application-attack; sid:2300018; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Unauthorized Model API Access - Anthropic"; flow:established,to_server; content:"/v1/messages"; http_uri; content:"x-api-key"; http_header; classtype:web-application-attack; sid:2300019; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - API Key Exposure in Request Body"; flow:established,to_server; pcre:"/\"(api[_-]?key|token|secret)\"\s*:\s*\"(sk-|key-|ak-|pk_)[a-zA-Z0-9_-]{20,}\"/i"; http_client_body; classtype:web-application-attack; sid:2300020; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Model Parameter Manipulation - Temperature Abuse"; flow:established,to_server; content:"/v1/chat/completions"; http_uri; pcre:"/\"temperature\"\s*:\s*(1[.][0-9]+|2\.[0-9]+)/i"; http_client_body; classtype:web-application-attack; sid:2300021; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Excessive Token Limit Request - DoS"; flow:established,to_server; content:"/v1/"; http_uri; pcre:"/\"max_tokens\"\s*:\s*[0-9]{5,}/i"; http_client_body; classtype:web-application-attack; sid:2300022; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Model Enumeration via API Version Fingerprinting"; flow:established,to_server; content:"/v1/models"; http_uri; classtype:web-application-attack; sid:2300023; rev:1; metadata:created_at 2026-08-17;)

# --- Data Exfiltration via LLM ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"AI/LLM Security - Data Exfiltration via LLM Response - PII Pattern"; flow:established,to_client; pcre:"/\b\d{3}[-.]?\d{2}[-.]?\d{4}\b|\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b|\b\d{3}[-]?\d{3}[-]?\d{4}\b/"; http_server_body; classtype:web-application-attack; sid:2300024; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Data Exfiltration via Prompt - Request Internal Docs"; flow:established,to_server; pcre:"/(list|show|give|extract|provide|output|reveal)\s+(all\s+)?(internal|confidential|private|secret|classified|sensitive)\s+(document|file|data|record|database|schema|config)/i"; http_client_body; classtype:web-application-attack; sid:2300025; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Training Data Extraction Attempt"; flow:established,to_server; pcre:"/repeat\s+(a\s+)?(word|token|phrase|sentence|paragraph)\s+(verbatim|exactly|word-for-word|character-for-character)/i"; http_client_body; classtype:web-application-attack; sid:2300026; rev:1; metadata:created_at 2026-08-17;)

# --- RAG and Embedding Attacks ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - RAG Pipeline Injection via Malicious Document Upload"; flow:established,to_server; content:"upload"; nocase:true; http_uri; content:"multipart/form-data"; http_header; pcre:"/(ignore|disregard|override)\s+(all\s+)?(previous|above|prior)\s+(instruction|prompt|context|rule)/i"; http_client_body; classtype:web-application-attack; sid:2300027; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Vector Database Query Injection"; flow:established,to_server; pcre:"/(query|search|find|similar)\s*\(.*\$(where|match|expr|function)/i"; http_client_body; classtype:web-application-attack; sid:2300028; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Embedding Poisoning - Anomalous Vector Dimensions"; flow:established,to_server; content:"embed"; nocase:true; http_uri; pcre:"/\[\s*-?(?:inf|nan|[0-9]+\.?[0-9]*[eE][+-]?[0-9]+)/i"; http_client_body; classtype:web-application-attack; sid:2300029; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Pinecone Namespace Isolation Bypass"; flow:established,to_server; content:"/vectors/query"; http_uri; pcre:"/\"namespace\"\s*:\s*null|\"namespace\"\s*:\s*\"\"/"; http_client_body; classtype:web-application-attack; sid:2300030; rev:1; metadata:created_at 2026-08-17;)

# --- LLM-Specific Attack Patterns ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Few-Shot Manipulation Attack"; flow:established,to_server; pcre:"/(example|input|output)\s*:\s*.*\n.*\n.*(example|input|output)\s*:\s*.*\n.*\n.*(example|input|output)/i"; http_client_body; classtype:web-application-attack; sid:2300031; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Chain-of-Thought Manipulation"; flow:established,to_server; pcre:"/(think|reason|step)\s+(step\s+)?(by\s+step|carefully|aloud|out\s+loud)/i"; http_client_body; pcre:"/(bypass|circumvent|evade|ignore|skip)/i"; http_client_body; classtype:web-application-attack; sid:2300032; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Model Context Overflow - Excessive Input Length"; flow:established,to_server; content:"/v1/chat/completions"; http_uri; dsize:>100000; classtype:web-application-attack; sid:2300033; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Prompt Injection via Translated Instruction"; flow:established,to_server; pcre:"/(translate|transliterate|convert)\s+(this|the\s+following)\s+(to|into)\s+\w+.*\n.*ignore/i"; http_client_body; classtype:web-application-attack; sid:2300034; rev:1; metadata:created_at 2026-08-17;)

# --- Model Output Abuse ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"AI/LLM Security - Harmful Content Generation Detected in Response"; flow:established,to_client; pcre:"/(how\s+to\s+(make|create|build|synthesize|manufacture)\s+(bomb|weapon|drug|poison|explosive)|step\s+by\s+step\s+(hack|exploit|attack|crack))/i"; http_server_body; classtype:web-application-attack; sid:2300035; rev:1; metadata:created_at 2026-08-17;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"AI/LLM Security - PII Leakage in Model Response - SSN Pattern"; flow:established,to_client; pcre:"/\b\d{3}-\d{2}-\d{4}\b/"; http_server_body; classtype:web-application-attack; sid:2300036; rev:1; metadata:created_at 2026-08-17;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"AI/LLM Security - PII Leakage in Model Response - Credit Card Pattern"; flow:established,to_client; pcre:"/\b\d{4}[-\s]?\d{4}[-\s]?\d{4}[-\s]?\d{4}\b/"; http_server_body; classtype:web-application-attack; sid:2300037; rev:1; metadata:created_at 2026-08-17;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"AI/LLM Security - API Key Leakage in Model Response"; flow:established,to_client; pcre:"/(sk-[a-zA-Z0-9]{20,}|AKIA[0-9A-Z]{16}|AIza[a-zA-Z0-9_-]{35})/"; http_server_body; classtype:web-application-attack; sid:2300038; rev:1; metadata:created_at 2026-08-17;)

# --- AI-Specific Infrastructure ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Unauthorized Access to AI Admin Panel"; flow:established,to_server; pcre:"/(\/admin|\/dashboard|\/console|\/manage)(\/.*?\.(ai|ml|model|llm|gpt|chat))/i"; http_uri; classtype:web-application-attack; sid:2300039; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - AI Model Endpoint Enumeration"; flow:established,to_server; pcre:"/\/(v1|v2|api)\/(models|engines|completions|embeddings|chat|images|audio|moderations)/i"; http_uri; classtype:web-application-attack; sid:2300040; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - HuggingFace Model Poisoning Attempt"; flow:established,to_server; content:"huggingface.co"; http_header; content:"upload"; nocase:true; http_uri; classtype:web-application-attack; sid:2300041; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Ollama API Unauthenticated Access"; flow:established,to_server; content:"/api/"; http_uri; content:"generate"; http_uri; classtype:web-application-attack; sid:2300042; rev:1; metadata:created_at 2026-08-17;)

# --- Agent and Tool Abuse ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - AI Agent Tool Abuse - Command Execution"; flow:established,to_server; pcre:"/(execute|run|call|invoke)\s+(command|shell|bash|powershell|cmd|terminal)/i"; http_client_body; classtype:web-application-attack; sid:2300043; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - AI Agent Tool Abuse - File System Access"; flow:established,to_server; pcre:"/(read|write|delete|modify|access|open)\s+(file|\/etc\/|\/var\/|\/home\/|c:\\|\.env)/i"; http_client_body; classtype:web-application-attack; sid:2300044; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - AI Agent Tool Abuse - Network Access Request"; flow:established,to_server; pcre:"/(fetch|request|get|post|curl|wget|http)\s+(https?:\/\/|url)/i"; http_client_body; pcre:"/(internal|private|localhost|127\.0\.0|10\.\d|172\.(1[6-9]|2\d|3[01])|192\.168)/i"; http_client_body; classtype:web-application-attack; sid:2300045; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - AI Agent SSRF via Tool Use"; flow:established,to_server; pcre:"/(tool|function|action)\s*:\s*(web_search|http_request|fetch|url_get|browse)/i"; http_client_body; pcre:"/(169\.254|metadata|internal|admin|localhost)/i"; http_client_body; classtype:web-application-attack; sid:2300046; rev:1; metadata:created_at 2026-08-17;)

# --- Bias and Safety ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"AI/LLM Security - Safety Filter Bypass Attempt - Encoding Tricks"; flow:established,to_server; pcre:"/(\\u[0-9a-fA-F]{4}|\\x[0-9a-fA-F]{2}|&#x?[0-9a-fA-F]+;).*(?:bomb|kill|hack|exploit|steal)/i"; http_client_body; classtype:web-application-attack; sid:2300047; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Prompt Injection via Markdown Link Obfuscation"; flow:established,to_server; pcre:"/\[.*\]\(.*(?:ignore|bypass|override|disregard).*(?:instruction|safety|policy|constraint).*\)/iU"; http_client_body; classtype:web-application-attack; sid:2300048; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Multi-Modal Injection via Image Metadata"; flow:established,to_server; content:"multipart/form-data"; http_header; content:"Content-Type"; http_header; content:"image/"; http_header; pcre:"/(ignore|bypass|override)\s+(previous|all|safety)\s+(instruction|prompt|rule)/i"; http_client_body; classtype:web-application-attack; sid:2300049; rev:1; metadata:created_at 2026-08-17;)

# --- Governance and Compliance ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - GDPR Right-to-Erasure Bypass via LLM Cache"; flow:established,to_server; content:"/v1/chat/completions"; http_uri; pcre:"/\"(cache|caching)\"\s*:\s*true/i"; http_client_body; classtype:web-application-attack; sid:2300050; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - AI Decision Audit Log Missing - No X-AI-Decision Header"; flow:established,to_client; content:"200"; http_stat_code; content:! "X-AI-Decision"; http_header; pcre:"/(approved|denied|recommendation|score|risk)/i"; http_server_body; classtype:web-application-attack; sid:2300051; rev:1; metadata:created_at 2026-08-17;)

# --- Emerging Attack Patterns ---
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Prompt Injection via JSON Schema Manipulation"; flow:established,to_server; pcre:"/\"(system|developer|instruction)\"\s*:\s*\"/i"; http_client_body; pcre:"/(ignore|bypass|override|disregard)\s+(previous|all|safety)/i"; http_client_body; classtype:web-application-attack; sid:2300052; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Model Steganography Attempt - Hidden Instruction in Output"; flow:established,to_server; pcre:"/(encode|hide|embed|conceal|steganograph)\s+(instruction|message|command)\s+(in|into|within|inside)/i"; http_client_body; classtype:web-application-attack; sid:2300053; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - LLM-as-Judge Manipulation"; flow:established,to_server; pcre:"/(rate|score|judge|evaluate|assess)\s+(this|the\s+above|the\s+following)\s+as\s+(safe|harmless|not\s+harmful|benign)/i"; http_client_body; classtype:web-application-attack; sid:2300054; rev:1; metadata:created_at 2026-08-17;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"AI/LLM Security - Autonomous Agent Loop Exploit - Excessive Tool Calls"; flow:established,to_server; content:"/v1/chat/completions"; http_uri; pcre:"/\"tool_calls\"\s*:\s*\[[^\]]{5000,}/i"; http_client_body; classtype:web-application-attack; sid:2300055; rev:1; metadata:created_at 2026-08-17;)