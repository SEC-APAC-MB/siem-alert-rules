  <rule id="WZ-ADV-015" level="10" group="advanced,jwt">
    <description>JWT algorithm confusion — RS256 token verified with HS256 using public key</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-09-15</field>
    <field name="zap_rules">40036</field>
    <field name="category">advanced</field>
