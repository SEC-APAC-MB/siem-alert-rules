  <!-- Advanced database-specific rules -->
  <rule id="WZ-ADV-020" level="12" group="advanced,nosql_injection">
    <description>NoSQL injection — MongoDB query manipulation via operator injection</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-09-20</field>
    <field name="zap_rules">40028</field>
    <field name="category">advanced</field>
