  Rule ID format: WZ-CAT-NUM (CAT: ADV, API, MOB)
-->
<group name="wazuh,wstg,advanced,api_security,mobile_security">

  <!-- ============================================================ -->
  <!-- WSTG-ADV: Advanced Testing (Server-Side, Race Conditions, etc.) -->
  <!-- ============================================================ -->

  <rule id="WZ-ADV-001" level="12" group="advanced,race_condition">
    <description>Race condition — concurrent requests exploiting timing vulnerabilities</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-09-01</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1129</id>
      <tactic>Execution</tactic>
      <technique>Shared Modules</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
      <nist_800_53>SI-10</nist_800_53>
    </compliance>
    <match>/transfer|/withdraw|/checkout|/apply|/redeem</match>
  </rule>

  <rule id="WZ-ADV-002" level="12" group="advanced,ssrf">
    <description>Server-Side Request Forgery via advanced chaining — SSRF to internal service pivot</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-09-02</field>
    <field name="zap_rules">40046,90034</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1190</id>
      <tactic>Initial Access</tactic>
      <technique>Exploit Public-Facing Application</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
      <nist_800_53>SI-10</nist_800_53>
    </compliance>
    <regex>url=http://(127\.0\.0\.1|localhost|169\.254\.169\.254|10\.\d+|172\.(1[6-9]|2\d|3[01])|192\.168\.\d+)</regex>
  </rule>

  <rule id="WZ-ADV-003" level="12" group="advanced,xxe">
    <description>XML External Entity injection — external entity processing revealing internal data</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-09-03</field>
    <field name="zap_rules">90023</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1190</id>
      <tactic>Initial Access</tactic>
      <technique>Exploit Public-Facing Application</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
      <nist_800_53>SI-10</nist_800_53>
    </compliance>
    <regex>&lt;!DOCTYPE.*\[.*&lt;!ENTITY.*SYSTEM|&lt;!ENTITY.*PUBLIC|ENTITY.*file://|ENTITY.*http://</regex>
  </rule>

  <rule id="WZ-ADV-004" level="12" group="advanced,deserialization">
    <description>Advanced insecure deserialization — RCE via crafted serialized object chain</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-09-04</field>
    <field name="zap_rules">90001,90002,40044</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1190</id>
      <tactic>Initial Access</tactic>
      <technique>Exploit Public-Facing Application</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
    </compliance>
    <regex>rO0AB|aced0005|O:\d+:"|java\.lang\.Runtime|ProcessBuilder|__wakeup|unserialize\(|\.readObject\(</regex>
  </rule>

  <rule id="WZ-ADV-005" level="10" group="advanced,idor">
    <description>Advanced IDOR — bulk data extraction via sequential resource access</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-09-05</field>
    <field name="zap_rules">10057,40008</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1078</id>
      <tactic>Persistence</tactic>
      <technique>Valid Accounts</technique>
    </mitre>
    <compliance>
      <gdpr>Art.32</gdpr>
      <pci_dss>6.5</pci_dss>
      <nist_800_53>AC-4</nist_800_53>
    </compliance>
    <regex>/api/v\d+/users/\d+/profile|/api/v\d+/records/\d+|/documents/[0-9a-f-]{36}</regex>
  </rule>

  <rule id="WZ-ADV-006" level="10" group="advanced,graphql">
    <description>GraphQL query depth attack — deep nested queries causing resource exhaustion</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-09-06</field>
    <field name="zap_rules">40008</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1190</id>
      <tactic>Initial Access</tactic>
      <technique>Exploit Public-Facing Application</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
    </compliance>
    <regex>\{[^}]*\{[^}]*\{[^}]*\{|query\s*\{.*__schema|introspection.*query</regex>
  </rule>

  <rule id="WZ-ADV-007" level="12" group="advanced,api_key_exposure">
    <description>API key exposure in client-side code — secret keys accessible in JavaScript bundles</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-09-07</field>
    <field name="zap_rules">10010</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1552.001</id>
      <tactic>Credential Access</tactic>
      <technique>Credentials in Files</technique>
    </mitre>
    <compliance>
      <gdpr>Art.32</gdpr>
      <pci_dss>8.6</pci_dss>
      <nist_800_53>IA-5</nist_800_53>
    </compliance>
    <regex>api[_-]?key\s*[:=]\s*["'][a-zA-Z0-9]{20,}|secret[_-]?key\s*[:=]|AKIA[0-9A-Z]{16}</regex>
  </rule>

  <rule id="WZ-ADV-008" level="10" group="advanced,rate_limiting">
    <description>Rate limiting bypass — API abuse without throttling detected</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-09-08</field>
    <field name="zap_rules">40008</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1110</id>
      <tactic>Credential Access</tactic>
      <technique>Brute Force</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
      <nist_800_53>SC-5</nist_800_53>
    </compliance>
    <match>429.*Too Many Requests|rate.*limit.*exceeded|X-RateLimit-Remaining:\s*0</match>
  </rule>

  <rule id="WZ-ADV-009" level="12" group="advanced,web_cache">
    <description>Web cache poisoning — cache key manipulation serving malicious content</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-09-09</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1189</id>
      <tactic>Initial Access</tactic>
      <technique>Drive-by Compromise</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
    </compliance>
    <regex>X-Cache:\s*HIT|Vary:\s*[^\n]*[;&amp;].*script|Cache-Control.*public</regex>
  </rule>

  <rule id="WZ-ADV-010" level="12" group="advanced,http_desync">
    <description>HTTP desync attack — request smuggling via ambiguous HTTP parsing</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-09-10</field>
    <field name="zap_rules">40003</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1190</id>
      <tactic>Initial Access</tactic>
      <technique>Exploit Public-Facing Application</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
    </compliance>
    <regex>Transfer-Encoding:\s*chunked[\r\n]+Content-Length:|CL\.TE|TE\.CL|Content-Length:\s*\d+.*Transfer-Encoding:\s*chunked</regex>
  </rule>

  <rule id="WZ-ADV-011" level="10" group="advanced,cors">
    <description>Advanced CORS exploitation — origin reflection allowing credential theft</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-09-11</field>
    <field name="zap_rules">40026</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1189</id>
      <tactic>Initial Access</tactic>
      <technique>Drive-by Compromise</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
    </compliance>
    <regex>Access-Control-Allow-Origin:.*evil\.com|Access-Control-Allow-Credentials: true.*Origin: .*</regex>
  </rule>

  <rule id="WZ-ADV-012" level="10" group="advanced,websocket">
