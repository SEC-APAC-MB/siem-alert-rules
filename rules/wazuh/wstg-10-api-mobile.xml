  <!-- ============================================================ -->
  <!-- Mobile Security Rules (OWASP Mobile) -->
  <!-- ============================================================ -->

  <rule id="WZ-MOB-001" level="8" group="mobile,architecture">
    <description>Mobile app architecture — insecure data storage or IPC mechanism exposure</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">MOB-ARCH-001</field>
    <field name="category">mobile</field>
    <mitre>
      <id>T1078</id>
      <tactic>Persistence</tactic>
      <technique>Valid Accounts</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
      <nist_800_53>SC-8</nist_800_53>
    </compliance>
    <match>SharedPreferences|Keychain|UserDefaults|ContentProvider</match>
  </rule>

  <rule id="WZ-MOB-002" level="10" group="mobile,data_storage">
    <description>Mobile insecure data storage — sensitive data stored in plaintext on device</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">MOB-ARCH-002</field>
    <field name="category">mobile</field>
    <mitre>
      <id>T1552</id>
      <tactic>Credential Access</tactic>
      <technique>Credentials in Files</technique>
    </mitre>
    <compliance>
      <gdpr>Art.32</gdpr>
      <pci_dss>3.4</pci_dss>
      <nist_800_53>SC-8</nist_800_53>
    </compliance>
    <regex>/data/data/.*\.xml|/data/data/.*\.db|NSUserDefaults|SharedPreferences.*MODE_WORLD_READABLE</regex>
  </rule>

  <rule id="WZ-MOB-003" level="12" group="mobile,credential_exposure">
    <description>Mobile hardcoded credentials — API keys or passwords embedded in app binary</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">MOB-ARCH-003</field>
    <field name="zap_rules">10010</field>
    <field name="category">mobile</field>
    <mitre>
      <id>T1552.001</id>
      <tactic>Credential Access</tactic>
      <technique>Credentials in Files</technique>
    </mitre>
    <compliance>
      <gdpr>Art.32</gdpr>
      <pci_dss>8.6</pci_dss>
    </compliance>
    <regex>API_KEY\s*=\s*["'][a-zA-Z0-9]{16,}|SECRET\s*=\s*["'][a-zA-Z0-9]{16,}|password\s*=\s*["']</regex>
  </rule>

  <rule id="WZ-MOB-004" level="8" group="mobile,cryptography">
    <description>Mobile insecure cryptography — weak encryption algorithm or key management</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">MOB-ARCH-004</field>
    <field name="category">mobile</field>
    <mitre>
      <id>T1600</id>
      <tactic>Credential Access</tactic>
      <technique>Weaken Encryption</technique>
    </mitre>
    <compliance>
      <pci_dss>4.1</pci_dss>
      <nist_800_53>SC-13</nist_800_53>
    </compliance>
    <regex>AES/ECB/|DES/ECB/|RSA/ECB/|RC4|MD5.*encrypt|SHA1.*encrypt</regex>
  </rule>

  <rule id="WZ-MOB-005" level="10" group="mobile,network">
    <description>Mobile insecure network communication — cleartext traffic or missing certificate pinning</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">MOB-ARCH-005</field>
    <field name="zap_rules">10106</field>
    <field name="category">mobile</field>
    <mitre>
      <id>T1040</id>
      <tactic>Credential Access</tactic>
      <technique>Network Sniffing</technique>
    </mitre>
    <compliance>
      <pci_dss>4.1</pci_dss>
      <nist_800_53>SC-8</nist_800_53>
    </compliance>
    <match>usesCleartextTraffic.*true|NSAllowsArbitraryLoads.*true|android:usesCleartextTraffic</match>
  </rule>

  <rule id="WZ-MOB-010" level="10" group="mobile,authentication">
    <description>Mobile authentication bypass — local auth bypass or biometric spoofing</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">MOB-AUTH-001</field>
    <field name="category">mobile</field>
    <mitre>
      <id>T1078</id>
      <tactic>Persistence</tactic>
      <technique>Valid Accounts</technique>
    </mitre>
    <compliance>
      <pci_dss>8.3</pci_dss>
      <nist_800_53>IA-2</nist_800_53>
    </compliance>
    <match>isDeviceSecure.*false|biometric.*bypass|BiometricPrompt.*ERROR|local_auth.*skip</match>
  </rule>

  <rule id="WZ-MOB-015" level="10" group="mobile,deeplink">
    <description>Mobile deep link hijacking — URL scheme or universal link exploited for data theft</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">MOB-AUTH-005</field>
    <field name="category">mobile</field>
    <mitre>
      <id>T1189</id>
      <tactic>Initial Access</tactic>
      <technique>Drive-by Compromise</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
    </compliance>
    <regex>intent://|scheme://|android:scheme=|universalLinks</regex>
  </rule>

  <rule id="WZ-MOB-020" level="8" group="mobile,intent">
    <description>Mobile intent hijacking — Android intent or iOS URL scheme interception</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">MOB-AUTH-010</field>
    <field name="category">mobile</field>
    <mitre>
      <id>T1189</id>
      <tactic>Initial Access</tactic>
      <technique>Drive-by Compromise</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
    </compliance>
    <match>android.intent.action|startActivity|openURL.*scheme|handleOpenURL</match>
  </rule>

  <rule id="WZ-MOB-025" level="8" group="mobile,certificate_pinning">
    <description>Mobile missing certificate pinning — TLS connections without pinned certificates</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">MOB-ARCH-010</field>
    <field name="zap_rules">10205</field>
    <field name="category">mobile</field>
    <mitre>
      <id>T1040</id>
      <tactic>Credential Access</tactic>
      <technique>Network Sniffing</technique>
    </mitre>
    <compliance>
      <pci_dss>4.1</pci_dss>
      <nist_800_53>SC-8</nist_800_53>
    </compliance>
    <match>certificatePinner|SSLPinning.*disabled|allowsAnyCertificate|trustAllCerts</match>
  </rule>

  <rule id="WZ-MOB-030" level="10" group="mobile,clipboard">
    <description>Mobile clipboard data exposure — sensitive data copied to system clipboard</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">MOB-ARCH-015</field>
    <field name="category">mobile</field>
    <mitre>
      <id>T1078</id>
      <tactic>Persistence</tactic>
      <technique>Valid Accounts</technique>
    </mitre>
    <compliance>
      <gdpr>Art.32</gdpr>
    </compliance>
    <match>ClipboardManager|UIPasteboard|setPrimaryClip|setText.*password</match>
  </rule>

  <rule id="WZ-MOB-035" level="10" group="mobile,screenshot">
    <description>Mobile screenshot/screen recording exposure — sensitive content captureable</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">MOB-ARCH-020</field>
    <field name="category">mobile</field>
    <mitre>
      <id>T1113</id>
      <tactic>Collection</tactic>
      <technique>Screen Capture</technique>
    </mitre>
    <compliance>
      <gdpr>Art.32</gdpr>
      <pci_dss>6.5</pci_dss>
    </compliance>
    <match>FLAG_SECURE|screenshot.*allowed|screenCapture.*enabled|isScreenCaptureAllowed</match>
