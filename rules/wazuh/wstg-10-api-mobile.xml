    </compliance>
    <regex>"stack":|"traceback":|"exception":|sqlstate|ORA-\d{5}|PostgreSQL.*ERROR</regex>
  </rule>

  <rule id="WZ-API-015" level="8" group="api_security,mass_assignment">
