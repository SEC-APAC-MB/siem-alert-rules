  <rule id="WZ-MOB-055" level="8" group="mobile,logging">
    <description>Mobile excessive logging — sensitive data written to system logs</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">MOB-ARCH-030</field>
    <field name="category">mobile</field>
    <mitre>
      <id>T1552</id>
      <tactic>Credential Access</tactic>
