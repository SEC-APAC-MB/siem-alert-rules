  <!-- Advanced database-specific rules for server-side -->
  <rule id="WZ-ADV-030" level="12" group="advanced,database,sql_injection">
    <description>Oracle UTL_HTTP out-of-band data exfiltration — database data sent to external server</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-INPV-47</field>
    <field name="zap_rules">40018</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1048</id>
      <tactic>Exfiltration</tactic>
      <technique>Exfiltration Over Alternative Protocol</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
    </compliance>
    <regex>UTL_HTTP|DBMS_LDAP|UTL_TCP|HTTPURITYPE|UTL_HTTP\.REQUEST</regex>
  </rule>

  <rule id="WZ-ADV-031" level="12" group="advanced,database,nosql_injection">
    <description>MongoDB NoSQL injection — operator injection for authentication bypass and data extraction</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-INPV-60</field>
    <field name="zap_rules">40028</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1190</id>
      <tactic>Initial Access</tactic>
      <technique>Exploit Public-Facing Application</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
    </compliance>
    <regex>\$where.*function|{"\$regex":\s*"\/.*\/"}|{"\$gt":\s*""}|{"\$ne":\s*1}|{"\$exists":\s*true}</regex>
  </rule>

  <rule id="WZ-ADV-032" level="10" group="advanced,database,cassandra">
    <description>Cassandra CQL injection — CQL query manipulation for data extraction</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-ATHZ-60</field>
    <field name="zap_rules">40028</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1190</id>
      <tactic>Initial Access</tactic>
      <technique>Exploit Public-Facing Application</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
    </compliance>
    <regex>ALLOW FILTERING;.*--|cqlsh&gt;|SELECT.*FROM.*WHERE.*ALLOW FILTERING</regex>
  </rule>

  <rule id="WZ-ADV-033" level="10" group="advanced,database,neo4j">
    <description>Neo4j Cypher injection — graph query manipulation for data extraction</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-ATHZ-55</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1190</id>
      <tactic>Initial Access</tactic>
      <technique>Exploit Public-Facing Application</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
    </compliance>
    <regex>MATCH.*WHERE.*OR\s+1=1|UNWIND.*CREATE|CALL\s*\{.*\}|LOAD CSV FROM</regex>
  </rule>

  <rule id="WZ-ADV-034" level="10" group="advanced,database,redis">
    <description>Redis Lua script injection — sandbox escape via EVAL command</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-ATHZ-58</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1190</id>
      <tactic>Initial Access</tactic>
      <technique>Exploit Public-Facing Application</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
    </compliance>
    <regex>EVAL\s+.*redis\.call|redis\.script|LUA.*script|CONFIG SET dir|CONFIG SET dbfilename</regex>
  </rule>

  <rule id="WZ-ADV-035" level="10" group="advanced,database,influxdb">
    <description>InfluxDB Flux injection — time-series query manipulation for data extraction</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-ATHZ-56</field>
    <field name="category">advanced</field>
    <mitre>
      <id>T1190</id>
      <tactic>Initial Access</tactic>
      <technique>Exploit Public-Facing Application</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
    </compliance>
    <regex>from\(bucket:.*\)\s*\|&gt;\s*range|flux.*injection|influxdb.*query.*from\(</regex>
  </rule>

