    </compliance>
    <regex>[?&amp;](token|api_key|access_token|secret)=[a-zA-Z0-9_-]+</regex>
  </rule>

  <rule id="WZ-API-014" level="10" group="api_security,data_exposure">
    <description>API verbose error response — internal details leaked in error messages</description>
    <decoded_as>api_log</decoded_as>
