    <field name="zap_rules">6,7,40032,40034,40035</field>
    <field name="category">authorization</field>
    <mitre>
      <id>T1083</id>
      <tactic>Discovery</tactic>
      <technique>File and Directory Discovery</technique>
    </mitre>
    <compliance>
      <pci_dss>6.5</pci_dss>
      <nist_800_53>AC-4</nist_800_53>
    </compliance>
    <regex>\.\./|\.\.\\|%2e%2e%2f|%2e%2e/|\.\.%2f|%2e%2e%5c</regex>
  </rule>

