  <rule id="WZ-ATHN-015" level="12" group="authentication,database,credential_exposure">
    <description>Credential data at rest — weak password hashing algorithm detected</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-ATHN-15</field>
    <field name="category">authentication</field>
    <mitre>
      <id>T1552</id>
      <tactic>Credential Access</tactic>
      <technique>Credentials in Files</technique>
    </mitre>
    <compliance>
      <pci_dss>8.6</pci_dss>
      <nist_800_53>IA-5</nist_800_53>
      <hipaa>§164.312(a)(1)</hipaa>
      <dora>Art.10</dora>
    </compliance>
    <regex>md5\$|sha1\$|sha256\$.*rounds=1\b|password.*hash.*md5|password.*hash.*sha1</regex>
  </rule>

