  <!-- WSTG-ATHN: Authentication Testing -->
  <!-- ============================================================ -->

  <rule id="WZ-ATHN-001" level="8" group="authentication,encryption">
    <description>Credentials transmitted over unencrypted channel — HTTP login without TLS detected</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-ATHN-01</field>
    <field name="zap_rules">10106,10035,10040</field>
    <field name="category">authentication</field>
    <mitre>
      <id>T1040</id>
      <tactic>Credential Access</tactic>
      <technique>Network Sniffing</technique>
    </mitre>
    <compliance>
      <pci_dss>4.1</pci_dss>
      <nist_800_53>SC-8</nist_800_53>
      <hipaa>§164.312(e)(1)</hipaa>
    </compliance>
    <match>password=|passwd=|login=|username=|credential=</match>
  </rule>

  <rule id="WZ-ATHN-002" level="12" group="authentication,default_credentials">
    <description>Default credentials detected — factory/default password authentication attempt</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">WSTG-ATHN-02</field>
    <field name="category">authentication</field>
    <mitre>
      <id>T1078.001</id>
      <tactic>Persistence</tactic>
      <technique>Valid Accounts — Default Accounts</technique>
    </mitre>
    <compliance>
      <pci_dss>8.6</pci_dss>
      <nist_800_53>IA-5</nist_800_53>
      <hipaa>§164.312(d)</hipaa>
      <nis2>Art.21(2)(e)</nis2>
    </compliance>
    <regex>admin:admin|root:root|admin:password|admin:12345|tomcat:tomcat|test:test</regex>
  </rule>

  <rule id="WZ-ATHN-003" level="7" group="authentication,lockout">
