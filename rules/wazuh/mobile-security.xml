<group name="wazuh,mobile,security">

  <rule id="WZ-MOB001" level="7" group="mobile,data-storage,masvs">
    <description>Mobile — Insecure Data Storage on Device — Detects mobile app data storage issues including unencrypted SQLite databases an</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">MOB-001</field>
    <mitre>
      <id>T1552.001</id>
    </mitre>
    <compliance>
      <gdpr>GDPR-32A</gdpr>
    </compliance>
    <match>data-storage|masvs</match>
  </rule>

  <rule id="WZ-MOB002" level="7" group="mobile,network,masvs">
    <description>Mobile — Insecure Network Communication — Detects mobile apps communicating over HTTP, using weak TLS, or accepting self-s</description>
    <decoded_as>web_log</decoded_as>
    <field name="test_id">MOB-002</field>
    <mitre>
      <id>T1041</id>
    </mitre>
    <compliance>
      <pci_dss>4.1</pci_dss>
    </compliance>
    <match>network|masvs</match>
  </rule>

  <rule id="WZ-MOB003" level="9" group="mobile,authentication,hardcoded">
