    {
      "rule_id": "AWS-API-001",
      "name": "API1: Broken Object Level Authorization (BOLA)",
      "description": "Detects sequential or unauthorized access to API objects by ID indicating broken object-level authorization",
      "severity": "critical",
      "category": "general",
      "mitre_attack": [
        "T1078"
      ],
      "compliance": [],
      "source": [
        "aws.cloudtrail"
      ],
      "detection": {
        "query_type": "cloudwatch_metric_filter",
        "filter_pattern": "{ ($.eventName = \"ConsoleLogin\") && ($.responseElements.ConsoleLogin = \"Success\") && ($.sourceIPAddress != \"10.*\") }",
        "log_group": "/aws/cloudtrail",
        "metric_namespace": "Security/Monitoring",
        "metric_name": "API1BrokenObjectLevelAuthorizationBOLA",
        "threshold": 3,
        "evaluation_periods": 1,
        "statistic": "Sum",
        "period": 300
      },
      "eventbridge": {
        "pattern": {
          "source": [
            "aws.security",
            "aws.guardduty"
          ],
          "detail-type": [
            "AWS API Call via CloudTrail",
            "GuardDuty Finding"
          ],
          "detail": {
            "eventName": [
              "API1: Broken Object Level Authorization (BOLA)"
            ]
          }
        },
        "state": "ENABLED"
      },
      "actions": [
        {
          "type": "SNS",
          "description": "Send alert to security team SNS topic"
        }
      ],
      "tags": [
        "api",
        "bola",
        "idor",
        "authorization"
      ]
    },
