[
  {
    "rule_id": "AWS-PERSISTENCE-147",
    "name": "Registry Run Key Modification",
    "description": "Detect modification of HKLM/HKCU Run/RunOnce keys",
    "severity": "high",
    "category": "persistence",
    "mitre_attack": [],
    "compliance": [],
    "source": "pentest",
    "detection": {
      "query_type": "cloudwatch_metric_filter",
      "filter_pattern": "{ ($.eventName = \"*\") }",
      "log_group": "/aws/cloudtrail",
      "metric_namespace": "Security/Monitoring",
      "metric_name": "RegistryRunKeyModification",
      "threshold": 5,
      "evaluation_periods": 1,
      "statistic": "Sum",
      "period": 300
    },
    "actions": [
      {
        "type": "SNS",
        "description": "Send alert to security team SNS topic"
      },
      {
        "type": "Lambda",
        "description": "Trigger automated remediation Lambda function"
      }
    ],
    "tags": [
      "persistence"
    ]
  },
