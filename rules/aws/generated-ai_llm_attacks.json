[
  {
    "rule_id": "AWS-AI_LLM_ATTACKS-041",
    "name": "Direct Prompt Injection",
    "description": "Detection rules for AI-specific attacks: prompt injection, model manipulation, data exfiltration, training data extraction",
    "severity": "critical",
    "category": "ai_llm_attacks",
    "mitre_attack": [],
    "compliance": [],
    "source": "emerging",
    "detection": {
      "query_type": "cloudwatch_metric_filter",
      "filter_pattern": "{ ($.eventName = \"*\") }",
      "log_group": "/aws/cloudtrail",
      "metric_namespace": "Security/Monitoring",
      "metric_name": "DirectPromptInjection",
      "threshold": 5,
      "evaluation_periods": 1,
      "statistic": "Sum",
      "period": 300
    },
    "actions": [
      {
        "type": "SNS",
        "description": "Send alert to security team SNS topic"
      },
      {
        "type": "Lambda",
        "description": "Trigger automated remediation Lambda function"
      }
    ],
    "tags": [
      "ai_llm_attacks"
    ]
  },
