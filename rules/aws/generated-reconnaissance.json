[
  {
    "rule_id": "AWS-RECONNAISSANCE-117",
    "name": "Active Directory Domain Enumeration",
    "description": "Detect AD enumeration via LDAP queries, DSQuery, BloodHound collection",
    "severity": "medium",
    "category": "reconnaissance",
    "mitre_attack": [],
    "compliance": [],
    "source": "pentest",
    "detection": {
      "query_type": "cloudwatch_metric_filter",
      "filter_pattern": "{ ($.eventName = \"*\") }",
      "log_group": "/aws/cloudtrail",
      "metric_namespace": "Security/Monitoring",
      "metric_name": "ActiveDirectoryDomainEnumeration",
      "threshold": 5,
      "evaluation_periods": 1,
      "statistic": "Sum",
      "period": 300
    },
    "actions": [
      {
        "type": "SNS",
        "description": "Send alert to security team SNS topic"
      },
      {
        "type": "Lambda",
        "description": "Trigger automated remediation Lambda function"
      }
    ],
    "tags": [
      "reconnaissance"
    ]
  },
