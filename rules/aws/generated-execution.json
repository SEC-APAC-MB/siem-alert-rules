[
  {
    "rule_id": "AWS-EXECUTION-137",
    "name": "PowerShell Suspicious Execution",
    "description": "Detect encoded PowerShell, -bypass, hidden window, and download cradle patterns",
    "severity": "critical",
    "category": "execution",
    "mitre_attack": [],
    "compliance": [],
    "source": "pentest",
    "detection": {
      "query_type": "cloudwatch_metric_filter",
      "filter_pattern": "{ ($.eventName = \"*\") }",
      "log_group": "/aws/cloudtrail",
      "metric_namespace": "Security/Monitoring",
      "metric_name": "PowerShellSuspiciousExecution",
      "threshold": 5,
      "evaluation_periods": 1,
      "statistic": "Sum",
      "period": 300
    },
    "actions": [
      {
        "type": "SNS",
        "description": "Send alert to security team SNS topic"
      },
      {
        "type": "Lambda",
        "description": "Trigger automated remediation Lambda function"
      }
    ],
    "tags": [
      "execution"
    ]
  },
