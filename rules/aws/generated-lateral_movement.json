[
  {
    "rule_id": "AWS-LATERAL_MOVEMENT-167",
    "name": "Pass-the-Hash Detection",
    "description": "Detect NTLM hash-based authentication without password",
    "severity": "critical",
    "category": "lateral_movement",
    "mitre_attack": [],
    "compliance": [],
    "source": "pentest",
    "detection": {
      "query_type": "cloudwatch_metric_filter",
      "filter_pattern": "{ ($.eventName = \"*\") }",
      "log_group": "/aws/cloudtrail",
      "metric_namespace": "Security/Monitoring",
      "metric_name": "Pass-the-HashDetection",
      "threshold": 5,
      "evaluation_periods": 1,
      "statistic": "Sum",
      "period": 300
    },
    "actions": [
      {
        "type": "SNS",
        "description": "Send alert to security team SNS topic"
      },
      {
        "type": "Lambda",
        "description": "Trigger automated remediation Lambda function"
      }
    ],
    "tags": [
      "lateral_movement"
    ]
  },
