[
  {
    "rule_id": "AWS-SUPPLY_CHAIN-057",
    "name": "Dependency Confusion Attack",
    "description": "Detection rules for software supply chain attacks: dependency confusion, typosquatting, compromised packages",
    "severity": "critical",
    "category": "supply_chain",
    "mitre_attack": [],
    "compliance": [],
    "source": "emerging",
    "detection": {
      "query_type": "cloudwatch_metric_filter",
      "filter_pattern": "{ ($.eventName = \"*\") }",
      "log_group": "/aws/cloudtrail",
      "metric_namespace": "Security/Monitoring",
      "metric_name": "DependencyConfusionAttack",
      "threshold": 5,
      "evaluation_periods": 1,
      "statistic": "Sum",
      "period": 300
    },
    "actions": [
      {
        "type": "SNS",
        "description": "Send alert to security team SNS topic"
      },
      {
        "type": "Lambda",
        "description": "Trigger automated remediation Lambda function"
      }
    ],
    "tags": [
      "supply_chain"
    ]
  },
