      "severity": "critical",
      "category": "general",
      "mitre_attack": [
        "T1040",
        "T1567"
      ],
      "compliance": [],
      "source": [
        "aws.cloudtrail"
      ],
      "detection": {
        "query_type": "cloudwatch_metric_filter",
        "filter_pattern": "{ ($.eventName = \"*\") && ($.sourceIPAddress != \"10.*\") && ($.requestParameters.* \"pci-dss\") }",
        "log_group": "/aws/cloudtrail",
        "metric_namespace": "Security/Monitoring",
        "metric_name": "PCIDSSUnencryptedCardholderDataTransmission",
        "threshold": 3,
        "evaluation_periods": 1,
        "statistic": "Sum",
        "period": 300
      },
      "eventbridge": {
        "pattern": {
          "source": [
            "aws.security",
            "aws.guardduty"
          ],
          "detail-type": [
            "AWS API Call via CloudTrail",
            "GuardDuty Finding"
          ],
          "detail": {
            "eventName": [
              "PCI-DSS \u2014 Unencrypted Cardholder Data Transmission"
            ]
          }
        },
        "state": "ENABLED"
      },
      "actions": [
        {
          "type": "SNS",
          "description": "Send alert to security team SNS topic"
        }
      ],
      "tags": [
