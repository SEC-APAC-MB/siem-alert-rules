[
  {
    "rule_id": "AWS-CLOUD_NATIVE-067",
    "name": "Container Escape via Privileged Pod",
    "description": "Kubernetes, container, serverless, and cloud-specific attack detection",
    "severity": "critical",
    "category": "cloud_native",
    "mitre_attack": [],
    "compliance": [],
    "source": "emerging",
    "detection": {
      "query_type": "cloudwatch_metric_filter",
      "filter_pattern": "{ ($.eventName = \"*\") }",
      "log_group": "/aws/cloudtrail",
      "metric_namespace": "Security/Monitoring",
      "metric_name": "ContainerEscapeviaPrivilegedPod",
      "threshold": 5,
      "evaluation_periods": 1,
      "statistic": "Sum",
      "period": 300
    },
    "actions": [
      {
        "type": "SNS",
        "description": "Send alert to security team SNS topic"
      },
      {
        "type": "Lambda",
        "description": "Trigger automated remediation Lambda function"
      }
    ],
    "tags": [
      "cloud_native"
    ]
  },
