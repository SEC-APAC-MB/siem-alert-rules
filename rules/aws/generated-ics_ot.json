[
  {
    "rule_id": "AWS-ICS_OT-107",
    "name": "Modbus Command Injection",
    "description": "Industrial Control Systems and Operational Technology attack detection",
    "severity": "critical",
    "category": "ics_ot",
    "mitre_attack": [],
    "compliance": [],
    "source": "emerging",
    "detection": {
      "query_type": "cloudwatch_metric_filter",
      "filter_pattern": "{ ($.eventName = \"*\") }",
      "log_group": "/aws/cloudtrail",
      "metric_namespace": "Security/Monitoring",
      "metric_name": "ModbusCommandInjection",
      "threshold": 5,
      "evaluation_periods": 1,
      "statistic": "Sum",
      "period": 300
    },
    "actions": [
      {
        "type": "SNS",
        "description": "Send alert to security team SNS topic"
      },
      {
        "type": "Lambda",
        "description": "Trigger automated remediation Lambda function"
      }
    ],
    "tags": [
      "ics_ot"
    ]
  },
