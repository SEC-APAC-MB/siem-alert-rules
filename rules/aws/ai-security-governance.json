    {
      "rule_id": "AWS-AI-GOV-004",
      "name": "AI \u2014 Unauthorized Model Deployment",
      "description": "Detects deployment of AI models without proper approval or governance review",
      "severity": "critical",
      "category": "general",
      "mitre_attack": [
        "T1190"
      ],
      "compliance": [],
      "source": [
        "aws.cloudtrail"
      ],
      "detection": {
        "query_type": "cloudwatch_metric_filter",
        "filter_pattern": "{ ($.eventName = \"*\") && ($.sourceIPAddress != \"10.*\") && ($.requestParameters.* \"ai\") }",
        "log_group": "/aws/cloudtrail",
        "metric_namespace": "Security/Monitoring",
        "metric_name": "AIUnauthorizedModelDeployment",
        "threshold": 3,
        "evaluation_periods": 1,
        "statistic": "Sum",
        "period": 300
      },
      "eventbridge": {
        "pattern": {
          "source": [
            "aws.security",
            "aws.guardduty"
          ],
          "detail-type": [
            "AWS API Call via CloudTrail",
            "GuardDuty Finding"
          ],
          "detail": {
            "eventName": [
              "AI \u2014 Unauthorized Model Deployment"
            ]
          }
        },
        "state": "ENABLED"
      },
      "actions": [
        {
          "type": "SNS",
          "description": "Send alert to security team SNS topic"
        }
      ],
      "tags": [
        "ai",
        "governance",
