      "name": "CVE-2026-64849 \u2014 MLflow Exploitation",
      "description": "Detects exploitation attempts targeting CVE-2026-64849: MLflow contains a server-side request forgery vulnerability that can allow attackers to reach internal or cloud metadata services and receive response_status and response_body.. Product: MLflow",
      "severity": "critical",
      "category": "ssrf",
      "mitre_attack": [
        "T1190"
      ],
      "compliance": [
        "PCI-DSS-6.5",
        "NIST-800-53-SI-4",
        "GDPR-32A"
      ],
      "source": [
        "aws.cloudtrail"
      ],
      "detection": {
        "query_type": "cloudwatch_metric_filter",
        "filter_pattern": "{ ($.eventName = \"*\") && ($.sourceIPAddress != \"10.*\") && ($.requestParameters.* \"CVE-2026-64849\") }",
        "log_group": "/aws/cloudtrail",
        "metric_namespace": "Security/Monitoring",
        "metric_name": "CVE202664849MLflowExploitation",
        "threshold": 3,
        "evaluation_periods": 1,
        "statistic": "Sum",
        "period": 300
      },
      "eventbridge": {
        "pattern": {
          "source": [
            "aws.security",
            "aws.guardduty"
          ],
          "detail-type": [
            "AWS API Call via CloudTrail",
            "GuardDuty Finding"
          ],
          "detail": {
