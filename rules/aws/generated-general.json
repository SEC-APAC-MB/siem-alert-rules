[
  {
    "rule_id": "AWS-GENERAL-002",
    "name": "CVE-2026-73570 \u2014 Zimbra Collaboration Suite (ZCS) Exploitation",
    "description": "Detects exploitation attempts targeting CVE-2026-73570: Zimbra Collaboration Suite (ZCS) contains an OS command injection vulnerability which could allow an unauthenticated attacker to send specially crafted SMTP requests that may result in execution of arbitrary operating system commands as the Zimbra user.. Product: Zimbra Collaboration Suite (ZCS)",
    "severity": "critical",
    "category": "general",
    "mitre_attack": [
      "T1110",
      "T1078"
    ],
    "compliance": [
      "PCI-DSS-6.5",
      "NIST-800-53-SI-4",
      "GDPR-32A"
    ],
    "source": [
      "aws.cloudtrail"
    ],
    "detection": {
      "query_type": "cloudwatch_metric_filter",
      "filter_pattern": "{ ($.eventName = \"*\") }",
      "log_group": "/aws/cloudtrail",
      "metric_namespace": "Security/Monitoring",
      "metric_name": "CVE-2026-73570\u2014ZimbraCollaborationSuite(ZCS)Exploitation",
      "threshold": 5,
      "evaluation_periods": 1,
      "statistic": "Sum",
      "period": 300
    },
    "actions": [
      {
        "type": "SNS",
        "description": "Send alert to security team SNS topic"
      },
      {
        "type": "Lambda",
        "description": "Trigger automated remediation Lambda function"
      }
    ],
    "tags": [
      "general",
      "cve",
      "cve-2026-73570",
      "exploited"
    ]
  },
