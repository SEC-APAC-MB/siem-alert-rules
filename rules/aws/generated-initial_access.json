[
  {
    "rule_id": "AWS-INITIAL_ACCESS-127",
    "name": "Phishing Link Detection",
    "description": "Detect credential harvesting links in email via URL reputation",
    "severity": "critical",
    "category": "initial_access",
    "mitre_attack": [],
    "compliance": [],
    "source": "pentest",
    "detection": {
      "query_type": "cloudwatch_metric_filter",
      "filter_pattern": "{ ($.eventName = \"*\") }",
      "log_group": "/aws/cloudtrail",
      "metric_namespace": "Security/Monitoring",
      "metric_name": "PhishingLinkDetection",
      "threshold": 5,
      "evaluation_periods": 1,
      "statistic": "Sum",
      "period": 300
    },
    "actions": [
      {
        "type": "SNS",
        "description": "Send alert to security team SNS topic"
      },
      {
        "type": "Lambda",
        "description": "Trigger automated remediation Lambda function"
      }
    ],
    "tags": [
      "initial_access"
    ]
  },
