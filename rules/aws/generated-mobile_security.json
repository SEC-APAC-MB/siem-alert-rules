[
  {
    "rule_id": "AWS-MOBILE_SECURITY-097",
    "name": "App Repackaging Detection",
    "description": "Android and iOS specific attack detection: app repackaging, certificate pinning bypass, API tampering",
    "severity": "critical",
    "category": "mobile_security",
    "mitre_attack": [],
    "compliance": [],
    "source": "emerging",
    "detection": {
      "query_type": "cloudwatch_metric_filter",
      "filter_pattern": "{ ($.eventName = \"*\") }",
      "log_group": "/aws/cloudtrail",
      "metric_namespace": "Security/Monitoring",
      "metric_name": "AppRepackagingDetection",
      "threshold": 5,
      "evaluation_periods": 1,
      "statistic": "Sum",
      "period": 300
    },
    "actions": [
      {
        "type": "SNS",
        "description": "Send alert to security team SNS topic"
      },
      {
        "type": "Lambda",
        "description": "Trigger automated remediation Lambda function"
      }
    ],
    "tags": [
      "mobile_security"
    ]
  },
