[
  {
    "rule_id": "AWS-ZERO_DAY-087",
    "name": "Unexpected Process Execution from Web Directory",
    "description": "Behavioral detection rules for unknown zero-day exploitation patterns",
    "severity": "critical",
    "category": "zero_day",
    "mitre_attack": [],
    "compliance": [],
    "source": "emerging",
    "detection": {
      "query_type": "cloudwatch_metric_filter",
      "filter_pattern": "{ ($.eventName = \"*\") }",
      "log_group": "/aws/cloudtrail",
      "metric_namespace": "Security/Monitoring",
      "metric_name": "UnexpectedProcessExecutionfromWebDirectory",
      "threshold": 5,
      "evaluation_periods": 1,
      "statistic": "Sum",
      "period": 300
    },
    "actions": [
      {
        "type": "SNS",
        "description": "Send alert to security team SNS topic"
      },
      {
        "type": "Lambda",
        "description": "Trigger automated remediation Lambda function"
      }
    ],
    "tags": [
      "zero_day"
    ]
  },
