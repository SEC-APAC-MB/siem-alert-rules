[
  {
    "rule_id": "AWS-EXFILTRATION-157",
    "name": "DNS Tunneling Detection",
    "description": "Detect anomalous DNS query patterns indicating data exfiltration via DNS",
    "severity": "critical",
    "category": "exfiltration",
    "mitre_attack": [],
    "compliance": [],
    "source": "pentest",
    "detection": {
      "query_type": "cloudwatch_metric_filter",
      "filter_pattern": "{ ($.eventName = \"*\") }",
      "log_group": "/aws/cloudtrail",
      "metric_namespace": "Security/Monitoring",
      "metric_name": "DNSTunnelingDetection",
      "threshold": 5,
      "evaluation_periods": 1,
      "statistic": "Sum",
      "period": 300
    },
    "actions": [
      {
        "type": "SNS",
        "description": "Send alert to security team SNS topic"
      },
      {
        "type": "Lambda",
        "description": "Trigger automated remediation Lambda function"
      }
    ],
    "tags": [
      "exfiltration"
    ]
  },
