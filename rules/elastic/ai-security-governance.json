      "rule_id": "ES-AI-GOV-010",
      "name": "AI Governance \u2014 Missing AI Risk Assessment",
      "description": "Detects deployment of AI systems without required risk assessment documentation per EU AI Act and organizational policy",
      "severity": "high",
      "type": "query",
      "query": "event.category:\"deployment\" AND \"ai-model\" AND NOT _marker:risk_assessment_completed",
      "index": [
